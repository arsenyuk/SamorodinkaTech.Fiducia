<div class="password-input position-relative @CssClass">
    <!-- Visible masked display -->
    <input type="text"
           class="form-control"
           value="@_maskedDisplay"
           placeholder="@Placeholder"
           readonly
           disabled="@Disabled"
           tabindex="-1" />

    <!-- Real password input (hidden, captures keystrokes) -->
    <input type="password"
           class="position-absolute top-0 start-0 w-100 h-100"
           style="opacity: 0; z-index: 1; cursor: text;"
           value="@Value"
           placeholder="@Placeholder"
           disabled="@Disabled"
           @oninput="HandleInput" />
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Фиксированное количество масок-символов. null = показывать все.</summary>
    [Parameter] public int? DisplayLimit { get; set; }

    [Parameter] public string MaskChar { get; set; } = "*";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private string _maskedDisplay = "";

    protected override void OnParametersSet()
    {
        UpdateMaskedDisplay();
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        var newValue = e.Value?.ToString() ?? "";
        await ValueChanged.InvokeAsync(newValue);
    }

    private void UpdateMaskedDisplay()
    {
        if (string.IsNullOrEmpty(Value))
        {
            _maskedDisplay = "";
            return;
        }

        var length = Value.Length;

        if (DisplayLimit.HasValue)
            length = DisplayLimit.Value;

        _maskedDisplay = length > 0 ? new string(MaskChar[0], length) : "";
    }
}
