@namespace SamorodinkaTech.Fiducia.Timeline.Components
@inherits GanttTimelineBase

<div class="gt-container">
    <div class="gt-controls">
        <button class="gt-btn" @onclick="ZoomIn" disabled="@(_scale == TimelineScale.Days)" title="Приблизить">
            <span class="gt-btn-icon">+</span>
        </button>
        <select class="gt-select" value="@_scale.ToString()" @onchange="OnScaleSelectChanged">
            <option value="Days">Дни</option>
            <option value="Weeks">Недели</option>
            <option value="Months">Месяцы</option>
            <option value="Quarters">Кварталы</option>
            <option value="Years">Годы</option>
        </select>
        <button class="gt-btn" @onclick="ZoomOut" disabled="@(_scale == TimelineScale.Years)" title="Отдалить">
            <span class="gt-btn-icon">–</span>
        </button>
    </div>

    <div class="gt-scroll" @ref="_scrollRef">
        <div class="gt-inner" style="width: @(_totalWidthPx)px">
            @if (_result != null)
            {
                <!-- Upper row -->
                <div class="gt-row gt-row-upper">
                    @foreach (var div in _result.Upper)
                    {
                        var w = div.Span * _cellWidthPx;
                        <div class="gt-cell gt-cell-upper" style="width: @(w)px" title="@div.Tooltip">
                            <span class="gt-label">@div.Label</span>
                        </div>
                    }
                </div>

                <!-- Lower row -->
                <div class="gt-row gt-row-lower">
                    @foreach (var div in _result.Lower)
                    {
                        var cls = "gt-cell gt-cell-lower";
                        if (div.IsWeekend) cls += " gt-weekend";
                        if (div.IsHoliday) cls += " gt-holiday";
                        if (div.IsToday) cls += " gt-today";

                        <div class="@cls"
                             style="width: @(_cellWidthPx)px"
                             title="@div.Tooltip"
                             @onclick="() => OnCellClicked(div)"
                             @onclick:stopPropagation="true">
                            <span class="gt-label">@div.Label</span>
                        </div>
                    }
                </div>

                <!-- Today marker line -->
                @if (_todayLinePx >= 0)
                {
                    <div class="gt-today-line" style="left: @(_todayLinePx)px"></div>
                }
            }
        </div>
    </div>
</div>