# =============================================================================
# LDAP-схема: атрибут mpiMasterId для MPI идентификатора
# =============================================================================
# Применение: ldapadd -x -H ldap://localhost -D "cn=admin,cn=config" -W -f schema-mpi.ldif
# =============================================================================

# Определение атрибута mpiMasterId
dn: cn=mpi,cn=schema,cn=config
changetype: add
objectClass: olcSchemaConfig
cn: mpi
olcAttributeTypes: ( 1.3.6.1.4.1.99999.1.1
    NAME 'mpiMasterId'
    EQUALITY caseIgnoreMatch
    SUBSTR caseIgnoreSubstringsMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{36}
    SINGLE-VALUE )
