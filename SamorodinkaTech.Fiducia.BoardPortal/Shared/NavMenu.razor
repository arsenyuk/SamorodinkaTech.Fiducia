@inject NavigationManager Navigation
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@inject SamorodinkaTech.Fiducia.Domain.Interfaces.ILegalEntityGosaIntervalService GosaSvc
@inject AuthenticationStateProvider AuthState

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="" @onclick="GoHome" @onclick:preventDefault><span class="oi oi-home" aria-hidden="true"></span> Fiducia</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="meetings">
                <span class="oi oi-people" aria-hidden="true"></span> Созывы СД
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="agenda">
                <span class="oi oi-list-rich" aria-hidden="true"></span> Повестки заседаний СД
            </NavLink>
        </div>
        <div class="nav-item px-3">
            @if (_isLlc)
            {
                <NavLink class="nav-link" href="osu-meetings">
                    <span class="oi oi-calendar" aria-hidden="true"></span> ОСУ
                </NavLink>
            }
            @if (_isLlc)
            {
                <NavLink class="nav-link" href="agenda-osu">
                    <span class="oi oi-list-rich" aria-hidden="true"></span> Повестка ОСУ
                </NavLink>
            }
            else
            {
                <NavLink class="nav-link" href="osa-meetings">
                    <span class="oi oi-calendar" aria-hidden="true"></span> ОСА
                </NavLink>
            }
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link text-nowrap" href="contracts">
                <span class="oi oi-document" aria-hidden="true"></span> Договоры
            </NavLink>
        </div>
        @if (_isMemberBoard)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="committees">
                    <span class="oi oi-browser" aria-hidden="true"></span> Комитеты
                </NavLink>
            </div>
        }
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="notifications">
                <span class="oi oi-bell" aria-hidden="true"></span> Оповещения
            </NavLink>
        </div>
        @if (_isLlc)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="participants">
                    <span class="oi oi-list-rich" aria-hidden="true"></span> Участники
                </NavLink>
            </div>
        }
        @if (_isParticipant)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="informing">
                    <span class="oi oi-info" aria-hidden="true"></span> Информирование
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="share-requests">
                    <span class="oi oi-briefcase" aria-hidden="true"></span> Мои запросы
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="documents/catalog">
                    <span class="oi oi-folder-open" aria-hidden="true"></span> Документы
                </NavLink>
            </div>
        }
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="org-plan">
                <span class="oi oi-project" aria-hidden="true"></span> План
            </NavLink>
        </div>
        @if (_isSysAdmin)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="trueconf-test">
                    <span class="oi oi-video" aria-hidden="true"></span> TrueConf Тест
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private bool _isLlc;
    private bool _isSysAdmin;
    private bool _isParticipant;
    private bool _isMemberBoard;
    private bool _isCeo;
    private string _legalEntityName = "Fiducia";

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthState.GetAuthenticationStateAsync();
            var user = authState.User;
            _isSysAdmin = user.IsInRole("SYS_ADMIN");
            _isParticipant = user.IsInRole("PARTICIPANT");
            _isMemberBoard = user.IsInRole("MEMBER_BOARD") || user.IsInRole("CHAIR_BOARD") || user.IsInRole("SYS_ADMIN");
            _isCeo = user.IsInRole("CEO");

            await using var ctx = await DbFactory.CreateDbContextAsync();
            var workplace = await ctx.CurrentWorkplaces.FirstOrDefaultAsync();
            var leId = workplace?.LastSelectedLegalEntityId;
            if (leId is not null && leId != Guid.Empty)
            {
                var le = await ctx.LegalEntities
                    .Where(x => x.Id == leId.Value)
                    .Select(x => new { x.Name, x.RefOkopf!.Code })
                    .FirstOrDefaultAsync();
                _isLlc = GosaSvc.IsLlc(le?.Code);
                _legalEntityName = le?.Name ?? "Fiducia";
            }
        }
        catch { /* fallback: показываем ОСА */ }
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/main");
    }
}
