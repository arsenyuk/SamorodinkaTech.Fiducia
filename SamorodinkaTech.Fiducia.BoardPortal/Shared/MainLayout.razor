@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject IHttpContextAccessor HttpContextAccessor
@inject HttpClient Http
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@using SamorodinkaTech.Fiducia.Infrastructure.Common

<PageTitle>Fiducia — Board Portal</PageTitle>

@if (_isPublicPage)
{
    <div class="container py-4">
        @Body
    </div>
}
else
{
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <div class="top-row px-4 d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@_legalEntityName</h5>
                <div class="d-flex align-items-center gap-3">
                    <a href="/notifications" class="text-decoration-none position-relative" title="Оповещения">
                        <span class="oi oi-bell" aria-hidden="true"></span>
                        @if (_unreadCount > 0)
                        {
                            <span class="badge bg-danger position-absolute top-0 start-100 translate-middle" style="font-size:0.65rem; font-weight:bold;">
                                @(_unreadCount > 9 ? "\u221E" : _unreadCount.ToString())
                            </span>
                        }
                    </a>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            @_userName
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/profile">
                                <span class="oi oi-person me-2"></span>Профиль
                            </a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/logout">
                                <span class="oi oi-account-logout me-2"></span>Выход
                            </a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <article class="content px-4">
                <ErrorBoundary @ref="_errorBoundary">
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent Context="exception">
                        <div class="alert alert-danger m-3">
                            <h4>Произошла ошибка</h4>
                            <p>При отображении страницы возникла непредвиденная ошибка. Попробуйте обновить страницу или обратитесь к администратору.</p>
                            <button class="btn btn-outline-danger btn-sm" @onclick="RecoverFromError">Повторить попытку</button>
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            </article>
        </main>
    </div>
}

@code {
    private string _userName = "Гость";
    private string _legalEntityName = "Fiducia Board Portal";
    private bool _isInitialized;
    private ErrorBoundary? _errorBoundary;
    private int _unreadCount;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private bool _isPublicPage => IsPublicUrl(NavigationManager.Uri);

    private static readonly string[] _publicPaths = { "/login", "/logout", "/proposal", "/onboarding", "/election", "/gantt-test" };

    private static bool IsPublicUrl(string uri)
    {
        var path = new Uri(uri).AbsolutePath;
        if (path == "/") return true;

        foreach (var p in _publicPaths)
        {
            if (path.StartsWith(p, StringComparison.OrdinalIgnoreCase))
                return true;
        }
        return false;
    }

    protected override void OnParametersSet()
    {
        _errorBoundary?.Recover();
    }

    private void RecoverFromError()
    {
        _errorBoundary?.Recover();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isInitialized)
        {
            _isInitialized = true;

            var userId = UserContextHelper.GetUserIdAsync(HttpContextAccessor.HttpContext!);
            if (userId.HasValue)
            {
                await using var ctx = await DbFactory.CreateDbContextAsync();
                _userName = await UserContextHelper.GetFullNameAsync(ctx, userId.Value);
            }

            // Гард: при отсутствии авторизации не даём оставаться на защищённых маршрутах
            try
            {
                var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Trim('/');
                var isPublicRoute = string.IsNullOrEmpty(relative)
                    || relative == "/"
                    || _publicPaths.Any(p => relative.StartsWith(p.TrimStart('/'), StringComparison.OrdinalIgnoreCase));
                if (userId is null && !isPublicRoute)
                {
                    NavigationManager.NavigateTo("/login", true);
                    return;
                }

                // Загружаем количество непрочитанных оповещений
                if (userId.HasValue)
                {
                    await using var ctx = await DbFactory.CreateDbContextAsync();
                    _unreadCount = await ctx.Notifications
                        .Where(n => n.UserId == userId.Value && !n.IsRead)
                        .CountAsync();
                }
            }
            catch { }

            try
            {
                await using var ctx = await DbFactory.CreateDbContextAsync();
                var leId = await LegalEntityHelper.GetLegalEntityIdAsync(ctx, HttpContextAccessor);
                if (leId is not null && leId != Guid.Empty)
                {
                    var le = await ctx.LegalEntities
                        .Where(x => x.Id == leId.Value)
                        .Select(x => x.Name)
                        .FirstOrDefaultAsync();
                    if (!string.IsNullOrWhiteSpace(le))
                        _legalEntityName = le;
                }
            }
            catch { /* fallback: Fiducia Board Portal */ }

            try
            {
                var config = await Http.GetFromJsonAsync<SessionConfig>("/api/session/config");
                if (config?.IdleTimeoutMinutes > 0)
                {
                    await JS.InvokeVoidAsync("idleTimer.start", config.IdleTimeoutMinutes);
                }
            }
            catch
            {
                await JS.InvokeVoidAsync("idleTimer.start", 5);
            }

            StateHasChanged();
        }
    }

    private record SessionConfig(int IdleTimeoutMinutes);
}
