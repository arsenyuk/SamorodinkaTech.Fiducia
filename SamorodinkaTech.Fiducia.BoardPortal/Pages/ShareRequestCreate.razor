    private record RequestTypeDto(Guid Id, string Code, string Name, bool RequiresFile, bool ConsideredByOsu, bool RequiresThreshold, decimal? ThresholdPercent, string? LegalBasis, bool IsCollective, bool IsAvailable, string? UnavailabilityReason);
    private record ParticipantDto(Guid Id, string? FullName, decimal? SharePercent);
    private record ExistingRequestDto(Guid Id, Guid RequestTypeId, string? Payload, string Status);
    private record DocumentGroupDto(string Code, string Name, List<DocumentTypeDto> Documents);
    private record DocumentTypeDto(Guid Id, string Code, string Name, string GroupCode, string GroupName, bool IsElectronicAvailable, int StorageYears);
    private record AccessMethodDto(Guid Id, string Code, string Name, string? Description, int? DeadlineDays);

    private static RequestTypeDto MapToRequestTypeDto(
        Domain.Entities.RefRequestType rt,
        Domain.Entities.LegalEntityCharter? charter,
        Domain.Entities.LegalEntityExtraSettings? extraSettings,
        Domain.Entities.LegalEntity? le,
        bool isLlc, bool isNjsc, bool isPjsc)
    {
        var isCollective = IsCollectiveType(rt.Code);
        var requiresThreshold = rt.Code is "DEMAND_VOSU" or "DEMAND_VOSA";
        decimal? thresholdPercent = requiresThreshold ? charter?.VosuThresholdPercent : null;

        // Проверка соответствия типа организации
        var isForOrgType = (isLlc && rt.IsForLlc) || (isNjsc && rt.IsForNjsc) || (isPjsc && rt.IsForPjsc);

        var isAvailable = isForOrgType && rt.Code switch
        {
            "EXIT_APPLICATION" => charter?.ExitAllowed ?? false,
            "PREEMPTIVE_LIST" => charter?.PreemptiveRight ?? true,
            "NOTARY_LIST_MAINTENANCE" => !(extraSettings?.NotaryListApproved ?? false),
            "CONVERT_STANDARD_TO_CUSTOM_CHARTER" => le?.StandardCharterId.HasValue ?? false,
            "CHANGE_STANDARD_CHARTER_NUMBER" => le?.StandardCharterId.HasValue ?? false,
            "CHANGE_CUSTOM_CHARTER_PROVISION" => !(le?.StandardCharterId.HasValue ?? true),
            "EXCLUDE_PARTICIPANT" => charter?.ExecutiveBody == 'A',
            _ => true
        };

        var unavailabilityReason = !isForOrgType
            ? $"Недоступно для {OrgTypeLabel(le)}"
            : rt.Code switch
            {
                "EXIT_APPLICATION" when !(charter?.ExitAllowed ?? false) => "Выход из общества не предусмотрен уставом",
                "NOTARY_LIST_MAINTENANCE" when extraSettings?.NotaryListApproved == true => "Ведение списка через нотариат уже утверждено",
                "CONVERT_STANDARD_TO_CUSTOM_CHARTER" when !(le?.StandardCharterId.HasValue ?? false) => "Текущий устав уже является индивидуальным",
                "CHANGE_STANDARD_CHARTER_NUMBER" when !(le?.StandardCharterId.HasValue ?? false) => "Текущий устав уже является индивидуальным",
                "CHANGE_CUSTOM_CHARTER_PROVISION" when le?.StandardCharterId.HasValue ?? true => "Текущий устав является типовым — используйте «Изменить номер типового устава»",
                "EXCLUDE_PARTICIPANT" when charter?.ExecutiveBody != 'A' => "Требование об исключении доступно только при единоличном исполнительном органе (генеральный директор)",
                _ => null
            };

        var legalBasis = GetLegalBasis(rt.Code);

        return new RequestTypeDto(rt.Id, rt.Code, rt.Name, rt.RequiresFile, rt.ConsideredByOsu,
            requiresThreshold, thresholdPercent, legalBasis, isCollective, isAvailable, unavailabilityReason);
    }

    private static string OrgTypeLabel(Domain.Entities.LegalEntity? le)
    {
        var code = le?.RefOkopf?.Code;
        if (code == "12300") return "ООО";
        if (code == "12267") return "НАО";
        if (code == "12247") return "ПАО";
        return "данного типа организации";
    }

