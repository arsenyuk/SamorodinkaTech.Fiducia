    private async Task SubmitRequest()
    {
        if (_selectedType is null) return;

        // Валидация
        if (_useMultiItems)
        {
            if (_formItems.Count == 0)
            {
                _error = "Добавьте хотя бы один пункт требования";
                return;
            }
            foreach (var (item, idx) in _formItems.Select((item, idx) => (item, idx)))
            {
                if (string.IsNullOrWhiteSpace(item.Title))
                {
                    _error = $"Введите заголовок пункта {idx + 1}";
                    return;
                }
                if (string.IsNullOrWhiteSpace(item.Description))
                {
                    _error = $"Введите описание пункта {idx + 1}";
                    return;
                }
            }
        }
        else if (IsCollectiveType(_selectedType.Code) && string.IsNullOrWhiteSpace(_demandText))
        {
            _error = "Введите текст требования";
            return;
        }
        else if (_selectedType.Code == "CHANGE_STANDARD_CHARTER_NUMBER" && string.IsNullOrWhiteSpace(_newCharterNumber))
        {
            _error = "Выберите номер типового устава";
            return;
        }
        else if (_selectedType.Code == "OTHER" && string.IsNullOrWhiteSpace(_demandText))
        {
            _error = "Введите описание требования";
            return;
        }

        _isSubmitting = true;
        _error = null;
        _previousRequestId = null;

        try
        {
            string? payload = BuildPayload();
            string? text = BuildText();
            Guid requestId;

            if (IsEditMode)
            {
                await ShareRequestWrite.UpdatePayloadAsync(Id!.Value, text, payload);
                requestId = Id!.Value;
            }
            else
            {
                if (_selectedType.IsCollective)
                {
                    if (_userId is null)
                    {
                        Logger.LogWarning("Не удалось определить пользователя при создании коллективного требования");
                        _error = "Не удалось определить пользователя.";
                        return;
                    }
                    requestId = await ShareRequestWrite.CreateCollectiveAsync(_userId.Value, _selectedType.Id, text, payload);
                }
                else
                {
                    if (_userId is null)
                    {
                        Logger.LogWarning("Не удалось определить пользователя при создании требования");
                        _error = "Не удалось определить пользователя.";
                        return;
                    }
                    requestId = await ShareRequestWrite.CreateAsync(_userId.Value, _selectedType.Id, text, payload);
                }
            }

            if (_useMultiItems)
            {
                // Сохраняем пункты требования
                for (var i = 0; i < _formItems.Count; i++)
                {
                    var itemId = await ShareRequestWrite.AddItemAsync(
                        requestId, _formItems[i].Title, _formItems[i].Description);

                    // Прикрепляем файлы к пункту
                    foreach (var file in _formItems[i].Files)
                    {
                        await ShareRequestWrite.AttachFileToItemAsync(requestId, itemId, file.FileId);
                    }
                }
            }
            else
            {
                // Прикрепляем файлы (общий блок)
                foreach (var file in _uploadedFiles)
                {
                    await ShareRequestWrite.AttachFileAsync(requestId, file.FileId);
                }
            }

            // Отправляем требование (если не было редактирования draft)
            if (!IsEditMode)
            {
                await ShareRequestWrite.SubmitAsync(requestId);
            }

            Nav.NavigateTo("/share-requests", forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка сохранения запроса");
            _error = ExtractErrorMessage(ex.Message);
            _previousRequestId = ExtractRequestId(ex.Message);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task SaveAsDraft()
    {
        if (_selectedType is null) return;

        _isSubmitting = true;
        _error = null;
        _previousRequestId = null;

        try
        {
            string? payload = BuildPayload();
            string? text = BuildText();
            Guid requestId;

            if (IsEditMode)
            {
                await ShareRequestWrite.UpdatePayloadAsync(Id!.Value, text, payload);
                requestId = Id!.Value;
            }
            else
            {
                if (_selectedType.IsCollective)
                {
                    if (_userId is null)
                    {
                        Logger.LogWarning("Не удалось определить пользователя при создании коллективного требования");
                        _error = "Не удалось определить пользователя.";
                        return;
                    }
                    requestId = await ShareRequestWrite.CreateCollectiveAsync(_userId.Value, _selectedType.Id, text, payload);
                }
                else
                {
                    if (_userId is null)
                    {
                        Logger.LogWarning("Не удалось определить пользователя при создании требования");
                        _error = "Не удалось определить пользователя.";
                        return;
                    }
                    requestId = await ShareRequestWrite.CreateAsync(_userId.Value, _selectedType.Id, text, payload);
                }
            }

            if (_uploadedFiles.Count > 0)
            {
                foreach (var file in _uploadedFiles)
                {
                    await ShareRequestWrite.AttachFileAsync(requestId, file.FileId);
                }
            }

            Nav.NavigateTo("/share-requests", forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка сохранения черновика");
            _error = $"Ошибка сохранения черновика: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private string? BuildPayload()
    {
        if (_selectedType is null) return null;

        if (_selectedType.Code == "DEMAND_VOSU")
        {
            return System.Text.Json.JsonSerializer.Serialize(new { reason = _demandReason });
        }
        if (_selectedType.Code == "CHANGE_STANDARD_CHARTER_NUMBER")
        {
            return System.Text.Json.JsonSerializer.Serialize(new { newCharterNumber = _newCharterNumber });
        }
        if (_selectedType.Code == "REQUEST_INFORMATION")
        {
            return System.Text.Json.JsonSerializer.Serialize(new
            {
                documentTypeCodes = _selectedDocumentTypeCodes.ToList(),
                accessMethodCode = _selectedAccessMethodCode
            });
        }
        return null;
    }

    private string? BuildText() => _selectedType is null ? null : _demandText;

    private void ToggleDocumentType(string code, object? isChecked)
    {
        if (isChecked is bool checkedVal && checkedVal)
            _selectedDocumentTypeCodes.Add(code);
        else
            _selectedDocumentTypeCodes.Remove(code);
    }

    private bool HasElectronicAvailable()
    {
        foreach (var group in _documentGroups)
        {
            foreach (var doc in group.Documents)
            {
                if (_selectedDocumentTypeCodes.Contains(doc.Code) && doc.IsElectronicAvailable)
                    return true;
            }
        }
        return false;
    }

