@page "/share-requests/create"
@page "/share-requests/{Id:guid}/edit"
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using SamorodinkaTech.Fiducia.Domain.Interfaces
@using SamorodinkaTech.Fiducia.SharedComponents.Components
@inject NavigationManager Nav
@inject ILogger<ShareRequestCreate> Logger
@inject IShareRequestReadService ShareRequestRead
@inject IShareRequestWriteService ShareRequestWrite
@inject IParticipantReadService ParticipantRead
@inject IHttpContextAccessor HttpContextAccessor
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "PARTICIPANT,CEO")]

<PageTitle>Fiducia — @(IsEditMode ? "Редактирование требования" : "Подать требование или запрос")</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>@(IsEditMode ? "Редактирование требования" : "Подать требование или запрос")</h3>
    <a href="/share-requests" class="btn btn-outline-secondary">← Назад к списку</a>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">
        @_error
        @if (_previousRequestId.HasValue)
        {
            <a href="/share-requests/@_previousRequestId" class="alert-link ms-1">Просмотреть заявку</a>
        }
    </div>
}

@if (_loading)
{
    <div class="text-center py-4">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (_selectedType is null)
{
    @* ── Выбор типа требования ─────────────────────────────────────── *@
    <p class="text-muted mb-4">Выберите тип требования или запроса:</p>

    @* ── Требования, рассматриваемые ОСУ ─────────────────────────── *@
    var osuTypes = _availableTypes.Where(t => t.ConsideredByOsu && t.IsAvailable).ToList();
    if (osuTypes.Count > 0)
    {
        <h5 class="mb-3">Требования, рассматриваемые ОСУ</h5>

        <div class="row g-3 mb-4">
            @foreach (var rt in osuTypes)
            {
                <div class="col-md-6">
                    <div class="card h-100" style="cursor:pointer" @onclick="() => SelectType(rt)">
                        <div class="card-body">
                            <h5 class="card-title">@rt.Name</h5>
                            <p class="card-text text-muted small mb-0">
                                @GetDescription(rt.Code)
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @* ── Требования, удовлетворяемые ГД ──────────────────────────── *@
    var gdTypes = _availableTypes.Where(t => !t.ConsideredByOsu && t.IsAvailable).ToList();
    if (gdTypes.Count > 0)
    {
        <h5 class="mb-3">Требования, удовлетворяемые ГД</h5>

        <div class="row g-3 mb-4">
            @foreach (var rt in gdTypes)
            {
                <div class="col-md-6">
                    <div class="card h-100" style="cursor:pointer" @onclick="() => SelectType(rt)">
                        <div class="card-body">
                            <h5 class="card-title">@rt.Name</h5>
                            <p class="card-text text-muted small mb-0">
                                @GetDescription(rt.Code)
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @* ── Недоступные (общая секция) ────────────────────────────────── *@
    var allUnavailable = _availableTypes.Where(t => !t.IsAvailable).ToList();
    @if (allUnavailable.Count > 0)
    {
        <h6 class="text-muted mb-2">Недоступные</h6>
        <div class="row g-3 mb-4">
            @foreach (var rt in allUnavailable)
            {
                <div class="col-md-6">
                    <div class="card h-100 border-secondary bg-light">
                        <div class="card-body">
                            <h5 class="card-title text-muted">@rt.Name</h5>
                            <p class="card-text small text-danger mb-0">
                                @rt.UnavailabilityReason
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    @* ── Форма создания требования ──────────────────────────────────── *@
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h5>@_selectedType.Name</h5>
                    <p class="text-muted mb-0">@GetDescription(_selectedType.Code)</p>
                </div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _selectedType = null">
                    ← Другой тип
                </button>
            </div>

            @* ── Подсказка по правовой норме ────────────────────────── *@
            @if (GetLegalBasisInfo(_selectedType.Code) is { } legalInfo)
            {
                <div class="alert alert-info py-2 mb-3">
                    <strong>Правовая норма:</strong>
                    <LawReferenceLink Article="@legalInfo.Article" Text="@legalInfo.Text" />
                </div>
            }

            @* ── Условия и ограничения ──────────────────────────────── *@
            @if (!_selectedType.IsAvailable && !string.IsNullOrEmpty(_selectedType.UnavailabilityReason))
            {
                <div class="alert alert-danger py-2 mb-3">
                    <strong>Недоступно:</strong> @_selectedType.UnavailabilityReason
                </div>
            }
            else if (!string.IsNullOrEmpty(GetConditions(_selectedType.Code)))
            {
                <div class="alert alert-warning py-2 mb-3">
                    <strong>Условия:</strong> @GetConditions(_selectedType.Code)
                </div>
            }

            @* ── Поля формы ──────────────────────────────────────────── *@
            <div class="row g-3">
                @if (_selectedType.Code == "DEMAND_VOSU")
                {
                    <div class="col-12">
                        <label class="form-label">Текст требования *</label>
                        <textarea class="form-control" @bind="_demandText" rows="4"
                                  placeholder="Опишите суть требования о созыве внеочередного собрания..."></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Основание (необязательно)</label>
                        <input class="form-control" @bind="_demandReason"
                               placeholder="Например: необходимость рассмотрения вопроса о..." />
                    </div>
                    <div class="col-12">
                        <div class="alert alert-secondary py-2 mb-0">
                            <text><strong>Порог:</strong>
                            Для созыва ВОСУ необходимо владеть не менее @_selectedType.ThresholdPercent% голосов участников (ст. 35 14-ФЗ).</text>
                            @if (_participantSharePercent.HasValue)
                            {
                                <span class="ms-2"><text>Ваша доля: <strong>@_participantSharePercent%</strong>
                                (@(_participantSharePercent >= _selectedType.ThresholdPercent ? "порог выполнен" : "ниже порога"))</text></span>
                            }
                        </div>
                    </div>
                }
                else if (IsCollectiveType(_selectedType.Code))
                {
                    <div class="col-12">
                        <label class="form-label">Текст требования *</label>
                        <textarea class="form-control" @bind="_demandText" rows="4"
                                  placeholder="Опишите суть требования..."></textarea>
                    </div>
                    <div class="col-12">
                        <div class="alert alert-secondary py-2 mb-0">
                            @if (_selectedType.RequiresThreshold)
                            {
                                <text><strong>Порог:</strong> @_selectedType.ThresholdPercent% голосов (ст. 55 208-ФЗ).
                                Требование будет направлено ГД только после набора порога.</text>
                            }
                            else
                            {
                                <text><strong>Без порога:</strong> Требование будет направлено ГД сразу после создания.</text>
                            }
                        </div>
                    </div>
                }
                else if (_selectedType.Code == "CHANGE_STANDARD_CHARTER_NUMBER")
                {
                    <div class="col-12">
                        <label class="form-label">Номер нового типового устава *</label>
                        <select class="form-select" @bind="_newCharterNumber">
                            <option value="">Выберите номер...</option>
                            @for (int i = 1; i <= 36; i++)
                            {
                                var num = i.ToString("D2");
                                <option value="@num">Типовой устав № @num</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <div class="col-12">
                        <label class="form-label">@(_selectedType.Code == "OTHER" ? "Описание требования *" : "Комментарий (необязательно)")</label>
                        <textarea class="form-control" @bind="_demandText" rows="4"
                                  placeholder="@(_selectedType.Code == "OTHER" ? "Опишите ваше требование или запрос..." : "Дополнительная информация...")"></textarea>
                    </div>
                }

                @* ── Типы документов и способ предоставления (REQUEST_INFORMATION) ── *@
                @if (_selectedType.Code == "REQUEST_INFORMATION")
                {
                    <div class="col-12">
                        <label class="form-label">Какие документы вы запрашиваете? *</label>
                        @if (_documentGroups.Count > 0)
                        {
                            @foreach (var group in _documentGroups)
                            {
                                <div class="mb-3">
                                    <h6 class="text-muted mb-2">@group.Name</h6>
                                    @foreach (var dt in group.Documents)
                                    {
                                        <div class="form-check ms-3">
                                            <input class="form-check-input" type="checkbox"
                                                   checked="@_selectedDocumentTypeCodes.Contains(dt.Code)"
                                                   @onchange="e => ToggleDocumentType(dt.Code, e.Value)" />
                                            <label class="form-check-label">
                                                @dt.Name
                                                <small class="text-muted">(хранение @dt.StorageYears лет)</small>
                                            </label>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted">Загрузка справочника...</div>
                        }
                    </div>
                    <div class="col-12">
                        <label class="form-label">Способ предоставления *</label>
                        @if (_accessMethods.Count > 0)
                        {
                            @foreach (var am in _accessMethods.Where(m => m.Code != "ELECTRONIC_COPY" || HasElectronicAvailable()))
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="accessMethod"
                                           value="@am.Code"
                                           checked="@(_selectedAccessMethodCode == am.Code)"
                                           @onchange="() => _selectedAccessMethodCode = am.Code" />
                                    <label class="form-check-label">
                                        @am.Name
                                        @if (am.DeadlineDays.HasValue)
                                        {
                                            <small class="text-muted">(в течение @am.DeadlineDays раб. дней)</small>
                                        }
                                    </label>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted">Загрузка справочника...</div>
                        }
                    </div>
                }
            </div>

            @* ── Файлы (общий блок для всех типов) ────────────────────── *@
            @if (!_useMultiItems)
            {
                <div class="col-12 mt-3">
                    <label class="form-label">Прикрепить файлы (необязательно)</label>
                    <FileUpload FileType="SHARE_REQUEST" OnFileUploadedInfo="OnFileUploaded" />
                    @if (_uploadedFiles.Count > 0)
                    {
                        <div class="mt-2">
                            @foreach (var f in _uploadedFiles)
                            {
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-light text-dark">📄 @f.Name</span>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveUploadedFile(f)">×</button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @* ── Мульти-пункты: кнопка переключения ──────────────────── *@
            @if (!_useMultiItems && SupportsMultiItems())
            {
                <div class="col-12 mt-3">
                    <button class="btn btn-outline-primary btn-sm" @onclick="SwitchToMultiItems">
                        + Добавить пункт
                    </button>
                    <small class="text-muted ms-2">Разбить требование на отдельные пункты с файлами к каждому</small>
                </div>
            }

            @* ── Мульти-пункты: редактор пунктов ──────────────────────── *@
            @if (_useMultiItems)
            {
                <div class="col-12 mt-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <label class="form-label mb-0"><strong>Пункты требования</strong></label>
                        <div>
                            <button class="btn btn-outline-primary btn-sm" @onclick="AddItem">+ Добавить пункт</button>
                            @if (_formItems.Count == 1)
                            {
                                <button class="btn btn-outline-secondary btn-sm ms-2" @onclick="SwitchToSingleItem">
                                    Вернуть к одному пункту
                                </button>
                            }
                        </div>
                    </div>

                    @for (var i = 0; i < _formItems.Count; i++)
                    {
                        var idx = i;
                        var item = _formItems[idx];
                        <div class="card mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span><strong>Пункт @(idx + 1)</strong></span>
                                @if (_formItems.Count > 1)
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveItem(idx)">Удалить</button>
                                }
                            </div>
                            <div class="card-body">
                                <div class="mb-2">
                                    <label class="form-label">Заголовок *</label>
                                    <input class="form-control" value="@item.Title"
                                           @onchange="e => UpdateItemTitle(idx, e)" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label">Описание *</label>
                                    <textarea class="form-control" rows="3"
                                              @onchange="e => UpdateItemDescription(idx, e)">@item.Description</textarea>
                                </div>
                                <div>
                                    <label class="form-label">Файлы пункта</label>
                                    <FileUpload FileType="SHARE_REQUEST"
                                                OnFileUploadedInfo="info => OnItemFileUploaded(idx, info)" />
                                    @if (item.Files.Count > 0)
                                    {
                                        <div class="mt-2">
                                            @foreach (var f in item.Files)
                                            {
                                                <div class="d-flex align-items-center gap-2 mb-1">
                                                    <span class="badge bg-light text-dark">📄 @f.Name</span>
                                                    <button class="btn btn-sm btn-outline-danger"
                                                            @onclick="() => RemoveItemFile(idx, f)">×</button>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            @* ── Предупреждение перед отправкой ──────────────────────── *@
            <div class="col-12 mt-4">
                <div class="alert alert-warning py-3">
                    <strong>Важно:</strong> Убедитесь, что текст каждого пункта сформулирован ясно и однозначно.
                    Если при рассмотрении пункта не будут обнаружены формальные основания для отказа, ОСУ может
                    голосовать против такой формулировки требования, поскольку не сможет однозначно интерпретировать суть.
                    Рекомендуется: конкретизировать действия, сроки и ожидаемый результат.
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="agreeWarning"
                           checked="@_agreedToWarning"
                           @onchange="e => _agreedToWarning = e.Value is true" />
                    <label class="form-check-label" for="agreeWarning">
                        Я ознакомлен с рекомендациями по формулировке требований
                    </label>
                </div>
            </div>

            @* ── Кнопка отправки ─────────────────────────────────────── *@
            <div class="mt-3">
                <button class="btn btn-primary" @onclick="SubmitRequest"
                        disabled="@(!_selectedType.IsAvailable || _isSubmitting || !_agreedToWarning)">
                    @if (_isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    @(IsEditMode ? "Сохранить и отправить" : "Подать требование")
                </button>
                <button class="btn btn-outline-secondary ms-2" @onclick="SaveAsDraft" disabled="@(!_selectedType.IsAvailable || _isSubmitting)">
                    @(IsEditMode ? "Сохранить черновик" : "Создать черновик")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private bool IsEditMode => Id.HasValue;
    private List<RequestTypeDto> _availableTypes = new();
    private RequestTypeDto? _selectedType;
    private bool _loading = true;
    private bool _isSubmitting;
    private string? _error;
    private Guid? _previousRequestId;
    private Guid? _userId;

    // Поля формы
    private string? _demandText;
    private string? _demandReason;
    private string? _newCharterNumber;
    private decimal? _participantSharePercent;
    private List<UploadedFileInfo> _uploadedFiles = new();

    // Мульти-пункты
    private bool _useMultiItems;
    private bool _agreedToWarning;
    private List<FormItem> _formItems = new();

    // Справочники для REQUEST_INFORMATION
    private List<DocumentGroupDto> _documentGroups = new();
    private List<AccessMethodDto> _accessMethods = new();
    private HashSet<string> _selectedDocumentTypeCodes = new();
    private string? _selectedAccessMethodCode;

    private record UploadedFileInfo(Guid FileId, string Name);
    private record FormItem(string Title, string? Description, List<UploadedFileInfo> Files);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            _userId = SamorodinkaTech.Fiducia.Infrastructure.Common.UserContextHelper.GetUserIdAsync(HttpContextAccessor.HttpContext!);
            var leId = _userId.HasValue ? await LegalEntityHelper.GetLegalEntityIdAsync(ctx, HttpContextAccessor) : null;

            // Загружаем данные для вычисления доступности типов
            Domain.Entities.LegalEntityCharter? charter = null;
            Domain.Entities.LegalEntityExtraSettings? extraSettings = null;
            Domain.Entities.LegalEntity? le = null;
            if (leId.HasValue)
            {
                charter = await ctx.LegalEntityCharters.FindAsync(leId.Value);
                extraSettings = await ctx.LegalEntityExtraSettings.FirstOrDefaultAsync(x => x.LegalEntityId == leId.Value);
                le = await ctx.LegalEntities.Include(x => x.RefOkopf).FirstOrDefaultAsync(x => x.Id == leId.Value);
            }

            var types = await ShareRequestRead.GetTypesAsync();
            var okopfCode = le?.RefOkopf?.Code;
            var isLlc = Domain.Validation.OkopfTypeMapper.IsLlc(okopfCode);
            var isNjsc = Domain.Validation.OkopfTypeMapper.IsNjsc(okopfCode);
            var isPjsc = Domain.Validation.OkopfTypeMapper.IsPjsc(okopfCode);
            _availableTypes = types
                .Where(rt => (isLlc && rt.IsForLlc) || (isNjsc && rt.IsForNjsc) || (isPjsc && rt.IsForPjsc))
                .Select(rt => MapToRequestTypeDto(rt, charter, extraSettings, le, isLlc, isNjsc, isPjsc))
                .ToList();

            // Загружаем долю участника для подсказок
            try
            {
                if (_userId.HasValue && leId.HasValue)
                {
                    var (participant, sharePercent) = await ParticipantRead.GetCurrentAsync(_userId.Value, leId.Value);
                    _participantSharePercent = sharePercent;
                }
            }
            catch { /* не критично */ }

            // Загружаем справочники для REQUEST_INFORMATION
            try
            {
                var refData = await ShareRequestRead.GetRefDataAsync();
                if (refData is not null)
                {
                    _documentGroups = refData.DocumentGroups.Select(MapToDocumentGroupDto).ToList();
                    _accessMethods = refData.AccessMethods.Select(MapToAccessMethodDto).ToList();
                }
            }
            catch { /* не критично */ }

            // Если режим редактирования — загружаем существующее требование
            if (IsEditMode)
            {
                var entity = await ShareRequestRead.GetDetailAsync(Id!.Value);
                if (entity is not null)
                {
                    var request = MapToExistingRequestDto(entity);
                    _selectedType = _availableTypes.FirstOrDefault(t => t.Id == request.RequestTypeId);
                    if (_selectedType is not null)
                    {
                        // Восстанавливаем текст из колонки text
                        _demandText = entity.Text;

                        // Восстанавливаем типоспецифичные данные из payload
                        if (!string.IsNullOrEmpty(request.Payload))
                        {
                            try
                            {
                                var payload = System.Text.Json.JsonSerializer.Deserialize<JsonElement>(request.Payload);
                                if (payload.TryGetProperty("reason", out var reasonProp))
                                    _demandReason = reasonProp.GetString();
                                if (payload.TryGetProperty("newCharterNumber", out var charterProp))
                                    _newCharterNumber = charterProp.GetString();
                                if (payload.TryGetProperty("documentTypeCodes", out var codesProp))
                                {
                                    foreach (var code in codesProp.EnumerateArray())
                                        _selectedDocumentTypeCodes.Add(code.GetString() ?? "");
                                }
                                if (payload.TryGetProperty("accessMethodCode", out var methodProp))
                                    _selectedAccessMethodCode = methodProp.GetString();
                            }
                            catch { /* payload не JSON — игнорируем */ }
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки типов требований");
            _error = "Ошибка загрузки данных";
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectType(RequestTypeDto type)
    {
        _selectedType = type;
        _demandText = null;
        _demandReason = null;
        _newCharterNumber = null;
        _uploadedFiles.Clear();
        _useMultiItems = false;
        _formItems.Clear();
        _agreedToWarning = false;
        _error = null;
    }

    private bool SupportsMultiItems() => _selectedType is not null
        && (_selectedType.ConsideredByOsu || _selectedType.Code == "OTHER")
        && _selectedType.Code != "CHANGE_STANDARD_CHARTER_NUMBER"
        && _selectedType.Code != "REQUEST_INFORMATION";

    private void SwitchToMultiItems()
    {
        if (_formItems.Count > 0) return;
        var title = "Пункт 1";
        var desc = _demandText;
        _formItems.Add(new FormItem(title, desc, new()));
        _demandText = null;
        _useMultiItems = true;
    }

    private void AddItem()
    {
        _formItems.Add(new FormItem($"Пункт {_formItems.Count + 1}", null, new()));
    }

    private void RemoveItem(int index)
    {
        if (index >= 0 && index < _formItems.Count && _formItems.Count > 1)
            _formItems.RemoveAt(index);
    }

    private void OnItemFileUploaded(int itemIndex, (Guid FileId, string OriginalName) info)
    {
        if (itemIndex >= 0 && itemIndex < _formItems.Count)
        {
            var item = _formItems[itemIndex];
            var files = new List<UploadedFileInfo>(item.Files) { new(info.FileId, info.OriginalName) };
            _formItems[itemIndex] = item with { Files = files };
        }
    }

    private void RemoveItemFile(int itemIndex, UploadedFileInfo file)
    {
        if (itemIndex >= 0 && itemIndex < _formItems.Count)
        {
            var item = _formItems[itemIndex];
            var files = new List<UploadedFileInfo>(item.Files);
            files.Remove(file);
            _formItems[itemIndex] = item with { Files = files };
        }
    }

    private void SwitchToSingleItem()
    {
        if (_formItems.Count == 1)
        {
            _demandText = _formItems[0].Description;
            _uploadedFiles = _formItems[0].Files.ToList();
            _formItems.Clear();
            _useMultiItems = false;
        }
    }

