@page "/share-requests/create"
@page "/share-requests/{Id:guid}/edit"
@using System.Net.Http.Json
@using System.Text.Json
@using SamorodinkaTech.Fiducia.SharedComponents.Components
@inject HttpClient Http
@inject NavigationManager Nav
@inject ILogger<ShareRequestCreate> Logger
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "PARTICIPANT")]

<PageTitle>Fiducia — @(IsEditMode ? "Редактирование требования" : "Подать требование или запрос")</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>@(IsEditMode ? "Редактирование требования" : "Подать требование или запрос")</h3>
    <a href="/share-requests" class="btn btn-outline-secondary">← Назад к списку</a>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_loading)
{
    <div class="text-center py-4">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (_selectedType is null)
{
    @* ── Выбор типа требования ─────────────────────────────────────── *@
    <p class="text-muted mb-4">Выберите тип требования или запроса:</p>

    <div class="row g-3">
        @foreach (var rt in _availableTypes)
        {
            <div class="col-md-6">
                <div class="card h-100" style="cursor:pointer" @onclick="() => SelectType(rt)">
                    <div class="card-body">
                        <h5 class="card-title">@rt.Name</h5>
                        <p class="card-text text-muted small mb-0">
                            @GetDescription(rt.Code)
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    @* ── Форма создания требования ──────────────────────────────────── *@
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h5>@_selectedType.Name</h5>
                    <p class="text-muted mb-0">@GetDescription(_selectedType.Code)</p>
                </div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _selectedType = null">
                    ← Другой тип
                </button>
            </div>

            @* ── Подсказка по правовой норме ────────────────────────── *@
            @if (GetLegalBasisInfo(_selectedType.Code) is { } legalInfo)
            {
                <div class="alert alert-info py-2 mb-3">
                    <strong>Правовая норма:</strong>
                    <LawReferenceLink Article="@legalInfo.Article" Text="@legalInfo.Text" />
                </div>
            }

            @* ── Условия и ограничения ──────────────────────────────── *@
            @if (!_selectedType.IsAvailable && !string.IsNullOrEmpty(_selectedType.UnavailabilityReason))
            {
                <div class="alert alert-danger py-2 mb-3">
                    <strong>Недоступно:</strong> @_selectedType.UnavailabilityReason
                </div>
            }
            else if (!string.IsNullOrEmpty(GetConditions(_selectedType.Code)))
            {
                <div class="alert alert-warning py-2 mb-3">
                    <strong>Условия:</strong> @GetConditions(_selectedType.Code)
                </div>
            }

            @* ── Поля формы ──────────────────────────────────────────── *@
            <div class="row g-3">
                @if (_selectedType.Code == "DEMAND_VOSU")
                {
                    <div class="col-12">
                        <label class="form-label">Текст требования *</label>
                        <textarea class="form-control" @bind="_demandText" rows="4"
                                  placeholder="Опишите суть требования о созыве внеочередного собрания..."></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Основание (необязательно)</label>
                        <input class="form-control" @bind="_demandReason"
                               placeholder="Например: необходимость рассмотрения вопроса о..." />
                    </div>
                    <div class="col-12">
                        <div class="alert alert-secondary py-2 mb-0">
                            <text><strong>Порог:</strong>
                            Для созыва ВОСУ необходимо владеть не менее @_selectedType.ThresholdPercent% голосов участников (ст. 35 14-ФЗ).</text>
                            @if (_participantSharePercent.HasValue)
                            {
                                <span class="ms-2"><text>Ваша доля: <strong>@_participantSharePercent%</strong>
                                (@(_participantSharePercent >= _selectedType.ThresholdPercent ? "порог выполнен" : "ниже порога"))</text></span>
                            }
                        </div>
                    </div>
                }
                else if (IsCollectiveType(_selectedType.Code))
                {
                    <div class="col-12">
                        <label class="form-label">Текст требования *</label>
                        <textarea class="form-control" @bind="_demandText" rows="4"
                                  placeholder="Опишите суть требования..."></textarea>
                    </div>
                    <div class="col-12">
                        <div class="alert alert-secondary py-2 mb-0">
                            @if (_selectedType.RequiresThreshold)
                            {
                                <text><strong>Порог:</strong> @_selectedType.ThresholdPercent% голосов (ст. 55 208-ФЗ).
                                Требование будет направлено ГД только после набора порога.</text>
                            }
                            else
                            {
                                <text><strong>Без порога:</strong> Требование будет направлено ГД сразу после создания.</text>
                            }
                        </div>
                    </div>
                }
                else if (_selectedType.Code == "CHANGE_STANDARD_CHARTER_NUMBER")
                {
                    <div class="col-12">
                        <label class="form-label">Номер нового типового устава *</label>
                        <select class="form-select" @bind="_newCharterNumber">
                            <option value="">Выберите номер...</option>
                            @for (int i = 1; i <= 36; i++)
                            {
                                var num = i.ToString("D2");
                                <option value="@num">Типовой устав № @num</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <div class="col-12">
                        <label class="form-label">@(_selectedType.Code == "OTHER" ? "Описание требования *" : "Комментарий (необязательно)")</label>
                        <textarea class="form-control" @bind="_demandText" rows="4"
                                  placeholder="@(_selectedType.Code == "OTHER" ? "Опишите ваше требование или запрос..." : "Дополнительная информация...")"></textarea>
                    </div>
                }
            </div>

            @* ── Файлы (общий блок для всех типов) ────────────────────── *@
            <div class="col-12 mt-3">
                <label class="form-label">Прикрепить файлы (необязательно)</label>
                <FileUpload FileType="SHARE_REQUEST" OnFileUploadedInfo="OnFileUploaded" />
                @if (_uploadedFiles.Count > 0)
                {
                    <div class="mt-2">
                        @foreach (var f in _uploadedFiles)
                        {
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge bg-light text-dark">📄 @f.Name</span>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveUploadedFile(f)">×</button>
                            </div>
                        }
                    </div>
                }
            </div>

            @* ── Кнопка отправки ─────────────────────────────────────── *@
            <div class="mt-4">
                <button class="btn btn-primary" @onclick="SubmitRequest" disabled="@(!_selectedType.IsAvailable || _isSubmitting)">
                    @if (_isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    @(IsEditMode ? "Сохранить и отправить" : "Подать требование")
                </button>
                <button class="btn btn-outline-secondary ms-2" @onclick="SaveAsDraft" disabled="@(!_selectedType.IsAvailable || _isSubmitting)">
                    @(IsEditMode ? "Сохранить черновик" : "Создать черновик")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private bool IsEditMode => Id.HasValue;
    private List<RequestTypeDto> _availableTypes = new();
    private RequestTypeDto? _selectedType;
    private bool _loading = true;
    private bool _isSubmitting;
    private string? _error;

    // Поля формы
    private string? _demandText;
    private string? _demandReason;
    private string? _newCharterNumber;
    private decimal? _participantSharePercent;
    private List<UploadedFileInfo> _uploadedFiles = new();

    private record UploadedFileInfo(Guid FileId, string Name);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _availableTypes = await Http.GetFromJsonAsync<List<RequestTypeDto>>("/api/share-requests/types") ?? new();

            // Загружаем долю участника для подсказок
            try
            {
                var participant = await Http.GetFromJsonAsync<ParticipantDto>("/api/participants/current");
                _participantSharePercent = participant?.SharePercent;
            }
            catch { /* не критично */ }

            // Если режим редактирования — загружаем существующее требование
            if (IsEditMode)
            {
                var request = await Http.GetFromJsonAsync<ExistingRequestDto>($"/api/share-requests/{Id}");
                if (request is not null)
                {
                    _selectedType = _availableTypes.FirstOrDefault(t => t.Id == request.RequestTypeId);
                    if (_selectedType is not null)
                    {
                        // Восстанавливаем данные из payload
                        if (!string.IsNullOrEmpty(request.Payload))
                        {
                            try
                            {
                                var payload = System.Text.Json.JsonSerializer.Deserialize<JsonElement>(request.Payload);
                                if (payload.TryGetProperty("text", out var textProp))
                                    _demandText = textProp.GetString();
                                if (payload.TryGetProperty("reason", out var reasonProp))
                                    _demandReason = reasonProp.GetString();
                                if (payload.TryGetProperty("newCharterNumber", out var charterProp))
                                    _newCharterNumber = charterProp.GetString();
                            }
                            catch { /* payload не JSON — игнорируем */ }
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки типов требований");
            _error = "Ошибка загрузки данных";
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectType(RequestTypeDto type)
    {
        _selectedType = type;
        _demandText = null;
        _demandReason = null;
        _newCharterNumber = null;
        _uploadedFiles.Clear();
        _error = null;
    }

    private void OnFileUploaded((Guid FileId, string OriginalName) info)
    {
        _uploadedFiles.Add(new UploadedFileInfo(info.FileId, info.OriginalName));
        StateHasChanged();
    }

    private void RemoveUploadedFile(UploadedFileInfo file)
    {
        _uploadedFiles.Remove(file);
    }

    private async Task SubmitRequest()
    {
        if (_selectedType is null) return;

        // Валидация
        if (IsCollectiveType(_selectedType.Code) && string.IsNullOrWhiteSpace(_demandText))
        {
            _error = "Введите текст требования";
            return;
        }
        if (_selectedType.Code == "CHANGE_STANDARD_CHARTER_NUMBER" && string.IsNullOrWhiteSpace(_newCharterNumber))
        {
            _error = "Выберите номер типового устава";
            return;
        }
        if (_selectedType.Code == "OTHER" && string.IsNullOrWhiteSpace(_demandText))
        {
            _error = "Введите описание требования";
            return;
        }

        _isSubmitting = true;
        _error = null;

        try
        {
            string? payload = BuildPayload();

            HttpResponseMessage response;
            if (IsEditMode)
            {
                // Обновляем существующее требование
                response = await Http.PutAsJsonAsync($"/api/share-requests/{Id}", new { Payload = payload });
            }
            else
            {
                // Создаём новое
                if (_selectedType.IsCollective)
                {
                    var collectiveDto = new
                    {
                        RequestTypeId = _selectedType.Id,
                        Payload = payload,
                        DemandText = _demandText
                    };
                    response = await Http.PostAsJsonAsync("/api/share-requests/collective", collectiveDto);
                }
                else
                {
                    var dto = new
                    {
                        RequestTypeId = _selectedType.Id,
                        Payload = payload
                    };
                    response = await Http.PostAsJsonAsync("/api/share-requests", dto);
                }
            }

            if (response.IsSuccessStatusCode)
            {
                // Получаем ID созданного/обновлённого требования
                var result = await response.Content.ReadFromJsonAsync<CreatedRequestDto>();
                var requestId = result?.Id ?? Id;

                // Прикрепляем файлы
                if (_uploadedFiles.Count > 0 && requestId.HasValue)
                {
                    foreach (var file in _uploadedFiles)
                    {
                        await Http.PostAsJsonAsync($"/api/share-requests/{requestId}/files", new { FileId = file.FileId });
                    }
                }

                // Отправляем требование (если не было редактирования draft)
                if (!IsEditMode && requestId.HasValue)
                {
                    await Http.PostAsJsonAsync($"/api/share-requests/{requestId}/submit", new { });
                }

                Nav.NavigateTo("/share-requests", forceLoad: true);
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                _error = $"Ошибка: {body}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка сохранения запроса");
            _error = $"Ошибка сохранения запроса: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task SaveAsDraft()
    {
        if (_selectedType is null) return;

        _isSubmitting = true;
        _error = null;

        try
        {
            string? payload = BuildPayload();

            HttpResponseMessage response;
            if (IsEditMode)
            {
                response = await Http.PutAsJsonAsync($"/api/share-requests/{Id}", new { Payload = payload });
            }
            else
            {
                if (_selectedType.IsCollective)
                {
                    var collectiveDto = new
                    {
                        RequestTypeId = _selectedType.Id,
                        Payload = payload,
                        DemandText = _demandText
                    };
                    response = await Http.PostAsJsonAsync("/api/share-requests/collective", collectiveDto);
                }
                else
                {
                    var dto = new
                    {
                        RequestTypeId = _selectedType.Id,
                        Payload = payload
                    };
                    response = await Http.PostAsJsonAsync("/api/share-requests", dto);
                }
            }

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<CreatedRequestDto>();
                var requestId = result?.Id ?? Id;

                if (_uploadedFiles.Count > 0 && requestId.HasValue)
                {
                    foreach (var file in _uploadedFiles)
                    {
                        await Http.PostAsJsonAsync($"/api/share-requests/{requestId}/files", new { FileId = file.FileId });
                    }
                }

                Nav.NavigateTo("/share-requests", forceLoad: true);
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                _error = $"Ошибка: {body}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка сохранения черновика");
            _error = $"Ошибка сохранения черновика: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private string? BuildPayload()
    {
        if (_selectedType is null) return null;

        if (_selectedType.Code == "DEMAND_VOSU")
        {
            return System.Text.Json.JsonSerializer.Serialize(new { text = _demandText, reason = _demandReason });
        }
        if (_selectedType.Code == "CHANGE_STANDARD_CHARTER_NUMBER")
        {
            return System.Text.Json.JsonSerializer.Serialize(new { newCharterNumber = _newCharterNumber });
        }
        if (!string.IsNullOrWhiteSpace(_demandText))
        {
            return System.Text.Json.JsonSerializer.Serialize(new { text = _demandText });
        }
        return null;
    }

    private static string GetDescription(string code) => code switch
    {
        "PREEMPTIVE_LIST" => "Вы имеете право запросить актуальный список участников для реализации преимущественного права покупки доли",
        "NOTARIAL_OFFER" => "Направление нотариально удостоверенного предложения о покупке доли",
        "EXIT_APPLICATION" => "Выход из общества путём подачи заявления. Доля переходит к обществу",
        "MANDATORY_BUYBACK" => "Требование о выкупе доли обществом при определённых обстоятельствах",
        "NOTARY_LIST_MAINTENANCE" => "Утверждение ведения реестра участников через нотариальную контору",
        "CONVERT_TO_NJSC" => "Требование о реорганизации общества путём преобразования в непубличное акционерное общество",
        "CHANGE_STANDARD_CHARTER_NUMBER" => "Переход на другой вариант типового устава",
        "CONVERT_STANDARD_TO_CUSTOM_CHARTER" => "Принятие индивидуального устава вместо типового",
        "CHANGE_CUSTOM_CHARTER_PROVISION" => "Внесение изменений в действующий нетиповой устав",
        "CHANGE_CHARTER_PROVISION" => "Внесение изменений в положение устава (НАО/ПАО)",
        "DEMAND_VOSU" => "Право участников с долей ≥10% потребовать внеочередного собрания (ст. 35 14-ФЗ)",
        "ADD_AGENDA_OSU" => "Внесение дополнительного вопроса в повестку очередного собрания. Любой участник (п. 2.1 ст. 36 14-ФЗ)",
        "REQUEST_INFORMATION" => "Право участника на доступ к документам общества (ст. 50 14-ФЗ)",
        "EXCLUDE_PARTICIPANT" => "Требование об исключении участника, совершившего вред обществу (ст. 10 14-ФЗ)",
        "DEMAND_VOSA" => "Право акционеров с долей ≥10% потребовать внеочередного собрания (ст. 55 208-ФЗ)",
        "ADD_AGENDA_GOSA" => "Внесение вопроса в повестку годового собрания (ст. 53 208-ФЗ)",
        "DEMAND_INFO_AO" => "Право акционеров на доступ к документам общества (ст. 89 208-ФЗ)",
        "OTHER" => "Прочие требования и запросы, не входящие в стандартные категории",
        _ => "Выберите для получения подробной информации"
    };

    private static (string Article, string Text)? GetLegalBasisInfo(string code) => code switch
    {
        "DEMAND_VOSU" => ("article-14fz-35", "ст. 35 14-ФЗ «Об ООО»"),
        "ADD_AGENDA_OSU" => ("article-14fz-36", "п. 2.1 ст. 36 14-ФЗ"),
        "REQUEST_INFORMATION" => ("article-14fz-50", "ст. 50 14-ФЗ"),
        "EXCLUDE_PARTICIPANT" => ("article-14fz-10", "ст. 10 14-ФЗ"),
        "DEMAND_VOSA" => ("article-208fz-55", "ст. 55 208-ФЗ"),
        "ADD_AGENDA_GOSA" => ("article-208fz-53", "ст. 53 208-ФЗ"),
        "DEMAND_INFO_AO" => ("article-208fz-89", "ст. 89 208-ФЗ"),
        "NOTARY_LIST_MAINTENANCE" => ("article-14fz-31-1", "ст. 32.1 14-ФЗ"),
        "EXIT_APPLICATION" => ("article-14fz-26", "ст. 26 14-ФЗ"),
        "CONVERT_TO_NJSC" => ("article-14fz-57", "ст. 57 14-ФЗ"),
        _ => null
    };

    private static string GetLegalBasis(string code) => GetLegalBasisInfo(code)?.Text ?? "";

    private static string GetConditions(string code) => code switch
    {
        "DEMAND_VOSU" => "Требуется владеть не менее 10% голосов (или иной порог, установленный уставом)",
        "ADD_AGENDA_OSU" => "Порог не требуется — право каждого участника (п. 2.1 ст. 36 14-ФЗ)",
        "EXIT_APPLICATION" => "Выход возможен только если он предусмотрен уставом",
        "CHANGE_STANDARD_CHARTER_NUMBER" => "Текущий устав должен быть типовым",
        "CONVERT_STANDARD_TO_CUSTOM_CHARTER" => "Текущий устав должен быть типовым",
        "CHANGE_CUSTOM_CHARTER_PROVISION" => "Текущий устав должен быть нетиповым",
        "CHANGE_CHARTER_PROVISION" => "Только для НАО/ПАО",
        "CONVERT_TO_NJSC" => "Доступно только для ООО",
        "CONVERT_TO_PJSC" => "Доступно только для НАО",
        "NOTARY_LIST_MAINTENANCE" => "Ведение списка через нотариат ещё не утверждено",
        _ => ""
    };

    private static bool IsCollectiveType(string code) => code switch
    {
        "DEMAND_VOSU" => true,       // 10% порог
        "ADD_AGENDA_OSU" => true,    // 2% порог
        "EXCLUDE_PARTICIPANT" => true, // 2/3 порог
        "DEMAND_VOSA" => true,       // 10% порог
        "ADD_AGENDA_GOSA" => true,   // 2% порог
        "DEMAND_INFO_AO" => true,    // 25% порог
        _ => false
    };

    private record RequestTypeDto(Guid Id, string Code, string Name, bool RequiresFile, bool RequiresThreshold, decimal? ThresholdPercent, string? LegalBasis, bool IsCollective, bool IsAvailable, string? UnavailabilityReason);
    private record ParticipantDto(Guid Id, string? FullName, decimal? SharePercent);
    private record CreatedRequestDto(Guid? Id);
    private record ExistingRequestDto(Guid Id, Guid RequestTypeId, string? Payload, string Status);
}
