        => new(g.Code, g.Name, g.Documents.Select(d => new DocumentTypeDto(d.Id, d.Code, d.Name, d.GroupCode, d.GroupName, d.IsElectronicAvailable, d.StorageYears)).ToList());

    private static AccessMethodDto MapToAccessMethodDto(Domain.Interfaces.DocumentAccessMethod m)
        => new(m.Id, m.Code, m.Name, m.Description, m.DeadlineDays);

    private static string ExtractErrorMessage(string message)
        => System.Text.RegularExpressions.Regex.Replace(message, @"\s*\[[0-9a-f-]+\]\s*$", "").Trim();

    private static Guid? ExtractRequestId(string message)
    {
        var match = System.Text.RegularExpressions.Regex.Match(message, @"\[([0-9a-f-]+)\]");
        return match.Success && Guid.TryParse(match.Groups[1].Value, out var id) ? id : null;
    }
