@page "/info-agency"
@using Microsoft.EntityFrameworkCore
@using SamorodinkaTech.Fiducia.Domain.Entities
@using SamorodinkaTech.Fiducia.Domain.Enums
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@inject HttpClient Http
@inject ILogger<InfoAgency> Logger
@inject IJSRuntime JS
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Fiducia — Информационное агентство</PageTitle>

<div class="container-fluid">
    <h3 class="mb-4">Информационное агентство</h3>

    @if (_showAddForm)
    {
        <!-- Форма добавления/редактирования договора -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@(_editId.HasValue ? "Редактировать договор" : "Новый договор с информационным агентством")</h5>
                <button type="button" class="btn-close" @onclick="CloseForm"></button>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger">@_errorMessage</div>
                }

                <!-- Выбранная компания -->
                @if (_selectedCompany is not null)
                {
                    <div class="card bg-light mb-3">
                        <div class="card-body py-2">
                            <strong>@_selectedCompany.ShortName</strong> (@_selectedCompany.Inn)
                            <span class="badge bg-secondary ms-2">@_selectedCompany.OkopfCode</span>
                            @if (_selectedCompany.Status == "Действующее")
                            {
                                <span class="badge bg-success ms-1">Действующее</span>
                            }
                        </div>
                    </div>
                }

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Номер договора</label>
                        <input type="text" class="form-control" @bind="_formContractNumber">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Дата договора</label>
                        <input type="date" class="form-control" @bind="_formContractDate">
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Начало действия</label>
                        <input type="date" class="form-control" @bind="_formValidFrom">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Окончание действия</label>
                        <input type="date" class="form-control" @bind="_formValidTo">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Файл договора</label>
                    @if (_formDocumentId.HasValue)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <a href="/api/files/@_formDocumentId/download" target="_blank" class="btn btn-sm btn-outline-secondary">
                                📄 Текущий файл
                            </a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => _formDocumentId = null">Удалить</button>
                        </div>
                    }
                    <InputFile class="form-control" OnChange="OnFileSelected" />
                </div>
            </div>
            <div class="card-footer">
                <button type="button" class="btn btn-secondary me-2" @onclick="CloseForm">Отмена</button>
                <button type="button" class="btn btn-primary" @onclick="Save" disabled="@(_saving || _selectedCompany is null)">
                    @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    @( _editId.HasValue ? "Сохранить" : "Добавить договор")
                </button>
            </div>
        </div>
    }
    else
    {
        <!-- Поле поиска (как на ЮЛ) -->
        @if (_isLawyer)
        {
            <div class="mb-4">
                <label class="form-label">Поиск информационного агентства по ИНН / наименованию</label>
                <input class="form-control" value="@_searchQuery" @oninput="OnSearchInput"
                       placeholder="Введите ИНН или наименование агентства" />
                @if (_searchResults?.Any() == true)
                {
                    <div class="dropdown-menu show w-100 mt-1" style="display:block; position:relative;">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Наименование</th>
                                    <th>ИНН</th>
                                    <th>ОКОПФ</th>
                                    <th>Статус</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var c in _searchResults)
                            {
                                <tr class="table-row-hover" style="cursor:pointer" @onclick="() => SelectCompany(c)">
                                    <td>@c.ShortName</td>
                                    <td>@c.Inn</td>
                                    <td>@c.OkopfCode</td>
                                    <td>@c.Status</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                        <div class="px-2 py-1 text-muted small">Показано до 10 записей</div>
                    </div>
                }
            </div>
        }
    }

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
        </div>
    }
    else if (_contractors.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <h5 class="text-muted">Информационное агентство не назначено</h5>
                <p class="text-muted">Заключите договор с информационным агентством для раскрытия информации</p>
            </div>
        </div>
    }
    else
    {
        @foreach (var c in _contractors)
        {
            <div class="card mb-3 @(c.IsActive ? "" : "border-secondary opacity-75")">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <strong>@c.ContractorName</strong>
                        <span class="badge bg-secondary ms-2">ИНН @c.ContractorInn</span>
                        @if (!c.IsActive)
                        {
                            <span class="badge bg-warning ms-2">Не действует</span>
                        }
                    </div>
                    <div>
                        @if (c.CbrStatus == "Active")
                        {
                            <span class="badge bg-success">Действующая</span>
                        }
                        else if (!string.IsNullOrEmpty(c.CbrStatus))
                        {
                            <span class="badge bg-danger">@c.CbrStatus</span>
                        }
                        @if (_isLawyer)
                        {
                            <button class="btn btn-sm btn-outline-primary ms-2" @onclick="() => ShowEditForm(c)">Редактировать</button>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Договор</h6>
                            <table class="table table-sm table-borderless mb-3">
                                <tr><td class="text-muted" style="width:200px">Номер:</td><td>@(c.ContractNumber ?? "—")</td></tr>
                                <tr><td class="text-muted">Дата:</td><td>@(c.ContractDate ?? "—")</td></tr>
                                <tr><td class="text-muted">Срок действия:</td><td>@(c.ContractValidFrom ?? "—") — @(c.ContractValidTo ?? "—")</td></tr>
                                @if (c.ContractDocumentId.HasValue)
                                {
                                    <tr>
                                        <td class="text-muted">Файл:</td>
                                        <td>
                                            <a href="/api/files/@c.ContractDocumentId/download" target="_blank" class="btn btn-sm btn-outline-secondary">
                                                📄 @(c.ContractDocumentName ?? "Скачать")
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </table>
                        </div>
                    </div>

                    @if (c.Licenses.Any())
                    {
                        <h6>Лицензии ЦБ РФ</h6>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Номер</th>
                                    <th>Наименование</th>
                                    <th>Дата начала</th>
                                    <th>Дата окончания</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var lic in c.Licenses)
                                {
                                    <tr>
                                        <td>@lic.Number</td>
                                        <td>@lic.ActivityName</td>
                                        <td>@lic.StartDate</td>
                                        <td>
                                            @lic.EndDate
                                            @if (DateTime.TryParse(lic.EndDate, out var endDate) && endDate < DateTime.UtcNow)
                                            {
                                                <span class="badge bg-danger ms-1">Истекла</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    @if (c.CbrFetchedAt.HasValue)
                    {
                        <div class="text-muted small">Данные ЦБ обновлены: @c.CbrFetchedAt.Value.ToString("dd.MM.yyyy HH:mm")</div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private bool _loading = true;
    private bool _isLawyer;
    private List<ContractorView> _contractors = new();

    // Поиск (как на ЮЛ)
    private string _searchQuery = "";
    private List<SparkCompanyView>? _searchResults;
    private const int SearchLimit = 10;

    // Форма
    private bool _showAddForm;
    private bool _saving;
    private string? _errorMessage;
    private Guid? _editId;
    private SparkCompanyView? _selectedCompany;
    private string? _formContractNumber;
    private DateOnly? _formContractDate;
    private DateOnly? _formValidFrom;
    private DateOnly? _formValidTo;
    private Guid? _formDocumentId;
    private IBrowserFile? _formFile;

    protected override async Task OnInitializedAsync()
    {
        var role = await JS.InvokeAsync<string>("localStorage.getItem", "currentUserRole");
        _isLawyer = role?.Contains("LAWYER", StringComparison.OrdinalIgnoreCase) == true;
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var response = await Http.GetAsync("/api/ao-contractors?contractorType=INFO_AGENCY");
            if (response.IsSuccessStatusCode)
            {
                _contractors = await response.Content.ReadFromJsonAsync<List<ContractorView>>() ?? new();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка загрузки информационных агентств");
        }
        finally
        {
            _loading = false;
        }
    }

    // ── Поиск по СПАРК (как на ЮЛ) ──

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(_searchQuery) || _searchQuery.Trim().Length < 2)
        {
            _searchResults = null;
            return;
        }

        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var q = _searchQuery.Trim();
            _searchResults = await ctx.ExtSparkCompanies
                .Where(c =>
                    (c.FullName != null && EF.Functions.ILike(c.FullName, $"%{q}%")) ||
                    (c.ShortName != null && EF.Functions.ILike(c.ShortName, $"%{q}%")) ||
                    (c.Inn != null && EF.Functions.ILike(c.Inn, $"%{q}%")) ||
                    (c.Ogrn != null && EF.Functions.ILike(c.Ogrn, $"%{q}%")))
                .OrderBy(c => c.FullName)
                .Take(SearchLimit)
                .Select(c => new SparkCompanyView
                {
                    Inn = c.Inn,
                    FullName = c.FullName,
                    ShortName = c.ShortName,
                    OkopfCode = c.OkopfCode,
                    OkopfName = c.OkopfName,
                    Status = c.Status
                })
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка поиска в СПАРК");
            _searchResults = null;
        }
    }

    private void SelectCompany(SparkCompanyView company)
    {
        _selectedCompany = company;
        _searchResults = null;
        _searchQuery = "";
        _showAddForm = true;
        _editId = null;
        _formContractNumber = null;
        _formContractDate = null;
        _formValidFrom = null;
        _formValidTo = null;
        _formDocumentId = null;
        _formFile = null;
        _errorMessage = null;
    }

    private void ShowEditForm(ContractorView c)
    {
        _selectedCompany = new SparkCompanyView
        {
            Inn = c.ContractorInn,
            ShortName = c.ContractorName,
            FullName = c.ContractorName
        };
        _editId = c.Id;
        _formContractNumber = c.ContractNumber;
        _formContractDate = DateOnly.TryParse(c.ContractDate, out var cd) ? cd : null;
        _formValidFrom = DateOnly.TryParse(c.ContractValidFrom, out var vf) ? vf : null;
        _formValidTo = DateOnly.TryParse(c.ContractValidTo, out var vt) ? vt : null;
        _formDocumentId = c.ContractDocumentId;
        _formFile = null;
        _errorMessage = null;
        _showAddForm = true;
    }

    private void CloseForm()
    {
        _showAddForm = false;
        _selectedCompany = null;
        _editId = null;
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _formFile = e.File;
    }

    private async Task Save()
    {
        if (_selectedCompany is null)
        {
            _errorMessage = "Выберите информационное агентство из списка";
            return;
        }

        _saving = true;
        _errorMessage = null;

        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(_selectedCompany.Inn), "contractorInn");
            content.Add(new StringContent(_selectedCompany.ShortName ?? _selectedCompany.FullName ?? ""), "contractorName");
            content.Add(new StringContent("INFO_AGENCY"), "contractorType");
            if (_formContractNumber is not null) content.Add(new StringContent(_formContractNumber), "contractNumber");
            if (_formContractDate.HasValue) content.Add(new StringContent(_formContractDate.Value.ToString("yyyy-MM-dd")), "contractDate");
            if (_formValidFrom.HasValue) content.Add(new StringContent(_formValidFrom.Value.ToString("yyyy-MM-dd")), "contractValidFrom");
            if (_formValidTo.HasValue) content.Add(new StringContent(_formValidTo.Value.ToString("yyyy-MM-dd")), "contractValidTo");

            if (_formFile is not null)
            {
                var stream = _formFile.OpenReadStream(maxAllowedSize: 50_000_000);
                content.Add(new StreamContent(stream), "file", _formFile.Name);
            }

            HttpResponseMessage response;
            if (_editId.HasValue)
            {
                response = await Http.PutAsync($"/api/ao-contractors/{_editId}", content);
            }
            else
            {
                response = await Http.PostAsync("/api/ao-contractors", content);
            }

            if (response.IsSuccessStatusCode)
            {
                _showAddForm = false;
                _selectedCompany = null;
                await LoadData();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _errorMessage = $"Ошибка: {error}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ошибка: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    // ── View models ──

    private class SparkCompanyView
    {
        public string Inn { get; set; } = "";
        public string? FullName { get; set; }
        public string? ShortName { get; set; }
        public string? OkopfCode { get; set; }
        public string? OkopfName { get; set; }
        public string? Status { get; set; }
    }

    private class ContractorView
    {
        public Guid Id { get; set; }
        public string ContractorInn { get; set; } = "";
        public string ContractorName { get; set; } = "";
        public string? ContractNumber { get; set; }
        public string? ContractDate { get; set; }
        public string? ContractValidFrom { get; set; }
        public string? ContractValidTo { get; set; }
        public Guid? ContractDocumentId { get; set; }
        public string? ContractDocumentName { get; set; }
        public bool IsActive { get; set; }
        public string? CbrStatus { get; set; }
        public DateTime? CbrFetchedAt { get; set; }
        public List<LicenseView> Licenses { get; set; } = new();
    }

    private class LicenseView
    {
        public int VidId { get; set; }
        public string? ActivityName { get; set; }
        public string? Number { get; set; }
        public string? Name { get; set; }
        public string? StartDate { get; set; }
        public string? EndDate { get; set; }
    }
}
