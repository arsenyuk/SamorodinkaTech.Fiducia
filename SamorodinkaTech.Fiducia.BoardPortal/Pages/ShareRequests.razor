@page "/share-requests"
@using SamorodinkaTech.Fiducia.Domain.Interfaces
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<ShareRequests> Logger
@inject IShareRequestReadService ShareRequestRead
@inject IShareRequestWriteService ShareRequestWrite
@inject IHttpContextAccessor HttpContextAccessor
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "PARTICIPANT,CEO")]

<PageTitle>Fiducia — Мои запросы</PageTitle>

<h3>Мои запросы в общество</h3>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_loading)
{
    <div class="text-center py-4">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else
{
    @* ── Кнопка создания ──────────────────────────────────────────── *@
    <a href="/share-requests/create" class="btn btn-primary mb-3">
        <span class="oi oi-plus"></span> Подать требование или запрос
    </a>

    @* ── Фильтр ────────────────────────────────────────────────────── *@
    <div class="mb-3">
        <select class="form-select form-select-sm" @bind="_filterTypeId" style="width: auto;">
            <option value="">Все типы</option>
            @foreach (var rt in _allTypes)
            {
                <option value="@rt.Id">@rt.Name</option>
            }
        </select>
    </div>

    @if (_filteredRequests.Count == 0)
    {
        <div class="alert alert-info">Нет запросов</div>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Тип</th>
                    <th>Статус</th>
                    <th>Дата</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _filteredRequests)
                {
                    <tr>
                        <td>
                            @r.RequestTypeName
                            @if (r.ItemCount > 0)
                            {
                                <br /><small class="text-muted">@r.ItemCount @GetItemWord(r.ItemCount)</small>
                            }
                        </td>
                        <td>
                            @GetStatusBadge(r.Status)
                            @if (!string.IsNullOrEmpty(r.DecisionStatus))
                            {
                                <br />@GetDecisionBadge(r.DecisionStatus)
                            }
                        </td>
                        <td>@r.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="d-flex gap-1">
                            <a href="/share-requests/@r.Id" class="btn btn-sm btn-outline-secondary">Подробнее</a>
                            @if (r.Status == "draft")
                            {
                                <a href="/share-requests/@r.Id/edit" class="btn btn-sm btn-outline-primary">Редактировать</a>
                                <button class="btn btn-sm btn-success" @onclick="() => SubmitRequest(r.Id)">Отправить</button>
                            }
                            @if (r.RequestTypeCode == "NOTARIAL_OFFER" && r.Status == "submitted" && !r.RevokedAt.HasValue && (DateTime.UtcNow - r.CreatedAt).TotalHours < 24)
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RequestRevoke(r.Id)">Отозвать</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private List<ShareRequestDto> _requests = new();
    private List<ShareRequestDto> _filteredRequests => string.IsNullOrEmpty(_filterTypeId)
        ? _requests
        : _requests.Where(r => r.RequestTypeId.ToString() == _filterTypeId).ToList();
    private List<RequestTypeDto> _availableTypes = new();
    private List<RequestTypeDto> _allTypes = new();
    private string? _filterTypeId;
    private bool _loading = true;
    private string? _error;
    private Guid? _userId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _userId = SamorodinkaTech.Fiducia.Infrastructure.Common.UserContextHelper.GetUserIdAsync(HttpContextAccessor.HttpContext!);
            if (_userId is null)
            {
                _error = "Не удалось определить пользователя.";
                return;
            }

            var types = await ShareRequestRead.GetTypesAsync();
            _availableTypes = types.Select(MapToRequestTypeDto).ToList();
            _allTypes = _availableTypes.ToList();

            var entities = await ShareRequestRead.GetListAsync(_userId.Value);
            _requests = entities.Select(MapToShareRequestDto).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки запросов");
            _error = "Ошибка загрузки данных";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateRequest(Guid requestTypeId)
    {
        try
        {
            if (_userId is null)
            {
                _error = "Не удалось определить пользователя.";
                return;
            }

            await ShareRequestWrite.CreateAsync(_userId.Value, requestTypeId, null);
            Nav.NavigateTo("/share-requests", forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка создания запроса");
            _error = $"Ошибка создания запроса: {ex.Message}";
        }
    }

    private async Task RequestRevoke(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            "Оферта была заверена нотариусом. Для отзыва также необходимо нотариальное заверение. Отзыв будет проведён с нотариальным заверением. Продолжить?");
        if (!confirmed) return;

        try
        {
            await ShareRequestWrite.RevokeAsync(id, true);
            Nav.NavigateTo("/share-requests", forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка отзыва запроса");
            _error = $"Ошибка отзыва: {ex.Message}";
        }
    }

    private async Task SubmitRequest(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            "Вы уверены, что хотите отправить требование? После отправки редактирование будет недоступно.");
        if (!confirmed) return;

        try
        {
            await ShareRequestWrite.SubmitAsync(id);
            Nav.NavigateTo("/share-requests", forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка отправки запроса");
            _error = $"Ошибка отправки: {ex.Message}";
        }
    }

    private static MarkupString GetStatusBadge(string status) => status switch
    {
        "draft" => new("<span class='badge bg-secondary'>Черновик</span>"),
        "submitted" => new("<span class='badge bg-info'>Подано</span>"),
        "accepted" => new("<span class='badge bg-success'>Принято</span>"),
        "rejected" => new("<span class='badge bg-danger'>Отклонено</span>"),
        "revoked" => new("<span class='badge bg-warning'>Отозвано</span>"),
        "completed" => new("<span class='badge bg-success'>Завершён</span>"),
        "pending" => new("<span class='badge bg-warning'>В обработке</span>"),
        _ => new($"<span class='badge bg-secondary'>{status}</span>")
    };

    private static MarkupString GetDecisionBadge(string? decisionStatus) => decisionStatus switch
    {
        "APPROVED" => new("<span class='badge bg-success'>Решение: Утверждено</span>"),
        "REJECTED" => new("<span class='badge bg-danger'>Решение: Отклонено</span>"),
        "PARTIALLY_APPROVED" => new("<span class='badge bg-warning'>Решение: Частично утверждено</span>"),
        _ => new("")
    };

    private static string GetItemWord(int count) => count switch
    {
        1 => "пункт",
        >= 2 and <= 4 => "пункта",
        _ => "пунктов"
    };

    private static RequestTypeDto MapToRequestTypeDto(Domain.Entities.RefRequestType rt)
        => new(rt.Id, rt.Code, rt.Name, rt.RequiresFile);

    private static ShareRequestDto MapToShareRequestDto(Domain.Entities.ShareRequest r)
        => new(r.Id, r.RequestTypeId, r.RequestType?.Code, r.RequestType?.Name,
            r.Status, r.Payload, r.CreatedAt, r.CompletedAt, r.RevokedAt,
            r.RevokedByNotarized, r.VisibleToAll, r.DecisionStatus,
            r.Items?.Count ?? 0);

    private record ShareRequestDto(Guid Id, Guid RequestTypeId, string? RequestTypeCode, string? RequestTypeName, string Status, string? Payload, DateTime CreatedAt, DateTime? CompletedAt, DateTime? RevokedAt, bool RevokedByNotarized, bool VisibleToAll, string? DecisionStatus, int ItemCount);
    private record RequestTypeDto(Guid Id, string Code, string Name, bool RequiresFile);
}
