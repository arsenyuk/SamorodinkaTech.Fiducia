@page "/ceo-demands"
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject ILogger<CeoDemandReview> Logger
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "CEO")]

<PageTitle>Fiducia — Требования участников</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Требования участников на рассмотрении</h3>
        <a href="/notifications" class="btn btn-outline-secondary btn-sm">К оповещениям</a>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (_loading)
    {
        <div class="text-center py-4">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (_demands.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center text-muted py-5">
                <p class="mb-0">Нет требований на рассмотрении</p>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Тип требования</th>
                            <th>Инициатор</th>
                            <th>Доля</th>
                            <th>Дата поступления</th>
                            <th>Дедлайн</th>
                            <th>Статус</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var demand in _demands)
                        {
                            <tr style="cursor:pointer" @onclick="@(() => Nav.NavigateTo($"/ceo-demands/{demand.Id}"))">
                                <td>@demand.RequestTypeName</td>
                                <td>@(demand.InitiatorName ?? "—")</td>
                                <td>@demand.TotalSupportPercent.ToString("F1")%</td>
                                <td>@(demand.SubmittedToCeoAt?.ToString("dd.MM.yyyy HH:mm") ?? demand.CreatedAt.ToString("dd.MM.yyyy HH:mm"))</td>
                                <td>@GetDeadlineBadge(demand.SubmittedToCeoAt, demand.CollectiveStatus)</td>
                                <td>@GetStatusBadge(demand.CollectiveStatus)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<DemandDto> _demands = new();
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _demands = await Http.GetFromJsonAsync<List<DemandDto>>("/api/share-requests/ceo-review") ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки требований для ГД");
            _error = "Ошибка загрузки данных";
        }
        finally
        {
            _loading = false;
        }
    }

    private static MarkupString GetStatusBadge(string? status) => status switch
    {
        "SUBMITTED_TO_CEO" => new("<span class='badge bg-warning'>Требует решения</span>"),
        "ACCEPTED" => new("<span class='badge bg-success'>Принято</span>"),
        "REJECTED" => new("<span class='badge bg-danger'>Отклонено</span>"),
        "THRESHOLD_REACHED" => new("<span class='badge bg-info'>Порог достигнут</span>"),
        "COLLECTING" => new("<span class='badge bg-secondary'>Сбор поддержек</span>"),
        "BOARD_REVIEW" => new("<span class='badge bg-primary'>На рассмотрении СД</span>"),
        _ => new($"<span class='badge bg-secondary'>{status}</span>")
    };

    private static MarkupString GetDeadlineBadge(DateTime? submittedToCeoAt, string? status)
    {
        if (status != "SUBMITTED_TO_CEO" || submittedToCeoAt is null)
            return new("<span class='badge bg-secondary'>—</span>");

        var daysElapsed = (DateTime.UtcNow - submittedToCeoAt.Value).TotalDays;
        var daysRemaining = 5 - daysElapsed;

        if (daysElapsed < 3)
            return new($"<span class='badge bg-success'>Осталось {Math.Ceiling(daysRemaining)} дн.</span>");
        if (daysElapsed <= 5)
            return new($"<span class='badge bg-warning'>Осталось {Math.Ceiling(daysRemaining)} дн.</span>");
        return new($"<span class='badge bg-danger'>Просрочено {Math.Floor(daysElapsed - 5)} дн.</span>");
    }

    private record DemandDto(
        Guid Id,
        string? RequestTypeName,
        string? InitiatorName,
        decimal TotalSupportPercent,
        string? CollectiveStatus,
        DateTime CreatedAt,
        DateTime? SubmittedToCeoAt);
}
