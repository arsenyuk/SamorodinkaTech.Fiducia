@page "/share-requests/{Id:guid}"
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject ILogger<ShareRequestDetail> Logger
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "PARTICIPANT")]

<PageTitle>Fiducia — Детали запроса</PageTitle>

<a href="/share-requests" class="btn btn-sm btn-outline-secondary mb-3">&larr; Назад к списку</a>

@if (_loading)
{
    <div class="text-center py-4">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (_request is null)
{
    <div class="alert alert-warning">Запрос не найден.</div>
}
else
{
    <h3>@_request.RequestTypeName</h3>

    <div class="card mb-4">
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Статус:</strong> @GetStatusBadge(_request.Status)
                </div>
                <div class="col-md-6">
                    <strong>Дата создания:</strong> @_request.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                </div>
            </div>
            @if (_request.CompletedAt.HasValue)
            {
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Дата завершения:</strong> @_request.CompletedAt.Value.ToString("dd.MM.yyyy HH:mm")
                    </div>
                </div>
            }
        </div>
    </div>

    @* ── Место ознакомления (для принятых требований) ──────────────── *@
    @if (_request.Status == "accepted" && !string.IsNullOrEmpty(_request.ReviewLocation))
    {
        <div class="card mb-4 border-success">
            <div class="card-body">
                <h5 class="text-success">Документы готовы к ознакомлению</h5>
                <p class="mb-1"><strong>Место ознакомления:</strong></p>
                <p class="mb-0">@_request.ReviewLocation</p>
            </div>
        </div>
    }

    @* ── Комментарий ГД (для завершённых требований) ────────────────── *@
    @if ((_request.Status == "accepted" || _request.Status == "rejected") && !string.IsNullOrEmpty(_request.CeoComment))
    {
        <div class="alert alert-info mb-4">
            <strong>Комментарий ГД:</strong> @_request.CeoComment
        </div>
    }

    @* ── Действия для черновика ────────────────────────────────────── *@
    @if (_request.Status == "draft")
    {
        <div class="card mb-4 border-primary">
            <div class="card-body">
                <h5>Действия</h5>
                <p class="text-muted">Требование в статусе черновика. Вы можете редактировать и отправить его.</p>
                <div class="d-flex gap-2">
                    <a href="/share-requests/@_request.Id/edit" class="btn btn-primary">
                        <span class="oi oi-pencil"></span> Редактировать
                    </a>
                    <button class="btn btn-success" @onclick="SubmitRequestAsync">
                        <span class="oi oi-check"></span> Отправить требование
                    </button>
                </div>
            </div>
        </div>
    }

    @* ── Результат для PREEMPTIVE_LIST ────────────────────────────── *@
    @if (_request.RequestTypeCode == "PREEMPTIVE_LIST" && _request.Status == "completed")
    {
        <h4>Участники с правом преимущественного выкупа</h4>
        @if (_resultParticipants.Count == 0)
        {
            <div class="text-muted">Нет других участников.</div>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Участник</th>
                        <th>Тип</th>
                        <th>Доля, %</th>
                        <th>Номинал, ₽</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in _resultParticipants)
                    {
                        <tr>
                            <td>@(p.FullName ?? p.CompanyName)</td>
                            <td>@p.ParticipantType</td>
                            <td>@p.SharePercent?.ToString("N2")</td>
                            <td>@p.ShareAmount?.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    @* ── Payload для других типов ──────────────────────────────────── *@
    @if (_request.RequestTypeCode == "REQUEST_INFORMATION" && !string.IsNullOrEmpty(_request.Payload))
    {
        <h4>Запрошенные документы</h4>
        <div class="card mb-4">
            <div class="card-body">
                @if (_infoDocumentTypes.Count > 0)
                {
                    <div class="mb-3">
                        <strong>Типы документов:</strong>
                        <ul class="mb-0">
                            @foreach (var dt in _infoDocumentTypes)
                            {
                                <li>@dt</li>
                            }
                        </ul>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_infoAccessMethod))
                {
                    <div class="mb-3">
                        <strong>Способ предоставления:</strong> @_infoAccessMethod
                    </div>
                }
                @if (!string.IsNullOrEmpty(_infoText))
                {
                    <div>
                        <strong>Комментарий:</strong> @_infoText
                    </div>
                }
            </div>
        </div>
    }
    else if (_request.RequestTypeCode != "PREEMPTIVE_LIST" && !string.IsNullOrEmpty(_request.Payload))
    {
        <h4>Данные запроса</h4>
        <pre class="bg-light p-3 rounded"><code>@_request.Payload</code></pre>
    }

    @* ── Пункты структурированного требования ──────────────────────── *@
    @if (_items.Count > 0)
    {
        @* ── Итоговое решение ────────────────────────────────────── *@
        @if (!string.IsNullOrEmpty(_request.DecisionStatus))
        {
            <div class="card mb-4 @(_request.DecisionStatus == "APPROVED" ? "border-success" : _request.DecisionStatus == "REJECTED" ? "border-danger" : "border-warning")">
                <div class="card-body">
                    <h5 class="card-title mb-3">
                        Итоговое решение: @GetDecisionBadge(_request.DecisionStatus)
                    </h5>
                    @if (!string.IsNullOrEmpty(_request.DecisionComment))
                    {
                        <p class="mb-0">@_request.DecisionComment</p>
                    }
                    @if (_request.DecidedAt.HasValue)
                    {
                        <small class="text-muted">Дата решения: @_request.DecidedAt.Value.ToString("dd.MM.yyyy HH:mm")</small>
                    }
                </div>
            </div>
        }

        <h4>Пункты требования</h4>
        @foreach (var item in _items)
        {
            <div class="card mb-3 @(item.Status == "approved" ? "border-success" : item.Status == "rejected" ? "border-danger" : "")">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>@item.Title</strong>
                    @if (item.Status == "approved")
                    {
                        <span class="badge bg-success">Утверждено</span>
                    }
                    else if (item.Status == "rejected")
                    {
                        <span class="badge bg-danger">Отклонено</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">На рассмотрении</span>
                    }
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(item.Description))
                    {
                        <p>@item.Description</p>
                    }
                    @if (item.Status == "rejected" && !string.IsNullOrEmpty(item.RejectionReason))
                    {
                        <div class="alert alert-danger py-2 mb-3">
                            <strong>Причина отклонения:</strong> @item.RejectionReason
                        </div>
                    }
                    @if (item.Files.Count > 0)
                    {
                        <div class="mt-2">
                            <strong>Прикреплённые файлы:</strong>
                            <ul class="mb-0 mt-1">
                                @foreach (var f in item.Files)
                                {
                                    <li>
                                        <a href="/api/files/@f.FileId/download" target="_blank" class="text-decoration-none">
                                            📄 @f.FileName
                                        </a>
                                        <span class="text-muted small">(@FormatSize(f.SizeBytes))</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        }
    }

    @* ── Прикреплённые файлы (общие) ────────────────────────────────── *@
    @if (_files.Count > 0 && _items.Count == 0)
    {
        <h4>Прикреплённые файлы</h4>
        <div class="mb-4">
            @foreach (var f in _files)
            {
                <div class="d-flex align-items-center gap-2 mb-1">
                    <a href="/api/files/@f.FileId/download" target="_blank" class="text-decoration-none">
                        📄 @f.FileName
                    </a>
                    <span class="text-muted small">(@FormatSize(f.SizeBytes))</span>
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private ShareRequestDto? _request;
    private List<ParticipantResultDto> _resultParticipants = new();
    private List<FileDto> _files = new();
    private List<ItemDto> _items = new();
    private bool _loading = true;

    // Данные для REQUEST_INFORMATION
    private List<string> _infoDocumentTypes = new();
    private string? _infoAccessMethod;
    private string? _infoText;

    // Справочники для кодирования
    private Dictionary<string, string> _documentTypeNames = new();
    private Dictionary<string, string> _accessMethodNames = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _request = await Http.GetFromJsonAsync<ShareRequestDto>($"/api/share-requests/{Id}");

            // Загружаем справочники для отображения REQUEST_INFORMATION
            try
            {
                var refData = await Http.GetFromJsonAsync<RefDataDto>("/api/share-requests/ref-data");
                if (refData?.DocumentGroups is not null)
                {
                    foreach (var group in refData.DocumentGroups)
                    {
                        foreach (var doc in group.Documents)
                            _documentTypeNames[doc.Code] = doc.Name;
                    }
                }
                if (refData?.AccessMethods is not null)
                    _accessMethodNames = refData.AccessMethods.ToDictionary(m => m.Code, m => m.Name);
            }
            catch { /* не критично */ }

            // Парсим payload для REQUEST_INFORMATION
            if (_request?.RequestTypeCode == "REQUEST_INFORMATION" && !string.IsNullOrEmpty(_request.Payload))
            {
                try
                {
                    var payload = System.Text.Json.JsonSerializer.Deserialize<JsonElement>(_request.Payload);
                    if (payload.TryGetProperty("documentTypeCodes", out var codesProp))
                    {
                        foreach (var code in codesProp.EnumerateArray())
                        {
                            var codeStr = code.GetString() ?? "";
                            _infoDocumentTypes.Add(_documentTypeNames.GetValueOrDefault(codeStr, codeStr));
                        }
                    }
                    if (payload.TryGetProperty("accessMethodCode", out var methodProp))
                    {
                        var methodCode = methodProp.GetString() ?? "";
                        _infoAccessMethod = _accessMethodNames.GetValueOrDefault(methodCode, methodCode);
                    }
                    if (payload.TryGetProperty("text", out var textProp))
                        _infoText = textProp.GetString();
                }
                catch { /* payload не JSON */ }
            }

            if (_request?.RequestTypeCode == "PREEMPTIVE_LIST" && _request.Status == "completed")
            {
                _resultParticipants = await Http.GetFromJsonAsync<List<ParticipantResultDto>>(
                    $"/api/share-requests/{Id}/result") ?? new();
            }

            var filesResponse = await Http.GetFromJsonAsync<List<FileDto>>($"/api/share-requests/{Id}/files");
            _files = filesResponse ?? new();

            // Загружаем пункты требования
            try
            {
                var itemsResponse = await Http.GetFromJsonAsync<List<ItemDto>>($"/api/share-requests/{Id}/items");
                _items = itemsResponse ?? new();
            }
            catch { /* пункты могут отсутствовать для старых требований */ }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки запроса {Id}", Id);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SubmitRequestAsync()
    {
        var confirmed = await Http.PostAsJsonAsync($"/api/share-requests/{Id}/submit", new { });
        if (confirmed.IsSuccessStatusCode)
        {
            Nav.NavigateTo($"/share-requests/{Id}", forceLoad: true);
        }
    }

    private static MarkupString GetStatusBadge(string status) => status switch
    {
        "draft" => new("<span class='badge bg-secondary'>Черновик</span>"),
        "submitted" => new("<span class='badge bg-info'>Подано</span>"),
        "accepted" => new("<span class='badge bg-success'>Принято</span>"),
        "rejected" => new("<span class='badge bg-danger'>Отклонено</span>"),
        "revoked" => new("<span class='badge bg-warning'>Отозвано</span>"),
        "completed" => new("<span class='badge bg-success'>Завершён</span>"),
        "pending" => new("<span class='badge bg-warning'>В обработке</span>"),
        _ => new($"<span class='badge bg-secondary'>{status}</span>")
    };

    private static MarkupString GetDecisionBadge(string? decisionStatus) => decisionStatus switch
    {
        "APPROVED" => new("<span class='badge bg-success'>Утверждено</span>"),
        "REJECTED" => new("<span class='badge bg-danger'>Отклонено</span>"),
        "PARTIALLY_APPROVED" => new("<span class='badge bg-warning'>Частично утверждено</span>"),
        _ => new("<span class='badge bg-secondary'>На рассмотрении</span>")
    };

    private record ShareRequestDto(Guid Id, Guid RequestTypeId, string? RequestTypeCode, string? RequestTypeName, string Status, string? Payload, DateTime CreatedAt, DateTime? CompletedAt, DateTime? RevokedAt, bool RevokedByNotarized, bool VisibleToAll, string? CeoComment, string? ReviewLocation, string? DecisionStatus, string? DecisionComment, DateTime? DecidedAt);
    private record ParticipantResultDto(Guid ParticipantId, string? FullName, string? CompanyName, string ParticipantType, decimal? SharePercent, decimal? ShareAmount);
    private record FileDto(Guid Id, Guid FileId, string FileName, long SizeBytes, string? ContentType, DateTime CreatedAt);
    private record ItemDto(Guid Id, int SequenceNumber, string Title, string? Description, string Status, string? RejectionReason, List<ItemFileDto> Files);
    private record ItemFileDto(Guid Id, Guid FileId, string FileName, long SizeBytes, string? ContentType);
    private record RefDataDto(List<DocumentGroupDto>? DocumentGroups, List<AccessMethodDto>? AccessMethods);
    private record DocumentGroupDto(string Code, string Name, List<DocumentTypeDto> Documents);
    private record DocumentTypeDto(Guid Id, string Code, string Name, string GroupCode, string GroupName, bool IsElectronicAvailable, int StorageYears);
    private record AccessMethodDto(Guid Id, string Code, string Name, string? Description, int? DeadlineDays);

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} Б";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} КБ";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024.0):F1} МБ";
        return $"{bytes / (1024.0 * 1024.0 * 1024.0):F1} ГБ";
    }
}
