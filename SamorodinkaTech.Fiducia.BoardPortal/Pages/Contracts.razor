@page "/contracts"
@using System.Net.Http.Json
@using Microsoft.EntityFrameworkCore
@using SamorodinkaTech.Fiducia.Domain.Entities
@using SamorodinkaTech.Fiducia.Domain.Enums
@using SamorodinkaTech.Fiducia.Domain.Validation
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@inject ILogger<Contracts> Logger
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject HttpClient Http
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Fiducia — Договоры</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Договоры</h3>
        <div class="d-flex gap-2">
            @if (_isLlc && (_isLawyer || _isCeo))
            {
                <button class="btn btn-outline-primary" @onclick='() => Navigation.NavigateTo("/contracts/add?contractType=MANAGEMENT_IP")'>+ Договор с управляющим</button>
            }
            @if (_isLawyer)
            {
                <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/contracts/add")'>+ Добавить договор</button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_globalError))
    {
        <div class="alert alert-danger">@_globalError</div>
    }

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
        </div>
    }
    else
    {
        @* Блок-предупреждения *@
        @if (!_hasRegistrar && (_isPjsc || _isNjsc))
        {
            <div class="alert alert-warning d-flex align-items-center" role="alert">
                <span class="me-2">⚠</span>
                <div>
                    <strong>Договор с регистратором обязателен для всех АО.</strong>
                    Заключите договор с лицензированным регистратором для ведения реестра владельцев ценных бумаг
                    (<LawReferenceLink Article="article-39fz-registrar" Text="ст. 8 39-ФЗ" />).
                </div>
            </div>
        }
        @if (_isPjsc && !_hasInfoAgency)
        {
            <div class="alert alert-warning d-flex align-items-center" role="alert">
                <span class="me-2">⚠</span>
                <div>
                    <strong>Договор с информационным агентством обязателен для ПАО.</strong>
                    ПАО обязаны раскрывать информацию через аккредитованное информационное агентство.
                </div>
            </div>
        }

        @if (_allContracts.Count == 0)
        {
            <div class="card">
                <div class="card-body text-center py-5">
                    <h5 class="text-muted">Договоры не заключены</h5>
                    <p class="text-muted">Добавьте договор с регистратором, информационным агентством или управляющим</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var c in _allContracts)
            {
                <div class="card mb-3 @(c.IsActive ? "" : "border-secondary opacity-75")">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@c.CounterpartyName</strong>
                            <span class="badge bg-secondary ms-2">ИНН @c.CounterpartyInn</span>
                            <span class="badge @GetTypeBadgeClass(c.ContractType) ms-1">@GetTypeLabel(c.ContractType)</span>
                            @if (c.ContractType == ContractType.REGISTRAR && _legalEntityName is not null)
                            {
                                <span class="text-muted ms-2">Эмитент: @_legalEntityName</span>
                            }
                            @if (!c.IsActive)
                            {
                                <span class="badge bg-warning ms-2">Не действует</span>
                            }
                        </div>
                        <div>
                            @if ((c.ContractType == ContractType.REGISTRAR || c.ContractType == ContractType.INFO_AGENCY) && c.CbrStatus == "Active")
                            {
                                <span class="badge bg-success">Действующая</span>
                            }
                            else if ((c.ContractType == ContractType.REGISTRAR || c.ContractType == ContractType.INFO_AGENCY) && !string.IsNullOrEmpty(c.CbrStatus))
                            {
                                <span class="badge bg-danger">@c.CbrStatus</span>
                            }
                            @if (c.ContractType == ContractType.REGISTRAR || c.ContractType == ContractType.INFO_AGENCY)
                            {
                                @if (_isLawyer)
                                {
                                    <button class="btn btn-sm btn-outline-info ms-2"
                                            @onclick="() => CheckCbrStatus(c)"
                                            disabled="@(_checkingCbrId == c.Id)">
                                        @if (_checkingCbrId == c.Id)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                        }
                                        else
                                        {
                                            <span>ЦБР</span>
                                        }
                                    </button>
                                }
                            }
                            @if (_isLawyer || (c.ContractType == ContractType.MANAGEMENT_IP && _isCeo) || (c.ContractType == ContractType.MANAGEMENT_UL && _isCeo))
                            {
                                <button class="btn btn-sm btn-outline-primary ms-2"
                                        @onclick="@(() => Navigation.NavigateTo($"/contracts/{c.Id}"))">Редактировать</button>
                            }
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6>Договор</h6>
                                <table class="table table-sm table-borderless mb-3">
                                    <tr><td class="text-muted" style="width:200px">Номер:</td><td>@(c.ContractNumber ?? "—")</td></tr>
                                    <tr><td class="text-muted">Дата:</td><td>@(c.ContractDate ?? "—")</td></tr>
                                    <tr><td class="text-muted">Начало:</td><td>@(c.ContractValidFrom ?? "—")</td></tr>
                                    <tr>
                                        <td class="text-muted">Срок:</td>
                                        <td>
                                            @if (c.IsIndefinite)
                                            {
                                                <span>Бессрочный</span>
                                            }
                                            else
                                            {
                                                <span>@(c.ContractValidFrom ?? "—") — @(c.ContractValidTo ?? "—")</span>
                                            }
                                        </td>
                                    </tr>
                                    @if (c.ContractDocumentId.HasValue)
                                    {
                                        <tr>
                                            <td class="text-muted">Файл:</td>
                                            <td>
                                                <a href="/api/files/@c.ContractDocumentId/download" target="_blank"
                                                   class="btn btn-sm btn-outline-secondary">
                                                    📄 Скачать
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </table>
                            </div>
                            @if (c.ContractType == ContractType.REGISTRAR)
                            {
                                <div class="col-md-6">
                                    <h6>Сроки подготовки реестров</h6>
                                    <table class="table table-sm table-borderless mb-3">
                                        <tr>
                                            <td class="text-muted" style="width:300px">Реестр акционеров:</td>
                                            <td>@(c.RegistryPreparationDays?.ToString() ?? "—") @(FormatUnit(c.RegistryPreparationUnit))</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Реестр для дивидендов:</td>
                                            <td>@(c.DividendRegistryPreparationDays?.ToString() ?? "—") @(FormatUnit(c.DividendRegistryPreparationUnit))</td>
                                        </tr>
                                    </table>
                                    @if (!string.IsNullOrEmpty(c.RegistryRulesUrl) || c.RegistryRulesDocumentId.HasValue)
                                    {
                                        <h6>Правила ведения реестра</h6>
                                        @if (c.RegistryRulesDocumentId.HasValue)
                                        {
                                            <a href="/api/files/@c.RegistryRulesDocumentId/download" target="_blank"
                                               class="btn btn-sm btn-outline-secondary me-2">
                                                📄 Скачать файл
                                            </a>
                                        }
                                        @if (!string.IsNullOrEmpty(c.RegistryRulesUrl))
                                        {
                                            <a href="@c.RegistryRulesUrl" target="_blank"
                                               class="btn btn-sm btn-outline-info">
                                                🌐 Открыть ссылку
                                            </a>
                                        }
                                    }
                                </div>
                            }
                            @if (c.ContractType == ContractType.MANAGEMENT_IP && !string.IsNullOrEmpty(c.ManagerOgrnip))
                            {
                                <div class="col-md-6">
                                    <h6>Данные управляющего ИП</h6>
                                    <table class="table table-sm table-borderless mb-0">
                                        <tr><td class="text-muted" style="width:200px">ОГРНИП:</td><td>@c.ManagerOgrnip</td></tr>
                                    </table>
                                </div>
                            }
                            @if (c.ContractType == ContractType.MANAGEMENT_UL && !string.IsNullOrEmpty(c.ManagerFullName))
                            {
                                <div class="col-md-6">
                                    <h6>Данные управляющей организации</h6>
                                    <table class="table table-sm table-borderless mb-0">
                                        <tr><td class="text-muted" style="width:200px">Наименование:</td><td>@c.ManagerFullName</td></tr>
                                        <tr><td class="text-muted">ИНН:</td><td>@(c.ManagerInn ?? "—")</td></tr>
                                    </table>
                                </div>
                            }
                        </div>

                        @if (c.Licenses.Any())
                        {
                            <h6>Лицензии ЦБ РФ</h6>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Номер</th>
                                        <th>Наименование</th>
                                        <th>Дата начала</th>
                                        <th>Дата окончания</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var lic in c.Licenses)
                                    {
                                        <tr>
                                            <td>@lic.Number</td>
                                            <td>@lic.ActivityName</td>
                                            <td>@lic.StartDate</td>
                                            <td>
                                                @lic.EndDate
                                                @if (DateTime.TryParse(lic.EndDate, out var endDate) && endDate < DateTime.UtcNow)
                                                {
                                                    <span class="badge bg-danger ms-1">Истекла</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        @if (c.CbrFetchedAt.HasValue)
                        {
                            <div class="text-muted small">Данные ЦБ обновлены: @c.CbrFetchedAt.Value.ToString("dd.MM.yyyy HH:mm")</div>
                        }
                    </div>
                </div>
            }
        }
    }
</div>

@code {
    private bool _loading = true;
    private bool _isLawyer;
    private bool _isCeo;
    private bool _isParticipant;
    private bool _isLlc;
    private bool _isPjsc;
    private bool _isNjsc;
    private List<ContractView> _allContracts = new();
    private string? _globalError;
    private string? _legalEntityName;
    private bool _hasRegistrar;
    private bool _hasInfoAgency;
    private Guid? _checkingCbrId;
    private Dictionary<string, string> _measurementUnitShortNames = new();

    protected override async Task OnInitializedAsync()
    {
        var role = await JS.InvokeAsync<string>("localStorage.getItem", "currentUserRole");
        _isLawyer = role?.Contains("LAWYER", StringComparison.OrdinalIgnoreCase) == true;
        _isCeo = role?.Contains("CEO", StringComparison.OrdinalIgnoreCase) == true;
        _isParticipant = role?.Contains("PARTICIPANT", StringComparison.OrdinalIgnoreCase) == true;

        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var workplace = await ctx.CurrentWorkplaces.FirstOrDefaultAsync();
            var leId = workplace?.LastSelectedLegalEntityId;
            if (leId is not null && leId != Guid.Empty)
            {
                var le = await ctx.LegalEntities
                    .Where(x => x.Id == leId.Value)
                    .Select(x => new { x.RefOkopf!.Code, x.ShortName })
                    .FirstOrDefaultAsync();
                _isLlc = OkopfTypeMapper.IsLlc(le?.Code);
                _isPjsc = OkopfTypeMapper.IsPjsc(le?.Code);
                _isNjsc = OkopfTypeMapper.IsNjsc(le?.Code);
                _legalEntityName = le?.ShortName;
            }
            _measurementUnitShortNames = await ctx.RefMeasurementUnits
                .ToDictionaryAsync(x => x.Code, x => x.ShortName);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка определения ОКОПФ текущего ЮЛ");
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var workplace = await ctx.CurrentWorkplaces.FirstOrDefaultAsync();
            var leId = workplace?.LastSelectedLegalEntityId;
            if (leId is null || leId == Guid.Empty) return;

            var items = await ctx.Contracts
                .Where(c => c.LegalEntityId == leId.Value)
                .OrderByDescending(c => c.IsActive)
                .ThenBy(c => c.CounterpartyName)
                .ToListAsync();

            // Данные ЦБ для REGISTRAR/INFO_AGENCY
            var aoInns = items
                .Where(c => c.ContractType == ContractType.REGISTRAR || c.ContractType == ContractType.INFO_AGENCY)
                .Select(c => c.CounterpartyInn)
                .Distinct()
                .ToList();
            var cbrOrgs = await ctx.ExtCbrFinOrgOrganizations
                .Where(o => aoInns.Contains(o.Inn))
                .ToDictionaryAsync(o => o.Inn);
            var cbrLicenses = await ctx.ExtCbrFinOrgLicenses
                .Where(l => aoInns.Contains(l.OrganizationInn))
                .ToListAsync();

            // Данные ЮЛ-управляющих для MANAGEMENT_UL
            var ulLeIds = items
                .Where(c => c.ContractType == ContractType.MANAGEMENT_UL && c.ManagerLegalEntityId.HasValue)
                .Select(c => c.ManagerLegalEntityId!.Value)
                .Distinct()
                .ToList();
            var ulEntities = await ctx.LegalEntities
                .Where(le => ulLeIds.Contains(le.Id))
                .ToDictionaryAsync(le => le.Id);

            _allContracts = items.Select(c =>
            {
                cbrOrgs.TryGetValue(c.CounterpartyInn, out var cbrOrg);
                var licenses = cbrLicenses.Where(l => l.OrganizationInn == c.CounterpartyInn).ToList();

                string? managerFullName = null;
                string? managerInn = null;
                if (c.ContractType == ContractType.MANAGEMENT_UL && c.ManagerLegalEntityId.HasValue &&
                    ulEntities.TryGetValue(c.ManagerLegalEntityId.Value, out var ul))
                {
                    managerFullName = ul.ShortName ?? ul.Name;
                    managerInn = ul.Inn;
                }

                return new ContractView
                {
                    Id = c.Id,
                    ContractType = c.ContractType,
                    CounterpartyName = c.CounterpartyName,
                    CounterpartyInn = c.CounterpartyInn,
                    ContractNumber = c.ContractNumber,
                    ContractDate = c.ContractDate?.ToString("dd.MM.yyyy"),
                    ContractValidFrom = c.ContractValidFrom?.ToString("dd.MM.yyyy"),
                    ContractValidTo = c.ContractValidTo?.ToString("dd.MM.yyyy"),
                    IsIndefinite = c.IsIndefinite,
                    ContractDocumentId = c.ContractDocumentId,
                    RegistryPreparationDays = c.RegistryPreparationDays,
                    RegistryPreparationUnit = c.RegistryPreparationUnit?.Code,
                    DividendRegistryPreparationDays = c.DividendRegistryPreparationDays,
                    DividendRegistryPreparationUnit = c.DividendRegistryPreparationUnit?.Code,
                    RegistryRulesUrl = c.RegistryRulesUrl,
                    RegistryRulesDocumentId = c.RegistryRulesDocumentId,
                    ManagerOgrnip = c.ManagerOgrnip,
                    ManagerLegalEntityId = c.ManagerLegalEntityId,
                    ManagerFullName = managerFullName,
                    ManagerInn = managerInn,
                    IsActive = c.IsActive,
                    CbrStatus = cbrOrg?.Status,
                    CbrFetchedAt = cbrOrg?.FetchedAt,
                    Licenses = licenses.Select(l => new LicenseView
                    {
                        VidId = l.VidId,
                        ActivityName = l.ActivityName,
                        Number = l.Number,
                        Name = l.Name,
                        StartDate = l.StartDate?.ToString("dd.MM.yyyy"),
                        EndDate = l.EndDate?.ToString("dd.MM.yyyy")
                    }).ToList()
                };
            }).ToList();

            _hasRegistrar = _allContracts.Any(c => c.ContractType == ContractType.REGISTRAR && c.IsActive);
            _hasInfoAgency = _allContracts.Any(c => c.ContractType == ContractType.INFO_AGENCY && c.IsActive);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка загрузки договоров");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CheckCbrStatus(ContractView contractor)
    {
        _checkingCbrId = contractor.Id;
        StateHasChanged();

        var requestUrl = $"/api/contracts/check-cbr?inn={contractor.CounterpartyInn}";

        try
        {
            var response = await Http.GetAsync(requestUrl);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<CbrCheckResult>();
                if (result is not null && result.Warning is null)
                {
                    var idx = _allContracts.FindIndex(c => c.Id == contractor.Id);
                    if (idx >= 0)
                    {
                        _allContracts[idx].CbrStatus = result.Status;
                        _allContracts[idx].Licenses = result.Licenses?.ToList() ?? new();
                    }
                }
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Logger.LogWarning("HTTP GET {Url} вернул {StatusCode}: {Body}", requestUrl, (int)response.StatusCode, body);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка HTTP GET {Url}", requestUrl);
        }
        finally
        {
            _checkingCbrId = null;
            StateHasChanged();
        }
    }

    private string FormatUnit(string? unit)
    {
        if (string.IsNullOrEmpty(unit)) return "";
        return _measurementUnitShortNames.TryGetValue(unit, out var shortName) ? shortName : unit;
    }

    private static string GetTypeBadgeClass(ContractType type) => type switch
    {
        ContractType.REGISTRAR => "bg-primary",
        ContractType.INFO_AGENCY => "bg-info",
        ContractType.MANAGEMENT_IP => "bg-success",
        ContractType.MANAGEMENT_UL => "bg-success",
        _ => "bg-secondary"
    };

    private static string GetTypeLabel(ContractType type) => type switch
    {
        ContractType.REGISTRAR => "Регистратор",
        ContractType.INFO_AGENCY => "Информ. агентство",
        ContractType.MANAGEMENT_IP => "Управляющий ИП",
        ContractType.MANAGEMENT_UL => "Управляющая организация",
        _ => "Неизвестный"
    };

    // ═════════════════════════════════════════════════════════════════════
    // View models
    // ═════════════════════════════════════════════════════════════════════

    private class ContractView
    {
        public Guid Id { get; set; }
        public ContractType ContractType { get; set; }
        public string CounterpartyName { get; set; } = "";
        public string CounterpartyInn { get; set; } = "";
        public string? ContractNumber { get; set; }
        public string? ContractDate { get; set; }
        public string? ContractValidFrom { get; set; }
        public string? ContractValidTo { get; set; }
        public bool IsIndefinite { get; set; }
        public Guid? ContractDocumentId { get; set; }
        public int? RegistryPreparationDays { get; set; }
        public string? RegistryPreparationUnit { get; set; }
        public int? DividendRegistryPreparationDays { get; set; }
        public string? DividendRegistryPreparationUnit { get; set; }
        public string? RegistryRulesUrl { get; set; }
        public Guid? RegistryRulesDocumentId { get; set; }
        public string? ManagerOgrnip { get; set; }
        public Guid? ManagerLegalEntityId { get; set; }
        public string? ManagerFullName { get; set; }
        public string? ManagerInn { get; set; }
        public bool IsActive { get; set; }
        public string? CbrStatus { get; set; }
        public DateTime? CbrFetchedAt { get; set; }
        public List<LicenseView> Licenses { get; set; } = new();
    }

    private class LicenseView
    {
        public int VidId { get; set; }
        public string? ActivityName { get; set; }
        public string? Number { get; set; }
        public string? Name { get; set; }
        public string? StartDate { get; set; }
        public string? EndDate { get; set; }
    }

    private class CbrCheckResult
    {
        public string? Warning { get; set; }
        public string? Inn { get; set; }
        public string? ShortName { get; set; }
        public string? Status { get; set; }
        public string? FoTypes { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("licenses")]
        public List<LicenseView>? Licenses { get; set; }
    }
}
