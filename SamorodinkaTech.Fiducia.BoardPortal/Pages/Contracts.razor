@page "/contracts"
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using Microsoft.EntityFrameworkCore
@using SamorodinkaTech.Fiducia.Domain.Entities
@using SamorodinkaTech.Fiducia.Domain.Enums
@using SamorodinkaTech.Fiducia.Domain.Validation
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@inject ILogger<Contracts> Logger
@inject IJSRuntime JS
@inject NavigationManager Navigation
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Fiducia — Договоры</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Договоры</h3>
        @if (_isLawyer)
        {
            <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/contracts/add")'>+ Добавить договор</button>
        }
    </div>

    @if (!string.IsNullOrEmpty(_globalError))
    {
        <div class="alert alert-danger">@_globalError</div>
    }

    @* ═══════════════════════════════════════════════════════════════════ *@
    @* Список договоров                                                   *@
    @* ═══════════════════════════════════════════════════════════════════ *@

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
        </div>
    }
    else
    {
        @* Блок-предупреждения для отсутствующих обязательных договоров *@
        @if (!_hasRegistrar)
        {
            <div class="alert alert-warning d-flex align-items-center" role="alert">
                <span class="me-2">⚠</span>
                <div>
                    <strong>Договор с регистратором обязателен для всех АО.</strong>
                    Заключите договор с лицензированным регистратором для ведения реестра владельцев ценных бумаг (39-ФЗ).
                </div>
            </div>
        }
        @if (_isPjsc && !_hasInfoAgency)
        {
            <div class="alert alert-warning d-flex align-items-center" role="alert">
                <span class="me-2">⚠</span>
                <div>
                    <strong>Договор с информационным агентством обязателен для ПАО.</strong>
                    ПАО обязаны раскрывать информацию через аккредитованное информационное агентство.
                </div>
            </div>
        }

        @if (_contractors.Count == 0)
        {
            <div class="card">
                <div class="card-body text-center py-5">
                    <h5 class="text-muted">Договоры не заключены</h5>
                    <p class="text-muted">Добавьте договор с регистратором и (при необходимости) информационным агентством</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var c in _contractors)
            {
                <div class="card mb-3 @(c.IsActive ? "" : "border-secondary opacity-75")">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@c.ContractorName</strong>
                            <span class="badge bg-secondary ms-2">ИНН @c.ContractorInn</span>
                            <span class="badge @(c.ContractorType == "REGISTRAR" ? "bg-primary" : "bg-info") ms-1">
                                @(c.ContractorType == "REGISTRAR" ? "Регистратор" : "Информ. агентство")
                            </span>
                            @if (_legalEntityName is not null)
                            {
                                <span class="text-muted ms-2">
                                    @(c.ContractorType == "REGISTRAR" ? "Эмитент" : "Заказчик"): @_legalEntityName
                                </span>
                            }
                            @if (!c.IsActive)
                            {
                                <span class="badge bg-warning ms-2">Не действует</span>
                            }
                        </div>
                        <div>
                            @if (c.CbrStatus == "Active")
                            {
                                <span class="badge bg-success">Действующая</span>
                            }
                            else if (!string.IsNullOrEmpty(c.CbrStatus))
                            {
                                <span class="badge bg-danger">@c.CbrStatus</span>
                            }
                            @if (_isLawyer)
                            {
                                <button class="btn btn-sm btn-outline-info ms-2"
                                        @onclick="() => CheckCbrStatus(c)"
                                        disabled="@(_checkingCbrId == c.Id)">
                                    @if (_checkingCbrId == c.Id)
                                    {
                                        <span class="spinner-border spinner-border-sm"></span>
                                    }
                                    else
                                    {
                                        <span>ЦБР</span>
                                    }
                                </button>
                                <button class="btn btn-sm btn-outline-primary ms-2"
                                        @onclick="@(() => Navigation.NavigateTo($"/contracts/{c.Id}"))">Редактировать</button>
                            }
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6>Договор</h6>
                                <table class="table table-sm table-borderless mb-3">
                                    <tr><td class="text-muted" style="width:200px">Номер:</td><td>@(c.ContractNumber ?? "—")</td></tr>
                                    <tr><td class="text-muted">Дата:</td><td>@(c.ContractDate ?? "—")</td></tr>
                                    <tr><td class="text-muted">Начало:</td><td>@(c.ContractValidFrom ?? "—")</td></tr>
                                    <tr>
                                        <td class="text-muted">Срок:</td>
                                        <td>
                                            @if (c.IsIndefinite)
                                            {
                                                <span>Бессрочный</span>
                                            }
                                            else
                                            {
                                                <span>@(c.ContractValidFrom ?? "—") — @(c.ContractValidTo ?? "—")</span>
                                                <span class="badge bg-secondary ms-1">пролонгация</span>
                                            }
                                        </td>
                                    </tr>
                                    @if (c.ContractDocumentId.HasValue)
                                    {
                                        <tr>
                                            <td class="text-muted">Файл:</td>
                                            <td>
                                                <a href="/api/files/@c.ContractDocumentId/download" target="_blank"
                                                   class="btn btn-sm btn-outline-secondary">
                                                    📄 @(c.ContractDocumentName ?? "Скачать")
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </table>
                            </div>
                            @if (c.ContractorType == "REGISTRAR")
                            {
                                <div class="col-md-6">
                                    <h6>Сроки подготовки реестров</h6>
                                    <table class="table table-sm table-borderless mb-3">
                                        <tr>
                                            <td class="text-muted" style="width:300px">Реестр акционеров:</td>
                                            <td>@(c.RegistryPreparationDays?.ToString() ?? "—") @(FormatUnit(c.RegistryPreparationUnit))</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Реестр для дивидендов:</td>
                                            <td>@(c.DividendRegistryPreparationDays?.ToString() ?? "—") @(FormatUnit(c.DividendRegistryPreparationUnit))</td>
                                        </tr>
                                    </table>
                                    @if (!string.IsNullOrEmpty(c.RegistryRulesUrl) || c.RegistryRulesDocumentId.HasValue)
                                    {
                                        <h6>Правила ведения реестра</h6>
                                        @if (c.RegistryRulesDocumentId.HasValue)
                                        {
                                            <a href="/api/files/@c.RegistryRulesDocumentId/download" target="_blank"
                                               class="btn btn-sm btn-outline-secondary me-2">
                                                📄 @(c.RegistryRulesDocumentName ?? "Скачать файл")
                                            </a>
                                        }
                                        @if (!string.IsNullOrEmpty(c.RegistryRulesUrl))
                                        {
                                            <a href="@c.RegistryRulesUrl" target="_blank"
                                               class="btn btn-sm btn-outline-info">
                                                🌐 Открыть ссылку
                                            </a>
                                        }
                                    }
                                </div>
                            }
                        </div>

                        @if (c.Licenses.Any())
                        {
                            <h6>Лицензии ЦБ РФ</h6>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Номер</th>
                                        <th>Наименование</th>
                                        <th>Дата начала</th>
                                        <th>Дата окончания</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var lic in c.Licenses)
                                    {
                                        <tr>
                                            <td>@lic.Number</td>
                                            <td>@lic.ActivityName</td>
                                            <td>@lic.StartDate</td>
                                            <td>
                                                @lic.EndDate
                                                @if (DateTime.TryParse(lic.EndDate, out var endDate) && endDate < DateTime.UtcNow)
                                                {
                                                    <span class="badge bg-danger ms-1">Истекла</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        @if (c.CbrFetchedAt.HasValue)
                        {
                            <div class="text-muted small">Данные ЦБ обновлены: @c.CbrFetchedAt.Value.ToString("dd.MM.yyyy HH:mm")</div>
                        }
                    </div>
                </div>
            }
        }
    }
</div>

@code {
    /// <summary>Максимальное количество результатов поиска.</summary>
    private const int MaxSearchResults = 10;

    private bool _loading = true;
    private bool _isLawyer;
    private bool _isPjsc;
    private List<ContractorView> _contractors = new();
    private string? _globalError;
    private string? _legalEntityName;
    private bool _hasRegistrar;
    private bool _hasInfoAgency;

    /// <summary>Проверка ЦБР — ID контрагента, для которого идёт запрос.</summary>
    private Guid? _checkingCbrId;

    protected override async Task OnInitializedAsync()
    {
        var role = await JS.InvokeAsync<string>("localStorage.getItem", "currentUserRole");
        _isLawyer = role?.Contains("LAWYER", StringComparison.OrdinalIgnoreCase) == true;

        // Определяем ОКОПФ текущего ЮЛ
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var workplace = await ctx.CurrentWorkplaces.FirstOrDefaultAsync();
            var leId = workplace?.LastSelectedLegalEntityId;
            if (leId is not null && leId != Guid.Empty)
            {
                var le = await ctx.LegalEntities
                    .Where(x => x.Id == leId.Value)
                    .Select(x => new { x.RefOkopf!.Code, x.ShortName })
                    .FirstOrDefaultAsync();
                _isPjsc = OkopfTypeMapper.IsPjsc(le?.Code);
                _legalEntityName = le?.ShortName;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка определения ОКОПФ текущего ЮЛ");
        }

        await LoadData();
    }

    /// <summary>Загрузка списка договоров из БД с привязкой к текущему ЮЛ.</summary>
    private async Task LoadData()
    {
        _loading = true;
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var workplace = await ctx.CurrentWorkplaces.FirstOrDefaultAsync();
            var leId = workplace?.LastSelectedLegalEntityId;
            if (leId is null || leId == Guid.Empty) return;

            var contractors = await ctx.AoContractors
                .Where(c => c.LegalEntityId == leId.Value)
                .OrderByDescending(c => c.IsActive)
                .ThenBy(c => c.ContractorName)
                .ToListAsync();

            var inns = contractors.Select(c => c.ContractorInn).Distinct().ToList();
            var cbrOrgs = await ctx.ExtCbrFinOrgOrganizations
                .Where(o => inns.Contains(o.Inn))
                .ToDictionaryAsync(o => o.Inn);
            var cbrLicenses = await ctx.ExtCbrFinOrgLicenses
                .Where(l => inns.Contains(l.OrganizationInn))
                .ToListAsync();

            _contractors = contractors.Select(c =>
            {
                cbrOrgs.TryGetValue(c.ContractorInn, out var org);
                var licenses = cbrLicenses.Where(l => l.OrganizationInn == c.ContractorInn).ToList();
                return new ContractorView
                {
                    Id = c.Id,
                    ContractorInn = c.ContractorInn,
                    ContractorName = c.ContractorName,
                    ContractorType = c.ContractorType.ToString(),
                    ContractNumber = c.ContractNumber,
                    ContractDate = c.ContractDate?.ToString("dd.MM.yyyy"),
                    ContractValidFrom = c.ContractValidFrom?.ToString("dd.MM.yyyy"),
                    ContractValidTo = c.ContractValidTo?.ToString("dd.MM.yyyy"),
                    IsIndefinite = c.IsIndefinite,
                    ContractDocumentId = c.ContractDocumentId,
                    RegistryPreparationDays = c.RegistryPreparationDays,
                    RegistryPreparationUnit = c.RegistryPreparationUnit?.ToString(),
                    DividendRegistryPreparationDays = c.DividendRegistryPreparationDays,
                    DividendRegistryPreparationUnit = c.DividendRegistryPreparationUnit?.ToString(),
                    RegistryRulesUrl = c.RegistryRulesUrl,
                    RegistryRulesDocumentId = c.RegistryRulesDocumentId,
                    IsActive = c.IsActive,
                    CbrStatus = org?.Status,
                    CbrFetchedAt = org?.FetchedAt,
                    Licenses = licenses.Select(l => new LicenseView
                    {
                        VidId = l.VidId,
                        ActivityName = l.ActivityName,
                        Number = l.Number,
                        Name = l.Name,
                        StartDate = l.StartDate?.ToString("dd.MM.yyyy"),
                        EndDate = l.EndDate?.ToString("dd.MM.yyyy")
                    }).ToList()
                };
            }).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка загрузки договоров");
        }
        finally
        {
            _loading = false;
        }

        _hasRegistrar = _contractors.Any(c => c.ContractorType == "REGISTRAR" && c.IsActive);
        _hasInfoAgency = _contractors.Any(c => c.ContractorType == "INFO_AGENCY" && c.IsActive);
    }

    /// <summary>Проверка статуса контрагента в ЦБР по ИНН.</summary>
    private async Task CheckCbrStatus(ContractorView contractor)
    {
        _checkingCbrId = contractor.Id;
        StateHasChanged();

        try
        {
            var token = await JS.InvokeAsync<string?>("localStorage.getItem", "jwtToken");
            using var http = new HttpClient { BaseAddress = new Uri(Navigation.BaseUri) };
            if (!string.IsNullOrEmpty(token))
                http.DefaultRequestHeaders.Authorization =
                    new AuthenticationHeaderValue("Bearer", token);

            var response = await http.GetAsync($"/api/ao-contractors/check-cbr?inn={contractor.ContractorInn}");
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<CbrCheckResult>();
                if (result is not null && result.Warning is null)
                {
                    var idx = _contractors.FindIndex(c => c.Id == contractor.Id);
                    if (idx >= 0)
                    {
                        _contractors[idx].CbrStatus = result.Status;
                        _contractors[idx].Licenses = result.Licenses?.ToList() ?? new();
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка проверки ЦБР для ИНН={Inn}", contractor.ContractorInn);
        }
        finally
        {
            _checkingCbrId = null;
            StateHasChanged();
        }
    }

    /// <summary>Форматирование единицы измерения срока (календ. / раб. дн.).</summary>
    private static string FormatUnit(string? unit) => unit switch
    {
        "CALENDAR" => "календ. дн.",
        "BUSINESS" => "раб. дн.",
        _ => ""
    };

    // ═════════════════════════════════════════════════════════════════════
    // View models
    // ═════════════════════════════════════════════════════════════════════

    private class ContractorView
    {
        public Guid Id { get; set; }
        public string ContractorInn { get; set; } = "";
        public string ContractorName { get; set; } = "";
        public string ContractorType { get; set; } = "";
        public string? ContractNumber { get; set; }
        public string? ContractDate { get; set; }
        public string? ContractValidFrom { get; set; }
        public string? ContractValidTo { get; set; }
        public bool IsIndefinite { get; set; }
        public Guid? ContractDocumentId { get; set; }
        public string? ContractDocumentName { get; set; }
        public int? RegistryPreparationDays { get; set; }
        public string? RegistryPreparationUnit { get; set; }
        public int? DividendRegistryPreparationDays { get; set; }
        public string? DividendRegistryPreparationUnit { get; set; }
        public string? RegistryRulesUrl { get; set; }
        public Guid? RegistryRulesDocumentId { get; set; }
        public string? RegistryRulesDocumentName { get; set; }
        public bool IsActive { get; set; }
        public string? CbrStatus { get; set; }
        public DateTime? CbrFetchedAt { get; set; }
        public List<LicenseView> Licenses { get; set; } = new();
    }

    private class LicenseView
    {
        public int VidId { get; set; }
        public string? ActivityName { get; set; }
        public string? Number { get; set; }
        public string? Name { get; set; }
        public string? StartDate { get; set; }
        public string? EndDate { get; set; }
    }

    private class CbrCheckResult
    {
        public string? Warning { get; set; }
        public string? Inn { get; set; }
        public string? ShortName { get; set; }
        public string? Status { get; set; }
        public string? FoTypes { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("licenses")]
        public List<LicenseView>? Licenses { get; set; }
    }
}
