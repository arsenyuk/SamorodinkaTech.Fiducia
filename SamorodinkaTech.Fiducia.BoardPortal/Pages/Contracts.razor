@page "/contracts"
@using Microsoft.EntityFrameworkCore
@using SamorodinkaTech.Fiducia.Domain.Entities
@using SamorodinkaTech.Fiducia.Domain.Enums
@using SamorodinkaTech.Fiducia.Domain.Validation
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@inject HttpClient Http
@inject ILogger<Contracts> Logger
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Fiducia — Договоры</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Договоры</h3>
        @if (_isLawyer && !_showAddForm)
        {
            <button class="btn btn-primary" @onclick="ShowAddForm">+ Добавить договор</button>
        }
    </div>

    @if (!string.IsNullOrEmpty(_globalError))
    {
        <div class="alert alert-danger">@_globalError</div>
    }

    @* ═══════════════════════════════════════════════════════════════════ *@
    @* Форма добавления нового договора                                  *@
    @* ═══════════════════════════════════════════════════════════════════ *@

    @if (_showAddForm)
    {
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Новый договор</h5>
                <button type="button" class="btn-close" @onclick="CloseAddForm"></button>
            </div>
            <div class="card-body">

                @if (!string.IsNullOrEmpty(_formError))
                {
                    <div class="alert alert-danger">@_formError</div>
                }

                @* ── Шаг 1: Поиск контрагента ── *@
                @if (_addStep == 1)
                {
                    <h6>Шаг 1. Поиск контрагента</h6>
                    <div class="mb-3">
                        <label class="form-label">ИНН контрагента</label>
                        <div class="input-group">
                            <input class="form-control" @bind="_formInn" maxlength="12"
                                   placeholder="Введите 10 или 12 цифр ИНН" />
                            <button class="btn btn-outline-primary" type="button"
                                    @onclick="DiagnoseInn" disabled="@(_diagnosing || _formInn?.Trim().Length < MinInnLength)">
                                @if (_diagnosing)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                else
                                {
                                    <span>Проверить</span>
                                }
                            </button>
                        </div>
                    </div>
                }

                @* ── Шаг 2: Диагностика ── *@
                @if (_addStep == 2 && _diagnosis is not null)
                {
                    <h6>Шаг 2. Результат диагностики</h6>

                    <div class="card bg-light mb-3">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <strong>@(_diagnosis.CompanyName ?? "Неизвестно")</strong>
                                    <br />
                                    <span class="text-muted">ИНН: @_diagnosis.Inn</span>
                                    @if (!string.IsNullOrEmpty(_diagnosis.OkopfCode))
                                    {
                                        <span class="badge bg-secondary ms-2">ОКОПФ @_diagnosis.OkopfCode</span>
                                    }
                                </div>
                                <div class="col-md-6 text-end">
                                    @if (_diagnosis.Status == "Действующее")
                                    {
                                        <span class="badge bg-success">Действующее</span>
                                    }
                                    else if (!string.IsNullOrEmpty(_diagnosis.Status))
                                    {
                                        <span class="badge bg-warning">@_diagnosis.Status</span>
                                    }
                                    @if (_diagnosis.IsRegistrar)
                                    {
                                        <span class="badge bg-info ms-1">Регистратор (VidID=4)</span>
                                    }
                                    @if (_diagnosis.IsInfoAgency)
                                    {
                                        <span class="badge bg-info ms-1">Информационное агентство (IA)</span>
                                    }
                                </div>
                            </div>

                            @if (_diagnosis.CbrStatus is not null)
                            {
                                <hr />
                                <div class="small">
                                    <span class="text-muted">Статус ЦБР:</span>
                                    @if (_diagnosis.CbrStatus == "Active")
                                    {
                                        <span class="badge bg-success ms-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary ms-1">@_diagnosis.CbrStatus</span>
                                    }
                                </div>
                            }

                            @if (_diagnosis.Licenses?.Any() == true)
                            {
                                <table class="table table-sm mt-2 mb-0">
                                    <thead>
                                        <tr><th>VidID</th><th>Наименование</th><th>Номер</th><th>Действует до</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var lic in _diagnosis.Licenses)
                                        {
                                            <tr>
                                                <td>@lic.VidId</td>
                                                <td>@lic.ActivityName</td>
                                                <td>@lic.Number</td>
                                                <td>
                                                    @lic.EndDate
                                                    @if (DateTime.TryParse(lic.EndDate, out var endDate) && endDate < DateTime.UtcNow)
                                                    {
                                                        <span class="badge bg-danger ms-1">Истекла</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }

                            @if (_diagnosis.Warnings?.Any() == true)
                            {
                                <div class="mt-2">
                                    @foreach (var w in _diagnosis.Warnings)
                                    {
                                        <div class="text-warning small">⚠ @w</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Тип договора</label>
                        <div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="contractorType"
                                       id="typeRegistrar" value="REGISTRAR"
                                       checked="@(_formContractorType == "REGISTRAR")"
                                       @onchange='() => _formContractorType = "REGISTRAR"' />
                                <label class="form-check-label" for="typeRegistrar">Регистратор</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="contractorType"
                                       id="typeInfoAgency" value="INFO_AGENCY"
                                       checked="@(_formContractorType == "INFO_AGENCY")"
                                       @onchange='() => _formContractorType = "INFO_AGENCY"' />
                                <label class="form-check-label" for="typeInfoAgency">Информационное агентство</label>
                            </div>
                        </div>
                        @if (_autoDetectedType is not null)
                        {
                            <div class="form-text">Автоопределён: @_autoDetectedType</div>
                        }
                    </div>

                    <button class="btn btn-primary" @onclick="GoToStep3"
                            disabled="@string.IsNullOrEmpty(_formContractorType)">
                        Далее — реквизиты договора
                    </button>
                    <button class="btn btn-outline-secondary ms-2" @onclick="ResetAddForm">Назад</button>
                }

                @* ── Шаг 3: Реквизиты договора ── *@
                @if (_addStep == 3)
                {
                    <h6>Шаг 3. Реквизиты договора</h6>

                    <div class="card bg-light mb-3">
                        <div class="card-body py-2">
                            <strong>@(_diagnosis?.CompanyName ?? _formInn)</strong>
                            <span class="badge bg-secondary ms-2">ИНН @_formInn</span>
                            <span class="badge @( _formContractorType == "REGISTRAR" ? "bg-primary" : "bg-info") ms-1">
                                @(_formContractorType == "REGISTRAR" ? "Регистратор" : "Информационное агентство")
                            </span>
                        </div>
                    </div>

                    @* Срок договора *@
                    <div class="mb-3">
                        <label class="form-label">Срок договора</label>
                        <div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="termType"
                                       id="termIndefinite" value="true"
                                       checked="@(_formIsIndefinite == "true")"
                                       @onchange='() => _formIsIndefinite = "true"' />
                                <label class="form-check-label" for="termIndefinite">Бессрочный</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="termType"
                                       id="termFixed" value="false"
                                       checked="@(_formIsIndefinite == "false")"
                                       @onchange='() => _formIsIndefinite = "false"' />
                                <label class="form-check-label" for="termFixed">Срочный с автоматической пролонгацией</label>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        @if (_formIsIndefinite == "true")
                        {
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Дата заключения</label>
                                <input type="date" class="form-control" @bind="_formContractDate" />
                            </div>
                        }
                        else
                        {
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Дата заключения</label>
                                <input type="date" class="form-control" @bind="_formContractDate" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Начало действия</label>
                                <input type="date" class="form-control" @bind="_formValidFrom" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Окончание действия</label>
                                <input type="date" class="form-control" @bind="_formValidTo" />
                                <div class="form-text">Автоматическая пролонгация</div>
                            </div>
                        }
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Номер договора</label>
                            <input type="text" class="form-control" @bind="_formContractNumber" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Файл договора</label>
                        @if (_formDocumentId.HasValue)
                        {
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <a href="/api/files/@_formDocumentId/download" target="_blank"
                                   class="btn btn-sm btn-outline-secondary">📄 @_formDocumentName</a>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => { _formDocumentId = null; _formDocumentName = null; }">Заменить</button>
                            </div>
                        }
                        else
                        {
                            <FileUpload Accept=".pdf,.doc,.docx"
                                        MaxSizeBytes="@MaxFileSizeBytes"
                                        FileType="CONTRACT"
                                        Token="@_jwtToken"
                                        OnFileUploadedInfo="OnContractFileUploaded" />
                        }
                    </div>

                    @* Поля только для Регистратора *@
                    @if (_formContractorType == "REGISTRAR")
                    {
                        <hr />
                        <h6>Сроки подготовки реестров</h6>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Реестр акционеров (дни)</label>
                                <input type="number" class="form-control" @bind="_formRegistryPrepDays" min="0" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Единица измерения</label>
                                <select class="form-select" @bind="_formRegistryPrepUnit">
                                    <option value="">Не указано</option>
                                    <option value="CALENDAR">Календарный день</option>
                                    <option value="BUSINESS">Рабочий день</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Реестр для дивидендов (дни)</label>
                                <input type="number" class="form-control" @bind="_formDividendRegPrepDays" min="0" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Единица измерения</label>
                                <select class="form-select" @bind="_formDividendRegPrepUnit">
                                    <option value="">Не указано</option>
                                    <option value="CALENDAR">Календарный день</option>
                                    <option value="BUSINESS">Рабочий день</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">URL Правил ведения реестра</label>
                            <input type="url" class="form-control" @bind="_formRegistryRulesUrl" placeholder="https://..." />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Файл Правил ведения реестра</label>
                            @if (_formRulesDocumentId.HasValue)
                            {
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <a href="/api/files/@_formRulesDocumentId/download" target="_blank"
                                       class="btn btn-sm btn-outline-secondary">📄 @_formRulesDocumentName</a>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => { _formRulesDocumentId = null; _formRulesDocumentName = null; }">Заменить</button>
                                </div>
                            }
                            else
                            {
                                <FileUpload Accept=".pdf,.doc,.docx"
                                            MaxSizeBytes="@MaxFileSizeBytes"
                                            FileType="REGISTRY_RULES"
                                            Token="@_jwtToken"
                                            OnFileUploadedInfo="OnRulesFileUploaded" />
                            }
                        </div>
                    }
                }

            </div>
            @if (_addStep == 3)
            {
                <div class="card-footer">
                    <button type="button" class="btn btn-secondary me-2" @onclick="() => _addStep = 2">← Назад</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveNewContract" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Создать договор
                    </button>
                </div>
            }
        </div>
    }

    @* ═══════════════════════════════════════════════════════════════════ *@
    @* Список договоров                                                   *@
    @* ═══════════════════════════════════════════════════════════════════ *@

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
        </div>
    }
    else
    {
        @* Блок-предупреждения для отсутствующих обязательных договоров *@
        @if (!_hasRegistrar)
        {
            <div class="alert alert-warning d-flex align-items-center" role="alert">
                <span class="me-2">⚠</span>
                <div>
                    <strong>Договор с регистратором обязателен для всех АО.</strong>
                    Заключите договор с лицензированным регистратором для ведения реестра владельцев ценных бумаг (39-ФЗ).
                </div>
            </div>
        }
        @if (_isPjsc && !_hasInfoAgency)
        {
            <div class="alert alert-warning d-flex align-items-center" role="alert">
                <span class="me-2">⚠</span>
                <div>
                    <strong>Договор с информационным агентством обязателен для ПАО.</strong>
                    ПАО обязаны раскрывать информацию через аккредитованное информационное агентство.
                </div>
            </div>
        }

        @if (_contractors.Count == 0 && !_showAddForm)
        {
            <div class="card">
                <div class="card-body text-center py-5">
                    <h5 class="text-muted">Договоры не заключены</h5>
                    <p class="text-muted">Добавьте договор с регистратором и (при необходимости) информационным агентством</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var c in _contractors)
            {
                <div class="card mb-3 @(c.IsActive ? "" : "border-secondary opacity-75")">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@c.ContractorName</strong>
                            <span class="badge bg-secondary ms-2">ИНН @c.ContractorInn</span>
                            <span class="badge @(c.ContractorType == "REGISTRAR" ? "bg-primary" : "bg-info") ms-1">
                                @(c.ContractorType == "REGISTRAR" ? "Регистратор" : "Информ. агентство")
                            </span>
                            @if (_legalEntityName is not null)
                            {
                                <span class="text-muted ms-2">
                                    @(c.ContractorType == "REGISTRAR" ? "Эмитент" : "Заказчик"): @_legalEntityName
                                </span>
                            }
                            @if (!c.IsActive)
                            {
                                <span class="badge bg-warning ms-2">Не действует</span>
                            }
                        </div>
                        <div>
                            @if (c.CbrStatus == "Active")
                            {
                                <span class="badge bg-success">Действующая</span>
                            }
                            else if (!string.IsNullOrEmpty(c.CbrStatus))
                            {
                                <span class="badge bg-danger">@c.CbrStatus</span>
                            }
                            @if (_isLawyer)
                            {
                                <button class="btn btn-sm btn-outline-info ms-2"
                                        @onclick="() => CheckCbrStatus(c)"
                                        disabled="@(_checkingCbrId == c.Id)">
                                    @if (_checkingCbrId == c.Id)
                                    {
                                        <span class="spinner-border spinner-border-sm"></span>
                                    }
                                    else
                                    {
                                        <span>ЦБР</span>
                                    }
                                </button>
                                <button class="btn btn-sm btn-outline-primary ms-2"
                                        @onclick="@(() => Navigation.NavigateTo($"/contracts/{c.Id}"))">Редактировать</button>
                            }
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6>Договор</h6>
                                <table class="table table-sm table-borderless mb-3">
                                    <tr><td class="text-muted" style="width:200px">Номер:</td><td>@(c.ContractNumber ?? "—")</td></tr>
                                    <tr><td class="text-muted">Дата:</td><td>@(c.ContractDate ?? "—")</td></tr>
                                    <tr><td class="text-muted">Начало:</td><td>@(c.ContractValidFrom ?? "—")</td></tr>
                                    <tr>
                                        <td class="text-muted">Срок:</td>
                                        <td>
                                            @if (c.IsIndefinite)
                                            {
                                                <span>Бессрочный</span>
                                            }
                                            else
                                            {
                                                <span>@(c.ContractValidFrom ?? "—") — @(c.ContractValidTo ?? "—")</span>
                                                <span class="badge bg-secondary ms-1">пролонгация</span>
                                            }
                                        </td>
                                    </tr>
                                    @if (c.ContractDocumentId.HasValue)
                                    {
                                        <tr>
                                            <td class="text-muted">Файл:</td>
                                            <td>
                                                <a href="/api/files/@c.ContractDocumentId/download" target="_blank"
                                                   class="btn btn-sm btn-outline-secondary">
                                                    📄 @(c.ContractDocumentName ?? "Скачать")
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </table>
                            </div>
                            @if (c.ContractorType == "REGISTRAR")
                            {
                                <div class="col-md-6">
                                    <h6>Сроки подготовки реестров</h6>
                                    <table class="table table-sm table-borderless mb-3">
                                        <tr>
                                            <td class="text-muted" style="width:300px">Реестр акционеров:</td>
                                            <td>@(c.RegistryPreparationDays?.ToString() ?? "—") @(FormatUnit(c.RegistryPreparationUnit))</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Реестр для дивидендов:</td>
                                            <td>@(c.DividendRegistryPreparationDays?.ToString() ?? "—") @(FormatUnit(c.DividendRegistryPreparationUnit))</td>
                                        </tr>
                                    </table>
                                    @if (!string.IsNullOrEmpty(c.RegistryRulesUrl) || c.RegistryRulesDocumentId.HasValue)
                                    {
                                        <h6>Правила ведения реестра</h6>
                                        @if (c.RegistryRulesDocumentId.HasValue)
                                        {
                                            <a href="/api/files/@c.RegistryRulesDocumentId/download" target="_blank"
                                               class="btn btn-sm btn-outline-secondary me-2">
                                                📄 @(c.RegistryRulesDocumentName ?? "Скачать файл")
                                            </a>
                                        }
                                        @if (!string.IsNullOrEmpty(c.RegistryRulesUrl))
                                        {
                                            <a href="@c.RegistryRulesUrl" target="_blank"
                                               class="btn btn-sm btn-outline-info">
                                                🌐 Открыть ссылку
                                            </a>
                                        }
                                    }
                                </div>
                            }
                        </div>

                        @if (c.Licenses.Any())
                        {
                            <h6>Лицензии ЦБ РФ</h6>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Номер</th>
                                        <th>Наименование</th>
                                        <th>Дата начала</th>
                                        <th>Дата окончания</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var lic in c.Licenses)
                                    {
                                        <tr>
                                            <td>@lic.Number</td>
                                            <td>@lic.ActivityName</td>
                                            <td>@lic.StartDate</td>
                                            <td>
                                                @lic.EndDate
                                                @if (DateTime.TryParse(lic.EndDate, out var endDate) && endDate < DateTime.UtcNow)
                                                {
                                                    <span class="badge bg-danger ms-1">Истекла</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        @if (c.CbrFetchedAt.HasValue)
                        {
                            <div class="text-muted small">Данные ЦБ обновлены: @c.CbrFetchedAt.Value.ToString("dd.MM.yyyy HH:mm")</div>
                        }
                    </div>
                </div>
            }
        }
    }
</div>

@code {
    /// <summary>Минимальная длина ИНН юридического лица (10 цифр).</summary>
    private const int MinInnLength = 10;

    /// <summary>Максимальный размер загружаемого файла: 50 МБ (50 * 1024 * 1024).</summary>
    private const long MaxFileSizeBytes = 52_428_800;

    private bool _loading = true;
    private bool _isLawyer;
    private bool _isPjsc;
    private List<ContractorView> _contractors = new();
    private string? _globalError;
    private string? _legalEntityName;

    // ── Добавление ──
    private bool _showAddForm;
    private int _addStep;
    private bool _saving;
    private string? _formError;
    private string? _jwtToken;

    // Шаг 1: поиск
    private string? _formInn;
    private bool _diagnosing;

    // Шаг 2: диагностика
    private DiagnosisResult? _diagnosis;
    private string? _formContractorType;
    private string? _autoDetectedType;

    // Шаг 3: реквизиты договора
    private string _formIsIndefinite = "true";
    private DateOnly? _formContractDate;
    private DateOnly? _formValidFrom;
    private DateOnly? _formValidTo;
    private string? _formContractNumber;
    private Guid? _formDocumentId;
    private string? _formDocumentName;
    private int? _formRegistryPrepDays;
    private string? _formRegistryPrepUnit;
    private int? _formDividendRegPrepDays;
    private string? _formDividendRegPrepUnit;
    private string? _formRegistryRulesUrl;
    private Guid? _formRulesDocumentId;
    private string? _formRulesDocumentName;

    // Проверка ЦБР
    private Guid? _checkingCbrId;

    protected override async Task OnInitializedAsync()
    {
        _jwtToken = HttpContextAccessor.HttpContext?.Request.Cookies["SessionToken"];

        var role = await JS.InvokeAsync<string>("localStorage.getItem", "currentUserRole");
        _isLawyer = role?.Contains("LAWYER", StringComparison.OrdinalIgnoreCase) == true;

        // Определяем ОКОПФ текущего ЮЛ
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var workplace = await ctx.CurrentWorkplaces.FirstOrDefaultAsync();
            var leId = workplace?.LastSelectedLegalEntityId;
            if (leId is not null && leId != Guid.Empty)
            {
                var le = await ctx.LegalEntities
                    .Where(x => x.Id == leId.Value)
                    .Select(x => new { x.RefOkopf!.Code, x.ShortName })
                    .FirstOrDefaultAsync();
                _isPjsc = OkopfTypeMapper.IsPjsc(le?.Code);
                _legalEntityName = le?.ShortName;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка определения ОКОПФ текущего ЮЛ");
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var response = await Http.GetAsync("/api/ao-contractors");
            if (response.IsSuccessStatusCode)
            {
                _contractors = await response.Content.ReadFromJsonAsync<List<ContractorView>>() ?? new();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка загрузки договоров");
        }
        finally
        {
            _loading = false;
        }

        _hasRegistrar = _contractors.Any(c => c.ContractorType == "REGISTRAR" && c.IsActive);
        _hasInfoAgency = _contractors.Any(c => c.ContractorType == "INFO_AGENCY" && c.IsActive);
    }

    private bool _hasRegistrar;
    private bool _hasInfoAgency;

    // ── Форма добавления ──

    private void ShowAddForm()
    {
        _showAddForm = true;
        _addStep = 1;
        _formInn = null;
        _diagnosis = null;
        _formContractorType = null;
        _autoDetectedType = null;
        _formError = null;
        ResetFormFields();
    }

    private void CloseAddForm()
    {
        _showAddForm = false;
        _addStep = 0;
        _formError = null;
    }

    private void ResetAddForm()
    {
        _addStep = 1;
        _formInn = null;
        _diagnosis = null;
        _formContractorType = null;
        _autoDetectedType = null;
        _formError = null;
    }

    private void ResetFormFields()
    {
        _formIsIndefinite = "true";
        _formContractDate = null;
        _formValidFrom = null;
        _formValidTo = null;
        _formContractNumber = null;
        _formDocumentId = null;
        _formDocumentName = null;
        _formRegistryPrepDays = null;
        _formRegistryPrepUnit = null;
        _formDividendRegPrepDays = null;
        _formDividendRegPrepUnit = null;
        _formRegistryRulesUrl = null;
        _formRulesDocumentId = null;
        _formRulesDocumentName = null;
    }

    // ── Диагностика ИНН ──

    private async Task DiagnoseInn()
    {
        if (string.IsNullOrWhiteSpace(_formInn) || _formInn.Trim().Length < MinInnLength) return;

        _diagnosing = true;
        _formError = null;
        StateHasChanged();

        try
        {
            var inn = _formInn.Trim();
            var response = await Http.GetAsync($"/api/ao-contractors/diagnose?inn={inn}");
            if (response.IsSuccessStatusCode)
            {
                _diagnosis = await response.Content.ReadFromJsonAsync<DiagnosisResult>();
                if (_diagnosis is not null)
                {
                    // Автоопределение типа
                    if (_diagnosis.IsRegistrar && !_diagnosis.IsInfoAgency)
                    {
                        _formContractorType = "REGISTRAR";
                        _autoDetectedType = "Регистратор (VidID=4)";
                    }
                    else if (_diagnosis.IsInfoAgency && !_diagnosis.IsRegistrar)
                    {
                        _formContractorType = "INFO_AGENCY";
                        _autoDetectedType = "Информационное агентство (FoType=IA)";
                    }
                    else
                    {
                        _formContractorType = null;
                        _autoDetectedType = null;
                    }

                    _addStep = 2;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка диагностики ИНН={Inn}", _formInn);
            _formError = $"Ошибка: {ex.Message}";
        }
        finally
        {
            _diagnosing = false;
            StateHasChanged();
        }
    }

    private void GoToStep3()
    {
        if (string.IsNullOrEmpty(_formContractorType))
        {
            _formError = "Выберите тип договора";
            return;
        }
        _formError = null;
        _addStep = 3;
    }

    // ── FileUpload callbacks ──

    private void OnContractFileUploaded((Guid FileId, string OriginalName) info)
    {
        _formDocumentId = info.FileId;
        _formDocumentName = info.OriginalName;
    }

    private void OnRulesFileUploaded((Guid FileId, string OriginalName) info)
    {
        _formRulesDocumentId = info.FileId;
        _formRulesDocumentName = info.OriginalName;
    }

    // ── Сохранение нового договора ──

    private async Task SaveNewContract()
    {
        if (string.IsNullOrEmpty(_formContractorType))
        {
            _formError = "Выберите тип договора";
            return;
        }

        _saving = true;
        _formError = null;

        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(_formInn!.Trim()), "contractorInn");
            content.Add(new StringContent(_diagnosis?.CompanyName ?? _formInn!.Trim()), "contractorName");
            content.Add(new StringContent(_formContractorType), "contractorType");
            content.Add(new StringContent(_formIsIndefinite), "isIndefinite");
            if (_formContractNumber is not null) content.Add(new StringContent(_formContractNumber), "contractNumber");
            if (_formContractDate.HasValue) content.Add(new StringContent(_formContractDate.Value.ToString("yyyy-MM-dd")), "contractDate");
            if (_formValidFrom.HasValue) content.Add(new StringContent(_formValidFrom.Value.ToString("yyyy-MM-dd")), "contractValidFrom");
            if (_formValidTo.HasValue) content.Add(new StringContent(_formValidTo.Value.ToString("yyyy-MM-dd")), "contractValidTo");
            if (_formContractorType == "REGISTRAR")
            {
                if (_formRegistryPrepDays.HasValue) content.Add(new StringContent(_formRegistryPrepDays.Value.ToString()), "registryPreparationDays");
                if (_formRegistryPrepUnit is not null) content.Add(new StringContent(_formRegistryPrepUnit), "registryPreparationUnit");
                if (_formDividendRegPrepDays.HasValue) content.Add(new StringContent(_formDividendRegPrepDays.Value.ToString()), "dividendRegistryPreparationDays");
                if (_formDividendRegPrepUnit is not null) content.Add(new StringContent(_formDividendRegPrepUnit), "dividendRegistryPreparationUnit");
                if (_formRegistryRulesUrl is not null) content.Add(new StringContent(_formRegistryRulesUrl), "registryRulesUrl");
            }

            var response = await Http.PostAsync("/api/ao-contractors", content);

            if (response.IsSuccessStatusCode)
            {
                _showAddForm = false;
                _addStep = 0;
                await LoadData();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _formError = $"Ошибка: {error}";
            }
        }
        catch (Exception ex)
        {
            _formError = $"Ошибка: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    // ── Проверка ЦБР ──

    private async Task CheckCbrStatus(ContractorView contractor)
    {
        _checkingCbrId = contractor.Id;
        StateHasChanged();

        try
        {
            var response = await Http.GetAsync($"/api/ao-contractors/check-cbr?inn={contractor.ContractorInn}");
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<CbrCheckResult>();
                if (result is not null && result.Warning is null)
                {
                    var idx = _contractors.FindIndex(c => c.Id == contractor.Id);
                    if (idx >= 0)
                    {
                        _contractors[idx].CbrStatus = result.Status;
                        _contractors[idx].Licenses = result.Licenses?.ToList() ?? new();
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка проверки ЦБР для ИНН={Inn}", contractor.ContractorInn);
        }
        finally
        {
            _checkingCbrId = null;
            StateHasChanged();
        }
    }

    private static string FormatUnit(string? unit) => unit switch
    {
        "CALENDAR" => "календ. дн.",
        "BUSINESS" => "раб. дн.",
        _ => ""
    };

