@page "/agenda-osu"
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject ILogger<AgendaOsu> Logger
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Fiducia — Повестка ОСУ</PageTitle>

<h3>Повестка ОСУ</h3>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_loading)
{
    <div class="text-center py-4">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else
{
    @* ── Фильтр ────────────────────────────────────────────────────── *@
    <div class="mb-3">
        <select class="form-select form-select-sm" @bind="_filterStatus" style="width: auto;">
            <option value="">Все статусы</option>
            <option value="PENDING">Ожидает рассмотрения</option>
            <option value="ACCEPTED">Принято</option>
            <option value="REJECTED">Отклонено</option>
        </select>
    </div>

    @if (_items.Count == 0)
    {
        <div class="alert alert-info">Нет пунктов повестки ОСУ</div>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Причина</th>
                    <th>Статус</th>
                    <th>Дата</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _filteredItems)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.Reason</td>
                        <td>@GetStatusBadge(item.Status)</td>
                        <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="d-flex gap-1">
                            @if (item.Status == "PENDING")
                            {
                                <button class="btn btn-sm btn-success" @onclick="() => AcceptItem(item.Id)">Принять</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RejectItem(item.Id)">Отказ</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private List<AgendaItemDto> _items = new();
    private List<AgendaItemDto> _filteredItems => string.IsNullOrEmpty(_filterStatus)
        ? _items
        : _items.Where(x => x.Status == _filterStatus).ToList();
    private string? _filterStatus;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _items = await Http.GetFromJsonAsync<List<AgendaItemDto>>("/api/agenda-items?targetType=OSA") ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки повестки ОСУ");
            _error = "Ошибка загрузки данных";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AcceptItem(Guid id)
    {
        try
        {
            var response = await Http.PostAsJsonAsync($"/api/agenda-items/{id}/accept", new { });
            if (response.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/agenda-osu", forceLoad: true);
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                _error = $"Ошибка принятия: {body}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка принятия пункта повестки {Id}", id);
            _error = "Ошибка принятия пункта повестки";
        }
    }

    private async Task RejectItem(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            "Отклонить этот пункт повестки?");
        if (!confirmed) return;

        try
        {
            var response = await Http.PostAsJsonAsync($"/api/agenda-items/{id}/reject", new { });
            if (response.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/agenda-osu", forceLoad: true);
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                _error = $"Ошибка отклонения: {body}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка отклонения пункта повестки {Id}", id);
            _error = "Ошибка отклонения пункта повестки";
        }
    }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private static MarkupString GetStatusBadge(string status) => status switch
    {
        "PENDING" => new("<span class='badge bg-warning'>Ожидает</span>"),
        "ACCEPTED" => new("<span class='badge bg-success'>Принято</span>"),
        "REJECTED" => new("<span class='badge bg-danger'>Отклонено</span>"),
        _ => new($"<span class='badge bg-secondary'>{status}</span>")
    };

    private record AgendaItemDto(Guid Id, string Title, string TargetType, string Reason, string Status, Guid? ShareRequestId, DateTime CreatedAt);
}
