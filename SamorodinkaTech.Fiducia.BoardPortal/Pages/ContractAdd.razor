@page "/contracts/add"
@using System.Net.Http.Json
@using Microsoft.EntityFrameworkCore
@using SamorodinkaTech.Fiducia.Domain.Entities
@using SamorodinkaTech.Fiducia.Domain.Enums
@using SamorodinkaTech.Fiducia.Domain.Validation
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@inject ILogger<ContractAdd> Logger
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IHttpContextAccessor HttpContextAccessor
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Fiducia — Новый договор</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Новый договор</h3>
        <button class="btn btn-outline-secondary" @onclick='() => Navigation.NavigateTo("/contracts")'>← К списку</button>
    </div>

    @if (!string.IsNullOrEmpty(_formError))
    {
        <div class="alert alert-danger">@_formError</div>
    }

    @* ═══════════════════════════════════════════════════════════════════ *@
    @* Шаг 1: Поиск контрагента                                          *@
    @* ═══════════════════════════════════════════════════════════════════ *@

    @if (_addStep == 1)
    {
        <div class="card mb-4">
            <div class="card-header"><h5 class="mb-0">Шаг 1. Поиск контрагента</h5></div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Наименование / ИНН / ОГРН</label>
                    <div class="input-group">
                        <input class="form-control" value="@_searchQuery" @oninput="OnSearchInput"
                               placeholder="Введите ИНН, наименование или ОГРН" />
                        <button class="btn btn-outline-primary" type="button"
                                @onclick="LoadFromSpark" disabled="@(_searchingSpark || _searchQuery?.Trim().Length < MinSearchLength)">
                            @if (_searchingSpark)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else
                            {
                                <span>СПАРК</span>
                            }
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(_sparkWarning))
                    {
                        <div class="text-warning small mt-1">@_sparkWarning</div>
                    }
                </div>

                @if (_searchResults?.Any() == true)
                {
                    <table class="table table-sm table-hover">
                        <thead>
                            <tr>
                                <th>Наименование</th>
                                <th>ИНН</th>
                                <th>ОКОПФ / Тип</th>
                                <th>Статус</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in _searchResults)
                            {
                                <tr style="cursor:pointer" @onclick="() => SelectCompany(c)">
                                    <td>@c.ShortName</td>
                                    <td>@c.Inn</td>
                                    <td>@(c.OkopfCode ?? c.FoTypes)</td>
                                    <td>@c.Status</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="text-muted small">Показано до @MaxSearchResults записей</div>
                }
            </div>
        </div>
    }

    @* ═══════════════════════════════════════════════════════════════════ *@
    @* Шаг 2: Диагностика                                                *@
    @* ═══════════════════════════════════════════════════════════════════ *@

    @if (_addStep == 2 && _diagnosis is not null)
    {
        <div class="card mb-4">
            <div class="card-header"><h5 class="mb-0">Шаг 2. Результат диагностики</h5></div>
            <div class="card-body">
                <div class="card bg-light mb-3">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <strong>@(_diagnosis.CompanyName ?? "Неизвестно")</strong>
                                <br />
                                <span class="text-muted">ИНН: @_diagnosis.Inn</span>
                                @if (!string.IsNullOrEmpty(_diagnosis.OkopfCode))
                                {
                                    <span class="badge bg-secondary ms-2">ОКОПФ @_diagnosis.OkopfCode</span>
                                }
                            </div>
                            <div class="col-md-6 text-end">
                                @if (_diagnosis.Status == "Действующее")
                                {
                                    <span class="badge bg-success">Действующее</span>
                                }
                                else if (!string.IsNullOrEmpty(_diagnosis.Status))
                                {
                                    <span class="badge bg-warning">@_diagnosis.Status</span>
                                }
                                @if (_diagnosis.IsRegistrar)
                                {
                                    <span class="badge bg-info ms-1">Регистратор (VidID=4)</span>
                                }
                                @if (_diagnosis.IsInfoAgency)
                                {
                                    <span class="badge bg-info ms-1">Информационное агентство (IA)</span>
                                }
                            </div>
                        </div>

                        @if (_diagnosis.CbrStatus is not null)
                        {
                            <hr />
                            <div class="small">
                                <span class="text-muted">Статус ЦБР:</span>
                                @if (_diagnosis.CbrStatus == "Active")
                                {
                                    <span class="badge bg-success ms-1">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary ms-1">@_diagnosis.CbrStatus</span>
                                }
                            </div>
                        }

                        @if (_diagnosis.Licenses?.Any() == true)
                        {
                            <table class="table table-sm mt-2 mb-0">
                                <thead>
                                    <tr><th>VidID</th><th>Наименование</th><th>Номер</th><th>Действует до</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var lic in _diagnosis.Licenses)
                                    {
                                        <tr>
                                            <td>@lic.VidId</td>
                                            <td>@lic.ActivityName</td>
                                            <td>@lic.Number</td>
                                            <td>
                                                @lic.EndDate
                                                @if (DateTime.TryParse(lic.EndDate, out var endDate) && endDate < DateTime.UtcNow)
                                                {
                                                    <span class="badge bg-danger ms-1">Истекла</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        @if (_diagnosis.Warnings?.Any() == true)
                        {
                            <div class="mt-2">
                                @foreach (var w in _diagnosis.Warnings)
                                {
                                    <div class="text-warning small">⚠ @w</div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Тип договора</label>
                    <div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="contractorType"
                                   id="typeRegistrar" value="REGISTRAR"
                                   checked="@(_formContractorType == "REGISTRAR")"
                                   @onchange='() => _formContractorType = "REGISTRAR"' />
                            <label class="form-check-label" for="typeRegistrar">Регистратор</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="contractorType"
                                   id="typeInfoAgency" value="INFO_AGENCY"
                                   checked="@(_formContractorType == "INFO_AGENCY")"
                                   @onchange='() => _formContractorType = "INFO_AGENCY"' />
                            <label class="form-check-label" for="typeInfoAgency">Информационное агентство</label>
                        </div>
                    </div>
                    @if (_autoDetectedType is not null)
                    {
                        <div class="form-text">Автоопределён: @_autoDetectedType</div>
                    }
                </div>

                <button class="btn btn-primary" @onclick="GoToStep3"
                        disabled="@string.IsNullOrEmpty(_formContractorType)">
                    Далее — реквизиты договора
                </button>
                <button class="btn btn-outline-secondary ms-2" @onclick="ResetToStep1">Назад к поиску</button>
            </div>
        </div>
    }

    @* ═══════════════════════════════════════════════════════════════════ *@
    @* Шаг 3: Реквизиты договора                                         *@
    @* ═══════════════════════════════════════════════════════════════════ *@

    @if (_addStep == 3)
    {
        <div class="card mb-4">
            <div class="card-header"><h5 class="mb-0">Шаг 3. Реквизиты договора</h5></div>
            <div class="card-body">
                <div class="card bg-light mb-3">
                    <div class="card-body py-2">
                        <strong>@(_diagnosis?.CompanyName ?? _formInn)</strong>
                        <span class="badge bg-secondary ms-2">ИНН @_formInn</span>
                        <span class="badge @( _formContractorType == "REGISTRAR" ? "bg-primary" : "bg-info") ms-1">
                            @(_formContractorType == "REGISTRAR" ? "Регистратор" : "Информационное агентство")
                        </span>
                    </div>
                </div>

                @* Срок договора *@
                <div class="mb-3">
                    <label class="form-label">Срок договора</label>
                    <div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="termType"
                                   id="termIndefinite" value="true"
                                   checked="@(_formIsIndefinite == "true")"
                                   @onchange='() => _formIsIndefinite = "true"' />
                            <label class="form-check-label" for="termIndefinite">Бессрочный</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="termType"
                                   id="termFixed" value="false"
                                   checked="@(_formIsIndefinite == "false")"
                                   @onchange='() => _formIsIndefinite = "false"' />
                            <label class="form-check-label" for="termFixed">Срочный с автоматической пролонгацией</label>
                        </div>
                    </div>
                </div>

                <div class="row">
                    @if (_formIsIndefinite == "true")
                    {
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Дата заключения</label>
                            <input type="date" class="form-control" @bind="_formContractDate" />
                        </div>
                    }
                    else
                    {
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Дата заключения</label>
                            <input type="date" class="form-control" @bind="_formContractDate" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Начало действия</label>
                            <input type="date" class="form-control" @bind="_formValidFrom" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Окончание действия</label>
                            <input type="date" class="form-control" @bind="_formValidTo" />
                            <div class="form-text">Автоматическая пролонгация</div>
                        </div>
                    }
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Номер договора</label>
                        <input type="text" class="form-control" @bind="_formContractNumber" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Файл договора</label>
                    @if (_formDocumentId.HasValue)
                    {
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <a href="/api/files/@_formDocumentId/download" target="_blank"
                               class="btn btn-sm btn-outline-secondary">📄 @_formDocumentName</a>
                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => { _formDocumentId = null; _formDocumentName = null; }">Заменить</button>
                        </div>
                    }
                    else
                    {
                        <FileUpload Accept=".pdf,.doc,.docx"
                                    MaxSizeBytes="@MaxFileSizeBytes"
                                    FileType="CONTRACT"
                                    Token="@_jwtToken"
                                    OnFileUploadedInfo="OnContractFileUploaded" />
                    }
                </div>

                @* Поля только для Регистратора *@
                @if (_formContractorType == "REGISTRAR")
                {
                    <hr />
                    <h6>Сроки подготовки реестров</h6>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Реестр акционеров (дни)</label>
                            <input type="number" class="form-control" @bind="_formRegistryPrepDays" min="0" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Единица измерения</label>
                            <select class="form-select" @bind="_formRegistryPrepUnit">
                                <option value="">Не указано</option>
                                <option value="CALENDAR">Календарный день</option>
                                <option value="BUSINESS">Рабочий день</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Реестр для дивидендов (дни)</label>
                            <input type="number" class="form-control" @bind="_formDividendRegPrepDays" min="0" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Единица измерения</label>
                            <select class="form-select" @bind="_formDividendRegPrepUnit">
                                <option value="">Не указано</option>
                                <option value="CALENDAR">Календарный день</option>
                                <option value="BUSINESS">Рабочий день</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">URL Правил ведения реестра</label>
                        <input type="url" class="form-control" @bind="_formRegistryRulesUrl" placeholder="https://..." />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Файл Правил ведения реестра</label>
                        @if (_formRulesDocumentId.HasValue)
                        {
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <a href="/api/files/@_formRulesDocumentId/download" target="_blank"
                                   class="btn btn-sm btn-outline-secondary">📄 @_formRulesDocumentName</a>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => { _formRulesDocumentId = null; _formRulesDocumentName = null; }">Заменить</button>
                            </div>
                        }
                        else
                        {
                            <FileUpload Accept=".pdf,.doc,.docx"
                                        MaxSizeBytes="@MaxFileSizeBytes"
                                        FileType="REGISTRY_RULES"
                                        Token="@_jwtToken"
                                        OnFileUploadedInfo="OnRulesFileUploaded" />
                        }
                    </div>
                }
            </div>
            <div class="card-footer">
                <button type="button" class="btn btn-secondary me-2" @onclick="() => _addStep = 2">← Назад</button>
                <button type="button" class="btn btn-primary" @onclick="SaveNewContract" disabled="@_saving">
                    @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Создать договор
                </button>
            </div>
        </div>
    }
</div>

@code {
    /// <summary>Минимальная длина запроса для поиска в локальной БД.</summary>
    private const int MinSearchLength = 2;

    /// <summary>Минимальная длина ИНН юридического лица (10 цифр).</summary>
    private const int MinInnLength = 10;

    /// <summary>Максимальный размер загружаемого файла: 50 МБ.</summary>
    private const long MaxFileSizeBytes = 52_428_800;

    /// <summary>Максимальное количество результатов поиска.</summary>
    private const int MaxSearchResults = 10;

    // ── Шаг 1: поиск ──
    private int _addStep = 1;
    private string _searchQuery = "";
    private List<SearchCompanyResult>? _searchResults;
    private bool _searchingSpark;
    private string? _sparkWarning;
    private string? _formInn;
    private string? _formError;

    // ── Шаг 2: диагностика ──
    private DiagnosisResult? _diagnosis;
    private string? _formContractorType;
    private string? _autoDetectedType;

    // ── Шаг 3: реквизиты договора ──
    private string _formIsIndefinite = "true";
    private DateOnly? _formContractDate;
    private DateOnly? _formValidFrom;
    private DateOnly? _formValidTo;
    private string? _formContractNumber;
    private Guid? _formDocumentId;
    private string? _formDocumentName;
    private int? _formRegistryPrepDays;
    private string? _formRegistryPrepUnit;
    private int? _formDividendRegPrepDays;
    private string? _formDividendRegPrepUnit;
    private string? _formRegistryRulesUrl;
    private Guid? _formRulesDocumentId;
    private string? _formRulesDocumentName;

    // ── Прочее ──
    private string? _jwtToken;
    private bool _saving;

    protected override void OnInitialized()
    {
        _jwtToken = HttpContextAccessor.HttpContext?.Request.Cookies["SessionToken"];
    }

    // ═════════════════════════════════════════════════════════════════════
    // Поиск контрагента
    // ═════════════════════════════════════════════════════════════════════

    /// <summary>Обработка ввода в поле поиска — поиск по локальной БД.</summary>
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(_searchQuery) || _searchQuery.Trim().Length < MinSearchLength)
        {
            _searchResults = null;
            return;
        }

        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var q = _searchQuery.Trim();

            // Ищем в ext_spark_company
            var sparkResults = await ctx.ExtSparkCompanies
                .Where(c =>
                    (c.FullName != null && EF.Functions.ILike(c.FullName, $"%{q}%")) ||
                    (c.ShortName != null && EF.Functions.ILike(c.ShortName, $"%{q}%")) ||
                    (c.Inn != null && EF.Functions.ILike(c.Inn, $"%{q}%")) ||
                    (c.Ogrn != null && EF.Functions.ILike(c.Ogrn, $"%{q}%")))
                .OrderBy(c => c.FullName)
                .Take(MaxSearchResults)
                .Select(c => new SearchCompanyResult
                {
                    Inn = c.Inn ?? "",
                    FullName = c.FullName,
                    ShortName = c.ShortName,
                    OkopfCode = c.OkopfCode,
                    FoTypes = null,
                    Status = c.Status
                })
                .ToListAsync();

            // Ищем в ext_cbr_finorg_organization (регистраторы PT, ИА IA)
            var cbrResults = await ctx.ExtCbrFinOrgOrganizations
                .Where(c =>
                    c.FoTypes != null && (c.FoTypes.Contains("PT") || c.FoTypes.Contains("IA")) &&
                    ((c.FullName != null && EF.Functions.ILike(c.FullName, $"%{q}%")) ||
                     (c.ShortName != null && EF.Functions.ILike(c.ShortName, $"%{q}%")) ||
                     (c.Inn != null && EF.Functions.ILike(c.Inn, $"%{q}%"))))
                .OrderBy(c => c.FullName)
                .Take(MaxSearchResults)
                .Select(c => new SearchCompanyResult
                {
                    Inn = c.Inn ?? "",
                    FullName = c.FullName,
                    ShortName = c.ShortName,
                    OkopfCode = null,
                    FoTypes = c.FoTypes,
                    Status = c.Status
                })
                .ToListAsync();

            // Объединяем, убирая дубли по ИНН
            _searchResults = sparkResults
                .Concat(cbrResults)
                .GroupBy(c => c.Inn)
                .Select(g => g.First())
                .Take(MaxSearchResults)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка поиска контрагента по запросу '{Query}'", _searchQuery);
            _searchResults = null;
        }
    }

    /// <summary>Поиск компании в СПАРК по ИНН из строки ввода.</summary>
    private async Task LoadFromSpark()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery) || _searchQuery.Trim().Length < MinInnLength) return;

        _searchingSpark = true;
        _sparkWarning = null;
        StateHasChanged();

        var inn = _searchQuery.Trim();
        var requestUrl = $"/api/ao-contractors/search-spark?inn={inn}";

        try
        {
            var http = Http;
            var response = await http.GetAsync(requestUrl);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SparkSearchResult>();
                if (result?.Warning is not null)
                {
                    _sparkWarning = result.Warning;
                }
                else if (result?.Inn is not null)
                {
                    _formInn = result.Inn;
                    await DiagnoseInn();
                }
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Logger.LogWarning("HTTP GET {Url} вернул {StatusCode}: {Body}", requestUrl, (int)response.StatusCode, body);
                _sparkWarning = $"Ошибка ({(int)response.StatusCode}) {requestUrl}: {body}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка HTTP GET {Url}", requestUrl);
            _sparkWarning = $"Ошибка {requestUrl}: {ex.Message}";
        }
        finally
        {
            _searchingSpark = false;
            StateHasChanged();
        }
    }

    /// <summary>Выбор контрагента из результатов поиска — переход к диагностике.</summary>
    private async Task SelectCompany(SearchCompanyResult company)
    {
        _formInn = company.Inn;
        _searchResults = null;
        _searchQuery = "";
        await DiagnoseInn();
    }

    // ═════════════════════════════════════════════════════════════════════
    // Диагностика
    // ═════════════════════════════════════════════════════════════════════

    /// <summary>Диагностика ИНН: проверка СПАРК + ЦБР + определение типа контрагента.</summary>
    private async Task DiagnoseInn()
    {
        if (string.IsNullOrWhiteSpace(_formInn) || _formInn.Trim().Length < MinInnLength) return;

        _formError = null;
        StateHasChanged();

        var inn = _formInn.Trim();
        var requestUrl = $"/api/ao-contractors/diagnose?inn={inn}";

        try
        {
            var http = Http;
            var fullUrl = new Uri(http.BaseAddress!, requestUrl.TrimStart('/'));
            Logger.LogDebug("Диагностика: GET {Url}, токен={HasToken}", fullUrl, !string.IsNullOrEmpty(_jwtToken) ? "есть" : "ОТСУТСТВУЕТ");

            var response = await http.GetAsync(requestUrl);

            Logger.LogDebug("Диагностика: ответ {StatusCode} для ИНН={Inn}", (int)response.StatusCode, inn);

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                Logger.LogWarning("HTTP GET {Url} вернул {StatusCode}: {Body}", requestUrl, (int)response.StatusCode, body);
                _formError = $"Ошибка ({(int)response.StatusCode}) {requestUrl}: {body}";
                StateHasChanged();
                return;
            }

            _diagnosis = await response.Content.ReadFromJsonAsync<DiagnosisResult>();
            if (_diagnosis is not null)
            {
                // Автоопределение типа
                if (_diagnosis.IsRegistrar && !_diagnosis.IsInfoAgency)
                {
                    _formContractorType = "REGISTRAR";
                    _autoDetectedType = "Регистратор (VidID=4)";
                }
                else if (_diagnosis.IsInfoAgency && !_diagnosis.IsRegistrar)
                {
                    _formContractorType = "INFO_AGENCY";
                    _autoDetectedType = "Информационное агентство (FoType=IA)";
                }
                else
                {
                    _formContractorType = null;
                    _autoDetectedType = null;
                }

                _addStep = 2;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка HTTP GET {Url}", requestUrl);
            _formError = $"Ошибка {requestUrl}: {ex.Message}";
        }
    }

    /// <summary>Переход к шагу 3 (реквизиты договора).</summary>
    private void GoToStep3()
    {
        if (string.IsNullOrEmpty(_formContractorType))
        {
            _formError = "Выберите тип договора";
            return;
        }
        _formError = null;
        _addStep = 3;
    }

    /// <summary>Сброс к шагу 1 (поиск).</summary>
    private void ResetToStep1()
    {
        _addStep = 1;
        _formInn = null;
        _diagnosis = null;
        _formContractorType = null;
        _autoDetectedType = null;
        _formError = null;
    }

