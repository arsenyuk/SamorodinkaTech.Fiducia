@page "/contracts/add"
@using System.Net.Http.Json
@using Microsoft.EntityFrameworkCore
@using SamorodinkaTech.Fiducia.Domain.Entities
@using SamorodinkaTech.Fiducia.Domain.Enums
@using SamorodinkaTech.Fiducia.Domain.Validation
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@inject ILogger<ContractAdd> Logger
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IHttpContextAccessor HttpContextAccessor
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Fiducia — Новый договор</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Новый договор</h3>
        <button class="btn btn-outline-secondary" @onclick='() => Navigation.NavigateTo("/contracts")'>← К списку</button>
    </div>

    @if (!string.IsNullOrEmpty(_formError))
    {
        <div class="alert alert-danger">@_formError</div>
    }

    @* ═══════════════════════════════════════════════════════════════════ *@
    @* Шаг 1: Выбор типа договора + поиск контрагента                     *@
    @* ═══════════════════════════════════════════════════════════════════ *@

    @if (_addStep == 1)
    {
        <div class="card mb-4">
            <div class="card-header"><h5 class="mb-0">Шаг 1. Тип договора и поиск контрагента</h5></div>
            <div class="card-body">
                @* Выбор типа *@
                <div class="mb-3">
                    <label class="form-label">Тип договора</label>
                    <div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="contractType"
                                   id="typeRegistrar" value="REGISTRAR"
                                   checked="@(_selectedType == "REGISTRAR")"
                                   @onchange='() => OnTypeChanged("REGISTRAR")' />
                            <label class="form-check-label" for="typeRegistrar">Регистратор</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="contractType"
                                   id="typeInfoAgency" value="INFO_AGENCY"
                                   checked="@(_selectedType == "INFO_AGENCY")"
                                   @onchange='() => OnTypeChanged("INFO_AGENCY")' />
                            <label class="form-check-label" for="typeInfoAgency">Информационное агентство</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="contractType"
                                   id="typeMgmtIp" value="MANAGEMENT_IP"
                                   checked="@(_selectedType == "MANAGEMENT_IP")"
                                   @onchange='() => OnTypeChanged("MANAGEMENT_IP")' />
                            <label class="form-check-label" for="typeMgmtIp">Управляющий ИП</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="contractType"
                                   id="typeMgmtUl" value="MANAGEMENT_UL"
                                   checked="@(_selectedType == "MANAGEMENT_UL")"
                                   @onchange='() => OnTypeChanged("MANAGEMENT_UL")' />
                            <label class="form-check-label" for="typeMgmtUl">Управляющая организация</label>
                        </div>
                    </div>
                </div>

                @* Поле поиска *@
                @if (_selectedType is not null)
                {
                    <div class="mb-3">
                        <label class="form-label">@GetSearchLabel()</label>
                        <div class="input-group">
                            <input class="form-control" @bind="_searchQuery" @bind:event="oninput"
                                   placeholder="@GetSearchPlaceholder()" />
                            <button class="btn btn-outline-primary" type="button"
                                    @onclick="SearchSpark" disabled="@(_searching || !_isSearchValid)">
                                @if (_searching)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                else
                                {
                                    <span>Проверить в СПАРК</span>
                                }
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(_validationMessage))
                        {
                            <div class="text-danger small mt-1">@_validationMessage</div>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(_sparkWarning))
                {
                    <div class="alert alert-warning">@_sparkWarning</div>
                }

                @if (_sparkResult is not null)
                {
                    <div class="alert alert-success">
                        <strong>Найдено:</strong> @_sparkResult.FullName (ИНН @_sparkResult.Inn)
                        @if (_sparkResult.IsActing)
                        {
                            <span class="badge bg-success ms-2">Действующий</span>
                        }
                        else
                        {
                            <span class="badge bg-danger ms-2">Не действующий</span>
                        }
                    </div>
                    <button class="btn btn-primary" @onclick="() => _addStep = 2">Далее →</button>
                }
            </div>
        </div>
    }

    @* ═══════════════════════════════════════════════════════════════════ *@
    @* Шаг 2: Реквизиты договора                                         *@
    @* ═══════════════════════════════════════════════════════════════════ *@

    @if (_addStep == 2)
    {
        <div class="card mb-4">
            <div class="card-header"><h5 class="mb-0">Шаг 2. Данные договора</h5></div>
            <div class="card-body">
                <div class="card bg-light mb-3">
                    <div class="card-body py-2">
                        <strong>@(_sparkResult?.FullName ?? _formInn)</strong>
                        <span class="badge bg-secondary ms-2">ИНН @_formInn</span>
                        <span class="badge @GetTypeBadgeClass(_selectedType!) ms-1">@GetTypeLabel(_selectedType!)</span>
                    </div>
                </div>

                @* Для MANAGEMENT_UL — дополнительные данные из справочника *@
                @if (_selectedType == "MANAGEMENT_UL")
                {
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Наименование управляющей организации</label>
                            <input class="form-control" @bind="_formManagerName" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">ИНН</label>
                            <input class="form-control" @bind="_formInn" readonly />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">ОГРН</label>
                            <input class="form-control" @bind="_formOgrn" readonly />
                        </div>
                    </div>
                }

                @* Для MANAGEMENT_IP — ОГРНИП *@
                @if (_selectedType == "MANAGEMENT_IP")
                {
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">ФИО управляющего</label>
                            <input class="form-control" @bind="_formManagerName" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">ИНН ИП</label>
                            <input class="form-control" @bind="_formInn" readonly />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">ОГРНИП</label>
                            <input class="form-control" @bind="_formOgrnip" />
                        </div>
                    </div>
                }

                @* Реквизиты договора *@
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label class="form-label">Номер договора</label>
                        <input class="form-control" @bind="_formContractNumber" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Дата договора</label>
                        <input type="date" class="form-control" @bind="_formContractDate" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Начало действия</label>
                        <input type="date" class="form-control" @bind="_formValidFrom" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Срок действия</label>
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" id="isIndefinite" @bind="_formIsIndefinite">
                            <label class="form-check-label" for="isIndefinite">Бессрочный</label>
                        </div>
                        @if (!_formIsIndefinite)
                        {
                            <input type="date" class="form-control mt-1" @bind="_formValidTo" />
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Файл договора</label>
                    <InputFile class="form-control" OnChange="OnFileSelected" accept=".pdf,.doc,.docx" />
                    @if (_selectedFile is not null)
                    {
                        <div class="text-muted small mt-1">Выбран: @_selectedFile.Name (@(_selectedFile.Size / 1024) КБ)</div>
                    }
                </div>

                @* Поля только для REGISTRAR *@
                @if (_selectedType == "REGISTRAR")
                {
                    <hr />
                    <h6>Сроки подготовки реестров</h6>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Реестр акционеров</label>
                            <div class="input-group">
                                <input type="number" class="form-control" @bind="_formRegistryPrepDays" min="0" />
                                <select class="form-select" @bind="_formRegistryPrepUnit" style="max-width:200px">
                                    <option value="">Ед. изм.</option>
                                    @foreach (var unit in _measurementUnits)
                                    {
                                        <option value="@unit.Code">@unit.ShortName</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Реестр для дивидендов</label>
                            <div class="input-group">
                                <input type="number" class="form-control" @bind="_formDividendRegPrepDays" min="0" />
                                <select class="form-select" @bind="_formDividendRegPrepUnit" style="max-width:200px">
                                    <option value="">Ед. изм.</option>
                                    @foreach (var unit in _measurementUnits)
                                    {
                                        <option value="@unit.Code">@unit.ShortName</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">URL Правил ведения реестра</label>
                        <input type="url" class="form-control" @bind="_formRegistryRulesUrl" placeholder="https://..." />
                    </div>
                }
            </div>
            <div class="card-footer">
                <button type="button" class="btn btn-secondary me-2" @onclick="() => _addStep = 1">← Назад</button>
                <button type="button" class="btn btn-primary" @onclick="Save" disabled="@(_saving)">
                    @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Сохранить
                </button>
            </div>
        </div>
    }
</div>

@code {
    private const int InnIpLength = 12;
    private const int OgrnipLength = 15;
    private const int InnUlLength = 10;
    private const int OgrnLength = 13;

    private int _addStep = 1;
    private string? _selectedType;
    private string _searchQuery = "";
    private bool _searching;
    private string? _formError;
    private string? _validationMessage;
    private string? _sparkWarning;
    private SparkResult? _sparkResult;

    private string _formInn = "";
    private string? _formManagerName;
    private string? _formOgrnip;
    private string? _formOgrn;
    private string? _formContractNumber;
    private DateOnly? _formContractDate;
    private DateOnly? _formValidFrom;
    private DateOnly? _formValidTo;
    private bool _formIsIndefinite = true;
    private IBrowserFile? _selectedFile;
    private bool _saving;

    private int? _formRegistryPrepDays;
    private string? _formRegistryPrepUnit;
    private int? _formDividendRegPrepDays;
    private string? _formDividendRegPrepUnit;
    private string? _formRegistryRulesUrl;

    private List<RefMeasurementUnit> _measurementUnits = new();

    private bool _isSearchValid =>
        _selectedType switch
        {
            "MANAGEMENT_IP" => _searchQuery.Length == InnIpLength || _searchQuery.Length == OgrnipLength,
            "MANAGEMENT_UL" => _searchQuery.Length == InnUlLength || _searchQuery.Length == OgrnLength,
            "REGISTRAR" or "INFO_AGENCY" => _searchQuery.Length >= InnUlLength,
            _ => false
        };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            _measurementUnits = await ctx.RefMeasurementUnits.OrderBy(x => x.SortOrder).ToListAsync();
        }
        catch { }

        var query = new Uri(Navigation.Uri).Query;
        if (query.Contains("contractType=MANAGEMENT_IP"))
            _selectedType = "MANAGEMENT_IP";
        else if (query.Contains("contractType=MANAGEMENT_UL"))
            _selectedType = "MANAGEMENT_UL";
    }

    private void OnTypeChanged(string type)
    {
        _selectedType = type;
        _searchQuery = "";
        _sparkResult = null;
        _sparkWarning = null;
        _validationMessage = null;
        StateHasChanged();
    }

    private string GetSearchLabel() => _selectedType switch
    {
        "MANAGEMENT_IP" => "ИНН ИП (12 цифр) или ОГРНИП (15 цифр)",
        "MANAGEMENT_UL" => "ИНН организации (10 цифр) или ОГРН (13 цифр)",
        _ => "ИНН контрагента (минимум 10 цифр)"
    };

    private string GetSearchPlaceholder() => _selectedType switch
    {
        "MANAGEMENT_IP" => "Введите ИНН ИП или ОГРНИП",
        "MANAGEMENT_UL" => "Введите ИНН или ОГРН организации",
        _ => "Введите ИНН"
    };

    private async Task SearchSpark()
    {
        _validationMessage = null;
        _sparkWarning = null;
        _sparkResult = null;

        var query = _searchQuery.Trim();

        // Валидация ввода
        if (_selectedType == "MANAGEMENT_IP")
        {
            if (query.Length == InnIpLength)
            {
                var (isValid, error) = InnIpValidator.Validate(query);
                if (!isValid) { _validationMessage = error; return; }
            }
            else if (query.Length == OgrnipLength)
            {
                var (isValid, error) = OgrnipValidator.Validate(query);
                if (!isValid) { _validationMessage = error; return; }
            }
            else
            {
                _validationMessage = "ИНН ИП: 12 цифр, ОГРНИП: 15 цифр";
                return;
            }
        }
        else if (_selectedType == "MANAGEMENT_UL")
        {
            if (query.Length != InnUlLength && query.Length != OgrnLength)
            {
                _validationMessage = "ИНН: 10 цифр, ОГРН: 13 цифр";
                return;
            }
        }

        _searching = true;
        StateHasChanged();

        try
        {
            var requestUrl = $"/api/contracts/search-spark?query={Uri.EscapeDataString(query)}&contractType={_selectedType}";
            var response = await Http.GetFromJsonAsync<SparkResult>(requestUrl);
            if (response is not null)
            {
                if (!string.IsNullOrEmpty(response.Warning))
                {
                    _sparkWarning = response.Warning;
                }
                else
                {
                    _sparkResult = response;
                    _formInn = response.Inn ?? query;
                    _formManagerName = response.FullName ?? response.ShortName;
                    _formOgrnip = response.Ogrn;
                    _formOgrn = response.Ogrn;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка поиска в СПАРК");
            _formError = $"Ошибка поиска: {ex.Message}";
        }
        finally
        {
            _searching = false;
            StateHasChanged();
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
    }

    private async Task Save()
    {
        _saving = true;
        _formError = null;

        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(_selectedType!), "contractType");
            content.Add(new StringContent(_formInn.Trim()), "counterpartyInn");
            content.Add(new StringContent(_formManagerName ?? _formInn.Trim()), "counterpartyName");
            content.Add(new StringContent(_formIsIndefinite ? "true" : "false"), "isIndefinite");
            if (!string.IsNullOrEmpty(_formContractNumber))
                content.Add(new StringContent(_formContractNumber), "contractNumber");
            if (_formContractDate.HasValue)
                content.Add(new StringContent(_formContractDate.Value.ToString("yyyy-MM-dd")), "contractDate");
            if (_formValidFrom.HasValue)
                content.Add(new StringContent(_formValidFrom.Value.ToString("yyyy-MM-dd")), "contractValidFrom");
            if (_formValidTo.HasValue)
                content.Add(new StringContent(_formValidTo.Value.ToString("yyyy-MM-dd")), "contractValidTo");

            // MANAGEMENT_IP: ОГРНИП
            if (_selectedType == "MANAGEMENT_IP" && !string.IsNullOrEmpty(_formOgrnip))
                content.Add(new StringContent(_formOgrnip), "managerOgrnip");

            // REGISTRAR: поля реестра
            if (_selectedType == "REGISTRAR")
            {
                if (_formRegistryPrepDays.HasValue) content.Add(new StringContent(_formRegistryPrepDays.Value.ToString()), "registryPreparationDays");
                if (!string.IsNullOrEmpty(_formRegistryPrepUnit)) content.Add(new StringContent(_formRegistryPrepUnit), "registryPreparationUnit");
                if (_formDividendRegPrepDays.HasValue) content.Add(new StringContent(_formDividendRegPrepDays.Value.ToString()), "dividendRegistryPreparationDays");
                if (!string.IsNullOrEmpty(_formDividendRegPrepUnit)) content.Add(new StringContent(_formDividendRegPrepUnit), "dividendRegistryPreparationUnit");
                if (!string.IsNullOrEmpty(_formRegistryRulesUrl)) content.Add(new StringContent(_formRegistryRulesUrl), "registryRulesUrl");
            }

            if (_selectedFile is not null)
            {
                var stream = _selectedFile.OpenReadStream(maxAllowedSize: 52_428_800);
                var fileContent = new StreamContent(stream);
                content.Add(fileContent, "file", _selectedFile.Name);
            }

            var response = await Http.PostAsync("/api/contracts", content);
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/contracts");
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                _formError = $"Ошибка сохранения: {body}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка сохранения договора");
            _formError = $"Ошибка: {ex.Message}";
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private static string GetTypeBadgeClass(string type) => type switch
    {
        "REGISTRAR" => "bg-primary",
        "INFO_AGENCY" => "bg-info",
        "MANAGEMENT_IP" => "bg-success",
        "MANAGEMENT_UL" => "bg-success",
        _ => "bg-secondary"
    };

    private static string GetTypeLabel(string type) => type switch
    {
        "REGISTRAR" => "Регистратор",
        "INFO_AGENCY" => "Информационное агентство",
        "MANAGEMENT_IP" => "Управляющий ИП",
        "MANAGEMENT_UL" => "Управляющая организация",
        _ => "Неизвестный"
    };

    private record SparkResult(
        string? Inn,
        string? FullName,
        string? ShortName,
        string? Ogrn,
        string? Status,
        bool IsActing,
        string? Warning);
}
