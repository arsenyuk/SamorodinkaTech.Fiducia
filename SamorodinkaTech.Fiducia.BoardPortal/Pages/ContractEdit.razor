@page "/contracts/{Id:guid}"
@using Microsoft.EntityFrameworkCore
@using SamorodinkaTech.Fiducia.Domain.Entities
@using SamorodinkaTech.Fiducia.Domain.Enums
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@inject HttpClient Http
@inject ILogger<ContractEdit> Logger
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Fiducia — Редактирование договора</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Редактирование договора</h3>
        <button class="btn btn-outline-secondary" @onclick='() => Navigation.NavigateTo("/contracts")'>← Назад к списку</button>
    </div>

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (_contract is null)
    {
        <div class="alert alert-danger">Договор не найден</div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_formError))
        {
            <div class="alert alert-danger">@_formError</div>
        }

        <div class="card bg-light mb-3">
            <div class="card-body py-2">
                <strong>@_contract.CounterpartyName</strong> (ИНН @_contract.CounterpartyInn)
                <span class="badge @GetTypeBadgeClass(_contract.ContractType) ms-2">@GetTypeLabel(_contract.ContractType)</span>
                @if (_legalEntityName is not null)
                {
                    <span class="text-muted ms-2">ЮЛ: @_legalEntityName</span>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                @* Для MANAGEMENT_UL *@
                @if (_contract.ContractType == "MANAGEMENT_UL")
                {
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Наименование управляющей организации</label>
                            <input class="form-control" @bind="_formManagerName" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">ИНН</label>
                            <input class="form-control" @bind="_contract.CounterpartyInn" readonly />
                        </div>
                    </div>
                }

                @* Для MANAGEMENT_IP *@
                @if (_contract.ContractType == "MANAGEMENT_IP")
                {
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">ФИО управляющего</label>
                            <input class="form-control" @bind="_formManagerName" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">ИНН ИП</label>
                            <input class="form-control" @bind="_contract.CounterpartyInn" readonly />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">ОГРНИП</label>
                            <input class="form-control" @bind="_formOgrnip" />
                        </div>
                    </div>
                }

                @* Реквизиты договора *@
                <div class="mb-3">
                    <label class="form-label">Срок действия</label>
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" id="isIndefinite" @bind="_formIsIndefinite">
                        <label class="form-check-label" for="isIndefinite">Бессрочный</label>
                    </div>
                    @if (!_formIsIndefinite)
                    {
                        <div class="row mt-2">
                            <div class="col-md-4">
                                <label class="form-label">Начало действия</label>
                                <input type="date" class="form-control" @bind="_formValidFrom" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Окончание действия</label>
                                <input type="date" class="form-control" @bind="_formValidTo" />
                            </div>
                        </div>
                    }
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Номер договора</label>
                        <input class="form-control" @bind="_formContractNumber" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Дата договора</label>
                        <input type="date" class="form-control" @bind="_formContractDate" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Файл договора</label>
                    @if (_contract.ContractDocumentId.HasValue)
                    {
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <a href="/api/files/@_contract.ContractDocumentId/download" target="_blank"
                               class="btn btn-sm btn-outline-secondary">📄 Текущий файл</a>
                        </div>
                    }
                    <InputFile class="form-control" OnChange="OnFileSelected" accept=".pdf,.doc,.docx" />
                    @if (_selectedFile is not null)
                    {
                        <div class="text-muted small mt-1">Выбран: @_selectedFile.Name (@(_selectedFile.Size / 1024) КБ)</div>
                    }
                </div>

                @* REGISTRAR: специфичные поля *@
                @if (_contract.ContractType == "REGISTRAR")
                {
                    <hr />
                    <h6>Сроки подготовки реестров</h6>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Реестр акционеров</label>
                            <div class="input-group">
                                <input type="number" class="form-control" @bind="_formRegistryPrepDays" min="0" />
                                <select class="form-select" @bind="_formRegistryPrepUnit" style="max-width:200px">
                                    <option value="">Ед. изм.</option>
                                    @foreach (var unit in _measurementUnits)
                                    {
                                        <option value="@unit.Code">@unit.ShortName</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Реестр для дивидендов</label>
                            <div class="input-group">
                                <input type="number" class="form-control" @bind="_formDividendRegPrepDays" min="0" />
                                <select class="form-select" @bind="_formDividendRegPrepUnit" style="max-width:200px">
                                    <option value="">Ед. изм.</option>
                                    @foreach (var unit in _measurementUnits)
                                    {
                                        <option value="@unit.Code">@unit.ShortName</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">URL Правил ведения реестра</label>
                        <input type="url" class="form-control" @bind="_formRegistryRulesUrl" placeholder="https://..." />
                    </div>
                }
            </div>
            <div class="card-footer">
                <button type="button" class="btn btn-secondary me-2" @onclick='() => Navigation.NavigateTo("/contracts")'>← Отмена</button>
                <button type="button" class="btn btn-primary" @onclick="Save" disabled="@(_saving)">
                    @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Сохранить
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private bool _loading = true;
    private ContractDto? _contract;
    private string? _formError;
    private bool _saving;

    private string? _formManagerName;
    private string? _formOgrnip;
    private string? _formContractNumber;
    private DateOnly? _formContractDate;
    private DateOnly? _formValidFrom;
    private DateOnly? _formValidTo;
    private bool _formIsIndefinite = true;
    private IBrowserFile? _selectedFile;

    private int? _formRegistryPrepDays;
    private string? _formRegistryPrepUnit;
    private int? _formDividendRegPrepDays;
    private string? _formDividendRegPrepUnit;
    private string? _formRegistryRulesUrl;

    private string? _legalEntityName;
    private List<RefMeasurementUnit> _measurementUnits = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var workplace = await ctx.CurrentWorkplaces.FirstOrDefaultAsync();
            var leId = workplace?.LastSelectedLegalEntityId;
            if (leId is not null && leId != Guid.Empty)
            {
                var le = await ctx.LegalEntities
                    .Where(x => x.Id == leId.Value)
                    .Select(x => new { x.ShortName })
                    .FirstOrDefaultAsync();
                _legalEntityName = le?.ShortName;
            }
            _measurementUnits = await ctx.RefMeasurementUnits.OrderBy(x => x.SortOrder).ToListAsync();
        }
        catch { }

        await LoadContract();
    }

    private async Task LoadContract()
    {
        _loading = true;
        try
        {
            var response = await Http.GetAsync($"/api/contracts/{Id}");
            if (response.IsSuccessStatusCode)
            {
                _contract = await response.Content.ReadFromJsonAsync<ContractDto>();
                if (_contract is not null)
                {
                    _formManagerName = _contract.ManagerFullName ?? _contract.CounterpartyName;
                    _formOgrnip = _contract.ManagerOgrnip;
                    _formContractNumber = _contract.ContractNumber;
                    _formIsIndefinite = _contract.IsIndefinite;
                    if (DateOnly.TryParse(_contract.ContractValidFrom, out var vf))
                        _formValidFrom = vf;
                    if (DateOnly.TryParse(_contract.ContractValidTo, out var vt))
                        _formValidTo = vt;
                    if (DateOnly.TryParse(_contract.ContractDate, out var cd))
                        _formContractDate = cd;
                    _formRegistryPrepDays = _contract.RegistryPreparationDays;
                    _formRegistryPrepUnit = _contract.RegistryPreparationUnit;
                    _formDividendRegPrepDays = _contract.DividendRegistryPreparationDays;
                    _formDividendRegPrepUnit = _contract.DividendRegistryPreparationUnit;
                    _formRegistryRulesUrl = _contract.RegistryRulesUrl;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки договора {Id}", Id);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
    }

    private async Task Save()
    {
        _saving = true;
        _formError = null;

        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(_formIsIndefinite ? "true" : "false"), "isIndefinite");
            if (!string.IsNullOrEmpty(_formContractNumber))
                content.Add(new StringContent(_formContractNumber), "contractNumber");
            if (_formContractDate.HasValue)
                content.Add(new StringContent(_formContractDate.Value.ToString("yyyy-MM-dd")), "contractDate");
            if (_formValidFrom.HasValue)
                content.Add(new StringContent(_formValidFrom.Value.ToString("yyyy-MM-dd")), "contractValidFrom");
            if (_formValidTo.HasValue)
                content.Add(new StringContent(_formValidTo.Value.ToString("yyyy-MM-dd")), "contractValidTo");

            // MANAGEMENT_IP: ОГРНИП
            if (_contract?.ContractType == "MANAGEMENT_IP" && !string.IsNullOrEmpty(_formOgrnip))
                content.Add(new StringContent(_formOgrnip), "managerOgrnip");

            // REGISTRAR: поля реестра
            if (_contract?.ContractType == "REGISTRAR")
            {
                if (_formRegistryPrepDays.HasValue) content.Add(new StringContent(_formRegistryPrepDays.Value.ToString()), "registryPreparationDays");
                if (!string.IsNullOrEmpty(_formRegistryPrepUnit)) content.Add(new StringContent(_formRegistryPrepUnit), "registryPreparationUnit");
                if (_formDividendRegPrepDays.HasValue) content.Add(new StringContent(_formDividendRegPrepDays.Value.ToString()), "dividendRegistryPreparationDays");
                if (!string.IsNullOrEmpty(_formDividendRegPrepUnit)) content.Add(new StringContent(_formDividendRegPrepUnit), "dividendRegistryPreparationUnit");
                if (!string.IsNullOrEmpty(_formRegistryRulesUrl)) content.Add(new StringContent(_formRegistryRulesUrl), "registryRulesUrl");
            }

            if (_selectedFile is not null)
            {
                var stream = _selectedFile.OpenReadStream(maxAllowedSize: 52_428_800);
                var fileContent = new StreamContent(stream);
                content.Add(fileContent, "file", _selectedFile.Name);
            }

            var response = await Http.PutAsync($"/api/contracts/{Id}", content);
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/contracts");
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                _formError = $"Ошибка сохранения: {body}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка сохранения договора {Id}", Id);
            _formError = $"Ошибка: {ex.Message}";
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private static string GetTypeBadgeClass(string type) => type switch
    {
        "REGISTRAR" => "bg-primary",
        "INFO_AGENCY" => "bg-info",
        "MANAGEMENT_IP" => "bg-success",
        "MANAGEMENT_UL" => "bg-success",
        _ => "bg-secondary"
    };

    private static string GetTypeLabel(string type) => type switch
    {
        "REGISTRAR" => "Регистратор",
        "INFO_AGENCY" => "Информационное агентство",
        "MANAGEMENT_IP" => "Управляющий ИП",
        "MANAGEMENT_UL" => "Управляющая организация",
        _ => "Неизвестный"
    };

    private class ContractDto
    {
        public Guid Id { get; set; }
        public string ContractType { get; set; } = "";
        public string CounterpartyName { get; set; } = "";
        public string CounterpartyInn { get; set; } = "";
        public string? ContractNumber { get; set; }
        public string? ContractDate { get; set; }
        public string? ContractValidFrom { get; set; }
        public string? ContractValidTo { get; set; }
        public bool IsIndefinite { get; set; }
        public Guid? ContractDocumentId { get; set; }
        public int? RegistryPreparationDays { get; set; }
        public string? RegistryPreparationUnit { get; set; }
        public int? DividendRegistryPreparationDays { get; set; }
        public string? DividendRegistryPreparationUnit { get; set; }
        public string? RegistryRulesUrl { get; set; }
        public Guid? RegistryRulesDocumentId { get; set; }
        public string? ManagerOgrnip { get; set; }
        public Guid? ManagerLegalEntityId { get; set; }
        public string? ManagerFullName { get; set; }
        public string? ManagerInn { get; set; }
        public bool IsActive { get; set; }
    }
}
