@page "/Error"
@using System.Diagnostics

<PageTitle>Ошибка — Fiducia Board Portal</PageTitle>

<div class="container mt-5">
    <div class="alert alert-danger">
        <h3>Произошла ошибка</h3>
        <p>При обработке запроса возникла непредвиденная ошибка. Пожалуйста, повторите попытку позже или обратитесь к администратору системы.</p>
        @if (ShowRequestId)
        {
            <p><strong>Request Id:</strong> <code>@RequestId</code></p>
        }
        <a href="/" class="btn btn-primary">На главную</a>
    </div>
</div>

@code {
    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id;
    }
}
