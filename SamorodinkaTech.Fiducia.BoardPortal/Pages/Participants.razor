    private void OpenEditTreasury(TreasuryRow t)
    {
        _editingTreasury = t;
        _formTreasurySharePercent = t.SharePercent;
        _formTreasuryShareAmount = t.ShareAmount;
        _formTreasuryAcquiredDateStr = ToHtmlDate(t.AcquiredDate);
        _formTreasuryAcquisitionBasis = t.AcquisitionBasis;
