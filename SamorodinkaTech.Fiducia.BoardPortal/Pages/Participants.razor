@page "/participants"
@using Microsoft.EntityFrameworkCore
@using SamorodinkaTech.Fiducia.Domain.Entities
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@inject HttpClient Http
@inject ILogger<Participants> Logger
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Fiducia — Участники</PageTitle>

<h3>Участники</h3>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (!_isLLC)
{
    <div class="text-muted">Раздел доступен только для обществ с ограниченной ответственностью (ООО).</div>
}
else
{
    @* ── Вкладки ──────────────────────────────────────────────── *@
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button type="button" class="nav-link @(_activeTab == 0 ? "active fw-bold" : "")"
                    @onclick="() => _activeTab = 0">
                Участники общества
            </button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link @(_activeTab == 1 ? "active fw-bold" : "")"
                    @onclick="() => _activeTab = 1">
                Доли, принадлежащие Обществу
            </button>
        </li>
    </ul>

    @* ── Вкладка 1: Участники общества ────────────────────────── *@
    @if (_activeTab == 0)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-primary btn-sm" @onclick="OpenAddParticipant">
                    Добавить участника
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="ImportFromSpark" disabled="@_importing">
                    @if (_importing)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    Импорт из СПАРК
                </button>
            </div>
            <div class="d-flex align-items-center gap-3 text-nowrap">
                <label class="form-label mb-0" for="status-filter">Статус:</label>
                <select id="status-filter" class="form-select form-select-sm" style="width: auto;" @bind="_statusFilter">
                    <option value="active">Действующий</option>
                    <option value="exited">Выбывший</option>
                    <option value="all">Все</option>
                </select>
            </div>
        </div>

        @if (_loading)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        else if (_participants.Count == 0)
        {
            <div class="text-muted">Участники не добавлены. Используйте кнопку «Добавить участника» или «Импорт из СПАРК».</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th style="width: 40px;">№</th>
                            <th>Данные участника (ДУЛ / реквизиты)</th>
                            <th style="width: 90px;">Доля %</th>
                            <th style="width: 120px;">Номинал (руб.)</th>
                            <th>Оплата доли</th>
                            <th>Регистрация операций</th>
                            <th style="width: 100px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (p, idx) in _filteredParticipants.Select((p, i) => (p, i)))
                        {
                            var isExited = !string.IsNullOrEmpty(p.ExitDate);
                            <tr class="@(isExited ? "text-muted text-decoration-line-through" : "")">
                                <td>@(idx + 1)</td>
                                <td>
                                    @if (p.ParticipantType == "FL")
                                    {
                                        <div class="fw-semibold">@(p.FullName ?? "—")</div>
                                        <div class="small text-muted">
                                            @if (!string.IsNullOrEmpty(p.PassportSeries) || !string.IsNullOrEmpty(p.PassportNumber))
                                            {
                                                <span>паспорт @p.PassportSeries @p.PassportNumber</span>
                                            }
                                            @if (!string.IsNullOrEmpty(p.PassportDepartmentCode))
                                            {
                                                <span>, код подр. @p.PassportDepartmentCode</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(p.PersonInn))
                                        {
                                            <div class="small font-monospace">ИНН: @p.PersonInn</div>
                                        }
                                        @if (!string.IsNullOrEmpty(p.Citizenship))
                                        {
                                            <div class="small">@p.Citizenship</div>
                                        }
                                    }
                                    else if (p.ParticipantType == "UL")
                                    {
                                        <div class="fw-semibold">@(p.CompanyName ?? "—")</div>
                                        <div class="small font-monospace">
                                            ОГРН: @(p.CompanyOgrn ?? "—") · ИНН: @(p.CompanyInn ?? "—")
                                        </div>
                                        @if (!string.IsNullOrEmpty(p.CompanyAddress))
                                        {
                                            <div class="small text-muted">@p.CompanyAddress</div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="fw-semibold">@(p.FullName ?? "—")</div>
                                        <div class="small font-monospace">ОГРНИП: @(p.Ogrnip ?? "—")</div>
                                        @if (!string.IsNullOrEmpty(p.PersonInn))
                                        {
                                            <div class="small font-monospace">ИНН: @p.PersonInn</div>
                                        }
                                    }
                                </td>
                                <td>
                                    @if (p.SharePercent.HasValue)
                                    {
                                        <span class="fw-bold">@p.SharePercent.Value.ToString("0.##")%</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (p.ShareAmount.HasValue)
                                    {
                                        <span>@p.ShareAmount.Value.ToString("N2") ₽</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="small">
                                    @(p.PaymentInfo ?? "—")
                                </td>
                                <td class="small">
                                    @(p.ShareRegistrationInfo ?? "—")
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-outline-primary btn-sm" @onclick="() => OpenEditParticipant(p)">
                                            ✎
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteParticipant(p.Id)">
                                            ✕
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    @* ── Вкладка 2: Доли, принадлежащие Обществу ──────────────── *@
    @if (_activeTab == 1)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <button class="btn btn-primary btn-sm" @onclick="OpenAddTreasury">
                Добавить запись
            </button>
        </div>

        @if (_loading)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        else if (_treasuryShares.Count == 0)
        {
            <div class="text-muted">Доли, принадлежащие Обществу, отсутствуют.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th style="width: 40px;">№</th>
                            <th style="width: 100px;">Доля %</th>
                            <th style="width: 140px;">Номинальная стоимость (руб.)</th>
                            <th>Дата перехода доли к Обществу</th>
                            <th>Основание перехода доли</th>
                            <th style="width: 100px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (t, idx) in _treasuryShares.Select((t, i) => (t, i)))
                        {
                            <tr>
                                <td>@(idx + 1)</td>
                                <td>
                                    @if (t.SharePercent.HasValue)
                                    {
                                        <span class="fw-bold">@t.SharePercent.Value.ToString("0.##")%</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (t.ShareAmount.HasValue)
                                    {
                                        <span>@t.ShareAmount.Value.ToString("N2") ₽</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="small">
                                    @(t.AcquiredDate ?? "—")
                                </td>
                                <td class="small">
                                    @(t.AcquisitionBasis ?? "—")
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-outline-primary btn-sm" @onclick="() => OpenEditTreasury(t)">
                                            ✎
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteTreasury(t.Id)">
                                            ✕
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
}

@* ── Модалка: добавление/редактирование участника ──────────────── *@
@if (_showParticipantModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editingParticipant is null ? "Добавить участника" : "Редактировать участника")</h5>
                    <button type="button" class="btn-close" @onclick="CloseParticipantModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_participantError))
                    {
                        <div class="alert alert-danger">@_participantError</div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Тип участника</label>
                        <select class="form-select" @bind="_formParticipantType">
                            <option value="FL">Физическое лицо</option>
                            <option value="UL">Юридическое лицо</option>
                            <option value="IP">Индивидуальный предприниматель</option>
                        </select>
                    </div>

                    @if (_formParticipantType == "FL")
                    {
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">ФИО</label>
                                <input class="form-control" @bind="_formFullName" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Серия паспорта</label>
                                <input class="form-control" @bind="_formPassportSeries" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Номер паспорта</label>
                                <input class="form-control" @bind="_formPassportNumber" />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Кем выдан</label>
                                <input class="form-control" @bind="_formPassportIssuedBy" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Дата выдачи</label>
                                <input type="date" class="form-control" value="@_formPassportIssueDateStr"
                                       @onchange="e => _formPassportIssueDateStr = e.Value?.ToString()" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Код подразделения</label>
                                <input class="form-control" @bind="_formPassportDepartmentCode" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Адрес регистрации</label>
                            <input class="form-control" @bind="_formPassportRegistrationAddress" />
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">ИНН</label>
                                <input class="form-control" @bind="_formPersonInn" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Гражданство</label>
                                <input class="form-control" @bind="_formCitizenship" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">ОГРНИП</label>
                                <input class="form-control" @bind="_formOgrnip" />
                            </div>
                        </div>
                    }
                    else if (_formParticipantType == "UL")
                    {
                        <div class="mb-3">
                            <label class="form-label">Наименование</label>
                            <input class="form-control" @bind="_formCompanyName" />
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-3">
                                <label class="form-label">ИНН</label>
                                <input class="form-control" @bind="_formCompanyInn" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">ОГРН</label>
                                <input class="form-control" @bind="_formCompanyOgrn" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">КПП</label>
                                <input class="form-control" @bind="_formCompanyKpp" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Адрес</label>
                                <input class="form-control" @bind="_formCompanyAddress" />
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">ФИО</label>
                                <input class="form-control" @bind="_formFullName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">ОГРНИП</label>
                                <input class="form-control" @bind="_formOgrnip" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">ИНН</label>
                            <input class="form-control" @bind="_formPersonInn" />
                        </div>
                    }

                    <hr />
                    <h6>Доля в уставном капитале</h6>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Размер доли (%)</label>
                            <input type="number" step="0.01" class="form-control" @bind="_formSharePercent" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Номинальная стоимость (руб.)</label>
                            <input type="number" step="0.01" class="form-control" @bind="_formShareAmount" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Оплата доли</label>
                            <input class="form-control" @bind="_formPaymentInfo" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Регистрация операций с долей</label>
                            <input class="form-control" @bind="_formShareRegistrationInfo" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Дата входа</label>
                            <input type="date" class="form-control" value="@_formEntryDateStr"
                                   @onchange="e => _formEntryDateStr = e.Value?.ToString()" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Дата выхода</label>
                            <input type="date" class="form-control" value="@_formExitDateStr"
                                   @onchange="e => _formExitDateStr = e.Value?.ToString()" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseParticipantModal">Отмена</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveParticipant" disabled="@_savingParticipant">
                        @if (_savingParticipant)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Сохранить
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Модалка: добавление/редактирование казначейской доли ──────── *@
@if (_showTreasuryModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editingTreasury is null ? "Добавить казначейскую долю" : "Редактировать казначейскую долю")</h5>
                    <button type="button" class="btn-close" @onclick="CloseTreasuryModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_treasuryError))
                    {
                        <div class="alert alert-danger">@_treasuryError</div>
                    }

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Размер доли (%)</label>
                            <input type="number" step="0.01" class="form-control" @bind="_formTreasurySharePercent" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Номинальная стоимость (руб.)</label>
                            <input type="number" step="0.01" class="form-control" @bind="_formTreasuryShareAmount" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Дата перехода доли к Обществу</label>
                            <input type="date" class="form-control" value="@_formTreasuryAcquiredDateStr"
                                   @onchange="e => _formTreasuryAcquiredDateStr = e.Value?.ToString()" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Основание перехода доли</label>
                            <input class="form-control" @bind="_formTreasuryAcquisitionBasis" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseTreasuryModal">Отмена</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveTreasury" disabled="@_savingTreasury">
                        @if (_savingTreasury)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Сохранить
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _isLLC;
    private string? _error;
    private int _activeTab;
    private bool _loading = true;
    private string _statusFilter = "active";
    private bool _importing;

    private List<ParticipantRow> _participants = new();
    private List<TreasuryRow> _treasuryShares = new();

    private List<ParticipantRow> _filteredParticipants => _statusFilter switch
    {
        "active" => _participants.Where(p => p.ExitDate is null).ToList(),
        "exited" => _participants.Where(p => p.ExitDate is not null).ToList(),
        _ => _participants
    };

    // ── Participant modal state ────────────────────────────────────
    private bool _showParticipantModal;
    private bool _savingParticipant;
    private string? _participantError;
    private ParticipantRow? _editingParticipant;

    private string _formParticipantType = "FL";
    private string? _formFullName;
    private string? _formPassportSeries;
    private string? _formPassportNumber;
    private string? _formPassportIssuedBy;
    private string? _formPassportIssueDateStr;
    private string? _formPassportDepartmentCode;
    private string? _formPassportRegistrationAddress;
    private string? _formPersonInn;
    private string? _formCitizenship;
    private string? _formCompanyName;
    private string? _formCompanyInn;
    private string? _formCompanyOgrn;
    private string? _formCompanyKpp;
    private string? _formCompanyAddress;
    private string? _formOgrnip;
    private decimal? _formSharePercent;
    private decimal? _formShareAmount;
    private string? _formPaymentInfo;
    private string? _formShareRegistrationInfo;
    private string? _formEntryDateStr;
    private string? _formExitDateStr;

    // ── Treasury modal state ───────────────────────────────────────
    private bool _showTreasuryModal;
    private bool _savingTreasury;
    private string? _treasuryError;
    private TreasuryRow? _editingTreasury;

    private decimal? _formTreasurySharePercent;
    private decimal? _formTreasuryShareAmount;
    private string? _formTreasuryAcquiredDateStr;
    private string? _formTreasuryAcquisitionBasis;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var workplace = await ctx.CurrentWorkplaces.FirstOrDefaultAsync();
            if (workplace?.LastSelectedLegalEntityId is null)
            {
                _error = "Юридическое лицо не выбрано. Перейдите в Административную консоль → Юридические лица и выберите ООО.";
                return;
            }

            var le = await ctx.LegalEntities
                .Include(x => x.RefOkopf)
                .FirstOrDefaultAsync(x => x.Id == workplace.LastSelectedLegalEntityId.Value);

            if (le is null)
            {
                _error = "Выбранное юридическое лицо не найдено.";
                return;
            }

            _isLLC = le.RefOkopf?.Code == "12300";
            if (!_isLLC) return;

            await LoadData();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки участников");
            _error = "Не удалось загрузить данные.";
        }
    }

    private async Task LoadData()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var participants = await Http.GetFromJsonAsync<List<ParticipantRow>>("/api/participants");
            _participants = participants ?? new();

            var treasury = await Http.GetFromJsonAsync<List<TreasuryRow>>("/api/treasury-shares");
            _treasuryShares = treasury ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки данных участников");
            _error = "Не удалось загрузить данные.";
        }
        finally
        {
            _loading = false;
        }
    }

    // ── Participant CRUD ───────────────────────────────────────────

    private void OpenAddParticipant()
    {
        _editingParticipant = null;
        ResetParticipantForm();
        _showParticipantModal = true;
    }

    private void OpenEditParticipant(ParticipantRow p)
    {
        _editingParticipant = p;
        _formParticipantType = p.ParticipantType ?? "FL";
        _formFullName = p.FullName;
        _formPassportSeries = p.PassportSeries;
        _formPassportNumber = p.PassportNumber;
        _formPassportIssuedBy = p.PassportIssuedBy;
        _formPassportIssueDateStr = ToHtmlDate(p.PassportIssueDate);
        _formPassportDepartmentCode = p.PassportDepartmentCode;
        _formPassportRegistrationAddress = p.PassportRegistrationAddress;
        _formPersonInn = p.PersonInn;
        _formCitizenship = p.Citizenship;
        _formCompanyName = p.CompanyName;
        _formCompanyInn = p.CompanyInn;
        _formCompanyOgrn = p.CompanyOgrn;
        _formCompanyKpp = p.CompanyKpp;
        _formCompanyAddress = p.CompanyAddress;
        _formOgrnip = p.Ogrnip;
        _formSharePercent = p.SharePercent;
        _formShareAmount = p.ShareAmount;
        _formPaymentInfo = p.PaymentInfo;
        _formShareRegistrationInfo = p.ShareRegistrationInfo;
        _formEntryDateStr = ToHtmlDate(p.EntryDate);
        _formExitDateStr = ToHtmlDate(p.ExitDate);
        _showParticipantModal = true;
    }

    private void CloseParticipantModal()
    {
        _showParticipantModal = false;
        _participantError = null;
    }

    private void ResetParticipantForm()
    {
        _formParticipantType = "FL";
        _formFullName = null;
        _formPassportSeries = null;
        _formPassportNumber = null;
