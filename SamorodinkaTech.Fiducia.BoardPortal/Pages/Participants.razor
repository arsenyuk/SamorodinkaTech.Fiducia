    private bool IsFormValid()
    {
        decimal? parsedShare = null;
        if (!string.IsNullOrWhiteSpace(_formShareInput))
        {
            try
            {
                (parsedShare, _) = SamorodinkaTech.Fiducia.Infrastructure.Common.ShareParser.Parse(_formShareInput);
                _formShareError = null;
            }
            catch (ArgumentException ex)
            {
                _formShareError = ex.Message;
                return false;
            }
        }
        else
        {
            _formShareError = null;
        }

        var shareOk = parsedShare > 0;
        var paymentRequired = parsedShare < 100;
        var paymentOk = !paymentRequired || !string.IsNullOrWhiteSpace(_formPaymentInfo);

        if (_formParticipantType == "FL")
            return !string.IsNullOrWhiteSpace(_formLastName)
                && !string.IsNullOrWhiteSpace(_formFirstName)
                && shareOk && paymentOk;
        if (_formParticipantType == "UL")
            return !string.IsNullOrWhiteSpace(_formCompanyName)
                && shareOk && paymentOk;
        return shareOk && paymentOk;
    }

    private async Task SaveParticipant()
    {
        _savingParticipant = true;
        _participantError = null;
        StateHasChanged();

        try
        {
            var userId = SamorodinkaTech.Fiducia.Infrastructure.Common.UserContextHelper.GetUserIdAsync(HttpContextAccessor.HttpContext!) ?? Guid.Empty;
            var clientIp = HttpContextAccessor.HttpContext?.Connection?.RemoteIpAddress?.ToString() ?? "unknown";

            // Парсинг размера доли
            decimal? parsedSharePercent = null;
            string? parsedShareFraction = null;
            if (!string.IsNullOrWhiteSpace(_formShareInput))
            {
                try
                {
                    (parsedSharePercent, parsedShareFraction) = SamorodinkaTech.Fiducia.Infrastructure.Common.ShareParser.Parse(_formShareInput);
                }
                catch (ArgumentException ex)
                {
                    _formShareError = ex.Message;
                    _savingParticipant = false;
                    StateHasChanged();
                    return;
