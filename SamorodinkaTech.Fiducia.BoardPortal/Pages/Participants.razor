    private string? _formPaymentInfo;
    private string? _formShareRegistrationInfo;
    private string? _formEntryDateStr;
    private string? _formExitDateStr;

    // ── Treasury modal state ───────────────────────────────────────
    private bool _showTreasuryModal;
    private bool _savingTreasury;
    private string? _treasuryError;
    private TreasuryRow? _editingTreasury;

    private string? _formTreasuryShareInput;
    private string _formTreasuryShareMode = "fraction";
    private string? _formTreasuryShareError;
    private decimal? _formTreasuryShareAmount;
    private string? _formTreasuryAcquiredDateStr;
    private string? _formTreasuryAcquisitionBasis;

    // ── Registry upload state ──────────────────────────────────────
    private bool _loadingRegistry = true;
    private bool _isUploadingRegistry;
    private string? _registryUploadError;
    private List<RegistryUploadRow> _registryUploads = new();
    private IBrowserFile? _selectedXmlFile;
    private string? _selectedXmlFileName;
    private IBrowserFile? _selectedSignatureFile;
    private string? _selectedSignatureFileName;

    // ── Participant changes (read-only) ────────────────────────────
    private bool _loadingChanges = true;
    private List<ParticipantChangeRow> _participantChanges = new();

    // ── Paper informing form ───────────────────────────────────────
    private bool _savingPaper;
    private string? _paperError;
    private string? _paperParticipantId;
    private string? _paperDateStr;
    private string? _paperDocNumber;
    private string? _paperFullName;
    private string? _paperPersonInn;
    private string? _paperAddress;
    private string? _paperCompanyName;
    private string? _paperCompanyInn;
    private string? _paperShareInput;
    private string _paperShareMode = "fraction";
    private string? _paperShareError;
    private decimal? _paperShareAmount;
    private string? _paperComment;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();

            // Определяем ЮЛ через EcosystemParticipant по userId из JWT
            var userId = SamorodinkaTech.Fiducia.Infrastructure.Common.UserContextHelper.GetUserIdAsync(HttpContextAccessor.HttpContext!);

            Guid? leId = null;
            if (userId.HasValue)
            {
                var user = await ctx.Users.FindAsync(userId.Value);
                if (user is not null)
                {
                    var participant = await ctx.EcosystemParticipants
                        .FirstOrDefaultAsync(ep => ep.UserId == user.Id);
                    leId = participant?.LegalEntityId;
                }
            }

            if (leId is null)
            {
                _error = "Юридическое лицо не выбрано. Обратитесь к администратору.";
                return;
            }

            _leId = leId.Value;

            var le = await ctx.LegalEntities
                .Include(x => x.RefOkopf)
                .FirstOrDefaultAsync(x => x.Id == leId.Value);

            if (le is null)
            {
                _error = "Выбранное юридическое лицо не найдено.";
                return;
            }

            _isLLC = le.RefOkopf?.Code == "12300";
            if (!_isLLC)
            {
                Nav.NavigateTo("/main");
                return;
            }

            // Проверяем статус ведения реестра через нотариат
            var extraSettings = await ctx.LegalEntityExtraSettings
                .FirstOrDefaultAsync(x => x.LegalEntityId == le.Id);
            _notaryListApproved = extraSettings?.NotaryListApproved ?? false;

            await LoadData();
            await LoadRegistryUploads();
            await LoadParticipantChanges();

            await using var dulCtx = await DbFactory.CreateDbContextAsync();
            _dulTypes = await dulCtx.RefDulTypes.OrderBy(t => t.SortOrder).ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки участников");
            _error = "Не удалось загрузить данные.";
        }
    }

    private async Task LoadData()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var entities = await ParticipantRead.GetByLegalEntityAsync(_leId);
            _participants = entities.Select(MapParticipantToRow).ToList();

            var treasuryEntities = await ParticipantRead.GetTreasuryAsync(_leId);
            _treasuryShares = treasuryEntities.Select(MapTreasuryToRow).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки данных участников");
            _error = "Не удалось загрузить данные.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadRegistryUploads()
    {
        _loadingRegistry = true;
        StateHasChanged();

        try
        {
            var uploads = await ParticipantRead.GetRegistryUploadsAsync(_leId);
            _registryUploads = uploads.Select(MapRegistryUploadToRow).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки актов реестра");
        }
        finally
        {
            _loadingRegistry = false;
        }
    }

    // ── Registry upload ────────────────────────────────────────────

    private void OnXmlFileSelected(InputFileChangeEventArgs e)
    {
        _selectedXmlFile = e.File;
        _selectedXmlFileName = e.File.Name;
        _registryUploadError = null;
    }

    private void OnSignatureFileSelected(InputFileChangeEventArgs e)
    {
        _selectedSignatureFile = e.File;
        _selectedSignatureFileName = e.File.Name;
    }

    private async Task UploadRegistry()
    {
        if (_selectedXmlFile is null || _selectedSignatureFile is null) return;

        _isUploadingRegistry = true;
        _registryUploadError = null;
        StateHasChanged();

        try
        {
            // Валидация расширений на клиенте
            var xmlExt = System.IO.Path.GetExtension(_selectedXmlFileName)?.ToLowerInvariant();
            if (xmlExt != ".xml")
            {
                _registryUploadError = "XML-файл должен иметь расширение .xml";
                return;
            }

            var sigExt = System.IO.Path.GetExtension(_selectedSignatureFileName)?.ToLowerInvariant();
            if (sigExt != ".sig" && sigExt != ".p7s")
            {
                _registryUploadError = "Файл подписи должен иметь расширение .sig или .p7s";
                return;
            }

            // Загружаем XML + подпись одним запросом
            using var content = new MultipartFormDataContent();

            using var xmlStream = _selectedXmlFile.OpenReadStream(10 * 1024 * 1024);
            using var xmlMs = new MemoryStream();
            await xmlStream.CopyToAsync(xmlMs);
            xmlMs.Position = 0;
            var xmlBytes = xmlMs.ToArray();
            content.Add(new ByteArrayContent(xmlBytes), "file", _selectedXmlFileName ?? "registry.xml");

            using var sigStream = _selectedSignatureFile.OpenReadStream(10 * 1024 * 1024);
            using var sigMs = new MemoryStream();
            await sigStream.CopyToAsync(sigMs);
            sigMs.Position = 0;
            var sigBytes = sigMs.ToArray();
            content.Add(new ByteArrayContent(sigBytes), "signature", _selectedSignatureFileName ?? "signature.sig");

            var response = await Http.PostAsync("/api/registry-uploads/upload-xml", content);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _registryUploadError = $"Ошибка загрузки ({(int)response.StatusCode}): {body}";
                return;
            }

            // Сбрасываем выбор
            _selectedXmlFile = null;
            _selectedXmlFileName = null;
            _selectedSignatureFile = null;
            _selectedSignatureFileName = null;

            await LoadRegistryUploads();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки реестра");
            _registryUploadError = "Не удалось загрузить реестр.";
        }
        finally
        {
            _isUploadingRegistry = false;
        }
    }

    private async Task DeleteRegistryUpload(Guid id)
    {
        try
        {
            var userId = SamorodinkaTech.Fiducia.Infrastructure.Common.UserContextHelper.GetUserIdAsync(HttpContextAccessor.HttpContext!) ?? Guid.Empty;
            var clientIp = HttpContextAccessor.HttpContext?.Connection?.RemoteIpAddress?.ToString() ?? "unknown";

            await ParticipantWrite.DeleteRegistryUploadAsync(id, userId, clientIp);
            await LoadRegistryUploads();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка удаления акта загрузки {Id}", id);
        }
    }

    // ── Participant changes (read-only) ────────────────────────────

    private async Task LoadParticipantChanges()
    {
        _loadingChanges = true;
        StateHasChanged();

        try
        {
            var changes = await ParticipantRead.GetChangesAsync(_leId);
            _participantChanges = changes.Select(MapChangeToRow).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки информирований");
        }
        finally
        {
            _loadingChanges = false;
        }
    }

    private async Task SavePaperInforming()
    {
        if (_paperParticipantId is null) return;

        _savingPaper = true;
        _paperError = null;
        StateHasChanged();

        try
        {
            var userId = SamorodinkaTech.Fiducia.Infrastructure.Common.UserContextHelper.GetUserIdAsync(HttpContextAccessor.HttpContext!) ?? Guid.Empty;
            var clientIp = HttpContextAccessor.HttpContext?.Connection?.RemoteIpAddress?.ToString() ?? "unknown";

            var participant = _participants.FirstOrDefault(p => p.Id.ToString() == _paperParticipantId);

            // Парсинг размера доли
            decimal? parsedPaperSharePercent = null;
            string? parsedPaperShareFraction = null;
            if (!string.IsNullOrWhiteSpace(_paperShareInput))
            {
                try
                {
                    (parsedPaperSharePercent, parsedPaperShareFraction) = SamorodinkaTech.Fiducia.Infrastructure.Common.ShareParser.Parse(_paperShareInput);
                }
                catch (ArgumentException ex)
                {
                    _paperShareError = ex.Message;
                    _savingPaper = false;
                    StateHasChanged();
                    return;
                }
            }

            var model = new ChangeCreateModel
            {
                LegalEntityId = _leId,
                ParticipantId = Guid.Parse(_paperParticipantId),
                ParticipantType = participant?.ParticipantType ?? "FL",
                LastName = null,
                FirstName = null,
                MiddleName = null,
                PersonInn = _paperPersonInn ?? participant?.PersonInn,
                CompanyName = _paperCompanyName ?? participant?.CompanyName,
                CompanyInn = _paperCompanyInn ?? participant?.CompanyInn,
                SharePercent = parsedPaperSharePercent ?? participant?.SharePercent,
                ShareFraction = parsedPaperShareFraction ?? participant?.ShareFraction,
                ShareAmount = _paperShareAmount ?? participant?.ShareAmount,
                Source = "paper",
                Date = _paperDateStr,
                PaperDocNumber = _paperDocNumber,
                Comment = _paperComment
            };

            await ParticipantWrite.CreateChangeAsync(model, userId, clientIp);

            // Сброс формы
            _paperParticipantId = null;
            _paperDateStr = null;
            _paperDocNumber = null;
            _paperFullName = null;
            _paperPersonInn = null;
            _paperAddress = null;
            _paperCompanyName = null;
            _paperCompanyInn = null;
            _paperShareInput = null;
            _paperShareAmount = null;
            _paperShareAmount = null;
            _paperComment = null;

            await LoadParticipantChanges();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка сохранения бумажного информирования");
            _paperError = ex.Message;
        }
        finally
        {
            _savingPaper = false;
        }
    }

    // ── Participant CRUD ───────────────────────────────────────────

    private void OpenAddParticipant()
    {
        _editingParticipant = null;
        ResetParticipantForm();
        _showParticipantModal = true;
    }

    private void OpenEditParticipant(ParticipantRow p)
    {
        _editingParticipant = p;
        _formParticipantType = p.ParticipantType ?? "FL";
        _formLastName = p.LastName;
        _formFirstName = p.FirstName;
        _formMiddleName = p.MiddleName;
        _formDulTypeId = p.DulTypeId;
        _formPassportSeries = p.DulSeries;
