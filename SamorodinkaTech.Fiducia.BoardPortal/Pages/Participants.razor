    }

    private void CloseTreasuryModal()
    {
        _showTreasuryModal = false;
        _treasuryError = null;
    }

    private void ResetTreasuryForm()
    {
        _formTreasurySharePercent = null;
        _formTreasuryShareAmount = null;
        _formTreasuryAcquiredDateStr = null;
        _formTreasuryAcquisitionBasis = null;
    }

    private async Task SaveTreasury()
    {
        _savingTreasury = true;
        _treasuryError = null;
        StateHasChanged();

        try
        {
            var dto = new
            {
                sharePercent = _formTreasurySharePercent,
                shareAmount = _formTreasuryShareAmount,
                acquiredDate = DateOnly.TryParse(_formTreasuryAcquiredDateStr, out var ad) ? ad : (DateOnly?)null,
                acquisitionBasis = _formTreasuryAcquisitionBasis
            };

            HttpResponseMessage response;
            if (_editingTreasury is null)
            {
                response = await Http.PostAsJsonAsync("/api/treasury-shares", dto);
            }
            else
            {
                response = await Http.PutAsJsonAsync($"/api/treasury-shares/{_editingTreasury.Id}", dto);
            }

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _treasuryError = $"Ошибка ({(int)response.StatusCode}): {body}";
                return;
            }

            CloseTreasuryModal();
            await LoadData();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка сохранения казначейской доли");
            _treasuryError = "Не удалось сохранить казначейскую долю.";
        }
        finally
        {
            _savingTreasury = false;
        }
    }

    private async Task DeleteTreasury(Guid id)
    {
        try
        {
            var response = await Http.DeleteAsync($"/api/treasury-shares/{id}");
            if (response.IsSuccessStatusCode)
                await LoadData();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка удаления казначейской доли");
        }
    }

