@page "/participants"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Json
@using SamorodinkaTech.Fiducia.Domain.Entities
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@inject HttpClient Http
@inject ILogger<Participants> Logger
@inject NavigationManager Nav
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Fiducia — Участники</PageTitle>

<h3>Участники</h3>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (!_isLLC)
{
    <div class="text-muted">Раздел доступен только для ООО.</div>
}
else
{
    @* ── Вкладки ──────────────────────────────────────────────── *@
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button type="button" class="nav-link @(_activeTab == 0 ? "active fw-bold" : "")"
                    @onclick="() => _activeTab = 0">
                Участники общества
            </button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link @(_activeTab == 1 ? "active fw-bold" : "")"
                    @onclick="() => _activeTab = 1">
                Доли, принадлежащие Обществу
            </button>
        </li>
        @if (_notaryListApproved)
        {
            <li class="nav-item">
                <button type="button" class="nav-link @(_activeTab == 2 ? "active fw-bold" : "")"
                        @onclick="() => _activeTab = 2">
                    Нотариальное ведение реестра
                </button>
            </li>
        }
        <li class="nav-item">
            <button type="button" class="nav-link @(_activeTab == 3 ? "active fw-bold" : "")"
                    @onclick="() => _activeTab = 3">
                Информирование
            </button>
        </li>
    </ul>

    @* ── Вкладка 1: Участники общества ────────────────────────── *@
    @if (_activeTab == 0)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-primary btn-sm" @onclick="OpenAddParticipant">
                    Добавить участника
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="ImportFromSpark" disabled="@_importing">
                    @if (_importing)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    Импорт из СПАРК
                </button>
            </div>
            <div class="d-flex align-items-center gap-3 text-nowrap">
                <label class="form-label mb-0" for="status-filter">Статус:</label>
                <select id="status-filter" class="form-select form-select-sm" style="width: auto;" @bind="_statusFilter">
                    <option value="active">Действующий</option>
                    <option value="exited">Выбывший</option>
                    <option value="all">Все</option>
                </select>
            </div>
        </div>

        @if (_loading)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        else if (_participants.Count == 0)
        {
            <div class="text-muted">Участники не добавлены. Используйте кнопку «Добавить участника» или «Импорт из СПАРК».</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th style="width: 40px;">№</th>
                            <th>Данные участника (ДУЛ / реквизиты)</th>
                            <th style="width: 90px;">Доля %</th>
                            <th style="width: 120px;">Номинал (руб.)</th>
                            <th>Оплата доли</th>
                            <th>Регистрация операций</th>
                            <th style="width: 100px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (p, idx) in _filteredParticipants.Select((p, i) => (p, i)))
                        {
                            var isExited = !string.IsNullOrEmpty(p.ExitDate);
                            <tr class="@(isExited ? "text-muted text-decoration-line-through" : "")">
                                <td>@(idx + 1)</td>
                                <td>
                                    @if (p.ParticipantType == "FL")
                                    {
                                        <div class="fw-semibold">@(p.FullName ?? "—")</div>
                                        <div class="small text-muted">
                                            @if (!string.IsNullOrEmpty(p.PassportSeries) || !string.IsNullOrEmpty(p.PassportNumber))
                                            {
                                                <span>паспорт @p.PassportSeries @p.PassportNumber</span>
                                            }
                                            @if (!string.IsNullOrEmpty(p.PassportDepartmentCode))
                                            {
                                                <span>, код подр. @p.PassportDepartmentCode</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(p.PersonInn))
                                        {
                                            <div class="small font-monospace">ИНН: @p.PersonInn</div>
                                        }
                                        @if (!string.IsNullOrEmpty(p.Citizenship))
                                        {
                                            <div class="small">@p.Citizenship</div>
                                        }
                                    }
                                    else if (p.ParticipantType == "UL")
                                    {
                                        <div class="fw-semibold">@(p.CompanyName ?? "—")</div>
                                        <div class="small font-monospace">
                                            ОГРН: @(p.CompanyOgrn ?? "—") · ИНН: @(p.CompanyInn ?? "—")
                                        </div>
                                        @if (!string.IsNullOrEmpty(p.CompanyAddress))
                                        {
                                            <div class="small text-muted">@p.CompanyAddress</div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="fw-semibold">@(p.FullName ?? "—")</div>
                                        <div class="small font-monospace">ОГРНИП: @(p.Ogrnip ?? "—")</div>
                                        @if (!string.IsNullOrEmpty(p.PersonInn))
                                        {
                                            <div class="small font-monospace">ИНН: @p.PersonInn</div>
                                        }
                                    }
                                </td>
                                <td>
                                    @if (p.SharePercent.HasValue)
                                    {
                                        <span class="fw-bold">@p.SharePercent.Value.ToString("0.##")%</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (p.ShareAmount.HasValue)
                                    {
                                        <span>@p.ShareAmount.Value.ToString("N2") ₽</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="small">
                                    @(p.PaymentInfo ?? "—")
                                </td>
                                <td class="small">
                                    @(p.ShareRegistrationInfo ?? "—")
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-outline-primary btn-sm" @onclick="() => OpenEditParticipant(p)">
                                            ✎
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteParticipant(p.Id)">
                                            ✕
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    @* ── Вкладка 2: Доли, принадлежащие Обществу ──────────────── *@
    @if (_activeTab == 1)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <button class="btn btn-primary btn-sm" @onclick="OpenAddTreasury">
                Добавить запись
            </button>
        </div>

        @if (_loading)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        else if (_treasuryShares.Count == 0)
        {
            <div class="text-muted">Доли, принадлежащие Обществу, отсутствуют.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th style="width: 40px;">№</th>
                            <th style="width: 100px;">Доля %</th>
                            <th style="width: 140px;">Номинальная стоимость (руб.)</th>
                            <th>Дата перехода доли к Обществу</th>
                            <th>Основание перехода доли</th>
                            <th style="width: 100px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (t, idx) in _treasuryShares.Select((t, i) => (t, i)))
                        {
                            <tr>
                                <td>@(idx + 1)</td>
                                <td>
                                    @if (t.SharePercent.HasValue)
                                    {
                                        <span class="fw-bold">@t.SharePercent.Value.ToString("0.##")%</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (t.ShareAmount.HasValue)
                                    {
                                        <span>@t.ShareAmount.Value.ToString("N2") ₽</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="small">
                                    @(t.AcquiredDate ?? "—")
                                </td>
                                <td class="small">
                                    @(t.AcquisitionBasis ?? "—")
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-outline-primary btn-sm" @onclick="() => OpenEditTreasury(t)">
                                            ✎
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteTreasury(t.Id)">
                                            ✕
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    @* ── Вкладка 3: Нотариальное ведение реестра ──────────────────── *@
    @if (_notaryListApproved && _activeTab == 2)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="card-title">Загрузка XML-файла реестра участников</h6>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">XML-файл реестра</label>
                        <InputFile OnChange="OnXmlFileSelected" accept=".xml"
                                   class="form-control form-control-sm" disabled="@_isUploadingRegistry" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Отсоединённая подпись (.sig или .p7s)</label>
                        <InputFile OnChange="OnSignatureFileSelected" accept=".sig,.p7s"
                                   class="form-control form-control-sm" disabled="@_isUploadingRegistry" />
                    </div>
                </div>
                @if (_selectedXmlFileName is not null || _selectedSignatureFileName is not null)
                {
                    <div class="mb-2">
                        @if (_selectedXmlFileName is not null)
                        {
                            <span class="badge bg-secondary me-2">XML: @_selectedXmlFileName</span>
                        }
                        @if (_selectedSignatureFileName is not null)
                        {
                            <span class="badge bg-secondary">Подпись: @_selectedSignatureFileName</span>
                        }
                    </div>
                }
                @if (_isUploadingRegistry)
                {
                    <div class="mb-2">
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar bg-primary" style="width: 100%"></div>
                        </div>
                        <small class="text-muted">Загрузка...</small>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_registryUploadError))
                {
                    <div class="alert alert-danger py-1 px-2 mb-2 small">@_registryUploadError</div>
                }
                <button class="btn btn-primary btn-sm" @onclick="UploadRegistry"
                        disabled="@(_selectedXmlFile is null || _selectedSignatureFile is null || _isUploadingRegistry)">
                    Загрузить
                </button>
            </div>
        </div>

        <h6>Акты загрузки реестра</h6>
        @if (_loadingRegistry)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        else if (_registryUploads.Count == 0)
        {
            <div class="text-muted">Акты загрузки отсутствуют.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th style="width: 40px;">№</th>
                            <th>Дата загрузки</th>
                            <th>XML-файл</th>
                            <th>Подпись</th>
                            <th>Статус</th>
                            <th style="width: 100px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (u, idx) in _registryUploads.Select((u, i) => (u, i)))
                        {
                            <tr>
                                <td>@(idx + 1)</td>
                                <td class="small">@u.UploadedAt</td>
                                <td>@(u.XmlOriginalName ?? "—")</td>
                                <td>@(u.SignatureOriginalName ?? "—")</td>
                                <td>
                                    @if (u.Status == "uploaded")
                                    {
                                        <span class="badge bg-success">Загружен</span>
                                    }
                                    else if (u.Status == "error")
                                    {
                                        <span class="badge bg-danger">Ошибка</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@u.Status</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteRegistryUpload(u.Id)">
                                        ✕
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    @* ── Вкладка 4: Информирование ──────────────────────────────── *@
    @if (_activeTab == 3)
    {
        @* Форма ручного ввода бумажного информирования *@
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Регистрация бумажного информирования</h5>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    Внесение данных из бумажного информирования участника об изменении сведений
                    (<LawReferenceLink Article="article-14fz-31-1" Text="п. 3 ст. 31.1 Закона № 14-ФЗ" />).
                </p>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Участник</label>
                        <select class="form-select" @bind="_paperParticipantId">
                            <option value="">— Выберите участника —</option>
                            @foreach (var p in _participants)
                            {
                                <option value="@p.Id">
                                    @(p.ParticipantType == "FL" ? p.FullName : p.CompanyName) (@p.ParticipantType)
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Дата информирования</label>
                        <input type="date" class="form-control" value="@_paperDateStr"
                               @onchange="e => _paperDateStr = e.Value?.ToString()" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">№ бумажного документа</label>
                        <input class="form-control" @bind="_paperDocNumber" placeholder="Исх. №" />
                    </div>
                </div>

                @if (_paperParticipantId is not null)
                {
                    var participant = _participants.FirstOrDefault(p => p.Id.ToString() == _paperParticipantId);

                    @if (participant?.ParticipantType == "FL")
                    {
                        <h6>Данные ФЛ</h6>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">ФИО</label>
                                <input class="form-control" @bind="_paperFullName" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">ИНН</label>
                                <input class="form-control" @bind="_paperPersonInn" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Адрес</label>
                                <input class="form-control" @bind="_paperAddress" />
                            </div>
                        </div>
                    }
                    else if (participant?.ParticipantType == "UL")
                    {
                        <h6>Данные ЮЛ</h6>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Наименование</label>
                                <input class="form-control" @bind="_paperCompanyName" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">ИНН</label>
                                <input class="form-control" @bind="_paperCompanyInn" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Адрес</label>
                                <input class="form-control" @bind="_paperAddress" />
                            </div>
                        </div>
                    }

                    <h6>Доля</h6>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Размер доли (%)</label>
                            <input type="number" step="0.01" class="form-control" @bind="_paperSharePercent" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Номинал (руб.)</label>
                            <input type="number" step="0.01" class="form-control" @bind="_paperShareAmount" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Примечание</label>
                        <input class="form-control" @bind="_paperComment" placeholder="Комментарий к записи" />
                    </div>

                    @if (!string.IsNullOrEmpty(_paperError))
                    {
                        <div class="alert alert-danger py-1 px-2 mb-2 small">@_paperError</div>
                    }

                    <button class="btn btn-primary btn-sm" @onclick="SavePaperInforming" disabled="@_savingPaper">
                        @if (_savingPaper)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Зарегистрировать
                    </button>
                }
            </div>
        </div>

        @* Таблица информирований (бумажные + электронные) *@
        <h5>Журнал информирований</h5>

        @if (_loadingChanges)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        else if (_participantChanges.Count == 0)
        {
            <div class="text-muted">Информирования отсутствуют.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th style="width: 40px;">№</th>
                            <th>Участник</th>
                            <th>Тип</th>
                            <th>Источник</th>
                            <th>Документ</th>
                            <th>Дата</th>
                            <th>Статус</th>
                            <th>Примечание</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (c, idx) in _participantChanges.Select((c, i) => (c, i)))
                        {
                            var participant = _participants.FirstOrDefault(p => p.Id == c.ParticipantId);
                            <tr>
                                <td>@(idx + 1)</td>
                                <td>@(participant?.FullName ?? participant?.CompanyName ?? c.ParticipantName ?? "—")</td>
                                <td>
                                    @if (c.ParticipantType == "FL")
                                    {
                                        <span class="badge bg-info">ФЛ</span>
                                    }
                                    else if (c.ParticipantType == "UL")
                                    {
                                        <span class="badge bg-primary">ЮЛ</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">ИП</span>
                                    }
                                </td>
                                <td>
                                    @if (c.Source == "paper")
                                    {
                                        <span class="badge bg-secondary">Бумажное</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Электронное</span>
                                    }
                                </td>
                                <td class="small">@(c.DocumentOriginalName ?? c.PaperDocNumber ?? "—")</td>
                                <td class="small">@(c.Date ?? c.SubmittedAt ?? "—")</td>
                                <td>
                                    @if (c.Status == "pending")
                                    {
                                        <span class="badge bg-warning text-dark">Ожидает</span>
                                    }
                                    else if (c.Status == "approved")
                                    {
                                        <span class="badge bg-success">Утверждено</span>
                                    }
                                    else if (c.Status == "rejected")
                                    {
                                        <span class="badge bg-danger">Отклонено</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@c.Status</span>
                                    }
                                </td>
                                <td class="small">@(c.Comment ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
}

@* ── Модалка: добавление/редактирование участника ──────────────── *@
@if (_showParticipantModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editingParticipant is null ? "Добавить участника" : "Редактировать участника")</h5>
                    <button type="button" class="btn-close" @onclick="CloseParticipantModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_participantError))
                    {
                        <div class="alert alert-danger">@_participantError</div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Тип участника</label>
                        <select class="form-select" @bind="_formParticipantType">
                            <option value="FL">Физическое лицо</option>
                            <option value="UL">Юридическое лицо</option>
                            <option value="IP">Индивидуальный предприниматель</option>
                        </select>
                    </div>

                    @if (_formParticipantType == "FL")
                    {
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">ФИО</label>
                                <input class="form-control" @bind="_formFullName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Вид документа</label>
                                <select class="form-select" @bind="_formDulTypeId">
                                    @if (_dulTypes is not null)
                                    {
                                        @foreach (var dt in _dulTypes)
                                        {
                                            <option value="@dt.Id">@dt.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-3 @(_selectedDulType?.HasSeries != true ? "invisible" : "")">
                                <label class="form-label">Серия</label>
                                <input class="form-control" @bind="_formPassportSeries" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Номер</label>
                                <input class="form-control" @bind="_formPassportNumber" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Дата выдачи</label>
                                <input type="date" class="form-control" value="@_formPassportIssueDateStr"
                                       @onchange="e => _formPassportIssueDateStr = e.Value?.ToString()" />
                            </div>
