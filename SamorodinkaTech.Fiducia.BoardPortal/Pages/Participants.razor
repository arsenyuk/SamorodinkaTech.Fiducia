    private async Task SaveParticipant()
    {
        _savingParticipant = true;
        _participantError = null;
        StateHasChanged();

        try
        {
            var dto = new
            {
                participantType = _formParticipantType,
                fullName = _formFullName,
                dulTypeId = _formDulTypeId,
                passportSeries = _formPassportSeries,
                passportNumber = _formPassportNumber,
                passportIssuedBy = _formPassportIssuedBy,
                passportIssueDate = DateOnly.TryParse(_formPassportIssueDateStr, out var pid) ? pid : (DateOnly?)null,
                passportDepartmentCode = _formPassportDepartmentCode,
                passportRegistrationAddress = _formPassportRegistrationAddress,
                personInn = _formPersonInn,
                citizenship = _formCitizenship,
                companyName = _formCompanyName,
                companyInn = _formCompanyInn,
                companyOgrn = _formCompanyOgrn,
                companyKpp = _formCompanyKpp,
                companyAddress = _formCompanyAddress,
                ogrnip = _formOgrnip,
                sharePercent = _formSharePercent,
                shareAmount = _formShareAmount,
                paymentInfo = _formPaymentInfo,
                shareRegistrationInfo = _formShareRegistrationInfo,
                entryDate = DateOnly.TryParse(_formEntryDateStr, out var ed) ? ed : (DateOnly?)null,
                exitDate = DateOnly.TryParse(_formExitDateStr, out var xd) ? xd : (DateOnly?)null,
                isActive = string.IsNullOrEmpty(_formExitDateStr)
            };

            HttpResponseMessage response;
            if (_editingParticipant is null)
            {
                response = await Http.PostAsJsonAsync("/api/participants", dto);
            }
            else
            {
                response = await Http.PutAsJsonAsync($"/api/participants/{_editingParticipant.Id}", dto);
            }

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _participantError = $"Ошибка ({(int)response.StatusCode}): {body}";
                return;
            }

            CloseParticipantModal();
            await LoadData();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка сохранения участника");
            _participantError = "Не удалось сохранить участника.";
        }
        finally
        {
            _savingParticipant = false;
        }
    }

