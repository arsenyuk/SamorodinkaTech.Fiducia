    private static ParticipantChangeRow MapChangeToRow(BoardParticipantChange c)
    {
        var computedName = c.ParticipantType == "UL"
            ? c.CompanyName
            : string.Join(" ", new[] { c.LastName, c.FirstName, c.MiddleName }
                .Where(x => !string.IsNullOrWhiteSpace(x)));
        return new ParticipantChangeRow
        {
            Id = c.Id,
            ParticipantId = c.ParticipantId,
            ParticipantType = c.ParticipantType,
            ParticipantName = computedName,
            DocumentOriginalName = c.DocumentOriginalName,
            SubmittedAt = c.SubmittedAt.ToString("dd.MM.yyyy HH:mm"),
            Status = c.Status,
            ReviewComment = c.ReviewComment,
            Source = c.Source,
            Date = c.Date,
            PaperDocNumber = c.PaperDocNumber,
            Comment = c.Comment
        };
    }

    /// <summary>Конвертирует дату из формата dd.MM.yyyy в yyyy-MM-dd для HTML date input.</summary>
    private static string? ToHtmlDate(string? dateStr)
    {
        if (string.IsNullOrEmpty(dateStr)) return null;
        if (DateOnly.TryParseExact(dateStr, "dd.MM.yyyy", out var d))
            return d.ToString("yyyy-MM-dd");
        return dateStr;
    }
