    private List<ParticipantRow> _filteredParticipants => _statusFilter switch
    {
        "active" => _participants.Where(p => p.ExitDate is null).ToList(),
        "exited" => _participants.Where(p => p.ExitDate is not null).ToList(),
        _ => _participants
    };

    // ── Participant modal state ────────────────────────────────────
    private bool _showParticipantModal;
    private bool _savingParticipant;
    private string? _participantError;
    private ParticipantRow? _editingParticipant;

    private string _formParticipantType = "FL";
    private string? _formFullName;
