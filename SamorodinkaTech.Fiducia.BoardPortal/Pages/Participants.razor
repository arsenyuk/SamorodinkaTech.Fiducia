            if (_editingParticipant is null)
            {
                var model = new ParticipantCreateModel
                {
                    LegalEntityId = _leId,
                    ParticipantType = _formParticipantType,
                    DulTypeCode = _dulTypes?.FirstOrDefault(t => t.Id == _formDulTypeId)?.Code,
                    LastName = _formLastName,
                    FirstName = _formFirstName,
                    MiddleName = _formMiddleName,
