@page "/profile"
@using SamorodinkaTech.Fiducia.Domain.Entities
@using SamorodinkaTech.Fiducia.Domain.Interfaces
@using SamorodinkaTech.Fiducia.Infrastructure.Common
@inject IProfileReadService ProfileRead
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Nav
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Fiducia — Профиль</PageTitle>

<div class="container">
    @if (_loading)
    {
        <div class="text-center py-4">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (_person is null && _user is null)
    {
        <div class="alert alert-warning">Профиль не найден.</div>
    }
    else
    {
        <h3 class="mb-4">Профиль</h3>

        @* ── Блок: Основные сведения (всегда виден) ─────────────── *@
        <div class="card mb-4">
            <div class="card-header"><strong>Основные сведения</strong></div>
            <div class="card-body">
                @if (_person is not null)
                {
                    <div class="row mb-2">
                        <div class="col-md-4 text-muted">ФИО</div>
                        <div class="col-md-8">@_person.FullName</div>
                    </div>
                    @if (!string.IsNullOrEmpty(_person.Citizenship))
                    {
                        <div class="row mb-2">
                            <div class="col-md-4 text-muted">Гражданство</div>
                            <div class="col-md-8">@_person.Citizenship</div>
                        </div>
                    }
                }
                else if (_user is not null)
                {
                    <div class="row mb-2">
                        <div class="col-md-4 text-muted">ФИО</div>
                        <div class="col-md-8">@_user.LastName @_user.FirstName</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-4 text-muted">Логин</div>
                        <div class="col-md-8">@_user.Login</div>
                    </div>
                }
                @if (_isParticipant)
                {
                    <hr />
                    <p class="text-muted mb-2">Согласно <LawReferenceLink Article="article-14fz-31-1" Text="п. 3 ст. 31.1 Закона № 14-ФЗ" />, вы обязаны информировать общество об изменении сведений.</p>
                    <a href="/informing" class="btn btn-outline-primary btn-sm">
                        <span class="oi oi-info me-1"></span>Информирование
                    </a>
                }
            </div>
        </div>

        @* ── Вкладки ────────────────────────────────────────────── *@
        <ul class="nav nav-tabs mb-3">
            @if (_legalEntity is not null)
            {
                <li class="nav-item">
                    <button class="nav-link @(_activeTab == "entity" ? "active" : "")" @onclick='() => _activeTab = "entity"'>Юридическое лицо</button>
                </li>
            }
            @if (_identityDocuments.Count > 0)
            {
                <li class="nav-item">
                    <button class="nav-link @(_activeTab == "docs" ? "active" : "")" @onclick='() => _activeTab = "docs"'>ДУЛ</button>
                </li>
            }
            @if (_isParticipant)
            {
                <li class="nav-item">
                    <button class="nav-link @(_activeTab == "history" ? "active" : "")" @onclick='() => _activeTab = "history"'>История информирования</button>
                </li>
            }
        </ul>

        @* ── Вкладка: Юридическое лицо ────────────────────────── *@
        @if (_activeTab == "entity" && _legalEntity is not null)
        {
            <div class="card">
                <div class="card-body">
                    <div class="row mb-2">
                        <div class="col-md-4 text-muted">Наименование</div>
                        <div class="col-md-8">@_legalEntity.Name</div>
                    </div>
                    @if (!string.IsNullOrEmpty(_legalEntity.Inn))
                    {
                        <div class="row mb-2">
                            <div class="col-md-4 text-muted">ИНН</div>
                            <div class="col-md-8">@_legalEntity.Inn</div>
                        </div>
                    }
                    @if (_participant is not null)
                    {
                        <div class="row mb-2">
                            <div class="col-md-4 text-muted">Статус</div>
                            <div class="col-md-8">
                                @if (_participant.IsActive)
                                {
                                    <span class="badge bg-success">Действующий участник</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Не активен</span>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(_boardRoleName))
                        {
                            <div class="row mb-2">
                                <div class="col-md-4 text-muted">Должность в СД</div>
                                <div class="col-md-8">@_boardRoleName</div>
                            </div>
                        }
                        @if (_participant.IsGeneralDirector)
                        {
                            <div class="row mb-2">
                                <div class="col-md-4 text-muted">Генеральный директор</div>
                                <div class="col-md-8"><span class="badge bg-primary">ГД</span></div>
                            </div>
                        }
                        @if (_participant.EntryDate.HasValue)
                        {
                            <div class="row mb-2">
                                <div class="col-md-4 text-muted">Дата вхождения</div>
                                <div class="col-md-8">@_participant.EntryDate.Value.ToString("dd.MM.yyyy")</div>
                            </div>
                        }
                    }
                    @if (_share is not null)
                    {
                        <hr />
                        <h6 class="mb-3">Доля в уставном капитале</h6>
                        @if (_share.SharePercent.HasValue)
                        {
                            <div class="row mb-2">
                                <div class="col-md-4 text-muted">Процент доли</div>
                                <div class="col-md-8">@_share.SharePercent.Value.ToString("N2")%</div>
                            </div>
                        }
                        @if (_share.ShareAmount.HasValue)
                        {
                            <div class="row mb-2">
                                <div class="col-md-4 text-muted">Номинальная стоимость</div>
                                <div class="col-md-8">@_share.ShareAmount.Value.ToString("N2") ₽</div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_share.PaymentInfo))
                        {
                            <div class="row mb-2">
                                <div class="col-md-4 text-muted">Оплата</div>
                                <div class="col-md-8">@_share.PaymentInfo</div>
                            </div>
                        }
                    }
                </div>
            </div>
        }

        @* ── Вкладка: ДУЛ ────────────────────────────────────── *@
        @if (_activeTab == "docs")
        {
            <div class="card">
                <div class="card-body">
                    @if (_person is not null)
                    {
                        @if (!string.IsNullOrEmpty(_person.Inn))
                        {
                            <div class="row mb-2">
                                <div class="col-md-4 text-muted">ИНН</div>
                                <div class="col-md-8">@_person.Inn</div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_person.Snils))
                        {
                            <div class="row mb-2">
                                <div class="col-md-4 text-muted">СНИЛС</div>
                                <div class="col-md-8">@_person.Snils</div>
                            </div>
                        }
                        <hr />
                    }
                    <div class="accordion" id="docsAccordion">
                        @foreach (var (doc, index) in _identityDocuments.Select((d, i) => (d, i)))
                        {
                            var collapseId = $"docCollapse{index}";
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                            aria-expanded="false" aria-controls="@collapseId">
                                        @(doc.DulType?.Name ?? "Документ") — @(doc.Series) @(doc.Number)
                                        @if (doc.IsActive)
                                        {
                                            <span class="badge bg-success ms-2">Активный</span>
                                        }
                                    </button>
                                </h2>
                                <div id="@collapseId" class="accordion-collapse collapse" data-bs-parent="#docsAccordion">
                                    <div class="accordion-body">
                                        @if (!string.IsNullOrEmpty(doc.IssuedBy))
                                        {
                                            <div class="row mb-2">
                                                <div class="col-md-4 text-muted">Кем выдан</div>
                                                <div class="col-md-8">@doc.IssuedBy</div>
                                            </div>
                                        }
                                        @if (doc.IssueDate.HasValue)
                                        {
                                            <div class="row mb-2">
                                                <div class="col-md-4 text-muted">Дата выдачи</div>
                                                <div class="col-md-8">@doc.IssueDate.Value.ToString("dd.MM.yyyy")</div>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(doc.DepartmentCode))
                                        {
                                            <div class="row mb-2">
                                                <div class="col-md-4 text-muted">Код подразделения</div>
                                                <div class="col-md-8">@doc.DepartmentCode</div>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(doc.RegistrationAddress))
                                        {
                                            <div class="row mb-2">
                                                <div class="col-md-4 text-muted">Адрес регистрации</div>
                                                <div class="col-md-8">@doc.RegistrationAddress</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @* ── Вкладка: История информирования ────────────────────── *@
        @if (_activeTab == "history")
        {
            <div class="card">
                <div class="card-body">
                    @if (_changeHistoryItems.Count == 0)
                    {
                        <p class="text-muted mb-0">Информирование ещё не подавалось.</p>
                    }
                    else
                    {
                    <table class="table table-sm table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Дата подачи</th>
                                <th>Что изменено</th>
                                <th>Статус</th>
                                <th>Рассмотрел</th>
                                <th>Комментарий</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ch in _changeHistoryItems)
                            {
                                <tr>
                                    <td>@ch.SubmittedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@ch.Description</td>
                                    <td>@GetStatusBadge(ch.Status)</td>
                                    <td>@(ch.ReviewedByLogin ?? "—")</td>
                                    <td>@(ch.ReviewComment ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private bool _loading = true;
    private string _activeTab = "entity";
    private User? _user;
    private Person? _person;
    private LegalEntity? _legalEntity;
    private BoardParticipant? _participant;
    private BoardParticipantShare? _share;
    private string? _boardRoleName;
    private List<IdentityDocument> _identityDocuments = new();
    private bool _isParticipant;
    private List<ChangeHistoryItem> _changeHistoryItems = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userId = UserContextHelper.GetUserIdAsync(HttpContextAccessor.HttpContext!);
            if (userId is null) return;

            var profile = await ProfileRead.GetProfileAsync(userId.Value);
            if (profile is null) return;

            _user = profile.User;
            _person = profile.Person;
            _legalEntity = profile.LegalEntity;
            _participant = profile.Participant;
            _share = profile.Share;
            _boardRoleName = profile.BoardRoleName;
            _identityDocuments = profile.IdentityDocuments;
            _isParticipant = profile.IsParticipant;
            _changeHistoryItems = profile.ChangeHistory;

            // Вкладка по умолчанию — первая доступная
            if (_legalEntity is null && _identityDocuments.Count == 0 && _changeHistoryItems.Count == 0)
                _activeTab = "";
        }
        catch (Exception ex)
        {
            // Логирование опущено — профиль не критичен
        }
        finally
        {
            _loading = false;
        }
    }

    private static MarkupString GetStatusBadge(string? status) => status switch
    {
        "pending" => new("<span class='badge bg-warning text-dark'>Ожидает</span>"),
        "approved" => new("<span class='badge bg-success'>Одобрено</span>"),
        "rejected" => new("<span class='badge bg-danger'>Отклонено</span>"),
        _ => new($"<span class='badge bg-secondary'>{status ?? "—"}</span>")
    };
}
