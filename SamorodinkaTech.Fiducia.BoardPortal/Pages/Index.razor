@page "/"
@inject NavigationManager Nav
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@inject IJSRuntime JS
@using SamorodinkaTech.Fiducia.Domain.Entities
@using SamorodinkaTech.Fiducia.Domain.Validation

<div class="d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="text-center">
        <h1 class="mb-2">Fiducia</h1>
        <p class="text-muted mb-4">Цифровой Совет Директоров</p>
        <div class="d-flex gap-3 justify-content-center">
            <a href="/login" class="btn btn-primary btn-lg px-4">Войти в кабинет</a>
            @if (_showProposalButton)
            {
                <a href="/proposal" class="btn btn-outline-primary btn-lg px-4">Подать вопрос в СД</a>
            }
        </div>
    </div>
</div>

@code {
    private bool _showProposalButton = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var leId = await LegalEntityHelper.GetLegalEntityIdAsync(ctx, JS);
            if (leId is null)
            {
                _showProposalButton = false;
                StateHasChanged();
                return;
            }
            var le = await ctx.LegalEntities
                .Where(x => x.Id == leId.Value)
                .Select(x => new { x.RefOkopf!.Code })
                .FirstOrDefaultAsync();
            if (le is null)
            {
                _showProposalButton = false;
                StateHasChanged();
                return;
            }
            if (OkopfTypeMapper.IsPjsc(le.Code) || le.Code == OkopfTypeMapper.NjscCode)
            {
                _showProposalButton = true;
            }
            else
            {
                var charter = await ctx.LegalEntityCharters
                    .FindAsync(leId.Value);
                _showProposalButton = charter?.HasBoardOfDirectors ?? false;
            }
        }
        catch
        {
            _showProposalButton = false;
        }
        StateHasChanged();
    }
}
