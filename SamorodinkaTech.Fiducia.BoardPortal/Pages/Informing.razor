@page "/informing"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Json
@using SamorodinkaTech.Fiducia.Domain.Entities
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@inject HttpClient Http
@inject IHttpContextAccessor HttpContextAccessor
@inject ILogger<Informing> Logger
@inject NavigationManager Nav
@inject IParticipantWriteService ParticipantWrite
@inject IInformingService InformingSvc
@using SamorodinkaTech.Fiducia.Domain.Interfaces
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "PARTICIPANT")]

<PageTitle>Fiducia — Информирование</PageTitle>

<h3>Информирование об изменении сведений</h3>

<p class="text-muted">
    Согласно <LawReferenceLink Article="article-14fz-31-1" Text="п. 3 ст. 31.1 Закона № 14-ФЗ" />, участник обязан информировать общество об изменении сведений
    (ФИО, адрес, email, доля и т.д.).
</p>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_success is not null)
{
    <div class="alert alert-success">@_success</div>
}

@* ── Форма подачи информирования ────────────────────────────────── *@
<div class="card mb-4">
    <div class="card-body">
        @if (_currentParticipant is null)
        {
            <div class="alert alert-warning">Участник не найден в реестре.</div>
        }
        else
        {
            @if (_currentParticipant.ParticipantType == "FL")
            {
                <div class="row mb-3 align-items-center">
                    <div class="col-auto">
                        <span class="text-muted me-1">Фамилия <span class="text-danger">*</span></span>
                        <input class="form-control d-inline-block" style="width:180px" @bind="_formLastName" required />
                    </div>
                    <div class="col-auto">
                        <span class="text-muted me-1">Имя <span class="text-danger">*</span></span>
                        <input class="form-control d-inline-block" style="width:150px" @bind="_formFirstName" required />
                    </div>
                    <div class="col-auto">
                        <span class="text-muted me-1">Отчество</span>
                        <input class="form-control d-inline-block" style="width:180px" @bind="_formMiddleName" />
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <div class="col-auto">
                        <span class="text-muted me-1">ИНН</span>
                        <input class="form-control d-inline-block" style="width:140px" @bind="_formPersonInn" />
                    </div>
                    <div class="col-auto">
                        <span class="text-muted me-1">СНИЛС</span>
                        <input class="form-control d-inline-block" style="width:140px" @bind="_formSnils" />
                    </div>
                    <div class="col-auto">
                        <span class="text-muted me-1">Гражданство</span>
                        <input class="form-control d-inline-block" style="width:220px" @bind="_formCitizenship" />
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <div class="col-auto">
                        <label class="form-label mb-0">Вид документа</label>
                    </div>
                    <div class="col">
                        <select class="form-select" @bind="_currentParticipant.DulTypeId">
                            @if (_dulTypes is not null)
                            {
                                @foreach (var dt in _dulTypes)
                                {
                                    <option value="@dt.Id">@dt.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <div class="col-auto @(_dulTypes?.FirstOrDefault(t => t.Id == _currentParticipant.DulTypeId)?.HasSeries != true ? "d-none" : "")">
                        <span class="text-muted me-1">Серия</span>
                        <input class="form-control d-inline-block" style="width:80px" @bind="_formPassportSeries" />
                    </div>
                    <div class="col-auto">
                        <span class="text-muted me-1">Номер</span>
                        <input class="form-control d-inline-block" style="width:100px" @bind="_formPassportNumber" />
                    </div>
                    <div class="col-auto @(_dulTypes?.FirstOrDefault(t => t.Id == _currentParticipant.DulTypeId)?.HasDepartmentCode != true ? "d-none" : "")">
                        <span class="text-muted me-1">Код подр.</span>
                        <input class="form-control d-inline-block" style="width:100px" @bind="_formPassportDepartmentCode" />
                    </div>
                    <div class="col-auto">
                        <span class="text-muted me-1">Дата выдачи</span>
                        <input type="date" class="form-control d-inline-block" style="width:150px" value="@_formPassportIssueDateStr"
                               @onchange="e => _formPassportIssueDateStr = e.Value?.ToString()" />
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Кем выдан</label>
                        <input class="form-control" @bind="_formPassportIssuedBy" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Адрес регистрации</label>
                        <input class="form-control" @bind="_formPassportRegistrationAddress" />
                    </div>
                </div>
            }
            else if (_currentParticipant.ParticipantType == "UL")
            {
                <h6 class="mt-3">Данные юридического лица</h6>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Наименование</label>
                        <input class="form-control" @bind="_formCompanyName" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">ИНН</label>
                        <input class="form-control" @bind="_formCompanyInn" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">ОГРН</label>
                        <input class="form-control" @bind="_formCompanyOgrn" />
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">КПП</label>
                        <input class="form-control" @bind="_formCompanyKpp" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">Адрес</label>
                        <input class="form-control" @bind="_formCompanyAddress" />
                    </div>
                </div>
            }
            else if (_currentParticipant.ParticipantType == "IP")
            {
                <h6 class="mt-3">Данные ИП</h6>
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Фамилия</label>
                        <input class="form-control" @bind="_formLastName" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Имя</label>
                        <input class="form-control" @bind="_formFirstName" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Отчество</label>
                        <input class="form-control" @bind="_formMiddleName" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">ИНН</label>
                        <input class="form-control" @bind="_formPersonInn" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">ОГРНИП</label>
                        <input class="form-control" @bind="_formOgrnip" />
                    </div>
                </div>
            }

            <h6 class="mt-3">Доля в уставном капитале</h6>
            <div class="row mb-3">
                <div class="col-md-3">
                    <label class="form-label">Размер доли</label>
                    <div class="input-group">
                        <select class="form-select form-select-sm" style="max-width:110px" @bind="_formShareMode">
                            <option value="fraction">Дробь</option>
                            <option value="percent">Процент</option>
                        </select>
                        @if (_formShareMode == "fraction")
                        {
                            <input type="text" class="form-control" @bind="_formShareInput" placeholder="1/3" />
                        }
                        else
                        {
                            <input type="text" class="form-control" @bind="_formShareInput" placeholder="50" />
                            <span class="input-group-text">%</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(_shareError))
                    {
                        <div class="text-danger small">@_shareError</div>
                    }
                </div>
                <div class="col-md-3">
                    <label class="form-label">Номинальная стоимость (руб.)</label>
                    <input type="number" step="0.01" class="form-control" @bind="_formShareAmount" />
                </div>
            </div>

            <h6 class="mt-3">Документ-подтверждение</h6>
            <div class="row mb-3">
                <div class="col-md-6">
                    <InputFile OnChange="OnDocumentSelected" accept=".pdf,.doc,.docx,.jpg,.png"
                               class="form-control" disabled="@_isSubmitting" />
                    @if (_selectedDocumentName is not null)
                    {
                        <div class="form-text">Выбран: @_selectedDocumentName</div>
                    }
                </div>
            </div>

            <button class="btn btn-primary" @onclick="SubmitInforming" disabled="@_isSubmitting">
                @if (_isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                Отправить информацию
            </button>
        }
    </div>
</div>



@code {
    private string? _error;
    private string? _success;
    private bool _loading = true;
    private bool _isSubmitting;

    private ParticipantRow? _currentParticipant;
    private List<ChangeRow> _myChanges = new();

    // ── Form state ──────────────────────────────────────────────────
    private IBrowserFile? _selectedDocument;
    private string? _selectedDocumentName;

    private string? _formLastName;
    private string? _formFirstName;
    private string? _formMiddleName;
    private string? _formPersonInn;
    private string? _formSnils;
    private string? _formCitizenship;
    private string? _formPassportSeries;
    private string? _formPassportNumber;
    private string? _formPassportIssuedBy;
    private string? _formPassportIssueDateStr;
    private string? _formPassportDepartmentCode;
    private string? _formPassportRegistrationAddress;
    private string? _formCompanyName;
    private string? _formCompanyInn;
    private string? _formCompanyOgrn;
    private string? _formCompanyKpp;
    private string? _formCompanyAddress;
    private string? _formOgrnip;
    private string? _formShareInput;
    private string _formShareMode = "fraction";
    private string? _shareError;
    private decimal? _formShareAmount;

    protected override async Task OnInitializedAsync() { await LoadAsync(); }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            // Определяем текущего участника по userId из JWT
            var userId = SamorodinkaTech.Fiducia.Infrastructure.Common.UserContextHelper.GetUserIdAsync(HttpContextAccessor.HttpContext!);
            if (userId is null)
            {
                Logger.LogWarning("Не удалось определить пользователя из JWT");
                _error = "Не удалось определить пользователя.";
                return;
            }

            await using var ctx = await DbFactory.CreateDbContextAsync();
            var leId = await LegalEntityHelper.GetLegalEntityIdAsync(ctx, HttpContextAccessor);
            if (leId is null)
            {
                Logger.LogWarning("Не удалось определить юридическое лицо для пользователя {UserId}", userId);
                _error = "Не удалось определить юридическое лицо.";
                return;
            }

            // Загружаем данные участника через сервис
            var participantDto = await InformingSvc.GetCurrentParticipantAsync(userId.Value, leId.Value);

            if (participantDto is not null)
            {
                _currentParticipant = new ParticipantRow
                {
                    Id = participantDto.ParticipantId,
                    ParticipantType = participantDto.ParticipantType,
                    FullName = participantDto.FullName,
                    LastName = participantDto.LastName,
                    FirstName = participantDto.FirstName,
                    MiddleName = participantDto.MiddleName,
                    DulTypeId = participantDto.DulTypeId,
                    DulSeries = participantDto.DulSeries,
                    DulNumber = participantDto.DulNumber,
                    PassportIssuedBy = participantDto.PassportIssuedBy,
                    PassportIssueDate = participantDto.PassportIssueDate,
                    PassportDepartmentCode = participantDto.PassportDepartmentCode,
                    PassportRegistrationAddress = participantDto.PassportRegistrationAddress,
                    PersonInn = participantDto.PersonInn,
                    Snils = participantDto.Snils,
                    Citizenship = participantDto.Citizenship,
                    CompanyName = participantDto.CompanyName,
                    CompanyInn = participantDto.CompanyInn,
                    CompanyOgrn = participantDto.CompanyOgrn,
                    CompanyKpp = participantDto.CompanyKpp,
                    CompanyAddress = participantDto.CompanyAddress,
                    Ogrnip = participantDto.Ogrnip,
                    SharePercent = participantDto.SharePercent,
                    ShareAmount = participantDto.ShareAmount,
                };
            }

            _dulTypes = await ctx.RefDulTypes.OrderBy(t => t.SortOrder).ToListAsync();

            if (_currentParticipant is not null)
            {
                PreFillForm(_currentParticipant);
            }

            if (_currentParticipant is not null)
            {
                var historyItems = await InformingSvc.GetChangeHistoryAsync(_currentParticipant.Id);
                _myChanges = historyItems.Select(c => new ChangeRow
                {
                    Id = c.Id,
                    ParticipantId = _currentParticipant.Id,
                    SubmittedAt = c.SubmittedAt.ToString("dd.MM.yyyy HH:mm"),
                    Status = c.Status,
                    ReviewComment = c.ReviewComment,
                    ReviewedByName = c.ReviewedByLogin,
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки данных");
            _error = "Не удалось загрузить данные.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void PreFillForm(ParticipantRow p)
    {
        _formLastName = p.LastName;
        _formFirstName = p.FirstName;
        _formMiddleName = p.MiddleName;
        _formPersonInn = p.PersonInn;
        _formSnils = p.Snils;
        _formCitizenship = p.Citizenship;
        _formPassportSeries = p.DulSeries;
        _formPassportNumber = p.DulNumber;
        _formPassportIssuedBy = p.PassportIssuedBy;
        _formPassportIssueDateStr = p.PassportIssueDate?.ToString("yyyy-MM-dd");
        _formPassportDepartmentCode = p.PassportDepartmentCode;
        _formPassportRegistrationAddress = p.PassportRegistrationAddress;
        _formCompanyName = p.CompanyName;
        _formCompanyInn = p.CompanyInn;
        _formCompanyOgrn = p.CompanyOgrn;
        _formCompanyKpp = p.CompanyKpp;
        _formCompanyAddress = p.CompanyAddress;
        _formOgrnip = p.Ogrnip;
        _formShareInput = !string.IsNullOrEmpty(p.ShareFraction) ? p.ShareFraction : p.SharePercent?.ToString("0.##");
        _formShareMode = !string.IsNullOrEmpty(p.ShareFraction) ? "fraction" : "percent";
        _formShareAmount = p.ShareAmount;
        _shareError = null;
    }

    private void OnDocumentSelected(InputFileChangeEventArgs e)
    {
        _selectedDocument = e.File;
        _selectedDocumentName = e.File.Name;
    }

    private bool HasChanges()
    {
        if (_currentParticipant is null) return false;

        static string? Norm(string? s) => s?.Trim();

        return !string.Equals(Norm(_formLastName), Norm(_currentParticipant.LastName), StringComparison.Ordinal)
            || !string.Equals(Norm(_formFirstName), Norm(_currentParticipant.FirstName), StringComparison.Ordinal)
            || !string.Equals(Norm(_formMiddleName), Norm(_currentParticipant.MiddleName), StringComparison.Ordinal)
            || !string.Equals(Norm(_formPersonInn), Norm(_currentParticipant.PersonInn), StringComparison.Ordinal)
            || !string.Equals(Norm(_formSnils), Norm(_currentParticipant.Snils), StringComparison.Ordinal)
            || !string.Equals(Norm(_formCitizenship), Norm(_currentParticipant.Citizenship), StringComparison.Ordinal)
            || !string.Equals(Norm(_formPassportSeries), Norm(_currentParticipant.DulSeries), StringComparison.Ordinal)
            || !string.Equals(Norm(_formPassportNumber), Norm(_currentParticipant.DulNumber), StringComparison.Ordinal)
            || !string.Equals(Norm(_formPassportIssuedBy), Norm(_currentParticipant.PassportIssuedBy), StringComparison.Ordinal)
            || !string.Equals(Norm(_formPassportDepartmentCode), Norm(_currentParticipant.PassportDepartmentCode), StringComparison.Ordinal)
            || !string.Equals(Norm(_formPassportRegistrationAddress), Norm(_currentParticipant.PassportRegistrationAddress), StringComparison.Ordinal)
            || !string.Equals(Norm(_formCompanyName), Norm(_currentParticipant.CompanyName), StringComparison.Ordinal)
            || !string.Equals(Norm(_formCompanyInn), Norm(_currentParticipant.CompanyInn), StringComparison.Ordinal)
            || !string.Equals(Norm(_formCompanyOgrn), Norm(_currentParticipant.CompanyOgrn), StringComparison.Ordinal)
            || !string.Equals(Norm(_formCompanyKpp), Norm(_currentParticipant.CompanyKpp), StringComparison.Ordinal)
            || !string.Equals(Norm(_formCompanyAddress), Norm(_currentParticipant.CompanyAddress), StringComparison.Ordinal)
            || !string.Equals(Norm(_formOgrnip), Norm(_currentParticipant.Ogrnip), StringComparison.Ordinal)
            || Norm(_formShareInput) != Norm(!string.IsNullOrEmpty(_currentParticipant.ShareFraction)
                ? _currentParticipant.ShareFraction
                : _currentParticipant.SharePercent?.ToString("0.##"))
            || _formShareAmount != _currentParticipant.ShareAmount;
    }

    private async Task SubmitInforming()
    {
        if (_currentParticipant is null) return;

        if (_currentParticipant.ParticipantType == "FL")
        {
            if (string.IsNullOrWhiteSpace(_formLastName) || string.IsNullOrWhiteSpace(_formFirstName))
            {
                _error = "Фамилия и Имя обязательны";
                StateHasChanged();
                return;
            }

            if (!string.IsNullOrWhiteSpace(_formSnils))
            {
                var digitsOnly = new string(_formSnils.Where(c => char.IsDigit(c)).ToArray());
                if (digitsOnly.Length != 11)
                {
                    _error = "СНИЛС должен содержать 11 цифр";
                    StateHasChanged();
                    return;
                }
            }
        }

        // Проверяем, есть ли изменения относительно текущих сведений
        if (!HasChanges() && _selectedDocument is null)
        {
            _error = "Изменения не обнаружены. Отредактируйте сведения или прикрепите документ для подачи информирования.";
            StateHasChanged();
            return;
        }

        _isSubmitting = true;
        _error = null;
        _success = null;
        StateHasChanged();

        try
        {
            var userId = SamorodinkaTech.Fiducia.Infrastructure.Common.UserContextHelper.GetUserIdAsync(HttpContextAccessor.HttpContext!) ?? Guid.Empty;
            var clientIp = HttpContextAccessor.HttpContext?.Connection?.RemoteIpAddress?.ToString() ?? "unknown";

            var leId = await LegalEntityHelper.GetLegalEntityIdAsync(
                await DbFactory.CreateDbContextAsync(), HttpContextAccessor);
            if (leId is null)
            {
                Logger.LogWarning("Не удалось определить юридическое лицо для пользователя {UserId}", userId);
                _error = "Не удалось определить юридическое лицо.";
                return;
            }

            // Создаём запись информирования
            decimal? parsedSharePercent = null;
            string? parsedShareFraction = null;
            if (!string.IsNullOrWhiteSpace(_formShareInput))
            {
                try
                {
                    (parsedSharePercent, parsedShareFraction) = SamorodinkaTech.Fiducia.Infrastructure.Common.ShareParser.Parse(_formShareInput);
                }
                catch (ArgumentException ex)
                {
                    _shareError = ex.Message;
                    _isSubmitting = false;
                    StateHasChanged();
                    return;
                }
            }

            var model = new ChangeCreateModel
            {
                LegalEntityId = leId.Value,
                ParticipantId = _currentParticipant.Id,
                ParticipantType = _currentParticipant.ParticipantType ?? "FL",
                LastName = _formLastName,
                FirstName = _formFirstName,
                MiddleName = _formMiddleName,
                DulTypeId = _currentParticipant.DulTypeId,
                PassportSeries = _formPassportSeries ?? _currentParticipant.DulSeries,
                PassportNumber = _formPassportNumber ?? _currentParticipant.DulNumber,
                PassportIssuedBy = _formPassportIssuedBy ?? _currentParticipant.PassportIssuedBy,
                PassportDepartmentCode = _formPassportDepartmentCode ?? _currentParticipant.PassportDepartmentCode,
                PassportRegistrationAddress = _formPassportRegistrationAddress ?? _currentParticipant.PassportRegistrationAddress,
                PersonInn = _formPersonInn ?? _currentParticipant.PersonInn,
                Citizenship = _formCitizenship ?? _currentParticipant.Citizenship,
                CompanyName = _formCompanyName ?? _currentParticipant.CompanyName,
                CompanyInn = _formCompanyInn ?? _currentParticipant.CompanyInn,
                CompanyOgrn = _formCompanyOgrn ?? _currentParticipant.CompanyOgrn,
                CompanyKpp = _formCompanyKpp ?? _currentParticipant.CompanyKpp,
                CompanyAddress = _formCompanyAddress ?? _currentParticipant.CompanyAddress,
                Ogrnip = _formOgrnip ?? _currentParticipant.Ogrnip,
                SharePercent = parsedSharePercent ?? _currentParticipant.SharePercent,
                ShareFraction = parsedShareFraction ?? _currentParticipant.ShareFraction,
                ShareAmount = _formShareAmount ?? _currentParticipant.ShareAmount,
                Source = "electronic"
            };

            var changeId = await ParticipantWrite.CreateChangeAsync(model, userId, clientIp);

            // Загружаем документ (если выбран)
            if (_selectedDocument is not null)
            {
                using var stream = _selectedDocument.OpenReadStream(10 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                ms.Position = 0;
                var contentType = _selectedDocument.ContentType ?? "application/octet-stream";
                await ParticipantWrite.UploadChangeDocumentAsync(changeId, ms, _selectedDocumentName ?? "document.pdf", contentType, userId, clientIp);
            }

            _success = "Информирование успешно подано.";
            ResetForm();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка подачи информирования");
            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        _selectedDocument = null;
        _selectedDocumentName = null;
        // Предзаполняем заново из текущего участника
        if (_currentParticipant is not null)
            PreFillForm(_currentParticipant);
    }

    private class ParticipantRow
    {
        public Guid Id { get; set; }
        public string? ParticipantType { get; set; }
        public string? FullName { get; set; }
        public string? LastName { get; set; }
        public string? FirstName { get; set; }
        public string? MiddleName { get; set; }
        public Guid? DulTypeId { get; set; }
        public string? DulSeries { get; set; }
        public string? DulNumber { get; set; }
        public string? CompanyName { get; set; }
        public string? PersonInn { get; set; }
        public string? Snils { get; set; }
        public string? Citizenship { get; set; }
        public string? PassportIssuedBy { get; set; }
        public DateOnly? PassportIssueDate { get; set; }
        public string? PassportDepartmentCode { get; set; }
        public string? PassportRegistrationAddress { get; set; }
        public string? CompanyInn { get; set; }
        public string? CompanyOgrn { get; set; }
        public string? CompanyKpp { get; set; }
        public string? CompanyAddress { get; set; }
        public string? Ogrnip { get; set; }
        public decimal? SharePercent { get; set; }
        public string? ShareFraction { get; set; }
        public decimal? ShareAmount { get; set; }
    }

    private class ChangeRow
    {
        public Guid Id { get; set; }
        public Guid ParticipantId { get; set; }
        public string? ParticipantType { get; set; }
        public string? DocumentOriginalName { get; set; }
        public string? SubmittedAt { get; set; }
        public string? Status { get; set; }
        public string? ReviewComment { get; set; }
        public string? ReviewedByName { get; set; }
    }

    private class UploadDocumentResult
    {
        public Guid FileId { get; set; }
        public string OriginalName { get; set; } = null!;
    }

    private List<RefDulType>? _dulTypes;

    private static ParticipantRow MapToParticipantRow(BoardParticipant bp, Person? person, IdentityDocument? doc)
    {
        var activeCompany = bp.Companies.FirstOrDefault();
        var activeShare = bp.Shares.FirstOrDefault();

        return new ParticipantRow
        {
            Id = bp.Id,
            ParticipantType = bp.ParticipantType,
            FullName = person?.FullName,
            LastName = person?.LastName,
            FirstName = person?.FirstName,
            MiddleName = person?.MiddleName,
            DulTypeId = doc?.DulTypeId,
            DulSeries = doc?.Series,
            DulNumber = doc?.Number,
            PassportIssuedBy = doc?.IssuedBy,
            PassportDepartmentCode = doc?.DepartmentCode,
            PassportRegistrationAddress = doc?.RegistrationAddress,
            PersonInn = person?.Inn,
            Citizenship = person?.Citizenship,
            CompanyName = activeCompany?.CompanyName ?? bp.CompanyName,
            CompanyInn = activeCompany?.CompanyInn ?? bp.CompanyInn,
            CompanyOgrn = activeCompany?.CompanyOgrn ?? bp.CompanyOgrn,
            CompanyKpp = activeCompany?.CompanyKpp ?? bp.CompanyKpp,
            CompanyAddress = activeCompany?.CompanyAddress ?? bp.CompanyAddress,
            Ogrnip = person?.Ogrnip,
            SharePercent = activeShare?.SharePercent,
            ShareFraction = activeShare?.ShareFraction,
            ShareAmount = activeShare?.ShareAmount,
        };
    }
}
