@page "/informing"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Json
@using SamorodinkaTech.Fiducia.Domain.Entities
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@inject HttpClient Http
@inject ILogger<Informing> Logger
@inject NavigationManager Nav
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "PARTICIPANT")]

<PageTitle>Fiducia — Информирование</PageTitle>

<h3>Информирование об изменении сведений</h3>

<p class="text-muted">
    Согласно п. 3 ст. 31.1 Закона № 14-ФЗ, участник обязан информировать общество об изменении сведений
    (ФИО, адрес, email, доля и т.д.).
</p>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_success is not null)
{
    <div class="alert alert-success">@_success</div>
}

@* ── Форма подачи информирования ────────────────────────────────── *@
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Подача информации об изменении сведений</h5>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Участник</label>
                <select class="form-select" @bind="_selectedParticipantId">
                    <option value="">— Выберите участника —</option>
                    @foreach (var p in _participants)
                    {
                        <option value="@p.Id">
                            @(p.ParticipantType == "FL" ? p.FullName : p.CompanyName) (@p.ParticipantType)
                        </option>
                    }
                </select>
            </div>
        </div>

        @if (_selectedParticipantId is not null)
        {
            var participant = _participants.FirstOrDefault(p => p.Id.ToString() == _selectedParticipantId);

            @if (participant?.ParticipantType == "FL")
            {
                <h6 class="mt-3">Данные физического лица</h6>
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">ФИО</label>
                        <input class="form-control" @bind="_formFullName" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">ИНН</label>
                        <input class="form-control" @bind="_formPersonInn" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Гражданство</label>
                        <input class="form-control" @bind="_formCitizenship" />
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label class="form-label">Серия паспорта</label>
                        <input class="form-control" @bind="_formPassportSeries" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Номер паспорта</label>
                        <input class="form-control" @bind="_formPassportNumber" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Код подразделения</label>
                        <input class="form-control" @bind="_formPassportDepartmentCode" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Дата выдачи</label>
                        <input type="date" class="form-control" value="@_formPassportIssueDateStr"
                               @onchange="e => _formPassportIssueDateStr = e.Value?.ToString()" />
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Кем выдан</label>
                        <input class="form-control" @bind="_formPassportIssuedBy" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Адрес регистрации</label>
                        <input class="form-control" @bind="_formPassportRegistrationAddress" />
                    </div>
                </div>
            }
            else if (participant?.ParticipantType == "UL")
            {
                <h6 class="mt-3">Данные юридического лица</h6>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Наименование</label>
                        <input class="form-control" @bind="_formCompanyName" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">ИНН</label>
                        <input class="form-control" @bind="_formCompanyInn" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">ОГРН</label>
                        <input class="form-control" @bind="_formCompanyOgrn" />
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">КПП</label>
                        <input class="form-control" @bind="_formCompanyKpp" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">Адрес</label>
                        <input class="form-control" @bind="_formCompanyAddress" />
                    </div>
                </div>
            }
            else if (participant?.ParticipantType == "IP")
            {
                <h6 class="mt-3">Данные ИП</h6>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">ФИО</label>
                        <input class="form-control" @bind="_formFullName" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">ИНН</label>
                        <input class="form-control" @bind="_formPersonInn" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">ОГРНИП</label>
                        <input class="form-control" @bind="_formOgrnip" />
                    </div>
                </div>
            }

            <h6 class="mt-3">Доля в уставном капитале</h6>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">Размер доли (%)</label>
                    <input type="number" step="0.01" class="form-control" @bind="_formSharePercent" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Номинальная стоимость (руб.)</label>
                    <input type="number" step="0.01" class="form-control" @bind="_formShareAmount" />
                </div>
            </div>

            <h6 class="mt-3">Документ-подтверждение</h6>
            <div class="row mb-3">
                <div class="col-md-6">
                    <InputFile OnChange="OnDocumentSelected" accept=".pdf,.doc,.docx,.jpg,.png"
                               class="form-control" disabled="@_isSubmitting" />
                    @if (_selectedDocumentName is not null)
                    {
                        <div class="form-text">Выбран: @_selectedDocumentName</div>
                    }
                </div>
            </div>

            <button class="btn btn-primary" @onclick="SubmitInforming" disabled="@_isSubmitting">
                @if (_isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                Отправить информацию
            </button>
        }
    </div>
</div>

@* ── Список поданных информирований ──────────────────────────────── *@
<h5>Мои информирования</h5>

@if (_loading)
{
    <div class="text-center py-4">
        <div class="spinner-border text-primary"></div>
    </div>
}
else if (_myChanges.Count == 0)
{
    <div class="text-muted">Вы ещё не подавали информирований.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th style="width: 40px;">№</th>
                    <th>Участник</th>
                    <th>Тип</th>
                    <th>Документ</th>
                    <th>Дата подачи</th>
                    <th>Статус</th>
                    <th>Комментарий</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (c, idx) in _myChanges.Select((c, i) => (c, i)))
                {
                    var participant = _participants.FirstOrDefault(p => p.Id == c.ParticipantId);
                    <tr>
                        <td>@(idx + 1)</td>
                        <td>@(participant?.FullName ?? participant?.CompanyName ?? "—")</td>
                        <td>
                            @if (c.ParticipantType == "FL")
                            {
                                <span class="badge bg-info">ФЛ</span>
                            }
                            else if (c.ParticipantType == "UL")
                            {
                                <span class="badge bg-primary">ЮЛ</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">ИП</span>
                            }
                        </td>
                        <td class="small">@(c.DocumentOriginalName ?? "—")</td>
                        <td class="small">@c.SubmittedAt</td>
                        <td>
                            @if (c.Status == "pending")
                            {
                                <span class="badge bg-warning text-dark">Ожидает</span>
                            }
                            else if (c.Status == "approved")
                            {
                                <span class="badge bg-success">Утверждено</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Отклонено</span>
                            }
                        </td>
                        <td class="small">@(c.ReviewComment ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private string? _error;
    private string? _success;
    private bool _loading = true;
    private bool _isSubmitting;

    private List<ParticipantRow> _participants = new();
    private List<ChangeRow> _myChanges = new();

    // ── Form state ──────────────────────────────────────────────────
    private string? _selectedParticipantId;
    private IBrowserFile? _selectedDocument;
    private string? _selectedDocumentName;

    private string? _formFullName;
    private string? _formPersonInn;
    private string? _formCitizenship;
    private string? _formPassportSeries;
    private string? _formPassportNumber;
    private string? _formPassportIssuedBy;
    private string? _formPassportIssueDateStr;
    private string? _formPassportDepartmentCode;
    private string? _formPassportRegistrationAddress;
    private string? _formCompanyName;
    private string? _formCompanyInn;
    private string? _formCompanyOgrn;
    private string? _formCompanyKpp;
    private string? _formCompanyAddress;
    private string? _formOgrnip;
    private decimal? _formSharePercent;
    private decimal? _formShareAmount;

    protected override async Task OnInitializedAsync() { await LoadAsync(); }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            _participants = await Http.GetFromJsonAsync<List<ParticipantRow>>("/api/participants") ?? new();
            _myChanges = await Http.GetFromJsonAsync<List<ChangeRow>>("/api/participant-changes") ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки данных");
            _error = "Не удалось загрузить данные.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnDocumentSelected(InputFileChangeEventArgs e)
    {
        _selectedDocument = e.File;
        _selectedDocumentName = e.File.Name;
    }

    private async Task SubmitInforming()
    {
        if (_selectedParticipantId is null) return;

        _isSubmitting = true;
        _error = null;
        _success = null;
        StateHasChanged();

        try
        {
            // Загружаем документ
            Guid? documentFileId = null;
            string? documentOriginalName = null;

            if (_selectedDocument is not null)
            {
                using var content = new MultipartFormDataContent();
                using var stream = _selectedDocument.OpenReadStream(10 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                ms.Position = 0;
                var bytes = ms.ToArray();
                content.Add(new ByteArrayContent(bytes), "file", _selectedDocumentName ?? "document.pdf");

                var docResponse = await Http.PostAsync("/api/participant-changes/upload-document", content);
                if (docResponse.IsSuccessStatusCode)
                {
                    var docResult = await docResponse.Content.ReadFromJsonAsync<UploadDocumentResult>();
                    documentFileId = docResult?.FileId;
                    documentOriginalName = docResult?.OriginalName;
                }
            }

            // Находим участника для заполнения данных
            var participant = _participants.FirstOrDefault(p => p.Id.ToString() == _selectedParticipantId);

            // Создаём запись
            var dto = new
            {
                participantId = Guid.Parse(_selectedParticipantId),
                participantType = participant?.ParticipantType ?? "FL",
                fullName = _formFullName ?? participant?.FullName,
                passportSeries = _formPassportSeries ?? participant?.PassportSeries,
                passportNumber = _formPassportNumber ?? participant?.PassportNumber,
                passportIssuedBy = _formPassportIssuedBy ?? participant?.PassportIssuedBy,
                passportDepartmentCode = _formPassportDepartmentCode ?? participant?.PassportDepartmentCode,
                passportRegistrationAddress = _formPassportRegistrationAddress ?? participant?.PassportRegistrationAddress,
                personInn = _formPersonInn ?? participant?.PersonInn,
                citizenship = _formCitizenship ?? participant?.Citizenship,
                companyName = _formCompanyName ?? participant?.CompanyName,
                companyInn = _formCompanyInn ?? participant?.CompanyInn,
                companyOgrn = _formCompanyOgrn ?? participant?.CompanyOgrn,
                companyKpp = _formCompanyKpp ?? participant?.CompanyKpp,
                companyAddress = _formCompanyAddress ?? participant?.CompanyAddress,
                ogrnip = _formOgrnip ?? participant?.Ogrnip,
                sharePercent = _formSharePercent ?? participant?.SharePercent,
                shareAmount = _formShareAmount ?? participant?.ShareAmount,
                documentFileId,
                documentOriginalName
            };

            var response = await Http.PostAsJsonAsync("/api/participant-changes", dto);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _error = $"Ошибка ({(int)response.StatusCode}): {body}";
                return;
            }

            _success = "Информирование успешно подано.";
            ResetForm();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка подачи информирования");
            _error = "Не удалось отправить информирование.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        _selectedParticipantId = null;
        _selectedDocument = null;
        _selectedDocumentName = null;
        _formFullName = null;
        _formPersonInn = null;
        _formCitizenship = null;
        _formPassportSeries = null;
        _formPassportNumber = null;
        _formPassportIssuedBy = null;
        _formPassportIssueDateStr = null;
        _formPassportDepartmentCode = null;
        _formPassportRegistrationAddress = null;
        _formCompanyName = null;
        _formCompanyInn = null;
        _formCompanyOgrn = null;
        _formCompanyKpp = null;
        _formCompanyAddress = null;
        _formOgrnip = null;
        _formSharePercent = null;
        _formShareAmount = null;
    }

    private class ParticipantRow
    {
        public Guid Id { get; set; }
        public string? ParticipantType { get; set; }
        public string? FullName { get; set; }
        public string? CompanyName { get; set; }
        public string? PersonInn { get; set; }
        public string? Citizenship { get; set; }
        public string? PassportSeries { get; set; }
        public string? PassportNumber { get; set; }
        public string? PassportIssuedBy { get; set; }
        public string? PassportDepartmentCode { get; set; }
        public string? PassportRegistrationAddress { get; set; }
        public string? CompanyInn { get; set; }
        public string? CompanyOgrn { get; set; }
        public string? CompanyKpp { get; set; }
        public string? CompanyAddress { get; set; }
        public string? Ogrnip { get; set; }
        public decimal? SharePercent { get; set; }
        public decimal? ShareAmount { get; set; }
    }

    private class ChangeRow
    {
        public Guid Id { get; set; }
        public Guid ParticipantId { get; set; }
        public string? ParticipantType { get; set; }
        public string? DocumentOriginalName { get; set; }
        public string? SubmittedAt { get; set; }
        public string? Status { get; set; }
        public string? ReviewComment { get; set; }
    }

    private class UploadDocumentResult
    {
        public Guid FileId { get; set; }
        public string OriginalName { get; set; } = null!;
    }
}
