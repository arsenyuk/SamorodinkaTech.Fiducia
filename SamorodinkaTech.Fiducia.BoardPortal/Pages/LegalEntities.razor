@page "/legal-entities"
@using Microsoft.EntityFrameworkCore
@using SamorodinkaTech.Fiducia.Domain.Entities
@using SamorodinkaTech.Fiducia.Domain.Validation
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@inject ILogger<LegalEntities> Logger
@inject IJSRuntime JS
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Fiducia — Юридическое лицо</PageTitle>

<h3>Юридическое лицо</h3>

@if (_loading)
{
    <div class="text-center py-4">
        <div class="spinner-border text-primary"></div>
    </div>
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_legalEntity is not null)
{
    <div class="card">
        <div class="card-body">
            <h5 class="mb-3">@(_legalEntity.Name ?? "Без наименования") (@_legalEntity.Inn)</h5>

            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <div class="alert alert-success py-2">@_successMessage</div>
            }
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger py-2">@_errorMessage</div>
            }

            <ul class="nav nav-tabs mb-3">
                <li class="nav-item">
                    <button class="nav-link @(_activeTab == 0 ? "active" : "")" @onclick="() => _activeTab = 0">Карточка ЮЛ</button>
                </li>
                @if (_orgType == OrgValidationType.LLC)
                {
                    <li class="nav-item">
                        <button class="nav-link @(_activeTab == 1 ? "active" : "")" @onclick="() => _activeTab = 1">Интервал ООСУ</button>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <button class="nav-link @(_activeTab == 1 ? "active" : "")" @onclick="() => _activeTab = 1">Интервал ГОСА</button>
                    </li>
                }
                <li class="nav-item">
                    <button class="nav-link @(_activeTab == 2 ? "active" : "")" @onclick="() => _activeTab = 2">Документооборот</button>
                </li>
                @if (_orgType == OrgValidationType.LLC)
                {
                    <li class="nav-item">
                        <button class="nav-link @(_activeTab == 3 ? "active" : "")" @onclick="() => _activeTab = 3">Устав</button>
                    </li>
                }
                @if (_hasBoardOfDirectors)
                {
                    <li class="nav-item">
                        <button class="nav-link @(_activeTab == 4 ? "active" : "")" @onclick="() => _activeTab = 4">Совет директоров</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(_activeTab == 5 ? "active" : "")" @onclick="() => _activeTab = 5">Комитеты</button>
                    </li>
                }
                @if (_orgType == OrgValidationType.LLC)
                {
                    <li class="nav-item">
                        <button class="nav-link @(_activeTab == 6 ? "active" : "")" @onclick="() => _activeTab = 6">Нотариальное ведение</button>
                    </li>
                }
            </ul>

            @if (_activeTab == 0)
            {
                <div class="row g-3">
                    <div class="col-md-6">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted fw-normal">Полное наименование</dt>
                            <dd class="col-sm-8">@_legalEntity.Name</dd>

                            <dt class="col-sm-4 text-muted fw-normal">Краткое наименование</dt>
                            <dd class="col-sm-8">
                                <input type="text" class="form-control form-control-sm" placeholder="Краткое наименование"
                                       value="@(_legalEntity.ShortName ?? "")"
                                       @onchange="e => _newShortName = e.Value?.ToString()" />
                            </dd>

                            <dt class="col-sm-4 text-muted fw-normal">ИНН</dt>
                            <dd class="col-sm-8">@_legalEntity.Inn</dd>

                            <dt class="col-sm-4 text-muted fw-normal">ОГРН</dt>
                            <dd class="col-sm-8">
                                <input type="text" class="form-control form-control-sm" placeholder="ОГРН"
                                       value="@(_legalEntity.Ogrn ?? "")"
                                       @onchange="e => _newOgrn = e.Value?.ToString()" />
                            </dd>

                            <dt class="col-sm-4 text-muted fw-normal">ОКОПФ *</dt>
                            <dd class="col-sm-8">
                                <select class="form-select form-select-sm" @bind="_selectedOkopfCode">
                                    <option value="">— выбрать —</option>
                                    @foreach (var okopf in _okopfList)
                                    {
                                        <option value="@okopf.Code">@okopf.Name</option>
                                    }
                                </select>
                            </dd>
                        </dl>
                    </div>
                </div>
            }

            @if (_activeTab == 1)
            {
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Начало @(_orgType == OrgValidationType.LLC ? "ООСУ" : "ГОСА") (день)</label>
                        <input type="number" class="form-control" @bind="_gosaStartDay" min="1" max="31" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Начало @(_orgType == OrgValidationType.LLC ? "ООСУ" : "ГОСА") (месяц)</label>
                        <select class="form-select" @bind="_gosaStartMonth">
                            <option value="1">Январь</option>
                            <option value="2">Февраль</option>
                            <option value="3">Март</option>
                            <option value="4">Апрель</option>
                            <option value="5">Май</option>
                            <option value="6">Июнь</option>
                            <option value="7">Июль</option>
                            <option value="8">Август</option>
                            <option value="9">Сентябрь</option>
                            <option value="10">Октябрь</option>
                            <option value="11">Ноябрь</option>
                            <option value="12">Декабрь</option>
                        </select>
                    </div>
                </div>
            }

            @if (_activeTab == 2)
            {
                <div class="text-muted">Настройки документооборота</div>
            }

            @if (_activeTab == 3)
            {
                <div class="text-muted">Настройки устава</div>
            }

            @if (_activeTab == 4)
            {
                <div class="text-muted">Настройки совета директоров</div>
            }

            @if (_activeTab == 5)
            {
                <div class="text-muted">Настройки комитетов</div>
            }

            @if (_activeTab == 6)
            {
                <div class="text-muted">Нотариальное ведение реестра</div>
            }

            <div class="mt-3">
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    Сохранить
                </button>
            </div>
        </div>
    </div>
}
else
{
    <div class="text-muted">Юридическое лицо не выбрано.</div>
}

@code {
    private LegalEntity? _legalEntity;
    private bool _loading = true;
    private string? _error;
    private string? _errorMessage;
    private string? _successMessage;
    private bool _saving;

    private int _activeTab;
    private OrgValidationType _orgType = OrgValidationType.Unknown;
    private bool _hasBoardOfDirectors;

    // Краткое наименование (редактируемое)
    private string? _newShortName;

    // ОГРН (редактируемое)
    private string? _newOgrn;

    // ОКОПФ
    private string _selectedOkopfCode = "";
    private List<RefOkopf> _okopfList = new();

    // Интервал ГОСА
    private int _gosaStartDay = 1;
    private int _gosaStartMonth = 3;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();

            // Определяем ЮЛ через EcosystemParticipant по login из localStorage
            var login = await JS.InvokeAsync<string?>("localStorage.getItem", "currentUserLogin");
            Logger.LogDebug("LegalEntities: currentUserLogin из localStorage = '{Login}'", login ?? "(null)");

            if (string.IsNullOrEmpty(login))
            {
                Logger.LogWarning("LegalEntities: login не найден в localStorage");
                _error = "Не удалось определить пользователя.";
                _loading = false;
                return;
            }

            Logger.LogDebug("LegalEntities: поиск EcosystemParticipant для login={Login}", login);

            var participant = await ctx.EcosystemParticipants
                .FirstOrDefaultAsync(ep => ep.Login == login);

            if (participant is null)
            {
                Logger.LogWarning("LegalEntities: EcosystemParticipant не найден для login={Login}", login);
                _error = "Пользователь не привязан к юридическому лицу. Обратитесь к администратору.";
                _loading = false;
                return;
            }

            _legalEntity = await ctx.LegalEntities
                .Include(le => le.RefOkopf)
                .FirstOrDefaultAsync(le => le.Id == participant.LegalEntityId);

            if (_legalEntity is null)
            {
                Logger.LogWarning("LegalEntities: LegalEntity не найден для LegalEntityId={LegalEntityId}", participant.LegalEntityId);
                _error = "Юридическое лицо не найдено.";
                _loading = false;
                return;
            }

            Logger.LogDebug("LegalEntities: загружено ЮЛ {LegalEntityName} (ИНН {Inn})", _legalEntity.Name, _legalEntity.Inn);

            // Загружаем справочник ОКОПФ
            _okopfList = await ctx.RefOkopf.OrderBy(o => o.Name).ToListAsync();
            _selectedOkopfCode = _legalEntity.RefOkopf?.Code ?? "";
            _newShortName = _legalEntity.ShortName;
            _newOgrn = _legalEntity.Ogrn;

            // Определяем тип организации
            if (_legalEntity.RefOkopf?.Code is not null)
            {
                _orgType = OkopfTypeMapper.DetectType(_legalEntity.RefOkopf.Code);
            }

            // Определяем наличие СД
            _hasBoardOfDirectors = _orgType != OrgValidationType.Unknown;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки ЮЛ");
            _error = "Не удалось загрузить данные.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_legalEntity is null) return;

        _saving = true;
        _errorMessage = null;
        _successMessage = null;
        StateHasChanged();

        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var le = await ctx.LegalEntities.FindAsync(_legalEntity.Id);
            if (le is null) return;

            // Сохраняем ОКОПФ
            if (!string.IsNullOrEmpty(_selectedOkopfCode))
            {
                var okopf = await ctx.RefOkopf.FirstOrDefaultAsync(o => o.Code == _selectedOkopfCode);
                if (okopf != null)
                {
                    le.OkopfId = okopf.Id;
                    Logger.LogDebug("LegalEntities: ОКОПФ установлен = {Code} ({Name})", okopf.Code, okopf.Name);
                }
            }

            // Сохраняем краткое наименование
            if (_newShortName is not null && _newShortName != le.ShortName)
            {
                le.ShortName = _newShortName;
                Logger.LogDebug("LegalEntities: краткое наименование установлено = {ShortName}", _newShortName);
            }

            // Сохраняем ОГРН
            if (_newOgrn is not null && _newOgrn != le.Ogrn)
            {
                le.Ogrn = _newOgrn;
                Logger.LogDebug("LegalEntities: ОГРН установлен = {Ogrn}", _newOgrn);
            }

            await ctx.SaveChangesAsync();
            _successMessage = "Настройки сохранены.";

            // Обновляем локальное состояние
            _legalEntity = await ctx.LegalEntities
                .Include(le => le.RefOkopf)
                .FirstOrDefaultAsync(le => le.Id == _legalEntity.Id);

            if (_legalEntity?.RefOkopf?.Code is not null)
                _orgType = OkopfTypeMapper.DetectType(_legalEntity.RefOkopf.Code);

            _hasBoardOfDirectors = _orgType != OrgValidationType.Unknown;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка сохранения ЮЛ {LegalEntityId}", _legalEntity.Id);
            _errorMessage = "Не удалось сохранить.";
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }
}
