@page "/registrar"
@using Microsoft.EntityFrameworkCore
@using SamorodinkaTech.Fiducia.Domain.Entities
@using SamorodinkaTech.Fiducia.Domain.Enums
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@inject HttpClient Http
@inject ILogger<Registrar> Logger
@inject IJSRuntime JS
@inject NavigationManager Navigation
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Fiducia — Регистратор</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Регистратор</h3>
        @if (_isLawyer)
        {
            <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/registrar/add")'>+ Добавить регистратора</button>
        }
    </div>

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
        </div>
    }
    else if (_contractors.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <h5 class="text-muted">Регистратор не назначен</h5>
                <p class="text-muted">Заключите договор с регистратором для ведения реестра акционеров</p>
            </div>
        </div>
    }
    else
    {
        @foreach (var c in _contractors)
        {
            <div class="card mb-3 @(c.IsActive ? "" : "border-secondary opacity-75")">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <strong>@c.ContractorName</strong>
                        <span class="badge bg-secondary ms-2">ИНН @c.ContractorInn</span>
                        @if (!c.IsActive)
                        {
                            <span class="badge bg-warning ms-2">Не действует</span>
                        }
                    </div>
                    <div>
                        @if (c.CbrStatus == "Active")
                        {
                            <span class="badge bg-success">Действующая</span>
                        }
                        else if (!string.IsNullOrEmpty(c.CbrStatus))
                        {
                            <span class="badge bg-danger">@c.CbrStatus</span>
                        }
                        @if (_isLawyer)
                        {
                            <button class="btn btn-sm btn-outline-info ms-2" @onclick="() => CheckCbrStatus(c)" disabled="@(_checkingCbrId == c.Id)">
                                @if (_checkingCbrId == c.Id)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                else
                                {
                                    <span>ЦБР</span>
                                }
                            </button>
                            <button class="btn btn-sm btn-outline-primary ms-2" @onclick="@(() => Navigation.NavigateTo($"/registrar/{c.Id}"))">Редактировать</button>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Договор</h6>
                            <table class="table table-sm table-borderless mb-3">
                                <tr><td class="text-muted" style="width:200px">Номер:</td><td>@(c.ContractNumber ?? "—")</td></tr>
                                <tr><td class="text-muted">Дата:</td><td>@(c.ContractDate ?? "—")</td></tr>
                                <tr><td class="text-muted">Срок действия:</td><td>@(c.ContractValidFrom ?? "—") — @(c.ContractValidTo ?? "—")</td></tr>
                                @if (c.ContractDocumentId.HasValue)
                                {
                                    <tr>
                                        <td class="text-muted">Файл:</td>
                                        <td>
                                            <a href="/api/files/@c.ContractDocumentId/download" target="_blank" class="btn btn-sm btn-outline-secondary">
                                                📄 @(c.ContractDocumentName ?? "Скачать")
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h6>Сроки подготовки реестров</h6>
                            <table class="table table-sm table-borderless mb-3">
                                <tr>
                                    <td class="text-muted" style="width:300px">Реестр акционеров:</td>
                                    <td>@(c.RegistryPreparationDays?.ToString() ?? "—") @(FormatUnit(c.RegistryPreparationUnit))</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Реестр для дивидендов:</td>
                                    <td>@(c.DividendRegistryPreparationDays?.ToString() ?? "—") @(FormatUnit(c.DividendRegistryPreparationUnit))</td>
                                </tr>
                            </table>
                            @if (!string.IsNullOrEmpty(c.RegistryRulesUrl) || c.RegistryRulesDocumentId.HasValue)
                            {
                                <h6>Правила ведения реестра</h6>
                                @if (c.RegistryRulesDocumentId.HasValue)
                                {
                                    <a href="/api/files/@c.RegistryRulesDocumentId/download" target="_blank" class="btn btn-sm btn-outline-secondary me-2">
                                        📄 @(c.RegistryRulesDocumentName ?? "Скачать файл")
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(c.RegistryRulesUrl))
                                {
                                    <a href="@c.RegistryRulesUrl" target="_blank" class="btn btn-sm btn-outline-info">
                                        🌐 Открыть ссылку
                                    </a>
                                }
                            }
                        </div>
                    </div>

                    @if (c.Licenses.Any())
                    {
                        <h6>Лицензии ЦБ РФ</h6>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Номер</th>
                                    <th>Наименование</th>
                                    <th>Дата начала</th>
                                    <th>Дата окончания</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var lic in c.Licenses)
                                {
                                    <tr>
                                        <td>@lic.Number</td>
                                        <td>@lic.ActivityName</td>
                                        <td>@lic.StartDate</td>
                                        <td>
                                            @lic.EndDate
                                            @if (DateTime.TryParse(lic.EndDate, out var endDate) && endDate < DateTime.UtcNow)
                                            {
                                                <span class="badge bg-danger ms-1">Истекла</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    @if (c.CbrFetchedAt.HasValue)
                    {
                        <div class="text-muted small">Данные ЦБ обновлены: @c.CbrFetchedAt.Value.ToString("dd.MM.yyyy HH:mm")</div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private bool _loading = true;
    private bool _isLawyer;
    private List<ContractorView> _contractors = new();
    private Guid? _checkingCbrId;

    protected override async Task OnInitializedAsync()
    {
        var role = await JS.InvokeAsync<string>("localStorage.getItem", "currentUserRole");
        _isLawyer = role?.Contains("LAWYER", StringComparison.OrdinalIgnoreCase) == true;
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var response = await Http.GetAsync("/api/ao-contractors?contractorType=REGISTRAR");
            if (response.IsSuccessStatusCode)
            {
                _contractors = await response.Content.ReadFromJsonAsync<List<ContractorView>>() ?? new();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка загрузки регистраторов");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CheckCbrStatus(ContractorView contractor)
    {
        _checkingCbrId = contractor.Id;
        StateHasChanged();

        try
        {
            var response = await Http.GetAsync($"/api/ao-contractors/check-cbr?inn={contractor.ContractorInn}");
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<CbrCheckResult>();
                if (result is not null && result.Warning is null)
                {
                    // Обновляем данные в списке
                    var idx = _contractors.FindIndex(c => c.Id == contractor.Id);
                    if (idx >= 0)
                    {
                        _contractors[idx].CbrStatus = result.Status;
                        _contractors[idx].Licenses = result.Licenses?.ToList() ?? new();
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка проверки ЦБР для ИНН={Inn}", contractor.ContractorInn);
        }
        finally
        {
            _checkingCbrId = null;
            StateHasChanged();
        }
    }

    private static string FormatUnit(string? unit) => unit switch
    {
        "CALENDAR" => "календ. дн.",
        "BUSINESS" => "раб. дн.",
        _ => ""
    };

    private class ContractorView
    {
        public Guid Id { get; set; }
        public string ContractorInn { get; set; } = "";
        public string ContractorName { get; set; } = "";
        public string? ContractNumber { get; set; }
        public string? ContractDate { get; set; }
        public string? ContractValidFrom { get; set; }
        public string? ContractValidTo { get; set; }
        public Guid? ContractDocumentId { get; set; }
        public string? ContractDocumentName { get; set; }
        public int? RegistryPreparationDays { get; set; }
        public string? RegistryPreparationUnit { get; set; }
        public int? DividendRegistryPreparationDays { get; set; }
        public string? DividendRegistryPreparationUnit { get; set; }
        public string? RegistryRulesUrl { get; set; }
        public Guid? RegistryRulesDocumentId { get; set; }
        public string? RegistryRulesDocumentName { get; set; }
        public bool IsActive { get; set; }
        public string? CbrStatus { get; set; }
        public DateTime? CbrFetchedAt { get; set; }
        public List<LicenseView> Licenses { get; set; } = new();
    }

    private class LicenseView
    {
        public int VidId { get; set; }
        public string? ActivityName { get; set; }
        public string? Number { get; set; }
        public string? Name { get; set; }
        public string? StartDate { get; set; }
        public string? EndDate { get; set; }
    }

    private class CbrCheckResult
    {
        public string? Warning { get; set; }
        public string? Inn { get; set; }
        public string? ShortName { get; set; }
        public string? Status { get; set; }
        public string? FoTypes { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("licenses")]
        public List<LicenseView>? Licenses { get; set; }
    }
}
