@page "/registrar/add"
@using Microsoft.EntityFrameworkCore
@using SamorodinkaTech.Fiducia.Domain.Entities
@using SamorodinkaTech.Fiducia.Domain.Enums
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@inject HttpClient Http
@inject ILogger<RegistrarAdd> Logger
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Fiducia — Новый договор с регистратором</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Новый договор с регистратором</h3>
        <button class="btn btn-outline-secondary" @onclick='() => Navigation.NavigateTo("/registrar")'>← Назад к списку</button>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger">@_errorMessage</div>
    }

    @if (_selectedCompany is null)
    {
        <!-- Поиск компании -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Выбор регистратора</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Поиск по ИНН / наименованию</label>
                    <div class="input-group">
                        <input class="form-control" value="@_searchQuery" @oninput="OnSearchInput"
                               placeholder="Введите ИНН или наименование регистратора" />
                        <button class="btn btn-outline-primary" type="button"
                                @onclick="LoadFromSpark" disabled="@(_searchingSpark || _searchQuery.Trim().Length < 10)">
                            @if (_searchingSpark)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else
                            {
                                <span>СПАРК</span>
                            }
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(_sparkWarning))
                    {
                        <div class="text-warning small mt-1">@_sparkWarning</div>
                    }
                </div>

                @if (_searchResults?.Any() == true)
                {
                    <table class="table table-sm table-hover">
                        <thead>
                            <tr>
                                <th>Наименование</th>
                                <th>ИНН</th>
                                <th>ОКОПФ</th>
                                <th>Статус</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var c in _searchResults)
                        {
                            <tr style="cursor:pointer" @onclick="() => SelectCompany(c)">
                                <td>@c.ShortName</td>
                                <td>@c.Inn</td>
                                <td>@c.OkopfCode</td>
                                <td>@c.Status</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    <div class="text-muted small">Показано до @SearchLimit записей</div>
                }
            </div>
        </div>
    }
    else
    {
        <!-- Выбранная компания + реквизиты договора -->
        <div class="card bg-light mb-3">
            <div class="card-body py-2 d-flex justify-content-between align-items-center">
                <div>
                    <strong>@_selectedCompany.ShortName</strong> (@_selectedCompany.Inn)
                    <span class="badge bg-secondary ms-2">@_selectedCompany.OkopfCode</span>
                    @if (_selectedCompany.Status == "Действующее")
                    {
                        <span class="badge bg-success ms-1">Действующее</span>
                    }
                </div>
                <button class="btn btn-sm btn-outline-danger" @onclick="ClearSelectedCompany">Изменить</button>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Реквизиты договора</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Номер договора</label>
                        <input type="text" class="form-control" @bind="_formContractNumber">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Дата договора</label>
                        <input type="date" class="form-control" @bind="_formContractDate">
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Начало действия</label>
                        <input type="date" class="form-control" @bind="_formValidFrom">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Окончание действия</label>
                        <input type="date" class="form-control" @bind="_formValidTo">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Файл договора</label>
                    @if (_formDocumentId.HasValue)
                    {
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <a href="/api/files/@_formDocumentId/download" target="_blank"
                               class="btn btn-sm btn-outline-secondary">📄 @_formDocumentName</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => { _formDocumentId = null; _formDocumentName = null; }">Заменить</button>
                        </div>
                    }
                    else
                    {
                        <FileUpload Accept=".pdf,.doc,.docx"
                                    MaxSizeBytes="52428800"
                                    FileType="CONTRACT"
                                    Token="@_jwtToken"
                                    OnFileUploadedInfo="OnContractFileUploaded" />
                    }
                </div>

                <hr />
                <h6>Сроки подготовки реестров</h6>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Реестр акционеров (дни)</label>
                        <input type="number" class="form-control" @bind="_formRegistryPrepDays" min="0">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Единица измерения</label>
                        <select class="form-select" @bind="_formRegistryPrepUnit">
                            <option value="">Не указано</option>
                            <option value="CALENDAR">Календарный день</option>
                            <option value="BUSINESS">Рабочий день</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Реестр для дивидендов (дни)</label>
                        <input type="number" class="form-control" @bind="_formDividendRegPrepDays" min="0">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Единица измерения</label>
                        <select class="form-select" @bind="_formDividendRegPrepUnit">
                            <option value="">Не указано</option>
                            <option value="CALENDAR">Календарный день</option>
                            <option value="BUSINESS">Рабочий день</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">URL Правил ведения реестра</label>
                    <input type="url" class="form-control" @bind="_formRegistryRulesUrl" placeholder="https://...">
                </div>

                <div class="mb-3">
                    <label class="form-label">Файл Правил ведения реестра</label>
                    @if (_formRulesDocumentId.HasValue)
                    {
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <a href="/api/files/@_formRulesDocumentId/download" target="_blank"
                               class="btn btn-sm btn-outline-secondary">📄 @_formRulesDocumentName</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => { _formRulesDocumentId = null; _formRulesDocumentName = null; }">Заменить</button>
                        </div>
                    }
                    else
                    {
                        <FileUpload Accept=".pdf,.doc,.docx"
                                    MaxSizeBytes="52428800"
                                    FileType="REGISTRY_RULES"
                                    Token="@_jwtToken"
                                    OnFileUploadedInfo="OnRulesFileUploaded" />
                    }
                </div>
            </div>
            <div class="card-footer">
                <button type="button" class="btn btn-secondary me-2" @onclick='() => Navigation.NavigateTo("/registrar")'>Отмена</button>
                <button type="button" class="btn btn-primary" @onclick="Save" disabled="@(_saving || _selectedCompany is null)">
                    @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Добавить договор
                </button>
            </div>
        </div>
    }
</div>

@code {
    private bool _saving;
    private string? _errorMessage;
    private string? _jwtToken;

    // Поиск
    private string _searchQuery = "";
    private List<SparkCompanyView>? _searchResults;
    private bool _searchingSpark;
    private string? _sparkWarning;
    private const int SearchLimit = 10;

    // Выбранная компания
    private SparkCompanyView? _selectedCompany;

    // Реквизиты договора
    private string? _formContractNumber;
    private DateOnly? _formContractDate;
    private DateOnly? _formValidFrom;
    private DateOnly? _formValidTo;
    private Guid? _formDocumentId;
    private string? _formDocumentName;
    private int? _formRegistryPrepDays;
    private string? _formRegistryPrepUnit;
    private int? _formDividendRegPrepDays;
    private string? _formDividendRegPrepUnit;
    private string? _formRegistryRulesUrl;
    private Guid? _formRulesDocumentId;
    private string? _formRulesDocumentName;

    // ── Поиск по СПАРК ──

    protected override void OnInitialized()
    {
        _jwtToken = HttpContextAccessor.HttpContext?.Request.Cookies["SessionToken"];
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(_searchQuery) || _searchQuery.Trim().Length < 2)
        {
            _searchResults = null;
            return;
        }

        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var q = _searchQuery.Trim();

            // Ищем в ext_spark_company
            var sparkResults = await ctx.ExtSparkCompanies
                .Where(c =>
                    (c.FullName != null && EF.Functions.ILike(c.FullName, $"%{q}%")) ||
                    (c.ShortName != null && EF.Functions.ILike(c.ShortName, $"%{q}%")) ||
                    (c.Inn != null && EF.Functions.ILike(c.Inn, $"%{q}%")) ||
                    (c.Ogrn != null && EF.Functions.ILike(c.Ogrn, $"%{q}%")))
                .OrderBy(c => c.FullName)
                .Take(SearchLimit)
                .Select(c => new SparkCompanyView
                {
                    Inn = c.Inn,
                    FullName = c.FullName,
                    ShortName = c.ShortName,
                    OkopfCode = c.OkopfCode,
                    OkopfName = c.OkopfName,
                    Status = c.Status
                })
                .ToListAsync();

            // Ищем в ext_cbr_finorg_organization (регистраторы PT, ИА IA)
            var cbrResults = await ctx.ExtCbrFinOrgOrganizations
                .Where(c =>
                    c.FoTypes != null && (c.FoTypes.Contains("PT") || c.FoTypes.Contains("IA")) &&
                    ((c.FullName != null && EF.Functions.ILike(c.FullName, $"%{q}%")) ||
                     (c.ShortName != null && EF.Functions.ILike(c.ShortName, $"%{q}%")) ||
                     (c.Inn != null && EF.Functions.ILike(c.Inn, $"%{q}%"))))
                .OrderBy(c => c.FullName)
                .Take(SearchLimit)
                .Select(c => new SparkCompanyView
                {
                    Inn = c.Inn,
                    FullName = c.FullName,
                    ShortName = c.ShortName,
                    OkopfCode = c.FoTypes,
                    OkopfName = c.FoTypes,
                    Status = c.Status
                })
                .ToListAsync();

            // Объединяем результаты, убирая дубли по ИНН
            _searchResults = sparkResults
                .Concat(cbrResults)
                .GroupBy(c => c.Inn)
                .Select(g => g.First())
                .Take(SearchLimit)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка поиска в СПАРК");
            _searchResults = null;
        }
    }

    private async Task LoadFromSpark()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery) || _searchQuery.Trim().Length < 10) return;

        _searchingSpark = true;
        _sparkWarning = null;
        StateHasChanged();

        try
        {
            var inn = _searchQuery.Trim();
            var response = await Http.GetAsync($"/api/ao-contractors/search-spark?inn={inn}");
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SparkSearchResult>();
                if (result?.Warning is not null)
                {
                    _sparkWarning = result.Warning;
                }
                else if (result?.Inn is not null)
                {
                    _selectedCompany = new SparkCompanyView
                    {
                        Inn = result.Inn,
                        FullName = result.FullName,
                        ShortName = result.ShortName,
                        OkopfCode = result.OkopfCode,
                        Status = result.Status
                    };
                    _searchResults = null;
                    _searchQuery = "";
                    _sparkWarning = null;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки из СПАРК");
            _sparkWarning = $"Ошибка: {ex.Message}";
        }
        finally
        {
            _searchingSpark = false;
            StateHasChanged();
        }
    }

    private void SelectCompany(SparkCompanyView company)
    {
        _selectedCompany = company;
        _searchResults = null;
        _searchQuery = "";
    }

    private void ClearSelectedCompany()
    {
        _selectedCompany = null;
        _searchQuery = "";
        _searchResults = null;
    }

    // ── FileUpload callbacks ──

    private void OnContractFileUploaded((Guid FileId, string OriginalName) info)
    {
        _formDocumentId = info.FileId;
        _formDocumentName = info.OriginalName;
    }

    private void OnRulesFileUploaded((Guid FileId, string OriginalName) info)
    {
        _formRulesDocumentId = info.FileId;
        _formRulesDocumentName = info.OriginalName;
    }

    // ── Сохранение ──

    private async Task Save()
    {
        if (_selectedCompany is null)
        {
            _errorMessage = "Выберите регистратора из списка";
            return;
        }

        _saving = true;
        _errorMessage = null;

        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(_selectedCompany.Inn), "contractorInn");
            content.Add(new StringContent(_selectedCompany.ShortName ?? _selectedCompany.FullName ?? ""), "contractorName");
            content.Add(new StringContent("REGISTRAR"), "contractorType");
            if (_formContractNumber is not null) content.Add(new StringContent(_formContractNumber), "contractNumber");
            if (_formContractDate.HasValue) content.Add(new StringContent(_formContractDate.Value.ToString("yyyy-MM-dd")), "contractDate");
            if (_formValidFrom.HasValue) content.Add(new StringContent(_formValidFrom.Value.ToString("yyyy-MM-dd")), "contractValidFrom");
            if (_formValidTo.HasValue) content.Add(new StringContent(_formValidTo.Value.ToString("yyyy-MM-dd")), "contractValidTo");
            if (_formRegistryPrepDays.HasValue) content.Add(new StringContent(_formRegistryPrepDays.Value.ToString()), "registryPreparationDays");
            if (_formRegistryPrepUnit is not null) content.Add(new StringContent(_formRegistryPrepUnit), "registryPreparationUnit");
            if (_formDividendRegPrepDays.HasValue) content.Add(new StringContent(_formDividendRegPrepDays.Value.ToString()), "dividendRegistryPreparationDays");
            if (_formDividendRegPrepUnit is not null) content.Add(new StringContent(_formDividendRegPrepUnit), "dividendRegistryPreparationUnit");
            if (_formRegistryRulesUrl is not null) content.Add(new StringContent(_formRegistryRulesUrl), "registryRulesUrl");

            var response = await Http.PostAsync("/api/ao-contractors", content);

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/registrar");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _errorMessage = $"Ошибка: {error}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ошибка: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    // ── View models ──

    private class SparkCompanyView
    {
        public string Inn { get; set; } = "";
        public string? FullName { get; set; }
        public string? ShortName { get; set; }
        public string? OkopfCode { get; set; }
        public string? OkopfName { get; set; }
        public string? Status { get; set; }
    }

    private class SparkSearchResult
    {
        public string? Warning { get; set; }
        public string? Inn { get; set; }
        public string? FullName { get; set; }
        public string? ShortName { get; set; }
        public string? OkopfCode { get; set; }
        public string? Status { get; set; }
    }
}
