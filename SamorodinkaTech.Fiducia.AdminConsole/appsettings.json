{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5434;Database=fiducia;Username=fiducia;Password=fiducia;Include Error Detail=true"
  },
  "Osa": {
    // Альтернативный шаблон: «ГОСА-{YYYY}»
    "GosaTitleTemplate": "Годовое за {YYYY} год"
  },
  "Auth": {
    "Method": "Basic",
    "ActiveDirectory": {
      "Server": "ldap://dc.company.local",
      "Domain": "company.local",
      "BaseDn": "DC=company,DC=local",
      "UseSsl": true
    }
  },
  "Ldap": {
    "Enabled": false,
    "Server": "localhost",
    "Port": 389,
    "BaseDn": "dc=bryansk-arsenal,dc=local",
    "BindUser": "cn=admin,dc=bryansk-arsenal,dc=local",
    "BindPassword": "admin",
    "BoardGroupDn": "cn=BoardOfDirectors,ou=Groups,dc=bryansk-arsenal,dc=local",
    "SysAdminGroupDn": "cn=SysAdmins,ou=Groups,dc=bryansk-arsenal,dc=local"
  },
  "Session": {
    "IdleTimeoutMinutes": 5,
    "JwtSecret": "Fiducia-256bit-secret-key-change-in-production-must-be-32-bytes"
  },
  "SecurityAudit": {
    "Enabled": true,
    "StoragePath": "/var/log/fiducia/audit",
    "FileNameFormat": "audit-{yyyy-MM}.log",
    "RotationPeriod": "Monthly",
    "RetentionDays": 365,
    "WriteToDatabase": true,
    "WriteToFile": true
  },
  "ApplicationLogging": {
    "Enabled": true,
    "StoragePath": "/var/log/fiducia/app",
    "FileNameFormat": "app-{yyyy-MM-dd}.log",
    "RotationPeriod": "Daily",
    "FileSizeLimitMB": 100
  },
  "FileStorage": {
    "Provider": "Local",
    "LocalBasePath": "/var/lib/fiducia/storage",
    "MinioEndpoint": "localhost:9000",
    "MinioAccessKey": "minioadmin",
    "MinioSecretKey": "minioadmin",
    "MinioBucketName": "fiducia",
    "MinioUseSsl": false
  },
  "FileUpload": {
    "MaxFileSizeBytes": 52428800,
    "ChunkSizeBytes": 524288,
    "MaxConcurrentUploads": 10,
    "UploadExpirationHours": 24,
    "BlockedExtensions": [
      "exe", "dll", "com", "msi", "bat", "cmd", "scr", "pif",
      "vbs", "vbe", "js", "jse", "ws", "wsh", "wsf",
      "ps1", "psm1", "psd1", "psc1",
      "sh", "bash", "csh", "ksh", "zsh",
      "app", "bin", "command", "cpl", "hta", "inf", "ins", "isp",
      "job", "lnk", "mdb", "msc", "msp",
      "reg", "rgs", "scf", "snap",
      "application", "gadget", "paf",
      "xbap", "xll", "xnk",
      "zip", "rar", "7z", "tar", "gz", "bz2", "xz", "zst",
      "iso", "img", "vhd", "vhdx", "vmdk", "ova", "ovf",
      "cab", "dmg", "pak", "war", "ear",
      "sys", "drv", "diagnostics", "msix", "appx",
      "widget", "webpnp"
    ]
  },
  "Spark": {
    "BaseUrl": "http://sparkgatetest.interfax.ru/iFaxWebService/ifaborern.asmx",
    "Login": "",
    "Password": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "/var/log/fiducia/app/app-.log",
          "rollingInterval": "Hour",
          "retainedFileCountLimit": 720,
          "fileSizeLimitBytes": 104857600,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        },
        "Filter": [
          {
            "Name": "ByExcluding",
            "Args": { "expression": "AuditLog is not null" }
          }
        ]
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": { "expression": "SourceContext like 'SamorodinkaTech.Fiducia.Infrastructure.Auditing.SecurityAuditService%'" }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "/var/log/fiducia/audit/audit-.log",
                  "rollingInterval": "Hour",
                  "retainedFileCountLimit": 8760,
                  "outputTemplate": "{Message:lj}{NewLine}"
                }
              }
            ]
          }
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "TrueConf": {
    "BaseUrl": "https://91.77.160.165",
    "ClientId": "",
    "ClientSecret": "",
    "Enabled": false
  },
  "MtsLink": {
    "BaseUrl": "https://userapi.mts-link.ru",
    "ApiToken": "",
    "Enabled": false
  }
}
