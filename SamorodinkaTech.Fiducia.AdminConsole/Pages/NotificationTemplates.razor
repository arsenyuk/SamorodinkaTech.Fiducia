@page "/notification-templates"
@using Microsoft.EntityFrameworkCore
@using SamorodinkaTech.Fiducia.Domain.Entities
@using SamorodinkaTech.Fiducia.Domain.Interfaces
@inject IApplicationDbContext DbContext
@inject NavigationManager Nav

<PageTitle>Fiducia — Шаблоны уведомлений</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Шаблоны уведомлений</h3>
    </div>

    @* ── Фильтры ──────────────────────────────────────────────── *@
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <span class="text-muted small me-2">Фильтр:</span>
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="checkbox" id="filterAll"
                           checked="@_filterAll" @onchange="ToggleFilterAll">
                    <label class="form-check-label small" for="filterAll">Все</label>
                </div>
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="checkbox" id="filterOSA"
                           checked="@_filterOsa" @onchange="ToggleFilterOsa">
                    <label class="form-check-label small" for="filterOSA">ОСА</label>
                </div>
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="checkbox" id="filterOSU"
                           checked="@_filterOsu" @onchange="ToggleFilterOsu">
                    <label class="form-check-label small" for="filterOSU">ОСУ</label>
                </div>
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="checkbox" id="filterUCHASTNIK"
                           checked="@_filterUchastnik" @onchange="ToggleFilterUchastnik">
                    <label class="form-check-label small" for="filterUCHASTNIK">Участник</label>
                </div>
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="checkbox" id="filterSD"
                           checked="@_filterSD" @onchange="ToggleFilterSd">
                    <label class="form-check-label small" for="filterSD">СД</label>
                </div>
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="checkbox" id="filterGD"
                           checked="@_filterGd" @onchange="ToggleFilterGd">
                    <label class="form-check-label small" for="filterGD">ГД</label>
                </div>
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="checkbox" id="filterSystem"
                           checked="@_filterSystem" @onchange="ToggleFilterSystem">
                    <label class="form-check-label small" for="filterSystem">Системные</label>
                </div>
            </div>
        </div>
    </div>

    @* ── Список шаблонов ──────────────────────────────────────── *@
    @if (_filteredTemplates.Count == 0)
    {
        <div class="text-center text-muted py-5">
            <p class="mb-0">Шаблоны не найдены</p>
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var template in _filteredTemplates)
            {
                <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                        @onclick="() => EditTemplate(template.NotificationTypeCode)">
                    <div>
                        <span class="fw-semibold">@(template.Description ?? template.NotificationTypeCode)</span>
                        @if (!string.IsNullOrEmpty(template.NotificationTypeCode))
                        {
                            <span class="text-muted small ms-2">(@template.NotificationTypeCode)</span>
                        }
                    </div>
                    <div>
                        @if (template.IsEnabled)
                        {
                            <span class="badge bg-success">Включён</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Выключен</span>
                        }
                    </div>
                </button>
            }
        </div>
    }
</div>

@code {
    private List<NotificationTemplate> _allTemplates = new();
    private List<NotificationTemplate> _filteredTemplates = new();

    // Фильтры
    private bool _filterAll = true;
    private bool _filterOsa;
    private bool _filterOsu;
    private bool _filterSD;
    private bool _filterUchastnik;
    private bool _filterGd;
    private bool _filterSystem;

    // Маппинг категорий
    private static readonly Dictionary<string, string> CategoryMap = new()
    {
        ["MEETING_SUMMONS"] = "SD",
        ["VOTE_REMINDER"] = "OSA",
        ["VOTE_DEADLINE"] = "OSA",
        ["PROTOCOL_SIGNED"] = "OSA",
        ["COMMITTEE_PROTOCOL_SIGNED"] = "SD",
        ["CHAIRMAN_NOMINATION"] = "SD",
        ["DEPUTY_CHAIRMAN_NOMINATION"] = "SD",
        ["CHAIRMAN_CONSENT"] = "SD",
        ["DEPUTY_CHAIRMAN_CONSENT"] = "SD",
        ["GENERAL"] = "SYSTEM",
        ["COLLECTIVE_DEMAND_THRESHOLD"] = "UCHASTNIK",
        ["COLLECTIVE_DEMAND_DECISION"] = "GD",
        ["SHARE_REQUEST_ACCEPTED"] = "GD",
        ["SHARE_REQUEST_VISIBLE_TO_ALL"] = "UCHASTNIK",
        ["OSU_MEETING_SUMMONS"] = "OSU",
        ["OSU_PROTOCOL_SIGNED"] = "OSU",
        ["OSA_MEETING_SUMMONS"] = "OSA",
        ["OSA_PROTOCOL_SIGNED"] = "OSA"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadTemplates();
    }

    private async Task LoadTemplates()
    {
        _allTemplates = await DbContext.NotificationTemplates
            .OrderBy(t => t.NotificationTypeCode)
            .ToListAsync();

        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (_filterAll)
        {
            _filteredTemplates = _allTemplates.ToList();
            return;
        }

        var activeCategories = new HashSet<string>();
        if (_filterOsa) activeCategories.Add("OSA");
        if (_filterOsu) activeCategories.Add("OSU");
        if (_filterSD) activeCategories.Add("SD");
        if (_filterUchastnik) activeCategories.Add("UCHASTNIK");
        if (_filterGd) activeCategories.Add("GD");
        if (_filterSystem) activeCategories.Add("SYSTEM");

        _filteredTemplates = _allTemplates
            .Where(t => CategoryMap.TryGetValue(t.NotificationTypeCode, out var cat) && activeCategories.Contains(cat))
            .ToList();
    }

    private void ToggleFilterAll()
    {
        _filterAll = !_filterAll;
        if (_filterAll)
        {
            _filterOsa = false;
            _filterOsu = false;
            _filterSD = false;
            _filterUchastnik = false;
            _filterGd = false;
            _filterSystem = false;
        }
        ApplyFilter();
    }

    private void ToggleFilterOsa() { _filterOsa = !_filterOsa; UpdateFilterAll(); ApplyFilter(); }
    private void ToggleFilterOsu() { _filterOsu = !_filterOsu; UpdateFilterAll(); ApplyFilter(); }
    private void ToggleFilterSd() { _filterSD = !_filterSD; UpdateFilterAll(); ApplyFilter(); }
    private void ToggleFilterUchastnik() { _filterUchastnik = !_filterUchastnik; UpdateFilterAll(); ApplyFilter(); }
    private void ToggleFilterGd() { _filterGd = !_filterGd; UpdateFilterAll(); ApplyFilter(); }
    private void ToggleFilterSystem() { _filterSystem = !_filterSystem; UpdateFilterAll(); ApplyFilter(); }

    private void UpdateFilterAll()
    {
        _filterAll = !_filterOsa && !_filterOsu && !_filterSD && !_filterUchastnik && !_filterGd && !_filterSystem;
    }

    private void EditTemplate(string code)
    {
        Nav.NavigateTo($"/notification-templates/{code}");
    }
}
