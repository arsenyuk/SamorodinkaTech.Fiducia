@page "/users/{UserId:guid}"
@using Microsoft.EntityFrameworkCore
@using SamorodinkaTech.Fiducia.Domain.Entities
@using SamorodinkaTech.Fiducia.Domain.Interfaces
@inject IApplicationDbContext DbContext
@inject NavigationManager Navigation

<PageTitle>Fiducia — Пользователь</PageTitle>

<div class="container-fluid">
    <div class="mb-3">
        <a class="btn btn-sm btn-outline-secondary" @onclick="GoBack" @onclick:preventDefault>
            ← Назад к пользователям
        </a>
    </div>

    <h3>@_fullName</h3>

    @if (_user == null && !_loaded)
    {
        <p>Загрузка...</p>
    }
    else if (_user == null)
    {
        <div class="alert alert-warning">Пользователь не найден.</div>
    }
    else
    {
        <div class="card mt-3">
            <div class="card-header">
                <ul class="nav nav-tabs card-header-tabs">
                    <li class="nav-item">
                        <button class="nav-link @(_tab == "info" ? "active" : "")"
                                @onclick='() => SwitchTab("info")'>УЗ</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(_tab == "person" ? "active" : "")"
                                @onclick='() => SwitchTab("person")'>ФЛ</button>
                    </li>
                    @if (_employees.Count > 0)
                    {
                        <li class="nav-item">
                            <button class="nav-link @(_tab == "employee" ? "active" : "")"
                                    @onclick='() => SwitchTab("employee")'>Сотрудник</button>
                        </li>
                    }
                    <li class="nav-item">
                        <button class="nav-link @(_tab == "roles" ? "active" : "")"
                                @onclick='() => SwitchTab("roles")'>Роли</button>
                    </li>
                    @if (_appointments.Count > 0)
                    {
                        <li class="nav-item">
                            <button class="nav-link @(_tab == "appointments" ? "active" : "")"
                                    @onclick='() => SwitchTab("appointments")'>Назначения в СД</button>
                        </li>
                    }
                    <li class="nav-item">
                        <button class="nav-link @(_tab == "edin" ? "active" : "")"
                                @onclick='() => SwitchTab("edin")'>ЕДИН</button>
                    </li>
                </ul>
            </div>
            <div class="card-body">
                @if (_tab == "info")
                {
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Фамилия</dt>
                        <dd class="col-sm-9">@_user.LastName</dd>

                        <dt class="col-sm-3">Имя</dt>
                        <dd class="col-sm-9">@_user.FirstName</dd>

                        @if (!string.IsNullOrWhiteSpace(_user.MiddleName))
                        {
                            <dt class="col-sm-3">Отчество</dt>
                            <dd class="col-sm-9">@_user.MiddleName</dd>
                        }

                        <dt class="col-sm-3">Email</dt>
                        <dd class="col-sm-9">@_user.Email</dd>

                        <dt class="col-sm-3">Телефон</dt>
                        <dd class="col-sm-9">@_user.Phone</dd>

                        <dt class="col-sm-3">Тип</dt>
                        <dd class="col-sm-9">
                            @if (_user.IsExternal)
                            {
                                <span class="badge bg-warning">Внешний</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Внутренний</span>
                            }
                        </dd>

                        <dt class="col-sm-3">Статус LDAP</dt>
                        <dd class="col-sm-9">
                            @if (!_user.IsActive)
                            {
                                <span class="badge bg-danger">Заблокирован</span>
                            }
                            else if (_user.AccountExpiresAt.HasValue && _user.AccountExpiresAt.Value < DateTime.UtcNow)
                            {
                                <span class="badge bg-warning">Истёк</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Активен</span>
                            }
                        </dd>

                        @if (_user.AccountExpiresAt.HasValue)
                        {
                            <dt class="col-sm-3">Действует до</dt>
                            <dd class="col-sm-9">@_user.AccountExpiresAt.Value.ToString("dd.MM.yyyy")</dd>
                        }

                    </dl>
                }
                else if (_tab == "person")
                {
                    @if (_person == null)
                    {
                        <p class="text-muted">Физическое лицо не привязано.</p>
                    }
                    else
                    {
                        <dl class="row mb-0">
                            <dt class="col-sm-3">Фамилия</dt>
                            <dd class="col-sm-9">@_person.LastName</dd>

                            <dt class="col-sm-3">Имя</dt>
                            <dd class="col-sm-9">@_person.FirstName</dd>

                            @if (!string.IsNullOrWhiteSpace(_person.MiddleName))
                            {
                                <dt class="col-sm-3">Отчество</dt>
                                <dd class="col-sm-9">@_person.MiddleName</dd>
                            }

                            <dt class="col-sm-3">Email</dt>
                            <dd class="col-sm-9">@_person.Email</dd>

                            @if (!string.IsNullOrWhiteSpace(_person.Phone))
                            {
                                <dt class="col-sm-3">Телефон</dt>
                                <dd class="col-sm-9">@_person.Phone</dd>
                            }

                            @if (!string.IsNullOrWhiteSpace(_person.Inn))
                            {
                                <dt class="col-sm-3">ИНН</dt>
                                <dd class="col-sm-9">@_person.Inn</dd>
                            }

                            @if (_user!.IsExternal)
                            {
                                <dt class="col-sm-3">Статус регистрации</dt>
                                <dd class="col-sm-9">
                                    @if (_pepAgreement?.AgreementSigned == true)
                                    {
                                        <span class="badge bg-success">ПЭП подписан</span>
                                    }
                                    else if (_independenceDeclaration?.Completed == true)
                                    {
                                        <span class="badge bg-info">Анкета заполнена</span>
                                    }
                                    else if (!string.IsNullOrEmpty(_user.InvitationToken))
                                    {
                                        <span class="badge bg-warning">Ожидает регистрации</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Не начата</span>
                                    }
                                </dd>
                            }
                        </dl>
                    }
                }
                else if (_tab == "employee")
                {
                    @if (_employees.Count == 0)
                    {
                        <p class="text-muted">Нет записей о сотрудничестве.</p>
                    }
                    else
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Юридическое лицо</th>
                                    <th>Должность</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var emp in _employees)
                                {
                                    <tr>
                                        <td>@emp.LegalEntity?.Name</td>
                                        <td>@emp.Position</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
                else if (_tab == "roles")
                {
                    <div class="row mb-3">
                        <div class="col-auto">
                            <select class="form-select form-select-sm" @bind="_selectedRoleId">
                                <option value="">— Выберите роль —</option>
                                @foreach (var role in _availableRoles)
                                {
                                    <option value="@role.Id">@role.Name (@role.Code)</option>
                                }
                            </select>
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-sm btn-primary" @onclick="AddRole"
                                    disabled="@string.IsNullOrEmpty(_selectedRoleId)">
                                Добавить
                            </button>
                        </div>
                    </div>

                    @if (_userRoles.Count == 0)
                    {
                        <p class="text-muted">Нет назначенных ролей.</p>
                    }
                    else
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Наименование</th>
                                    <th>Код</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ur in _userRoles)
                                {
                                    <tr>
                                        <td>@ur.Role.Name</td>
                                        <td><code>@ur.Role.Code</code></td>
                                        <td>
                                            @if (ur.Role.IsAssignable)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveRole(ur)">
                                                    Удалить
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
                else if (_tab == "appointments")
                {
                    @if (_appointments.Count == 0)
                    {
                        <p class="text-muted">Нет записей о назначениях в Совет директоров.</p>
                    }
                    else
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Должность</th>
                                    <th>Начало</th>
                                    <th>Окончание</th>
                                    <th>Статус</th>
                                    <th>Причина выбытия</th>
                                    <th>Дата выбытия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appt in _appointments)
                                {
                                    <tr>
                                        <td>@(appt.Role?.Name ?? appt.RoleCode)</td>
                                        <td>@appt.StartedAt.ToString("dd.MM.yyyy")</td>
                                        <td>@(appt.EndedAt?.ToString("dd.MM.yyyy") ?? "—")</td>
                                        <td>@(appt.Status?.Name ?? "—")</td>
                                        <td>@(appt.RefResignationReason?.Name ?? "—")</td>
                                        <td>@(appt.ResignedAt?.ToString("dd.MM.yyyy") ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
                else if (_tab == "edin")
                {
                    <dl class="row mb-0">
                        <dt class="col-sm-3">MPI MasterId</dt>
                        <dd class="col-sm-9">
                            @if (_user!.MpiMasterId.HasValue)
                            {
                                <code>@_user.MpiMasterId.Value</code>
                                <span class="badge bg-success ms-2">Привязан</span>
                            }
                            else
                            {
                                <span class="text-muted">Не привязан</span>
                            }
                        </dd>
                        <dt class="col-sm-3">Источник</dt>
                        <dd class="col-sm-9">LDAP/AD</dd>
                    </dl>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid UserId { get; set; }

    private User? _user;
    private EcosystemParticipant? _person;
    private string _fullName = string.Empty;
    private string _tab = "info";
    private bool _loaded;
    private List<BoardMemberAppointment> _appointments = new();
    private List<UserRole> _userRoles = new();
    private List<RefRole> _allRoles = new();
    private List<Employee> _employees = new();
    private string _selectedRoleId = string.Empty;
    private PepAgreement? _pepAgreement;
    private IndependenceDeclaration? _independenceDeclaration;

    private List<RefRole> _availableRoles =>
        _allRoles.Where(r => r.IsAssignable && _userRoles.All(ur => ur.RoleId != r.Id)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _user = await DbContext.Users
            .AsNoTracking()
            .FirstOrDefaultAsync(u => u.Id == UserId);

        if (_user != null)
        {
            _fullName = string.Join(" ",
                new[] { _user.LastName, _user.FirstName, _user.MiddleName }
                .Where(s => !string.IsNullOrWhiteSpace(s)));

            // Находим участника экосистемы по UserId
            _person = await DbContext.EcosystemParticipants
                .AsNoTracking()
                .FirstOrDefaultAsync(p => p.UserId == _user.Id);

            if (_person is not null)
            {
                _pepAgreement = await DbContext.PepAgreements
                    .AsNoTracking()
                    .FirstOrDefaultAsync(a => a.EcosystemParticipantId == _person.Id);

                _independenceDeclaration = await DbContext.IndependenceDeclarations
                    .AsNoTracking()
                    .FirstOrDefaultAsync(d => d.EcosystemParticipantId == _person.Id);
            }

            // Находим сотрудников по логину участника экосистемы
            _employees = await DbContext.Employees
                .AsNoTracking()
                .Include(e => e.LegalEntity)
                .Include(e => e.EcosystemParticipant)
                .Where(e => e.EcosystemParticipant != null && e.EcosystemParticipant.Login == _user.Login)
                .ToListAsync();

            _userRoles = await DbContext.UserRoles
                .AsNoTracking()
                .Include(ur => ur.Role)
                .Where(ur => ur.UserId == UserId)
                .ToListAsync();

            _allRoles = await DbContext.Roles
                .AsNoTracking()
                .OrderBy(r => r.Name)
                .ToListAsync();

            _appointments = await DbContext.BoardMemberAppointments
                .AsNoTracking()
                .Include(a => a.BoardMember)
                .Include(a => a.Role)
                .Include(a => a.Status)
                .Include(a => a.RefResignationReason)
                .Where(a => a.BoardMember!.UserId == UserId)
                .OrderByDescending(a => a.StartedAt)
                .ToListAsync();
        }

        _loaded = true;

        if ((_tab == "employee" && _employees.Count == 0) ||
            (_tab == "appointments" && _appointments.Count == 0))
        {
            _tab = "info";
        }
    }

    private async Task AddRole()
    {
        if (string.IsNullOrEmpty(_selectedRoleId)) return;

        var roleId = Guid.Parse(_selectedRoleId);
        if (_userRoles.Any(ur => ur.RoleId == roleId)) return;

        var userRole = new UserRole
        {
            Id = Guid.NewGuid(),
            UserId = UserId,
            RoleId = roleId
        };

        DbContext.UserRoles.Add(userRole);
        await DbContext.SaveChangesAsync(CancellationToken.None);

        _selectedRoleId = string.Empty;
        await LoadData();
    }

    private async Task RemoveRole(UserRole userRole)
    {
        var tracked = await DbContext.UserRoles
            .Include(ur => ur.Role)
            .FirstOrDefaultAsync(ur => ur.Id == userRole.Id);

        if (tracked != null && tracked.Role.IsAssignable)
        {
            DbContext.UserRoles.Remove(tracked);
            await DbContext.SaveChangesAsync(CancellationToken.None);
            await LoadData();
        }
    }

    private void SwitchTab(string tab)
    {
        _tab = tab;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/users");
    }
}
