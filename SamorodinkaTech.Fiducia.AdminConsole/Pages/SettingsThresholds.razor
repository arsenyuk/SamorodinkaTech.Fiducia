@page "/settings/thresholds"
@using Microsoft.EntityFrameworkCore
@using SamorodinkaTech.Fiducia.Domain.Constants
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SYS_ADMIN")]

<PageTitle>Fiducia — Пороги для требований о созыве собраний</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Пороги для требований о созыве собраний</h3>
        <a href="/settings" class="btn btn-outline-secondary btn-sm">← Назад</a>
    </div>

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success">@_successMessage</div>
    }

    @* ── Пороги ООО ────────────────────────────────────────────── *@
    <h5 class="mt-4">Пороги ООО</h5>
    <div class="card mb-4">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label fw-bold">Порог для требования ВОСУ, %</label>
                <input type="number" class="form-control" @bind="_vosuThreshold"
                       min="0.01" max="100" step="0.01" placeholder="10 (по умолчанию)" />
                <small class="text-muted">Порог доли участника ООО для требования о созыве внеочередного собрания участников. По умолчанию 10% (п. 1 ст. 35 14-ФЗ). Устав может понизить порог.</small>
            </div>
        </div>
    </div>

    @* ── Пороги АО ────────────────────────────────────────────── *@
    <h5 class="mt-4">Пороги АО</h5>
    <div class="card mb-4">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label fw-bold">Порог для требования ВОСА, %</label>
                <input type="number" class="form-control" @bind="_vosaThreshold"
                       min="0.01" max="100" step="0.01" placeholder="10 (по умолчанию)" />
                <small class="text-muted">Порог доли акционера АО для требования о созыве внеочередного собрания акционеров. По умолчанию 10% (п. 1 ст. 55 208-ФЗ).</small>
            </div>
        </div>
    </div>

    <button class="btn btn-primary" @onclick="Save">Сохранить пороги</button>
</div>

@code {
    private decimal? _vosuThreshold;
    private decimal? _vosaThreshold;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var settings = await ctx.SystemSettings.ToDictionaryAsync(x => x.Key, x => x.Value);
            if (settings.TryGetValue(SystemSettingKeys.VosuDefaultThresholdPercent, out var v) && decimal.TryParse(v, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var vosu))
                _vosuThreshold = vosu;
            if (settings.TryGetValue(SystemSettingKeys.VosaDefaultThresholdPercent, out var a) && decimal.TryParse(a, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var vosa))
                _vosaThreshold = vosa;
        }
        catch { }
    }

    private async Task Save()
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            await Upsert(ctx, SystemSettingKeys.VosuDefaultThresholdPercent, _vosuThreshold?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "", "Порог доли участника для требования ВОСУ");
            await Upsert(ctx, SystemSettingKeys.VosaDefaultThresholdPercent, _vosaThreshold?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "", "Порог доли акционера для требования ВОСА");
            await ctx.SaveChangesAsync();
            _successMessage = "Пороги сохранены.";
        }
        catch { }
    }

    private static async Task Upsert(SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext ctx, string key, string value, string description)
    {
        var s = await ctx.SystemSettings.FirstOrDefaultAsync(x => x.Key == key);
        if (s is not null) { s.Value = value; s.UpdatedAt = DateTime.UtcNow; }
        else ctx.SystemSettings.Add(new SamorodinkaTech.Fiducia.Domain.Entities.SystemSetting { Id = Guid.NewGuid(), Key = key, Value = value, Description = description, CreatedAt = DateTime.UtcNow });
    }
}
