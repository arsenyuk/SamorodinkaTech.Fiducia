@page "/settings/llc"
@using Microsoft.EntityFrameworkCore
@using SamorodinkaTech.Fiducia.Domain.Constants
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SYS_ADMIN")]

<PageTitle>Fiducia — Настройки ООО</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Настройки ООО</h3>
        <a href="/settings" class="btn btn-outline-secondary btn-sm">← Назад</a>
    </div>

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success">@_successMessage</div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h6>Шаблоны</h6>
            <div class="mb-3">
                <label class="form-label fw-bold">Шаблон наименования ООСУ</label>
                <input type="text" class="form-control @(_oosuTitleError is not null ? "is-invalid" : "")" @bind="_oosuTitleTemplate"
                       @oninput="() => _oosuTitleError = null"
                       placeholder="Очередное за {YYYY} год">
                @if (_oosuTitleError is not null)
                {
                    <div class="invalid-feedback">@_oosuTitleError</div>
                }
                <small class="text-muted">Плейсхолдеры: <code>{YYYY}</code> — год, <code>{YY}</code> — год (2 цифры), <code>{MM}</code> — месяц, <code>{DD}</code> — день</small>
            </div>

            <button class="btn btn-primary" @onclick="Save">Сохранить</button>

            <hr />
            <h6>Справочная информация (по закону, не редактируется)</h6>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Срок составления протокола ОСУ (дней)</label>
                    <input type="number" class="form-control" value="3" disabled>
                    <small class="text-muted"><a href="/board-law/37">ст. 37 п. 6 14-ФЗ</a></small>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Срок составления протокола заседания СД (дней)</label>
                    <input type="number" class="form-control" value="3" disabled>
                    <small class="text-muted"><a href="/board-law/32">ст. 32 п. 3.2 14-ФЗ</a></small>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Порог для требования ВОСУ, %</label>
                <input type="number" class="form-control" value="10" disabled>
                <small class="text-muted"><a href="/board-law/35">п. 1 ст. 35 14-ФЗ</a></small>
            </div>
        </div>
    </div>
</div>

@code {
    private string _oosuTitleTemplate = "Очередное за {YYYY} год";
    private string? _oosuTitleError;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var settings = await ctx.SystemSettings.ToDictionaryAsync(x => x.Key, x => x.Value);

            if (settings.TryGetValue(SystemSettingKeys.OosuTitleTemplate, out var ot) && !string.IsNullOrEmpty(ot))
                _oosuTitleTemplate = ot;
        }
        catch { }
    }

    private async Task Save()
    {
        _successMessage = null;
        _oosuTitleError = ValidateTemplate(_oosuTitleTemplate);

        if (_oosuTitleError is not null)
        {
            StateHasChanged();
            return;
        }

        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            await UpsertSetting(ctx, SystemSettingKeys.OosuTitleTemplate, _oosuTitleTemplate, "Шаблон названия ООСУ", "template_string");
            await ctx.SaveChangesAsync();
            _successMessage = "Настройки ООО сохранены.";
        }
        catch { }
    }

    private static async Task UpsertSetting(SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext ctx,
        string key, string value, string description, string? validationType = null)
    {
        var setting = await ctx.SystemSettings.FirstOrDefaultAsync(x => x.Key == key);
        if (setting is not null)
        {
            setting.Value = value;
            setting.ValidationType = validationType;
            setting.UpdatedAt = DateTime.UtcNow;
        }
        else
        {
            ctx.SystemSettings.Add(new SamorodinkaTech.Fiducia.Domain.Entities.SystemSetting
            {
                Id = Guid.NewGuid(), Key = key, Value = value, Description = description,
                ValidationType = validationType, CreatedAt = DateTime.UtcNow
            });
        }
    }

    private static readonly HashSet<string> KnownPlaceholders = new(StringComparer.OrdinalIgnoreCase) { "{YYYY}", "{YY}", "{MM}", "{DD}" };

    private static string? ValidateTemplate(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        if (value.Length > 200) return "Шаблон слишком длинный (максимум 200 символов).";
        var matches = System.Text.RegularExpressions.Regex.Matches(value, @"\{[A-Za-z]+\}");
        foreach (System.Text.RegularExpressions.Match m in matches)
        {
            if (m.Value != m.Value.ToUpperInvariant())
                return $"Плейсхолдер «{m.Value}» должен быть в верхнем регистре: «{m.Value.ToUpperInvariant()}».";
            if (!KnownPlaceholders.Contains(m.Value))
                return $"Неизвестный плейсхолдер «{m.Value}». Допустимы: {string.Join(", ", KnownPlaceholders)}";
        }
        return null;
    }
}
