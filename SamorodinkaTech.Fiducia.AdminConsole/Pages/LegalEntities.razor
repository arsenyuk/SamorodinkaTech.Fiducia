@page "/legal-entities"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using SamorodinkaTech.Fiducia.Domain.Models.Spark
@using SamorodinkaTech.Fiducia.Domain.Models
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@inject SamorodinkaTech.Fiducia.Domain.Interfaces.ILegalEntityGosaIntervalService GosaSvc
@inject SamorodinkaTech.Fiducia.Domain.Interfaces.ISparkDataService SparkDataSvc
@inject ILogger<LegalEntities> Logger
@inject SamorodinkaTech.Fiducia.Domain.Interfaces.IFileStorage FileStorage
@inject IHttpContextAccessor HttpContextAccessor
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SYS_ADMIN")]

<h3>Юридическое лицо</h3>

@if (selectedEntity is null)
{
    <div class="mb-3">
        <label class="form-label">Поиск ЮЛ</label>
        <input class="form-control" value="@search" @oninput="OnSearchInput" placeholder="Наименование / ИНН / ОГРН" />
        @if (searchResults?.Any() == true)
        {
            <div class="dropdown-menu show w-100 mt-1" style="display:block; position:relative;">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Наименование</th>
                            <th>Краткое</th>
                            <th>ИНН</th>
                            <th>ОГРН</th>
                            <th>ОКОПФ</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var le in searchResults!)
                    {
                        <tr class="table-row-hover" style="cursor:pointer" @onclick="async () => await SelectEntity(le)">
                            <td>@le.Name</td>
                            <td>@le.ShortName</td>
                            <td>@le.Inn</td>
                            <td>@le.Ogrn</td>
                            <td>@(le.RefOkopf is null ? string.Empty : $"{le.RefOkopf.Code} · {le.RefOkopf.Name}")</td>
                        </tr>
                    }
                    </tbody>
                </table>
                <div class="px-2 py-1 text-muted small">Показано до @limit записей</div>
            </div>
        }
    </div>
}

@if (selectedEntity is not null)
{
    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">@selectedEntity.Name (@selectedEntity.Inn)</h5>
                <div class="d-flex gap-2">
                    @if (!string.IsNullOrEmpty(selectedEntity?.Inn))
                    {
                        <button class="btn btn-sm btn-outline-secondary"
                                @onclick="LoadSparkData"
                                disabled="@sparkLoading"
                                title="Загрузить данные из СПАРК">
                            @if (sparkLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                @:СПАРК...
                            }
                            else
                            {
                                @:СПАРК
                            }
                        </button>
                    }
                    <button class="btn btn-sm btn-outline-primary" @onclick="ShowSearch">Поиск</button>
                </div>
            </div>

            <div class="mb-3">
                <span class="badge bg-info fs-6">@EntityTypeLabel</span>
            </div>

            <ul class="nav nav-tabs mb-3">
                <li class="nav-item">
                    <button class="nav-link @(_activeTab == 0 ? "active" : "")" @onclick="() => _activeTab = 0">Карточка ЮЛ</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(_activeTab == 1 ? "active" : "")" @onclick="() => _activeTab = 1">Руководитель</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(_activeTab == 2 ? "active" : "")" @onclick="() => _activeTab = 2">Интервал @GosaLabel</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(_activeTab == 3 ? "active" : "")" @onclick="() => _activeTab = 3">Документооборот</button>
                </li>
                @if (_orgType == OrgType.LLC)
                {
                    <li class="nav-item">
                        <button class="nav-link @(_activeTab == 4 ? "active" : "")" @onclick="() => _activeTab = 4">Устав</button>
                    </li>
                }
                @if (editHasBoardOfDirectors)
                {
                    <li class="nav-item">
                        <button class="nav-link @(_activeTab == 5 ? "active" : "")" @onclick="() => _activeTab = 5">Совет директоров</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(_activeTab == 6 ? "active" : "")" @onclick="() => _activeTab = 6">Комитеты</button>
                    </li>
                }
            </ul>

            @if (_activeTab == 0)
            {
                <div class="row g-3">
                    <div class="col-md-6">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted fw-normal">Полное наименование</dt>
                            <dd class="col-sm-8">@(_sparkCompanyFullName ?? selectedEntity.Name)</dd>

                            <dt class="col-sm-4 text-muted fw-normal">Краткое наименование</dt>
                            <dd class="col-sm-8">@(_sparkCompanyShortName ?? selectedEntity.ShortName ?? "—")</dd>

                            <dt class="col-sm-4 text-muted fw-normal">ИНН</dt>
                            <dd class="col-sm-8">@selectedEntity.Inn</dd>

                            <dt class="col-sm-4 text-muted fw-normal">ОГРН</dt>
                            <dd class="col-sm-8">@(_sparkCompanyOgrn ?? selectedEntity.Ogrn ?? "—")</dd>

                            <dt class="col-sm-4 text-muted fw-normal">ОКОПФ</dt>
                            <dd class="col-sm-8">@(_sparkCompanyOkopfName ?? selectedEntity.RefOkopf?.Name ?? "—")</dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted fw-normal">Юридический адрес</dt>
                            <dd class="col-sm-8">@(_sparkCompanyAddress ?? "—")</dd>

                            <dt class="col-sm-4 text-muted fw-normal">Статус</dt>
                            <dd class="col-sm-8">@(_sparkCompanyStatus ?? "—")</dd>

                            <dt class="col-sm-4 text-muted fw-normal">Дата регистрации</dt>
                            <dd class="col-sm-8">@(_sparkCompanyRegDate?.ToString("dd.MM.yyyy") ?? "—")</dd>
                        </dl>
                    </div>
                </div>
            }  @* end of _activeTab == 0 *@

            @if (_activeTab == 1)
            {
                <div class="row g-3">
                    <div class="col-md-6">
                        @if (!string.IsNullOrEmpty(_sparkManagerName))
                        {
                            <dl class="row mb-0">
                                <dt class="col-sm-4 text-muted fw-normal">ФИО</dt>
                                <dd class="col-sm-8">@_sparkManagerName</dd>

                                <dt class="col-sm-4 text-muted fw-normal">Должность</dt>
                                <dd class="col-sm-8">@(_sparkManagerPosition ?? "—")</dd>

                                <dt class="col-sm-4 text-muted fw-normal">ИНН</dt>
                                <dd class="col-sm-8">@(_sparkManagerInn ?? "—")</dd>

                                <dt class="col-sm-4 text-muted fw-normal">Назначен</dt>
                                <dd class="col-sm-8">@(_sparkManagerStartDate?.ToString("dd.MM.yyyy") ?? "—")</dd>
                            </dl>
                        }
                        else if (!string.IsNullOrEmpty(selectedEntity?.Inn))
                        {
                            <div class="text-muted">Нажмите «СПАРК» для загрузки данных</div>
                        }
                        else
                        {
                            <div class="text-muted">Нет данных</div>
                        }
                        @if (!string.IsNullOrEmpty(sparkError))
                        {
                            <div class="text-danger small mt-2">@sparkError</div>
                        }
                        @if (!string.IsNullOrEmpty(sparkWarning))
                        {
                            <div class="text-warning small mt-1">@sparkWarning</div>
                        }
                    </div>
                    @if (_orgType == OrgType.LLC && _sparkFounders.Count > 0)
                    {
                        <div class="col-md-6">
                            <h6 class="text-muted mb-2">Учредители (участники)</h6>
                            @foreach (var f in _sparkFounders)
                            {
                                var displayName = f.FullName ?? f.Name ?? "—";
                                var displayInn = f.PersonInn ?? f.Inn;
                                <div class="card mb-2">
                                    <div class="card-body py-2 px-3">
                                        <div class="fw-semibold">@displayName</div>
                                        @if (!string.IsNullOrEmpty(displayInn))
                                        {
                                            <div class="small text-muted">ИНН: @displayInn</div>
                                        }
                                        <div class="small">
                                            @if (f.SharePercent.HasValue)
                                            {
                                                <span>@f.SharePercent.Value.ToString("0.##")%</span>
                                            }
                                            @if (f.ShareAmount.HasValue)
                                            {
                                                <span class="text-muted">(@f.ShareAmount.Value.ToString("N2") ₽)</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }  @* end of _activeTab == 1 *@

            @if (_activeTab == 2)
            {
                <div class="mb-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-auto">
                            <label class="form-label">Начало @GosaLabel</label>
                            <div class="d-flex gap-1">
                                <select class="form-select" style="width:80px" @bind="gosaStartDay" disabled="@(!gosaIsPjsc)">
                                    @for (int d = 1; d <= 31; d++)
                                    {
                                        <option value="@d">@d</option>
                                    }
                                </select>
                                <select class="form-select" style="width:100px" @bind="gosaStartMonth" disabled="@(!gosaIsPjsc)">
                                    <option value="3">Март</option>
                                    <option value="4">Апрель</option>
                                    <option value="5">Май</option>
                                    <option value="6">Июнь</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-auto">
                            <label class="form-label">Завершение @GosaLabel</label>
                            <div class="d-flex gap-1">
                                <select class="form-select" style="width:80px" @bind="gosaEndDay" disabled="@(!gosaIsPjsc)">
                                    @for (int d = 1; d <= 31; d++)
                                    {
                                        <option value="@d">@d</option>
                                    }
                                </select>
                                <select class="form-select" style="width:100px" @bind="gosaEndMonth" disabled="@(!gosaIsPjsc)">
                                    <option value="3">Март</option>
                                    <option value="4">Апрель</option>
                                    <option value="5">Май</option>
                                    <option value="6">Июнь</option>
                                </select>
                            </div>
                        </div>
                        @if (gosaIsPjsc)
                        {
                            <div class="col-auto align-self-center">
                                <span class="text-muted small">Допустимый диапазон: 01.03 – 30.06 (<a href="/board-law/47">ст. 47 208-ФЗ</a>)</span>
                            </div>
                        }
                        else if (_orgType == OrgType.LLC)
                        {
                            <div class="col-auto align-self-center">
                                <span class="text-muted small">Для ООО интервал фиксирован: 01.03 – 30.04 (<a href="/board-law/article-14fz-34">ст. 34 14-ФЗ</a>)</span>
                            </div>
                        }
                        else if (_orgType == OrgType.NJSC)
                        {
                            <div class="col-auto align-self-center">
                                <span class="text-muted small">Для НАО интервал фиксирован: 01.03 – 30.06 (<a href="/board-law/47">п. 5 ст. 47 208-ФЗ</a>)</span>
                            </div>
                        }
                        <div class="col-auto">
                            @if (!string.IsNullOrEmpty(gosaError))
                            {
                                <span class="text-danger small">@gosaError</span>
                            }
                        </div>
                    </div>
                </div>
            }  @* end of _activeTab == 2 *@

            @if (_activeTab == 3)
            {
                <div class="mb-3">
                    <div class="form-check" @onclick="() => _editDocumentFlow = SamorodinkaTech.Fiducia.Domain.Enums.DocumentFlowType.Paper">
                        <input class="form-check-input" type="radio" name="docFlow"
                               checked="@(_editDocumentFlow == SamorodinkaTech.Fiducia.Domain.Enums.DocumentFlowType.Paper)">
                        <label class="form-check-label">Бумажный документооборот</label>
                    </div>
                    <div class="form-check" @onclick="() => _editDocumentFlow = SamorodinkaTech.Fiducia.Domain.Enums.DocumentFlowType.Mixed">
                        <input class="form-check-input" type="radio" name="docFlow"
                               checked="@(_editDocumentFlow == SamorodinkaTech.Fiducia.Domain.Enums.DocumentFlowType.Mixed)">
                        <label class="form-check-label">Смешанный документооборот (бумажный и ЮЗЭДО)</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="docFlow" value="2"
                               disabled>
                        <label class="form-check-label text-muted">Юридически значимый электронный документооборот (ЮЗЭДО)</label>
                    </div>
                    <div class="text-muted small mt-2">
                        В связи с особенностями текущего законодательства выбор только электронного документооборота
                        (без бумажного) невозможен.
                    </div>
                </div>
            }  @* end of _activeTab == 3 *@

            @if (_activeTab == 5)
            {
                <fieldset class="border rounded p-3 mb-3">
                    <legend class="float-none w-auto px-2 mb-0">Допустимые формы голосования</legend>
                    <div class="d-flex gap-4 flex-wrap">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="editInPersonAllowed" checked disabled>
                            <label class="form-check-label" for="editInPersonAllowed">
                                Очное голосование
                            </label>
                            <div class="text-muted small">Допускается на заседаниях</div>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="editAbsenteeAllowed" @bind="_editAbsenteeAllowed">
                            <label class="form-check-label" for="editAbsenteeAllowed">
                                Заочное голосование
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="editMixedAllowed" @bind="_editMixedAllowed">
                            <label class="form-check-label" for="editMixedAllowed">
                                Смешанное голосование
                            </label>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="border rounded p-3 mb-3">
                    <legend class="float-none w-auto px-2 mb-0">Пороги голосования</legend>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Кворум (%)</label>
                            <input type="number" class="form-control" @bind="_editQuorumPercent" min="50" max="100">
                            @if (_orgType != OrgType.LLC)
                            {
                            <small class="text-muted">Не менее 50% от числа избранных членов (<a href="/board-law/68">п. 2 ст. 68 208-ФЗ</a>)</small>
                            }
                        </div>
                        @if (_orgType != OrgType.LLC)
                        {
                        <div class="col-md-6">
                            <label class="form-label">Квалифицированное большинство (%)</label>
                            <input type="number" class="form-control" @bind="_editQualifiedMajorityPercent" min="51" max="100">
                            <small class="text-muted">Для приостановления полномочий ЕИО и иных особых решений (<a href="/board-law/69">п. 3 ст. 69 208-ФЗ</a>)</small>
                        </div>
                        }
                    </div>
                </fieldset>

                <fieldset class="border rounded p-3 mb-3">
                    <legend class="float-none w-auto px-2 mb-0">Особые правила</legend>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="editChairTiebreaker" @bind="_editChairTiebreaker">
                        <label class="form-check-label" for="editChairTiebreaker">
                            Решающий голос председателя при равенстве голосов
                        </label>
                    </div>
                    @if (_orgType != OrgType.LLC)
                    {
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="editAbsenteeOpinions" @bind="_editAbsenteeOpinions">
                        <label class="form-check-label" for="editAbsenteeOpinions">
                            Учёт письменных мнений отсутствующих членов СД
                        </label>
                        <div class="text-muted small">Если предусмотрено уставом (<a href="/board-law/68">п. 1 ст. 68 208-ФЗ</a>)</div>
                    </div>
                    }
                    @if (_orgType != OrgType.LLC)
                    {
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="editSpotByElection" @bind="_editSpotByElection">
                        <label class="form-check-label" for="editSpotByElection">
                            Точечное доизбрание членов СД взамен выбывших
                        </label>
                        <div class="text-muted small">Если предусмотрено уставом (<a href="/board-law/66">п. 6 ст. 66 208-ФЗ</a>)</div>
                    </div>
                    }
                    <div class="row g-2 align-items-center mb-2">
                        <div class="col-auto">
                            <label class="col-form-label">Предельный срок первого заседания СД (дней от ОСА)</label>
                        </div>
                        <div class="col-auto">
                            <input type="number" class="form-control" @bind="_editFirstMeetingDeadlineDays" min="1" max="183" style="width:90px">
                        </div>
                        <div class="col-auto">
                            <small class="text-muted">По умолчанию 30 дней</small>
                        </div>
                    </div>
                </fieldset>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Положение о Совете директоров (PDF)</label>
                        <FileUpload Accept=".pdf"
                                    MaxSizeBytes="52428800"
                                    FileType="REGULATION"
                                    Token="@_jwtToken"
                                    OnFileUploaded="OnBoardRegulationFileUploaded"
                                    OnUploadError="OnBoardRegulationUploadError" />
                        @if (_customBoardRegulationDocName != null && _customBoardRegulationDocId.HasValue)
                        {
                            <a href="/api/files/@_customBoardRegulationDocId/download" target="_blank"
                               class="text-success small">📄 @_customBoardRegulationDocName</a>
                        }
                    </div>
                </div>
            }  @* end of _activeTab == 5 *@

            @if (_activeTab == 6)
            {
                var isPjsc = _orgType == OrgType.PJSC;
                @if (_orgType != OrgType.LLC)
                {
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="editCommitteesMandatory"
                           checked="@(isPjsc || _editCommitteesMandatory)"
                           disabled="@isPjsc"
                           @onchange="args => { if (!isPjsc) _editCommitteesMandatory = (bool)(args.Value ?? false); }">
                    <label class="form-check-label" for="editCommitteesMandatory">
                        Комитеты обязательны
                    </label>
                    <div class="text-muted small">Для ПАО обязателен комитет по аудиту (<a href="/board-law/64">п. 3 ст. 64 208-ФЗ</a>)</div>
                </div>
                }
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="editCommitteesDefinedByDocuments" @bind="_editCommitteesDefinedByDocuments">
                    <label class="form-check-label" for="editCommitteesDefinedByDocuments">
                        Комитеты определены документами Общества
                    </label>
                </div>
                @if (_editCommitteesDefinedByDocuments)
                {
                <div class="mt-2">
                    @if (_customCommitteeRegulationDocName != null && _customCommitteeRegulationDocId.HasValue && !_showCommitteeRegulationUpload)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <a href="/api/files/@_customCommitteeRegulationDocId/download" target="_blank"
                               class="btn btn-sm btn-outline-success">📄 @_customCommitteeRegulationDocName</a>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showCommitteeRegulationUpload = true">Заменить</button>
                        </div>
                    }
                    else
                    {
                        <FileUpload Accept=".pdf"
                                    MaxSizeBytes="52428800"
                                    FileType="REGULATION"
                                    Token="@_jwtToken"
                                    OnFileUploadedInfo="OnCommitteeRegulationFileUploadedInfo"
                                    OnUploadError="OnCommitteeRegulationUploadError" />
                    }
                </div>
                <div class="d-flex align-items-center gap-4 mb-2">
                    <div class="form-check mb-0 flex-shrink-0" style="width:540px">
                        <input class="form-check-input" type="checkbox" id="editMaxCommitteesPerMemberDefined"
                               @bind="_editMaxCommitteesPerMemberDefined"
                               @bind:after="OnMaxPerMemberDefinedChanged">
                        <label class="form-check-label" for="editMaxCommitteesPerMemberDefined">
                            Определено максимальное число комитетов для одного члена СД
                        </label>
                    </div>
                    @if (_editMaxCommitteesPerMemberDefined)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <label class="form-label mb-0 text-nowrap">Макс. число комитетов на одного члена СД</label>
                            <input type="number" class="form-control form-control-sm" @bind="_editMaxCommitteesPerMember" min="1" style="width:80px">
                        </div>
                    }
                </div>
                <div class="d-flex align-items-center gap-4 mb-2">
                    <div class="form-check mb-0 flex-shrink-0" style="width:540px">
                        <input class="form-check-input" type="checkbox" id="editMaxCommitteesHeadedPerMemberDefined"
                               @bind="_editMaxCommitteesHeadedPerMemberDefined"
                               @bind:after="OnMaxHeadedDefinedChanged">
                        <label class="form-check-label" for="editMaxCommitteesHeadedPerMemberDefined">
                            Определено макс. число возглавляемых комитетов для одного члена СД
                        </label>
                    </div>
                    @if (_editMaxCommitteesHeadedPerMemberDefined)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <label class="form-label mb-0 text-nowrap">Макс. число возглавляемых комитетов</label>
                            <input type="number" class="form-control form-control-sm" @bind="_editMaxCommitteesHeadedPerMember" min="1" style="width:80px">
                        </div>
                    }
                </div>
                <div class="d-flex align-items-center gap-4 mb-2">
                    <div class="form-check mb-0 flex-shrink-0" style="width:540px">
                        <input class="form-check-input" type="checkbox" id="editMinCommitteeMembersDefined"
                               @bind="_editMinCommitteeMembersDefined"
                               @bind:after="OnMinMembersDefinedChanged">
                        <label class="form-check-label" for="editMinCommitteeMembersDefined">
                            Определено мин. количество членов в комитете
                        </label>
                    </div>
                    @if (_editMinCommitteeMembersDefined)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <label class="form-label mb-0 text-nowrap">Мин. количество членов в комитете</label>
                            <input type="number" class="form-control form-control-sm" @bind="_editMinCommitteeMembers" min="2" style="width:80px">
                        </div>
                    }
                </div>
                <div class="d-flex align-items-center gap-4 mb-2">
                    <div class="form-check mb-0 flex-shrink-0" style="width:540px">
                        <input class="form-check-input" type="checkbox" id="editCommitteeQuorumDefined"
                               @bind="_editCommitteeQuorumDefined"
                               @bind:after="OnQuorumDefinedChanged">
