                                    <select class="form-select" @bind="_decisionConfirmStr">
                                        <option value="False">Нотариальное</option>
                                        <option value="True">Подписание всеми участниками</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Переход доли наследникам</label>
                                    <select class="form-select" @bind="_inheritanceStr">
                                        <option value="False">С согласия участников</option>
                                        <option value="True">Без согласия участников</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row g-3 mt-2">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold" title="Обязательный аудит годовой отчётности — выручка >800 млн или активы >400 млн (ст. 5 307-ФЗ). Влияет на состав задач при подготовке к ООСУ/ВОСУ.">Обязательный аудит</label>
                                    <select class="form-select" @bind="_mandatoryAuditStr">
                                        <option value="">Не указано</option>
                                        <option value="True">Да</option>
                                        <option value="False">Нет</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold" title="Наличие ревизионной комиссии (ревизора) — >15 участников ООО по ст. 32 14-ФЗ. Влияет на состав задач при подготовке к ООСУ/ВОСУ.">Ревизионная комиссия</label>
                                    <select class="form-select" @bind="_hasRevisionStr">
                                        <option value="">Не указано</option>
                                        <option value="True">Да</option>
                                        <option value="False">Нет</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold" title="Наличие Совета директоров. Для ООО — только по нетиповому уставу. Определяет доступность вкладки «Совет директоров».">Совет директоров</label>
                                    <select class="form-select" @bind="_hasBoardOfDirectorsStr">
                                        <option value="False">Нет</option>
                                        <option value="True">Да</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }  @* end of _activeTab == 4 *@

            <div class="d-flex gap-2">
                <button class="btn btn-primary" @onclick="Save" disabled="@(!CanSave)">Сохранить</button>
                <button class="btn btn-outline-danger" @onclick="ConfirmDelete">Очистить</button>
            </div>

            @if (_showDeleteConfirm)
            {
                <div class="modal d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5)">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Подтверждение очистки</h5>
                                <button type="button" class="btn-close" @onclick="() => _showDeleteConfirm = false"></button>
                            </div>
                            <div class="modal-body">
                                <p>Очистить конфигурацию юридического лица <strong>@selectedEntity?.Name</strong> (@selectedEntity?.Inn)?</p>
                                <p class="text-muted mb-0">Будут сброшены: устав, email-настройки, правила голосования в СД. ОСА, Совет директоров и организационные мероприятия не затрагиваются.</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" @onclick="() => _showDeleteConfirm = false">Отмена</button>
                                <button type="button" class="btn btn-danger" @onclick="Delete" disabled="@_deleteLoading">
                                    @if (_deleteLoading)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    }
                                    Очистить
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(saveError))
{
    <div class="alert alert-danger mt-3">@saveError</div>
}
@if (!string.IsNullOrEmpty(saveSuccess))
{
    <div class="alert alert-success mt-3">@saveSuccess</div>
}

