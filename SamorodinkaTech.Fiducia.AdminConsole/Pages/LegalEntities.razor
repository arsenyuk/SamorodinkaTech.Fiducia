    private string? _lastCharterNumber;

    private async Task OnCharterNumberSet(string? value)
    {
        if (_isLoadingCharter) return;
        if (value == _editCharterNumber) return;
        _editCharterNumber = value;
        await OnCharterNumberChanged();
    }

    private async Task OnCharterNumberChanged()
    {
        if (string.IsNullOrEmpty(_editCharterNumber))
        {
            _charterSettings = null;
            if (selectedEntity is not null)
                await LoadCharterAsync(null, selectedEntity.Id);
            return;
        }

        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var charter = await ctx.RefStandardCharters
                .FirstOrDefaultAsync(x => x.Number == _editCharterNumber);
            _charterSettings = charter is not null
                ? StandardCharterInfo.FromEntity(charter)
                : null;

            // Авто-заполняем параметры из типового устава
            if (charter is not null)
            {
                _customExitAllowed = charter.ExitAllowed;
                _customTransferToParticipants = charter.TransferToParticipantsWithoutConsent;
                _customTransferToThirdParties = charter.TransferToThirdPartiesWithoutConsent;
                _customPreemptiveRight = charter.PreemptiveRight;
                _customInheritance = charter.InheritanceWithoutConsent;
                _customExecutiveBody = charter.ExecutiveBody;
                _customDecisionConfirmation = charter.DecisionConfirmationByAllSign;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки данных типового устава №{Number}", _editCharterNumber);
            _charterSettings = null;
        }
    }

