    private async Task<Guid> SaveUploadedFileAsync(
        SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext ctx,
        IBrowserFile file)
    {
        // Проверка запрещённых расширений
        var ext = System.IO.Path.GetExtension(file.Name)?.TrimStart('.').ToLowerInvariant();
        if (!string.IsNullOrEmpty(ext) && _blockedExtensions.Contains(ext))
            throw new InvalidOperationException($"Загрузка файлов с расширением .{ext} запрещена.");

        await using var stream = file.OpenReadStream(maxAllowedSize: 50_000_000);
        var storageKey = await FileStorage.SaveAsync(stream, file.Name, file.ContentType, CancellationToken.None);
        var entry = new FileEntry
        {
            Id = Guid.NewGuid(),
            OriginalName = file.Name,
            ContentType = file.ContentType,
            SizeBytes = file.Size,
            StorageProvider = "LOCAL",
            StorageKeyOrPath = storageKey,
            Extension = System.IO.Path.GetExtension(file.Name)?.TrimStart('.')
        };
        ctx.Files.Add(entry);
        return entry.Id;
    }

