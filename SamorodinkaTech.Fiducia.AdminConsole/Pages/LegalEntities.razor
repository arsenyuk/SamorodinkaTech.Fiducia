@page "/legal-entities"
@using Microsoft.EntityFrameworkCore
@using SamorodinkaTech.Fiducia.Domain.Entities
@using SamorodinkaTech.Fiducia.Domain.Enums
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@inject ILogger<LegalEntities> Logger
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SYS_ADMIN")]

<h3>Юридическое лицо</h3>

@if (selectedEntity is null)
{
    <div class="mb-3">
        <label class="form-label">Поиск ЮЛ</label>
        <div class="input-group">
            <input class="form-control" @bind="_searchInput" @bind:event="oninput"
                   placeholder="Наименование / ИНН / ОГРН"
                   @onkeydown="OnSearchKeyDown" />
            <button class="btn btn-outline-secondary" @onclick="ExecuteSearch"
                    disabled="@(_searchInput?.Trim().Length < 2)">
                Найти
            </button>
        </div>
        @if (searchResults?.Any() == true)
        {
            <div class="dropdown-menu show w-100 mt-1" style="display:block; position:relative;">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Наименование</th>
                            <th>Краткое</th>
                            <th>ИНН</th>
                            <th>ОКОПФ</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var le in searchResults!)
                    {
                        <tr class="table-row-hover" style="cursor:pointer" @onclick="async () => await SelectEntity(le)">
                            <td>@le.Name</td>
                            <td>@(le.ShortName ?? "—")</td>
                            <td>@le.Inn</td>
                            <td>@(le.RefOkopf is null ? "" : $"{le.RefOkopf.Code} · {le.RefOkopf.Name}")</td>
                        </tr>
                    }
                    </tbody>
                </table>
                <div class="px-2 py-1 text-muted small">Показано до @limit записей</div>
            </div>
        }
    </div>

    <div class="mt-3">
        <button class="btn btn-success" @onclick="ShowCreateForm">+ Создать ЮЛ</button>
    </div>

    @if (_showCreateForm)
    {
        <div class="card mt-3">
            <div class="card-body">
                <h5>Новое юридическое лицо</h5>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">Наименование *</label>
                        <input type="text" class="form-control" @bind="_createName" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">ИНН *</label>
                        <input type="text" class="form-control" @bind="_createInn" maxlength="12" />
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_createError))
                {
                    <div class="text-danger mt-2">@_createError</div>
                }
                <div class="mt-3">
                    <button class="btn btn-primary" @onclick="CreateLegalEntity" disabled="@(_createLoading || string.IsNullOrWhiteSpace(_createName) || string.IsNullOrWhiteSpace(_createInn))">
                        @if (_createLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Создать
                    </button>
                    <button class="btn btn-secondary ms-2" @onclick="() => _showCreateForm = false">Отмена</button>
                </div>
            </div>
        </div>
    }
}

@if (selectedEntity is not null)
{
    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">@selectedEntity.Name (@selectedEntity.Inn)</h5>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-primary" @onclick="ShowSearch">Поиск</button>
                </div>
            </div>

            <ul class="nav nav-tabs mb-3">
                <li class="nav-item">
                    <button class="nav-link @(_activeTab == 0 ? "active" : "")" @onclick="() => _activeTab = 0">Карточка ЮЛ</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(_activeTab == 1 ? "active" : "")" @onclick="LoadEmployeesTab">Привязки учётных записей</button>
                </li>
            </ul>

            @if (_activeTab == 0)
            {
                <div class="row g-3">
                    <div class="col-md-6">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted fw-normal">Полное наименование</dt>
                            <dd class="col-sm-8">@selectedEntity.Name</dd>

                            <dt class="col-sm-4 text-muted fw-normal">Краткое наименование</dt>
                            <dd class="col-sm-8">@(selectedEntity.ShortName ?? "—")</dd>

                            <dt class="col-sm-4 text-muted fw-normal">ИНН</dt>
                            <dd class="col-sm-8">@selectedEntity.Inn</dd>

                            <dt class="col-sm-4 text-muted fw-normal">ОГРН</dt>
                            <dd class="col-sm-8">@(selectedEntity.Ogrn ?? "—")</dd>

                            <dt class="col-sm-4 text-muted fw-normal">ОКОПФ</dt>
                            <dd class="col-sm-8">@(selectedEntity.RefOkopf?.Name ?? "—")</dd>
                        </dl>
                    </div>
                </div>
            }

            @if (_activeTab == 1)
            {
                <h6>Сотрудники и учётные записи</h6>

                @if (_employees.Count > 0)
                {
                    <table class="table table-sm table-striped mb-3">
                        <thead>
                            <tr>
                                <th>ФИО</th>
                                <th>Должность</th>
                                <th>Учётная запись</th>
                                <th style="width:60px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in _employees)
                            {
                                <tr>
                                    <td>@e.PersonFullName</td>
                                    <td>@(e.Position ?? "—")</td>
                                    <td>@(e.UserLogin ?? "—")</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveEmployee(e.Id)" title="Удалить">✕</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-muted mb-3">Сотрудники не добавлены.</div>
                }

                <div class="card">
                    <div class="card-body">
                        <h6>Добавить сотрудника</h6>
                        <div class="row g-2">
                            <div class="col-md-3">
                                <input type="text" class="form-control form-control-sm" @bind="_newFirstName" placeholder="Фамилия" />
                            </div>
                            <div class="col-md-3">
                                <input type="text" class="form-control form-control-sm" @bind="_newLastName" placeholder="Имя" />
                            </div>
                            <div class="col-md-3">
                                <input type="text" class="form-control form-control-sm" @bind="_newMiddleName" placeholder="Отчество" />
                            </div>
                            <div class="col-md-3">
                                <input type="text" class="form-control form-control-sm" @bind="_newPosition" placeholder="Должность" />
                            </div>
                        </div>
                        <div class="row g-2 mt-2">
                            <div class="col-md-6">
                                <select class="form-select form-select-sm" @bind="_newUserId">
                                    <option value="">— выбрать учётную запись —</option>
                                    @foreach (var u in _availableUsers)
                                    {
                                        <option value="@u.Id">@u.Login (@u.LastName @u.FirstName)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <button class="btn btn-sm btn-primary" @onclick="AddEmployee"
                                        disabled="@(_addLoading || string.IsNullOrWhiteSpace(_newFirstName) || string.IsNullOrWhiteSpace(_newLastName))">
                                    @if (_addLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                    Добавить
                                </button>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(_addError))
                        {
                            <div class="text-danger mt-2 small">@_addError</div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    // ── Поиск ──────────────────────────────────────────────────────
    private string _searchInput = string.Empty;
    private List<LegalEntityVm>? searchResults;
    private LegalEntityVm? selectedEntity;
    private const int limit = 50;

    // ── Табы ───────────────────────────────────────────────────────
    private int _activeTab;

    // ── Создание ЮЛ ───────────────────────────────────────────────
    private bool _showCreateForm;
    private string _createName = "";
    private string _createInn = "";
    private bool _createLoading;
    private string? _createError;

    // ── Сотрудники ─────────────────────────────────────────────────
    private List<EmployeeDto> _employees = new();
    private List<UserVm> _availableUsers = new();
    private string _newFirstName = "";
    private string _newLastName = "";
    private string? _newMiddleName;
    private string? _newPosition;
    private string? _newUserId;
    private bool _addLoading;
    private string? _addError;

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            _ = ExecuteSearch();
    }

    private async Task ExecuteSearch()
    {
        if (string.IsNullOrWhiteSpace(_searchInput) || _searchInput.Trim().Length < 2)
        {
            searchResults = null;
            return;
        }

        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var q = _searchInput.Trim();
            searchResults = await ctx.LegalEntities
                .Include(le => le.RefOkopf)
                .Where(le =>
                    (le.Name != null && EF.Functions.ILike(le.Name, $"%{q}%")) ||
                    (le.ShortName != null && EF.Functions.ILike(le.ShortName, $"%{q}%")) ||
                    (le.Inn != null && EF.Functions.ILike(le.Inn, $"%{q}%")) ||
                    (le.Ogrn != null && EF.Functions.ILike(le.Ogrn, $"%{q}%")))
                .OrderBy(le => le.Name)
                .Take(limit)
                .Select(le => new LegalEntityVm
                {
                    Id = le.Id,
                    Name = le.Name,
                    ShortName = le.ShortName,
                    Inn = le.Inn,
                    Ogrn = le.Ogrn,
                    RefOkopf = le.RefOkopf != null ? new OkopfVm { Code = le.RefOkopf.Code, Name = le.RefOkopf.Name } : null
                })
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка поиска ЮЛ");
            searchResults = null;
        }
    }

    private async Task SelectEntity(LegalEntityVm le)
    {
        selectedEntity = le;
        searchResults = null;
        _activeTab = 0;
        await LoadEmployeesAsync();
    }

    private void ShowSearch()
    {
        selectedEntity = null;
        _searchInput = string.Empty;
        searchResults = null;
    }

    private void ShowCreateForm()
    {
        _showCreateForm = true;
        _createError = null;
    }

    private async Task CreateLegalEntity()
    {
        _createLoading = true;
        _createError = null;

        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();

            // Проверка уникальности ИНН
            if (await ctx.LegalEntities.AnyAsync(le => le.Inn == _createInn))
            {
                _createError = $"ЮЛ с ИНН {_createInn} уже существует.";
                return;
            }

            var le = new LegalEntity
            {
                Id = Guid.NewGuid(),
                Name = _createName,
                Inn = _createInn
            };

            ctx.LegalEntities.Add(le);
            await ctx.SaveChangesAsync();

            selectedEntity = new LegalEntityVm
            {
                Id = le.Id,
                Name = le.Name,
                Inn = le.Inn
            };

            _showCreateForm = false;
            _activeTab = 0;
            await LoadEmployeesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка создания ЮЛ");
            _createError = "Не удалось создать ЮЛ.";
        }
        finally
        {
            _createLoading = false;
        }
    }

    private async Task LoadEmployeesTab()
    {
        _activeTab = 1;
        await LoadEmployeesAsync();
    }

    private async Task LoadEmployeesAsync()
    {
        if (selectedEntity is null) return;

        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();

            // Загружаем сотрудников ЮЛ
            _employees = await ctx.Employees
                .Include(e => e.Person)
                .Include(e => e.LegalEntity)
                .Where(e => e.LegalEntityId == selectedEntity.Id)
                .Select(e => new EmployeeDto
                {
                    Id = e.Id,
                    PersonFullName = e.Person != null
                        ? string.Join(" ", new[] { e.Person.LastName, e.Person.FirstName, e.Person.MiddleName }.Where(p => !string.IsNullOrWhiteSpace(p)))
                        : "—",
                    Position = e.Position,
                    UserId = null,
                    UserLogin = null
                })
                .ToListAsync();

            // Загружаем доступные учётные записи
            _availableUsers = await ctx.Users
                .Select(u => new UserVm
                {
                    Id = u.Id,
                    Login = u.Login,
                    LastName = u.LastName,
                    FirstName = u.FirstName
                })
                .OrderBy(u => u.Login)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки сотрудников для ЮЛ {LegalEntityId}", selectedEntity.Id);
        }
    }

    private async Task AddEmployee()
    {
        if (selectedEntity is null) return;

        _addLoading = true;
        _addError = null;

        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();

            // Создаём ФЛ
            var person = new Person
            {
                Id = Guid.NewGuid(),
                LastName = _newFirstName,
                FirstName = _newLastName,
                MiddleName = _newMiddleName,
                CreatedAt = DateTime.UtcNow
            };
            ctx.Persons.Add(person);

            // Создаём сотрудника
            var employee = new Employee
            {
                Id = Guid.NewGuid(),
                PersonId = person.Id,
                LegalEntityId = selectedEntity.Id,
                Position = _newPosition ?? "",
                CreatedAt = DateTime.UtcNow,
                CreatedBy = Guid.Empty
            };
            ctx.Employees.Add(employee);

            // Привязываем к учётной записи (если выбрана)
            if (Guid.TryParse(_newUserId, out var userId))
            {
                var user = await ctx.Users.FindAsync(userId);
                if (user is not null)
                {
                    user.PersonId = person.Id;
                }
            }

            await ctx.SaveChangesAsync();

            // Сбрасываем форму
            _newFirstName = "";
            _newLastName = "";
            _newMiddleName = null;
            _newPosition = null;
            _newUserId = null;

            await LoadEmployeesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка добавления сотрудника");
            _addError = "Не удалось добавить сотрудника.";
        }
        finally
        {
            _addLoading = false;
        }
    }

    private async Task RemoveEmployee(Guid employeeId)
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var employee = await ctx.Employees.FindAsync(employeeId);
            if (employee is not null)
            {
                ctx.Employees.Remove(employee);
                await ctx.SaveChangesAsync();
                await LoadEmployeesAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка удаления сотрудника {EmployeeId}", employeeId);
        }
    }

    // ── DTO ────────────────────────────────────────────────────────

    private record LegalEntityVm
    {
        public Guid Id { get; init; }
        public string Name { get; init; } = "";
        public string? ShortName { get; init; }
        public string? Inn { get; init; }
        public string? Ogrn { get; init; }
        public OkopfVm? RefOkopf { get; init; }
    }

    private record OkopfVm
    {
        public Guid Id { get; init; }
        public string? Code { get; init; }
        public string? Name { get; init; }
    }

    private record EmployeeDto
    {
        public Guid Id { get; init; }
        public string PersonFullName { get; init; } = "";
        public string? Position { get; init; }
        public Guid? UserId { get; init; }
        public string? UserLogin { get; init; }
    }

    private record UserVm
    {
        public Guid Id { get; init; }
        public string Login { get; init; } = "";
        public string? LastName { get; init; }
        public string? FirstName { get; init; }
    }
}
