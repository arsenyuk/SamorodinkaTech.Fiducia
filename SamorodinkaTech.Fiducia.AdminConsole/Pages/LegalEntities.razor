    private async Task OnSearchInput(ChangeEventArgs e)
    {
        search = e.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(search) || search.Trim().Length < 2)
        {
            searchResults = null;
            return;
        }

        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var q = search.Trim();
            searchResults = await ctx.ExtSparkCompanies
                .Where(le =>
                    (le.FullName != null && EF.Functions.ILike(le.FullName, $"%{q}%")) ||
                    (le.ShortName != null && EF.Functions.ILike(le.ShortName, $"%{q}%")) ||
                    (le.Inn != null && EF.Functions.ILike(le.Inn, $"%{q}%")) ||
                    (le.Ogrn != null && EF.Functions.ILike(le.Ogrn, $"%{q}%")))
                .OrderBy(le => le.FullName)
                .Take(limit)
                .Select(le => new LegalEntityVm
                {
                    Id = le.Id,
                    Name = le.FullName,
                    ShortName = le.ShortName,
                    Inn = le.Inn,
                    Ogrn = le.Ogrn,
                    RefOkopf = le.OkopfCode != null ? new OkopfVm { Code = le.OkopfCode, Name = le.OkopfName } : null
                })
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка поиска ЮЛ по запросу '{Query}'", search);
            searchResults = null;
        }
    }

    private async Task SelectEntity(LegalEntityVm le)
    {
        selectedEntity = le;
        searchResults = null;

        await using var ctx = await DbFactory.CreateDbContextAsync();

        // Если ЮЛ найдено через СПАРК — находим или создаём запись в legal_entities
        if (!string.IsNullOrEmpty(le.Inn))
        {
            var existingLe = await ctx.LegalEntities.FirstOrDefaultAsync(x => x.Inn == le.Inn);
            if (existingLe is null)
            {
                // Ищем ОКОПФ по коду
                Guid? okopfId = null;
                if (!string.IsNullOrEmpty(le.RefOkopf?.Code))
                {
                    var okopf = await ctx.RefOkopf.FirstOrDefaultAsync(o => o.Code == le.RefOkopf.Code);
                    okopfId = okopf?.Id;
                }

                existingLe = new SamorodinkaTech.Fiducia.Domain.Entities.LegalEntity
                {
                    Id = Guid.NewGuid(),
                    Name = le.Name ?? le.Inn,
                    ShortName = le.ShortName,
                    Inn = le.Inn,
                    Ogrn = le.Ogrn,
                    OkopfId = okopfId
                };
                ctx.LegalEntities.Add(existingLe);
                await ctx.SaveChangesAsync();

                // Обновляем ID в selectedEntity для дальнейшей работы
                le.Id = existingLe.Id;
            }
            else
            {
                // Используем существующую запись
                le.Id = existingLe.Id;
            }
        }

        // Загружаем руководителя (CurrentWorkplace) для выбранного ЮЛ
        var ip = await ctx.CurrentWorkplaces.FirstOrDefaultAsync();
        if (ip != null)
        {
            _influentialPersonId = ip.Id;
            editPosition = ip.Position ?? "Генеральный директор";
            editFullName = ip.FullName ?? string.Empty;
        }
        else
        {
            _influentialPersonId = null;
            editPosition = "Генеральный директор";
            editFullName = string.Empty;
        }

        // Определяем тип организации
        await ResolveOrgTypeAsync(le.Id);
        editHasBoardOfDirectors = _orgType != OrgType.Unknown;

        // Загружаем ГОСА
        await LoadGosaWindowAsync(le.Id);

        // Загружаем правила голосования в СД (индивидуальные для ЮЛ)
        await LoadVotingRulesAsync(le.Id);

        // Загружаем настройки комитетов
        await LoadCommitteesSettingsAsync();

        // Загружаем кэшированные данные СПАРК
        await LoadCachedSparkAsync();

        // Загружаем настройки устава
        await LoadCharterSettings(le.Id);

        // Для ООО — наличие СД определяется уставом
        if (_orgType == OrgType.LLC)
            editHasBoardOfDirectors = string.IsNullOrEmpty(_editCharterNumber) && _customHasBoardOfDirectors;

        saveError = null;
        saveSuccess = null;

        StateHasChanged();
    }

    private bool CanSave
        => selectedEntity is not null
           && string.IsNullOrEmpty(gosaError);

    private string OrgTypeLabel => _orgType switch
    {
        OrgType.LLC => "ООО",
        OrgType.NJSC => "непубличного АО",
        OrgType.PJSC => "ПАО",
        _ => "данного типа общества"
    };

    private string GosaLabel => _orgType switch
    {
        OrgType.LLC => "ООСУ",
        _ => "ГОСА"
    };

    private string EntityTypeLabel => selectedEntity?.RefOkopf is null
        ? "ОКОПФ не указан"
        : $"{selectedEntity.RefOkopf.Code} — {selectedEntity.RefOkopf.Name}";

    private async Task Save()
    {
        if (selectedEntity is null) return;
        saveError = null;
        saveSuccess = null;

        Logger.LogDebug("[Save] TransferToThird={Transfer}, PreemptiveRight={Preemptive}, CanSave={CanSave}, gosaError={GosaError}",
            _customTransferToThirdParties, _customPreemptiveRight, CanSave, gosaError);

        // Серверная валидация (BDR‑008) — вызывается первой, до любых операций с БД
        Logger.LogDebug("Серверная валидация ЮЛ {LegalEntityId} ({LegalEntityName})",
            selectedEntity.Id, selectedEntity.Name);

        var validationModel = new SamorodinkaTech.Fiducia.Domain.Validation.LegalEntitySaveValidationModel
        {
            OkopfCode = selectedEntity.RefOkopf?.Code,
            HasBoardOfDirectors = editHasBoardOfDirectors,
            GosaWindowStart = GosaStart,
            GosaWindowEnd = GosaEnd,
            Position = editPosition,
            FullName = editFullName,
            StandardCharterNumber = _editCharterNumber
        };
        var validation = SamorodinkaTech.Fiducia.Domain.Validation.LegalEntityValidator.Validate(validationModel);
        if (!validation.IsValid)
        {
            Logger.LogWarning("Валидация не пройдена для ЮЛ {LegalEntityId} ({LegalEntityName}): {Errors}",
                selectedEntity.Id, selectedEntity.Name, string.Join("; ", validation.Errors));
            saveError = string.Join(" ", validation.Errors);
            return;
        }

        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();

            // Сохраняем руководителя
            if (_influentialPersonId.HasValue)
            {
                var ip = await ctx.CurrentWorkplaces.FirstOrDefaultAsync(x => x.Id == _influentialPersonId.Value);
                if (ip != null)
                {
                    ip.FullName = string.IsNullOrWhiteSpace(editFullName) ? string.Empty : editFullName.Trim();
                    ip.Position = string.IsNullOrWhiteSpace(editPosition) ? null : editPosition.Trim();
                    ip.LastSelectedLegalEntityId = selectedEntity.Id;
                }
            }
            else
            {
                // Создаём запись руководителя, если её ещё нет
                var ip = new SamorodinkaTech.Fiducia.Domain.Entities.CurrentWorkplace
                {
                    Id = Guid.NewGuid(),
                    FullName = string.IsNullOrWhiteSpace(editFullName) ? string.Empty : editFullName.Trim(),
                    Position = string.IsNullOrWhiteSpace(editPosition) ? null : editPosition.Trim(),
                    LastSelectedLegalEntityId = selectedEntity.Id
                };
                ctx.CurrentWorkplaces.Add(ip);
                _influentialPersonId = ip.Id;
            }

            // Сохраняем настройки СД
            if (editHasBoardOfDirectors)
            {
                var settings = await ctx.LegalEntityBoardSettings.FirstOrDefaultAsync();
                if (settings is null)
                {
                    settings = new SamorodinkaTech.Fiducia.Domain.Entities.LegalEntityBoardSettings { Id = Guid.NewGuid() };
                    ctx.LegalEntityBoardSettings.Add(settings);
                }

                // ГОСА
                var leForGosa = await ctx.LegalEntities.Include(x => x.RefOkopf).FirstOrDefaultAsync(x => x.Id == selectedEntity.Id);
                if (leForGosa != null)
                {
                    var isPao = GosaSvc.IsPjsc(leForGosa.RefOkopf?.Code);
                    if (isPao)
                    {
                        if (!GosaSvc.ValidateForOkopf(leForGosa.RefOkopf?.Code, GosaStart, GosaEnd))
                        {
                            saveError = "Недопустимый интервал ГОСА для данной ОПФ";
                            return;
                        }
                        settings.GosaWindowStart = GosaStart;
                        settings.GosaWindowEnd = GosaEnd;
                    }
                    else
                    {
                        var (defStart, defEnd) = GosaSvc.GetWindowForOkopf(leForGosa.RefOkopf?.Code);
                        settings.GosaWindowStart = defStart;
                        settings.GosaWindowEnd = defEnd;
                    }
                }

                settings.CommitteesMandatory = _orgType == OrgType.PJSC || _editCommitteesMandatory;
                settings.CommitteesDefinedByDocuments = _editCommitteesDefinedByDocuments;
                settings.MaxCommitteesPerMemberDefined = _editMaxCommitteesPerMemberDefined;
                settings.MaxCommitteesPerMember = _editMaxCommitteesPerMemberDefined ? _editMaxCommitteesPerMember : null;
                settings.MaxCommitteesHeadedPerMemberDefined = _editMaxCommitteesHeadedPerMemberDefined;
                settings.MaxCommitteesHeadedPerMember = _editMaxCommitteesHeadedPerMemberDefined ? _editMaxCommitteesHeadedPerMember : null;
                settings.MinCommitteeMembersDefined = _editMinCommitteeMembersDefined;
                settings.MinCommitteeMembers = _editMinCommitteeMembersDefined ? _editMinCommitteeMembers : null;
                settings.CommitteeQuorumDefined = _editCommitteeQuorumDefined;
                settings.CommitteeQuorumPercent = _editCommitteeQuorumDefined ? _editCommitteeQuorumPercent : null;
                settings.JointCommitteeQuorumDefined = _editJointCommitteeQuorumDefined;
                settings.JointCommitteeQuorumPercent = _editJointCommitteeQuorumDefined ? _editJointCommitteeQuorumPercent : null;

                // Валидация настроек комитетов
                if (_editMaxCommitteesPerMemberDefined && _editMaxCommitteesPerMember is not > 0)
                { saveError = "Укажите максимальное число комитетов для одного члена СД"; return; }
                if (_editMaxCommitteesHeadedPerMemberDefined && _editMaxCommitteesHeadedPerMember is not > 0)
                { saveError = "Укажите максимальное число возглавляемых комитетов для одного члена СД"; return; }
                if (_editMinCommitteeMembersDefined && _editMinCommitteeMembers is not >= 2)
                { saveError = "Минимальное количество членов в комитете должно быть не менее 2"; return; }
                if (_editCommitteeQuorumDefined && (_editCommitteeQuorumPercent is not > 0 || _editCommitteeQuorumPercent > 100))
                { saveError = "Кворум комитета должен быть от 1 до 100%"; return; }
                if (_editJointCommitteeQuorumDefined && (_editJointCommitteeQuorumPercent is not > 0 || _editJointCommitteeQuorumPercent > 100))
                { saveError = "Кворум совместного заседания должен быть от 1 до 100%"; return; }

            }

            // Сохраняем правила голосования в СД (вне зависимости от editHasBoardOfDirectors)
            if (_editQuorumPercent < 50)
            {
                saveError = "Кворум не может быть менее 50% (п. 2 ст. 68 208-ФЗ)";
                return;
            }
            var votingRules = await ctx.LegalEntityVotingRules
                .FirstOrDefaultAsync(x => x.LegalEntityId == selectedEntity.Id);
            if (votingRules is null)
            {
                votingRules = new SamorodinkaTech.Fiducia.Domain.Entities.LegalEntityVotingRules
                {
                    Id = Guid.NewGuid(),
                    LegalEntityId = selectedEntity.Id,
                    QuorumPercent = _editQuorumPercent,
                    ChairTiebreaker = _editChairTiebreaker,
                    AbsenteeOpinions = _editAbsenteeOpinions,
                    AbsenteeAllowed = _editAbsenteeAllowed,
                    MixedAllowed = _editMixedAllowed,
                    DocumentFlow = _editDocumentFlow,
                    QualifiedMajorityPercent = _editQualifiedMajorityPercent,
                    SpotByElection = _editSpotByElection,
                    FirstMeetingDeadlineDays = _editFirstMeetingDeadlineDays
                };
                ctx.LegalEntityVotingRules.Add(votingRules);
            }
            else
            {
                votingRules.QuorumPercent = _editQuorumPercent;
                votingRules.ChairTiebreaker = _editChairTiebreaker;
                votingRules.AbsenteeOpinions = _editAbsenteeOpinions;
                votingRules.QualifiedMajorityPercent = _editQualifiedMajorityPercent;
                votingRules.AbsenteeAllowed = _editAbsenteeAllowed;
                votingRules.MixedAllowed = _editMixedAllowed;
                votingRules.DocumentFlow = _editDocumentFlow;
                votingRules.SpotByElection = _editSpotByElection;
                votingRules.FirstMeetingDeadlineDays = _editFirstMeetingDeadlineDays;
            }

            // Сохраняем параметры устава (для ООО — типовой/нетиповой, для АО — всегда нетиповой)
            if (_orgType == OrgType.LLC || _orgType == OrgType.PJSC || _orgType == OrgType.NJSC)
            {
                var leForCharter = await ctx.LegalEntities.FirstOrDefaultAsync(x => x.Id == selectedEntity.Id);
                if (leForCharter != null)
                {
                    // Типовой устав — только для ООО
                    if (_orgType == OrgType.LLC)
                    {
                        if (!string.IsNullOrEmpty(_editCharterNumber))
                        {
                            var charter = await ctx.RefStandardCharters
                                .FirstOrDefaultAsync(x => x.Number == _editCharterNumber);
                            leForCharter.StandardCharterId = charter?.Id;
                        }
                        else
                        {
                            leForCharter.StandardCharterId = null;
                        }
                    }

                    // Всегда сохраняем параметры устава (для типового — из справочника, для нетипового — из формы)

                    // Сохраняем загруженные файлы
                    if (_charterFile != null)
                        _customCharterDocId = await SaveUploadedFileAsync(ctx, _charterFile);
                    if (_boardRegulationFile != null)
                        _customBoardRegulationDocId = await SaveUploadedFileAsync(ctx, _boardRegulationFile);
                    if (_committeeRegulationFile != null)
                        _customCommitteeRegulationDocId = await SaveUploadedFileAsync(ctx, _committeeRegulationFile);

                    // Сбрасываем ссылки на файлы после сохранения
                    _charterFile = null;
                    _boardRegulationFile = null;
                    _committeeRegulationFile = null;

                    var charterParams = await ctx.LegalEntityCharters
                        .FirstOrDefaultAsync(x => x.LegalEntityId == leForCharter.Id);
                    if (charterParams == null)
                    {
                        charterParams = new SamorodinkaTech.Fiducia.Domain.Entities.LegalEntityCharter
                        {
                            LegalEntityId = leForCharter.Id
                        };
                        ctx.LegalEntityCharters.Add(charterParams);
                    }
                    charterParams.ExitAllowed = _customExitAllowed;
                    charterParams.TransferToParticipantsWithoutConsent = _customTransferToParticipants;
                    charterParams.TransferToThirdPartiesWithoutConsent = _customTransferToThirdParties;
                    charterParams.PreemptiveRight = _customPreemptiveRight;
                    charterParams.InheritanceWithoutConsent = _customInheritance;
                    charterParams.ExecutiveBody = _customExecutiveBody;
                    charterParams.DecisionConfirmationByAllSign = _customDecisionConfirmation;
                    charterParams.CharterDocumentId = _customCharterDocId ?? charterParams.CharterDocumentId;
                    charterParams.BoardRegulationDocumentId = _customBoardRegulationDocId ?? charterParams.BoardRegulationDocumentId;
                    charterParams.CommitteeRegulationDocumentId = _customCommitteeRegulationDocId ?? charterParams.CommitteeRegulationDocumentId;
                    charterParams.MandatoryAudit = _customMandatoryAudit;
                    charterParams.HasRevisionCommission = _customHasRevisionCommission;
                    charterParams.HasBoardOfDirectors = _customHasBoardOfDirectors;
                    charterParams.GdTermId = _customGdTermId;
                }
            }

            await ctx.SaveChangesAsync();
            saveSuccess = "Изменения сохранены.";
            Logger.LogDebug("[Save] SaveChangesAsync completed successfully");

            // Обновляем видимость вкладки «Совет директоров» для ООО после сохранения устава
            if (_orgType == OrgType.LLC)
                editHasBoardOfDirectors = string.IsNullOrEmpty(_editCharterNumber) && _customHasBoardOfDirectors;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка сохранения ЮЛ");
            saveError = ExceptionFlattener.Unwrap(ex);
            Logger.LogDebug("[Save] saveError set to: {Error}", saveError);
        }
    }

    private void ConfirmDelete()
    {
        if (selectedEntity is null) return;
        saveError = null;
        saveSuccess = null;
        _showDeleteConfirm = true;
    }

    private async Task Delete()
    {
        if (selectedEntity is null) return;
        _deleteLoading = true;
        StateHasChanged();

        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var id = selectedEntity.Id;
            var name = selectedEntity.Name;

            // Очистка конфигурации ЮЛ (без удаления ОСА, СД и организационных мероприятий)
            await ctx.LegalEntityCharters
                .Where(x => x.LegalEntityId == id)
                .ExecuteDeleteAsync();

            await ctx.LegalEntityEmailSettings
                .Where(x => x.LegalEntityId == id)
                .ExecuteDeleteAsync();

            await ctx.LegalEntityVotingRules
                .Where(x => x.LegalEntityId == id)
                .ExecuteDeleteAsync();

            // Сброс ссылки в current_workplace
            await ctx.CurrentWorkplaces
                .Where(x => x.LastSelectedLegalEntityId == id)
                .ExecuteUpdateAsync(s => s.SetProperty(x => x.LastSelectedLegalEntityId, (Guid?)null));

            Logger.LogInformation("Конфигурация ЮЛ {LegalEntityId} ({LegalEntityName}) очищена", id, name);
            saveSuccess = $"Конфигурация «{name}» очищена.";

            // Сброс UI-состояния
            _showDeleteConfirm = false;
            selectedEntity = null;
            _activeTab = 0;
            _sparkManagerName = null;
            _sparkManagerPosition = null;
            _sparkCompanyFullName = null;
            _sparkCompanyShortName = null;
            _sparkCompanyOgrn = null;
            _sparkCompanyOkopfName = null;
            _sparkCompanyAddress = null;
            _sparkCompanyStatus = null;
            _sparkCompanyRegDate = null;
            _sparkFounders.Clear();
            _editCharterNumber = null;
            _charterSettings = null;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка очистки конфигурации ЮЛ {LegalEntityId}", selectedEntity.Id);
            saveError = ExceptionFlattener.Unwrap(ex);
        }
        finally
        {
            _deleteLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadCachedSparkAsync()
    {
        if (string.IsNullOrEmpty(selectedEntity?.Inn)) return;
        try
        {
            var view = await SparkDataSvc.LoadCachedAsync(selectedEntity.Inn.Trim(), _orgType == OrgType.LLC);

            _sparkManagerName = view.ManagerName;
            _sparkManagerPosition = view.ManagerPosition;
            _sparkManagerInn = view.ManagerInn;
            _sparkManagerStartDate = view.ManagerStartDate;
            _sparkCompanyFullName = view.CompanyFullName;
            _sparkCompanyShortName = view.CompanyShortName;
            _sparkCompanyOgrn = view.CompanyOgrn;
            _sparkCompanyOkopfName = view.CompanyOkopfName;
            _sparkCompanyAddress = view.CompanyAddress;
            _sparkCompanyStatus = view.CompanyStatus;
            _sparkCompanyRegDate = view.CompanyRegDate;
            _sparkFounders = view.Founders;

            // Автозаполнение ФИО/должности руководителя из кэша СПАРК,
            // если CurrentWorkplace не содержит данных (новое ЮЛ)
            if (string.IsNullOrWhiteSpace(editFullName) && !string.IsNullOrEmpty(view.ManagerName))
                editFullName = view.ManagerName;
            if (string.IsNullOrWhiteSpace(editPosition) && view.ManagerPosition is not null)
                editPosition = view.ManagerPosition;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки кэша СПАРК для ИНН={Inn}", selectedEntity.Inn);
        }
    }

    private async Task LoadSparkData()
    {
        if (string.IsNullOrEmpty(selectedEntity?.Inn)) return;
        sparkLoading = true;
        sparkError = null;
        sparkWarning = null;
        StateHasChanged();

        try
        {
            var inn = selectedEntity.Inn.Trim();
            var result = await SparkDataSvc.FetchAndSaveAsync(inn, _orgType == OrgType.LLC, selectedEntity.Id);

            // ОКОПФ — обновляем локальное состояние, если найден в СПАРК
            if (result.OkopfCode is not null)
            {
                await using var ctx = await DbFactory.CreateDbContextAsync();
                var okopf = await ctx.RefOkopf.FirstOrDefaultAsync(o => o.Code == result.OkopfCode);
                if (okopf is not null)
                {
                    selectedEntity.RefOkopf = new OkopfVm { Code = okopf.Code, Name = okopf.Name };
                    _orgType = ResolveOrgTypeFromCode(okopf.Code);
                    editHasBoardOfDirectors = _orgType != OrgType.Unknown;
                }
            }

            // Карточка компании
            if (result.Company is not null)
            {
                var c = result.Company;
                _sparkCompanyFullName = c.FullName;
                _sparkCompanyShortName = c.ShortName;
                _sparkCompanyOgrn = c.Ogrn;
                _sparkCompanyOkopfName = c.OkopfName;
                _sparkCompanyAddress = c.LegalAddress;
                _sparkCompanyStatus = c.Status;
                _sparkCompanyRegDate = c.RegistrationDate;
            }

            // Руководитель
            if (result.Manager is not null)
            {
                var m = result.Manager;
                editFullName = m.FullName;
                editPosition = m.Position ?? "Генеральный директор";
                _sparkManagerName = m.FullName;
                _sparkManagerPosition = m.Position;
                _sparkManagerInn = m.Inn;
                _sparkManagerStartDate = m.ActualDate;
            }
            else
            {
                sparkError = "Руководитель не найден в СПАРК";
            }

            // Учредители
            if (result.Founders.Count > 0)
                _sparkFounders = result.Founders;
            else if (result.Company is not null || result.Manager is not null)
                sparkWarning = "Данные об учредителях не загружены — возможно, требуется расширенный тариф СПАРК";

            sparkWarning ??= result.Warning;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки данных из СПАРК для ИНН={Inn}", selectedEntity.Inn);
            sparkError = "Ошибка соединения со СПАРК";
        }
        finally
        {
            sparkLoading = false;
            StateHasChanged();
        }
    }

    private static OrgType ResolveOrgTypeFromCode(string? code)
    {
        var normalized = new string((code ?? string.Empty).Where(char.IsDigit).ToArray());
        return normalized switch
        {
            OkopfTypeMapper.PjscCode => OrgType.PJSC,
            OkopfTypeMapper.NjscCode => OrgType.NJSC,
            OkopfTypeMapper.LlcCode => OrgType.LLC,
            _ => OrgType.Unknown
        };
    }

    private async Task ResolveOrgTypeAsync(Guid legalEntityId)
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var le = await ctx.LegalEntities.Include(x => x.RefOkopf).FirstOrDefaultAsync(x => x.Id == legalEntityId);
            var codeRaw = le?.RefOkopf?.Code ?? string.Empty;
            var normalized = new string(codeRaw.Where(char.IsDigit).ToArray());
            _orgType = normalized switch
            {
                OkopfTypeMapper.PjscCode => OrgType.PJSC,
                OkopfTypeMapper.NjscCode => OrgType.NJSC,
                OkopfTypeMapper.LlcCode => OrgType.LLC,
                _ => OrgType.Unknown
            };
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка определения типа ЮЛ {LegalEntityId}", legalEntityId);
        }
    }

    private async Task LoadGosaWindowAsync(Guid legalEntityId)
    {
        try
        {
            gosaError = null;
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var le = await ctx.LegalEntities.Include(x => x.RefOkopf).FirstOrDefaultAsync(x => x.Id == legalEntityId);
            if (le is null) { gosaError = "ЮЛ не найдено"; return; }
            var settings = await ctx.LegalEntityBoardSettings.FirstOrDefaultAsync();
            var (defStart, defEnd) = GosaSvc.GetWindowForOkopf(le.RefOkopf?.Code);
            var s = settings?.GosaWindowStart ?? defStart;
            var e = settings?.GosaWindowEnd ?? defEnd;
            gosaStartMonth = s.Month;
            gosaStartDay = s.Day;
            gosaEndMonth = e.Month;
            gosaEndDay = e.Day;
            gosaIsPjsc = GosaSvc.IsPjsc(le.RefOkopf?.Code);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки интервала ГОСА");
            gosaError = ExceptionFlattener.Unwrap(ex);
        }
    }

    private void OnGosaDateChanged()
    {
        var isPao = gosaIsPjsc;
        if (!isPao) { gosaError = null; return; }
        gosaError = GosaSvc.ValidateForOkopf(null, GosaStart, GosaEnd)
            ? null
            : "Недопустимый интервал ГОСА для данной ОПФ";
    }

    private async Task LoadVotingRulesAsync(Guid legalEntityId)
    {
        try
        {
