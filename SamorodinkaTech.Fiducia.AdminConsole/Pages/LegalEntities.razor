    private async Task LoadCharterSettings(Guid legalEntityId)
    {
        try
        {
            _isLoadingCharter = true;
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var le = await ctx.LegalEntities
                .Include(x => x.StandardCharter)
                .FirstOrDefaultAsync(x => x.Id == legalEntityId);
            _editCharterNumber = le?.StandardCharter?.Number;
            _lastCharterNumber = _editCharterNumber;
            _charterSettings = le?.StandardCharter is not null
                ? StandardCharterInfo.FromEntity(le.StandardCharter)
                : null;

            if (le is not null)
                await LoadCharterAsync(ctx, le.Id);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки настроек устава для ЮЛ {LegalEntityId}", legalEntityId);
        }
        finally
        {
            _isLoadingCharter = false;
        }
    }

    private async Task LoadCharterAsync(SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext? ctx, Guid legalEntityId)
    {
        try
        {
            var dispose = ctx == null;
            if (ctx == null) ctx = await DbFactory.CreateDbContextAsync();

            var custom = await ctx.LegalEntityCharters
                .FirstOrDefaultAsync(x => x.LegalEntityId == legalEntityId);

            if (custom != null)
            {
                _customExitAllowed = custom.ExitAllowed;
                _customTransferToParticipants = custom.TransferToParticipantsWithoutConsent;
                _customTransferToThirdParties = custom.TransferToThirdPartiesWithoutConsent;
                _customPreemptiveRight = custom.PreemptiveRight;
                _customInheritance = custom.InheritanceWithoutConsent;
                _customExecutiveBody = custom.ExecutiveBody;
                _customDecisionConfirmation = custom.DecisionConfirmationByAllSign;
                _customCharterDocId = custom.CharterDocumentId;
                _customBoardRegulationDocId = custom.BoardRegulationDocumentId;
                _customCommitteeRegulationDocId = custom.CommitteeRegulationDocumentId;
                _customMandatoryAudit = custom.MandatoryAudit;
                _customHasRevisionCommission = custom.HasRevisionCommission;
                _customHasBoardOfDirectors = custom.HasBoardOfDirectors;
                _customGdTermId = custom.GdTermId;

                if (_customExecutiveBody == 'A' && _customGdTermId is null && _gdTerms.Count > 0)
                    _customGdTermId = _gdTerms.FirstOrDefault(t => t.Code == "5_YEARS")?.Id
                                      ?? _gdTerms.FirstOrDefault()?.Id;

                if (custom.CharterDocumentId.HasValue)
                {
                    var file = await ctx.Files.FirstOrDefaultAsync(x => x.Id == custom.CharterDocumentId.Value);
                    _customCharterDocName = file?.OriginalName;
                }
                else _customCharterDocName = null;

                if (custom.BoardRegulationDocumentId.HasValue)
                {
                    var file = await ctx.Files.FirstOrDefaultAsync(x => x.Id == custom.BoardRegulationDocumentId.Value);
                    _customBoardRegulationDocName = file?.OriginalName;
                }
                else _customBoardRegulationDocName = null;

                if (custom.CommitteeRegulationDocumentId.HasValue)
                {
                    var file = await ctx.Files.FirstOrDefaultAsync(x => x.Id == custom.CommitteeRegulationDocumentId.Value);
                    _customCommitteeRegulationDocName = file?.OriginalName;
                }
                else _customCommitteeRegulationDocName = null;
            }
            else if (_charterSettings != null)
            {
                // Если записи в БД ещё нет, но выбран типовой устав — заполняем из справочника
                _customExitAllowed = _charterSettings.ExitAllowed;
                _customTransferToParticipants = _charterSettings.TransferToParticipantsWithoutConsent;
                _customTransferToThirdParties = _charterSettings.TransferToThirdPartiesWithoutConsent;
                _customPreemptiveRight = _charterSettings.PreemptiveRight;
                _customInheritance = _charterSettings.InheritanceWithoutConsent;
                _customExecutiveBody = _charterSettings.ExecutiveBody;
                _customDecisionConfirmation = _charterSettings.DecisionConfirmationByAllSign;
                _customMandatoryAudit = null;
                _customHasRevisionCommission = null;
                _customHasBoardOfDirectors = false;
                _customGdTermId = null;
                if (_customExecutiveBody == 'A' && _gdTerms.Count > 0)
                    _customGdTermId = _gdTerms.FirstOrDefault(t => t.Code == "5_YEARS")?.Id
                                      ?? _gdTerms.FirstOrDefault()?.Id;
            }
            else
            {
                _customExitAllowed = false;
                _customTransferToParticipants = true;
                _customTransferToThirdParties = false;
                _customPreemptiveRight = true;
                _customInheritance = true;
                _customExecutiveBody = 'A';
                _customDecisionConfirmation = false;
                _customMandatoryAudit = null;
                _customHasRevisionCommission = null;
                _customHasBoardOfDirectors = false;
                _customGdTermId = null;
                if (_customExecutiveBody == 'A' && _gdTerms.Count > 0)
                    _customGdTermId = _gdTerms.FirstOrDefault(t => t.Code == "5_YEARS")?.Id
                                      ?? _gdTerms.FirstOrDefault()?.Id;
            }

            if (dispose) ctx.Dispose();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки параметров устава для ЮЛ {Id}", legalEntityId);
        }
    }

