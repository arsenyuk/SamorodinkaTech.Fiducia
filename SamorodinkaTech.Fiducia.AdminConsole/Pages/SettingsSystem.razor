@page "/settings/system"
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SYS_ADMIN")]

<PageTitle>Fiducia — Системные настройки</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Системные настройки</h3>
        <a href="/settings" class="btn btn-outline-secondary btn-sm">← Назад</a>
    </div>

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success">@_successMessage</div>
    }
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger">@_errorMessage</div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Дедлайн протокола (дней)</label>
                    <input type="number" class="form-control" @bind="_protocolDeadline" min="1" max="30">
                    <small class="text-muted">Согласно <a href="/board-law/68">ст. 68 п. 4 208-ФЗ</a></small>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Срок действия инвайта (дней)</label>
                    <input type="number" class="form-control" @bind="_inviteExpiry" min="1" max="30">
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">TSP-сервер (RFC 3161)</label>
                <input type="text" class="form-control" @bind="_tspServer">
                <small class="text-muted">Сервер точного времени для фиксации UTC-меток подписей</small>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Запас шкалы Ганта (недель)</label>
                    <input type="number" class="form-control @(_ganttPaddingError is not null ? "is-invalid" : "")" @bind="_ganttPaddingWeeks"
                           @oninput="() => _ganttPaddingError = null" min="0">
                    @if (_ganttPaddingError is not null)
                    {
                        <div class="invalid-feedback">@_ganttPaddingError</div>
                    }
                    <small class="text-muted">После окончания последней задачи на диаграмме оргплана</small>
                </div>
            </div>

            <hr />
            <h6>Шаблоны наименований заседаний</h6>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Шаблон наименования ГОСА</label>
                    <input type="text" class="form-control @(_gosaTitleError is not null ? "is-invalid" : "")" @bind="_gosaTitleTemplate"
                           @oninput="() => _gosaTitleError = null"
                           placeholder="Годовое за {YYYY} год">
                    @if (_gosaTitleError is not null)
                    {
                        <div class="invalid-feedback">@_gosaTitleError</div>
                    }
                    <small class="text-muted">Плейсхолдеры: <code>{YYYY}</code> — год, <code>{YY}</code> — год (2 цифры), <code>{MM}</code> — месяц, <code>{DD}</code> — день</small>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Шаблон наименования ООСУ</label>
                    <input type="text" class="form-control @(_oosuTitleError is not null ? "is-invalid" : "")" @bind="_oosuTitleTemplate"
                           @oninput="() => _oosuTitleError = null"
                           placeholder="Очередное за {YYYY} год">
                    @if (_oosuTitleError is not null)
                    {
                        <div class="invalid-feedback">@_oosuTitleError</div>
                    }
                    <small class="text-muted">Плейсхолдеры: <code>{YYYY}</code> — год, <code>{YY}</code> — год (2 цифры), <code>{MM}</code> — месяц, <code>{DD}</code> — день</small>
                </div>
            </div>

            <hr />
            <h6>Загрузка файлов</h6>
            <div class="mb-3">
                <label class="form-label fw-bold">Запрещённые расширения (через запятую)</label>
                <textarea class="form-control @(_blockedExtensionsError is not null ? "is-invalid" : "")" rows="3" @bind="_blockedExtensions"
                          @oninput="() => _blockedExtensionsError = null"
                          placeholder="exe, dll, bat, cmd, ..."></textarea>
                @if (_blockedExtensionsError is not null)
                {
                    <div class="invalid-feedback">@_blockedExtensionsError</div>
                }
                <small class="text-muted">Файлы с этими расширениями будут отклоняться при загрузке. Только латинские буквы без точки (пример: exe, dll, bat)</small>
            </div>

            <h6>Чтение QR-кодов</h6>
            <div class="mb-3">
                <label class="form-label fw-bold">Расширения файлов для QR-кода (через запятую)</label>
                <textarea class="form-control @(_qrExtensionsError is not null ? "is-invalid" : "")" rows="2" @bind="_qrExtensions"
                          @oninput="() => _qrExtensionsError = null"
                          placeholder="png, jpg, jpeg, bmp, gif, tiff, pdf"></textarea>
                @if (_qrExtensionsError is not null)
                {
                    <div class="invalid-feedback">@_qrExtensionsError</div>
                }
                <small class="text-muted">Файлы с этими расширениями будут сканироваться на наличие QR-кода нотариуса. Только латинские буквы без точки</small>
            </div>

            <button class="btn btn-primary" @onclick="Save">Сохранить</button>
        </div>
    </div>
</div>

@code {
    private int _protocolDeadline = 3;
    private int _inviteExpiry = 7;
    private string _tspServer = "http://timestamp.ru/timestamp";
    private int _ganttPaddingWeeks = 2;
    private string _gosaTitleTemplate = "Годовое за {YYYY} год";
    private string _oosuTitleTemplate = "Очередное за {YYYY} год";
    private string _blockedExtensions = "exe,dll,com,msi,bat,cmd,scr,pif";
    private string? _blockedExtensionsError;
    private string _qrExtensions = "png,jpg,jpeg,bmp,gif,tiff,pdf";
    private string? _qrExtensionsError;
    private string? _gosaTitleError;
    private string? _oosuTitleError;
    private string? _ganttPaddingError;
    private string? _successMessage;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var settings = await ctx.SystemSettings.ToDictionaryAsync(x => x.Key, x => x.Value);

            if (settings.TryGetValue("gantt_end_padding_weeks", out var pw) && int.TryParse(pw, out var pww))
                _ganttPaddingWeeks = pww;
            if (settings.TryGetValue("gosa_title_template", out var gt) && !string.IsNullOrEmpty(gt))
                _gosaTitleTemplate = gt;
            if (settings.TryGetValue("oosu_title_template", out var ot) && !string.IsNullOrEmpty(ot))
                _oosuTitleTemplate = ot;
            if (settings.TryGetValue("blocked_extensions", out var be) && !string.IsNullOrEmpty(be))
                _blockedExtensions = be;
            if (settings.TryGetValue("qr_code_extensions", out var qr) && !string.IsNullOrEmpty(qr))
                _qrExtensions = qr;
        }
        catch { }
    }

    private async Task Save()
    {
        _successMessage = null;
        _errorMessage = null;

        _blockedExtensionsError = ValidateExtensionList(_blockedExtensions);
        _qrExtensionsError = ValidateExtensionList(_qrExtensions);
        _gosaTitleError = ValidateTemplate(_gosaTitleTemplate);
        _oosuTitleError = ValidateTemplate(_oosuTitleTemplate);
        _ganttPaddingError = _ganttPaddingWeeks < 0 ? "Значение не может быть отрицательным." : null;

        if (_blockedExtensionsError is not null || _qrExtensionsError is not null
            || _gosaTitleError is not null || _oosuTitleError is not null
            || _ganttPaddingError is not null)
        {
            StateHasChanged();
            return;
        }

        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            await UpsertSetting(ctx, "gantt_end_padding_weeks", _ganttPaddingWeeks.ToString(), "Запас в неделях");
            await UpsertSetting(ctx, "gosa_title_template", _gosaTitleTemplate, "Шаблон названия ГОСА", "template_string");
            await UpsertSetting(ctx, "oosu_title_template", _oosuTitleTemplate, "Шаблон названия ООСУ", "template_string");
            await UpsertSetting(ctx, "blocked_extensions", _blockedExtensions, "Запрещённые расширения файлов", "extension_list");
            await UpsertSetting(ctx, "qr_code_extensions", _qrExtensions, "Расширения файлов для QR-кода", "extension_list");
            await ctx.SaveChangesAsync();
            _successMessage = "Настройки сохранены.";
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private static async Task UpsertSetting(SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext ctx,
        string key, string value, string description, string? validationType = null)
    {
        var setting = await ctx.SystemSettings.FirstOrDefaultAsync(x => x.Key == key);
        if (setting is not null)
        {
            setting.Value = value;
            setting.ValidationType = validationType;
            setting.UpdatedAt = DateTime.UtcNow;
        }
        else
        {
            ctx.SystemSettings.Add(new SamorodinkaTech.Fiducia.Domain.Entities.SystemSetting
            {
                Id = Guid.NewGuid(), Key = key, Value = value, Description = description,
                ValidationType = validationType, CreatedAt = DateTime.UtcNow
            });
        }
    }

    private static string? ValidateExtensionList(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        var extensions = value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (extensions.Length == 0) return null;
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var ext in extensions)
        {
            if (!System.Text.RegularExpressions.Regex.IsMatch(ext, @"^[a-zA-Z0-9]+$"))
                return $"Недопустимое расширение «{ext}». Допустимы только латинские буквы и цифры без точки.";
            if (!seen.Add(ext)) return $"Дубликат расширения «{ext}».";
            if (ext.Length > 20) return $"Расширение «{ext}» слишком длинное (максимум 20 символов).";
        }
        return null;
    }

    private static readonly HashSet<string> KnownPlaceholders = new(StringComparer.OrdinalIgnoreCase) { "{YYYY}", "{YY}", "{MM}", "{DD}" };

    private static string? ValidateTemplate(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        if (value.Length > 200) return "Шаблон слишком длинный (максимум 200 символов).";
        var matches = System.Text.RegularExpressions.Regex.Matches(value, @"\{[A-Za-z]+\}");
        foreach (System.Text.RegularExpressions.Match m in matches)
        {
            if (m.Value != m.Value.ToUpperInvariant())
                return $"Плейсхолдер «{m.Value}» должен быть в верхнем регистре: «{m.Value.ToUpperInvariant()}».";
            if (!KnownPlaceholders.Contains(m.Value))
                return $"Неизвестный плейсхолдер «{m.Value}». Допустимы: {string.Join(", ", KnownPlaceholders)}";
        }
        return null;
    }
}
