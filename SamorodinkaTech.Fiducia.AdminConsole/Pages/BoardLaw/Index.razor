@page "/board-law"
@attribute [Authorize(Roles = "SYS_ADMIN")]

<h3>Пояснения по Совету директоров</h3>

<p class="text-muted">Документ подготовлен на основе норм действующего законодательства РФ по состоянию на 2026 год.</p>

@* ── Переключатель АО / ООО ────────────────────────────────────── *@
<div class="btn-group mb-4" role="group">
    <button type="button" class="btn @(_showLlc ? "btn-primary" : "btn-outline-primary")"
            @onclick="() => _showLlc = true">ООО (14-ФЗ)</button>
    <button type="button" class="btn @(!_showLlc ? "btn-primary" : "btn-outline-primary")"
            @onclick="() => _showLlc = false">АО (208-ФЗ)</button>
</div>

@if (_showLlc)
{
    @* ── ООО ──────────────────────────────────────────────────────── *@
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Действие</th>
                <th>Правовое основание</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>СД — не обязателен, если предусмотрен уставом</td>
                <td><a href="/board-law/article-14fz-32#p2">п. 2 ст. 32 Закона № 14-ФЗ</a></td>
            </tr>
            <tr>
                <td>СД избирается ОСУ до следующего очередного собрания</td>
                <td><a href="/board-law/article-14fz-32#p3">п. 3 ст. 32 Закона № 14-ФЗ</a></td>
            </tr>
            <tr>
                <td>Члены коллегиального исполнительного органа — не более ¼ состава СД</td>
                <td><a href="/board-law/article-14fz-32#p2">п. 2.1 ст. 32 Закона № 14-ФЗ</a></td>
            </tr>
            <tr>
                <td>Досрочное прекращение полномочий члена СД</td>
                <td><a href="/board-law/article-14fz-32#p2_3">п. 2.3 ст. 32 Закона № 14-ФЗ</a></td>
            </tr>
            <tr>
                <td>Кворум СД — не менее половины от числа избранных членов</td>
                <td><a href="/board-law/article-14fz-32#p3_1">п. 3.1 ст. 32 Закона № 14-ФЗ</a></td>
            </tr>
            <tr>
                <td>Протокол СД — не позднее 3 дней</td>
                <td><a href="/board-law/article-14fz-32#p3_2">п. 3.2 ст. 32 Закона № 14-ФЗ</a></td>
            </tr>
            <tr>
                <td>ООСУ — с 1 марта по 30 апреля (2 месяца)</td>
                <td><a href="/board-law/article-14fz-34">п. 1 ст. 34 Закона № 14-ФЗ</a></td>
            </tr>
            <tr>
                <td>Участник вправе потребовать документы</td>
                <td><a href="/board-law/article-14fz-50">ст. 50 Закона № 14-ФЗ</a></td>
            </tr>
        </tbody>
        <caption>*Документ подготовлен на основе норм действующего законодательства РФ по состоянию на 2026 год.</caption>
    </table>
}
else
{
    @* ── АО ──────────────────────────────────────────────────────── *@
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Действие</th>
                <th>Правовое основание</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Избрание СД на ОСА</td>
                <td><a href="/board-law/66">п. 1, 3 ст. 66 Закона № 208-ФЗ</a></td>
            </tr>
            <tr>
                <td>Кумулятивное голосование</td>
                <td><a href="/board-law/66">п. 4 ст. 66 Закона № 208-ФЗ</a></td>
            </tr>
            <tr>
                <td>Срок полномочий СД — до следующего ГОСА</td>
                <td><a href="/board-law/66">п. 1 ст. 66 Закона № 208-ФЗ</a></td>
            </tr>
            <tr>
                <td>ГОСА — с 1 марта по 30 июня</td>
                <td><a href="/board-law/47">п. 3 ст. 47 Закона № 208-ФЗ</a></td>
            </tr>
            <tr>
                <td>Протокол ОСА — не позднее 3 рабочих дней</td>
                <td><a href="/board-law/63">п. 1 ст. 63 Закона № 208-ФЗ</a></td>
            </tr>
            <tr>
                <td>Избрание Председателя СД</td>
                <td><a href="/board-law/66">п. 2 ст. 66 Закона № 208-ФЗ</a></td>
            </tr>
            <tr>
                <td>Председатель не может быть Генеральным директором</td>
                <td><a href="/board-law/66">п. 2 ст. 66 Закона № 208-ФЗ</a></td>
            </tr>
            <tr>
                <td>При отсутствии Председателя — один из членов СД</td>
                <td><a href="/board-law/67">п. 3 ст. 67 Закона № 208-ФЗ</a></td>
            </tr>
            <tr>
                <td>Кворум СД — не менее половины от числа избранных членов</td>
                <td><a href="/board-law/68">п. 2 ст. 68 Закона № 208-ФЗ</a></td>
            </tr>
            <tr>
                <td>Протокол СД подписывается Председателем и Секретарем (если есть)</td>
                <td><a href="/board-law/68">п. 4 ст. 68 Закона № 208-ФЗ</a></td>
            </tr>
            <tr>
                <td>Секретарь СД — не обязан, может быть назначен</td>
                <td><a href="/board-law/68">п. 1 ст. 68 Закона № 208-ФЗ</a></td>
            </tr>
        </tbody>
        <caption>*Документ подготовлен на основе норм действующего законодательства РФ по состоянию на 2026 год.</caption>
    </table>
}

@code {
    private bool _showLlc = true;
}
