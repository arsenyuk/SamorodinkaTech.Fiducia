@page "/org-templates/intents/{IntentId:guid}/gantt"
@using Microsoft.EntityFrameworkCore
@using SamorodinkaTech.Fiducia.Domain.Enums
@using SamorodinkaTech.Fiducia.Domain.Entities
@using SamorodinkaTech.Fiducia.Timeline.Services
@using SamorodinkaTech.Fiducia.Timeline.Models
@using SamorodinkaTech.Fiducia.Infrastructure.Services
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@inject ILogger<OrgTemplates> Logger
@inject NavigationManager Nav
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SYS_ADMIN")]

<div style="display:flex; flex-direction:column; height:calc(100vh - 56px); overflow:hidden; margin-top:-1.1rem; margin-left:-2rem; margin-right:-1.5rem; padding-left:2rem; padding-right:1.5rem; padding-top:1.1rem">

<h3>
    <a href="/org-templates" class="text-decoration-none">Шаблоны</a> →
    <a href="/org-templates/intents/@IntentId/stages" class="text-decoration-none">@(_intentName ?? "Этапы")</a> →
    Диаграмма Ганта
</h3>

@if (_availableMarkers.Count > 0)
{
    <div class="d-flex flex-wrap align-items-center gap-1 mb-2">
        <span class="small text-muted me-1">Маркеры:</span>
        @foreach (var marker in _availableMarkers)
        {
            var isActive = _activeMarkers[marker.Key];
            <button type="button"
                    class="btn btn-sm @(isActive ? "btn-outline-primary" : "btn-outline-secondary text-decoration-line-through")"
                    @onclick="() => ToggleMarker(marker.Key)">
                @marker.Label
            </button>
        }
        @if (_activeMarkers.Values.Any(v => !v))
        {
            <button type="button" class="btn btn-sm btn-link text-decoration-none"
                    @onclick="EnableAllMarkers">
                Сбросить фильтр
            </button>
        }
    </div>
}

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (_ganttInput == null)
{
    <div class="text-muted">Загрузка...</div>
}
else if (_ganttInput.Nodes.Count == 0)
{
    <div class="text-muted">Нет этапов и задач для отображения.</div>
}
else
{
    <div class="small text-muted mb-1">Узлов: @_ganttInput.Nodes.Count, связей: @_ganttInput.Dependencies.Count,
        дат: @FormatDate(_ganttInput.StartDate) – @FormatDate(_ganttInput.EndDate)</div>
    <div style="flex:1; min-height:0; border:1px solid #ccc; border-radius:4px;">
        <GanttChart Data="@_ganttInput" RowHeight="32" BottomPaddingPx="60"
                    TaskColor="#42a5f5" StageColor="#78909c"
                    MilestoneColor="#9c27b0" OverdueColor="#d32f2f"
                    ProgressColor="rgba(0,0,0,0.15)"
                    OnTaskBarClick="HandleDoubleClick">
            <TooltipTemplate>
                <div class="gantt-tooltip-name">@context.Name</div>
                <div class="gantt-tooltip-path">@context.BreadcrumbPath</div>
                @{
                    var dates = context.NodeType == GanttNodeType.Milestone
                        ? FormatDate(context.MilestoneDate)
                        : $"{FormatDate(context.StartDate)} – {FormatDate(context.EndDate)}";
                }
                <div class="gantt-tooltip-dates">@dates</div>
            </TooltipTemplate>
        </GanttChart>
    </div>
}</div>

@if (_showOfferModal && _modalOffer != null)
{
    <div class="modal show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5)" @onclick="CloseOfferModal">
        <div class="modal-dialog modal-lg" @onclick:stopPropagation>
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@_modalOffer.Name</h5>
                    <button type="button" class="btn-close" @onclick="CloseOfferModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Этап</label>
                            <div>@(_modalStageName ?? "—")</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Шаблон</label>
                            <div>@(_modalIntentName ?? "—")</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Описание</label>
                            <div class="@(string.IsNullOrEmpty(_modalOffer.Description) ? "text-muted" : "")">
                                @(_modalOffer.Description ?? "—")
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Смещение</label>
                            <div>@(_modalOffer.StartOffsetDays?.ToString() ?? "—")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Дедлайн</label>
                            <div>
                                @(_modalOffer.DeadlineRule switch
                                {
                                    "FIXED_DAYS" => $"+{_modalOffer.DeadlineDays} {_modalOffer.MeasurementUnit?.ShortName ?? "дн."}",
                                    "AFTER_START" => $"после нач. +{_modalOffer.DeadlineDays} {_modalOffer.MeasurementUnit?.ShortName ?? "дн."}",
                                    _ => "—"
                                })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Должность СД</label>
                            <div>@(_modalOffer.AssignedBoardRole?.Name ?? "—")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Роль исполнителя</label>
                            <div>@(_modalOffer.AssignedRole?.Name ?? "—")</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Кандидаты (роли)</label>
                            <div>
                                @if (_modalOfferRoleNames.Count > 0)
                                {
                                    @string.Join(", ", _modalOfferRoleNames.Values)
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Условия включения</label>
                            <div>
                                @if (_modalOffer.RequireNotaryConfirmation == true) { <span class="badge bg-secondary me-1">Нотариус</span> }
                                @if (_modalOffer.RequireAllSignConfirmation == true) { <span class="badge bg-secondary me-1">Подп. всеми</span> }
                                @if (_modalOffer.RequireCommittees == true) { <span class="badge bg-secondary me-1">Комитеты</span> }
                                @if (_modalOffer.RequireBoardRegulation == true) { <span class="badge bg-secondary me-1">Положение СД</span> }
                                @if (_modalOffer.RequireCustomCharter == true) { <span class="badge bg-secondary me-1">Нетиповой устав</span> }
                                @if (_modalOffer.RequireExecutiveBodyA == true) { <span class="badge bg-secondary me-1">Гендиректор</span> }
                                @if (_modalOffer.RequireBoardOfDirectors == true) { <span class="badge bg-secondary me-1">Совет директоров</span> }
                                @if (_modalOffer.RequireDocumentFlowLegalElectronic == true) { <span class="badge bg-secondary me-1">ЮЗЭДО</span> }
                                @if (_modalOffer.RequireMandatoryAudit == true) { <span class="badge bg-secondary me-1">Обяз. аудит</span> }
                                @if (_modalOffer.RequireRevisionCommission == true) { <span class="badge bg-secondary me-1">Ревиз. комиссия</span> }
                                @if (!_modalOffer.RequireNotaryConfirmation.HasValue && !_modalOffer.RequireAllSignConfirmation.HasValue
                                    && !_modalOffer.RequireCommittees.HasValue && !_modalOffer.RequireBoardRegulation.HasValue
                                    && !_modalOffer.RequireCustomCharter.HasValue && !_modalOffer.RequireExecutiveBodyA.HasValue
                                    && !_modalOffer.RequireBoardOfDirectors.HasValue && !_modalOffer.RequireDocumentFlowLegalElectronic.HasValue
                                    && !_modalOffer.RequireMandatoryAudit.HasValue && !_modalOffer.RequireRevisionCommission.HasValue)
                                {
                                    <span class="text-muted">—</span>
                                }
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Предшественники</label>
                            <div>
                                @if (_modalPredecessorNames.Count > 0)
                                {
                                    @string.Join(", ", _modalPredecessorNames.Values)
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <a class="btn btn-outline-primary" href="/org-templates/stages/@_modalOffer.StageId/offers">Редактировать</a>
                    <button class="btn btn-secondary" @onclick="CloseOfferModal">Закрыть</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid IntentId { get; set; }

    private GanttChartInput? _ganttInput;
    private string? _intentName;
    private string? _error;
    private Dictionary<Guid, Guid> _offerStageMap = new();

    // ── Модальное окно задачи ──────────────────────────────────────────
    private bool _showOfferModal;
    private TplOrgTaskOffer? _modalOffer;
    private string? _modalStageName;
    private string? _modalIntentName;
    private List<RefRole> _modalRoles = new();
    private List<RefBoardRole> _modalBoardRoles = new();
    private Dictionary<Guid, string> _modalOfferRoleNames = new();
    private Dictionary<Guid, string> _modalPredecessorNames = new();

    // ── Маркеры (теги) ─────────────────────────────────────────────────

    /// <summary>Описание маркера (ключ свойства + отображаемое имя).</summary>
    private sealed record MarkerDef(string Key, string Label);

    /// <summary>Маппинг boolean-свойств TplOrgTaskOffer на отображаемые имена маркеров.</summary>
    private static readonly MarkerDef[] AllMarkerDefs =
    [
        new(nameof(TplOrgTaskOffer.RequireNotaryConfirmation), "Нотариус"),
        new(nameof(TplOrgTaskOffer.RequireAllSignConfirmation), "Подп. всеми"),
        new(nameof(TplOrgTaskOffer.RequireCommittees), "Комитеты"),
        new(nameof(TplOrgTaskOffer.RequireBoardRegulation), "Положение СД"),
        new(nameof(TplOrgTaskOffer.RequireCustomCharter), "Нетиповой устав"),
        new(nameof(TplOrgTaskOffer.RequireExecutiveBodyA), "Гендиректор"),
        new(nameof(TplOrgTaskOffer.RequireBoardOfDirectors), "Совет директоров"),
        new(nameof(TplOrgTaskOffer.RequireDocumentFlowLegalElectronic), "ЮЗЭДО"),
        new(nameof(TplOrgTaskOffer.RequireMandatoryAudit), "Обяз. аудит"),
        new(nameof(TplOrgTaskOffer.RequireRevisionCommission), "Ревиз. комиссия"),
    ];

    /// <summary>Маркеры, которые реально встречаются в задачах текущей диаграммы.</summary>
    private List<MarkerDef> _availableMarkers = new();

    /// <summary>Состояние включения/отключения каждого маркера.</summary>
    private Dictionary<string, bool> _activeMarkers = new();

    // ── Сырые данные, загружаемые из БД один раз ──────────────────────

    private List<TplOrgStage> _stages = new();
    private List<TplOrgTaskOffer> _allOffers = new();
    private List<TplOrgMilestone> _milestones = new();
    private HashSet<DateOnly> _holidays = new();
    private DateOnly _planStart;

    // ── Константы ─────────────────────────────────────────────────────

    /// <summary>Отступ в днях до начала первого этапа на диаграмме.</summary>
    private const int ChartStartPaddingDays = 7;

    /// <summary>Отступ в днях после окончания последнего этапа на диаграмме.</summary>
    private const int ChartEndPaddingDays = 30;

    /// <summary>Отступ в днях после максимальной даты в ComputeChartEnd.</summary>
    private const int ComputeChartEndPaddingDays = 14;

    // ── Инициализация ──────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var intent = await ctx.TplOrgIntents.FirstOrDefaultAsync(x => x.Id == IntentId);
            if (intent == null) { _error = "Шаблон не найден."; return; }
            _intentName = intent.Name;

            _stages = await ctx.TplOrgStages
                .Where(x => x.IntentId == IntentId)
                .OrderBy(x => x.SortOrder).ThenBy(x => x.Name).ToListAsync();

            var stageIds = _stages.Select(s => s.Id).ToList();
            _allOffers = await ctx.TplOrgOffers
                .Where(x => stageIds.Contains(x.StageId))
                .OrderBy(x => x.StartOffsetDays ?? 0).ThenBy(x => x.Name).ToListAsync();

            _milestones = await ctx.TplOrgMilestones
                .Where(x => x.IntentId == IntentId)
                .OrderBy(x => x.SortOrder).ThenBy(x => x.Name).ToListAsync();

            var today = DateOnly.FromDateTime(DateTime.Today);
            _planStart = today.AddDays(1);
            _holidays = WorkingDayHelper.GetHolidays(today.Year);
            _holidays.UnionWith(WorkingDayHelper.GetHolidays(today.Year + 1));

            // Сбор уникальных маркеров из задач
            var presentMarkers = new HashSet<string>();
            foreach (var offer in _allOffers)
            {
                foreach (var key in GetOfferMarkers(offer))
                    presentMarkers.Add(key);
            }
            _availableMarkers = AllMarkerDefs
                .Where(m => presentMarkers.Contains(m.Key))
                .ToList();
            _activeMarkers = _availableMarkers.ToDictionary(m => m.Key, _ => true);

            RebuildGanttInput();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки диаграммы Ганта");
            _error = ExceptionFlattener.Unwrap(ex);
        }
    }

    // ── Пересборка диаграммы ───────────────────────────────────────────

    /// <summary>Пересобирает GanttChartInput с учётом текущего фильтра маркеров.</summary>
    private void RebuildGanttInput()
    {
        var filteredOffers = _allOffers.Where(IsOfferVisible).ToList();

        var nodes = new List<GanttNode>();
        var dependencies = new List<GanttDependency>();
        var computedStageStart = new Dictionary<Guid, DateOnly>();
        var computedStageEnd = new Dictionary<Guid, DateOnly>();
        var computedOfferDates = new Dictionary<Guid, (DateOnly Start, DateOnly End)>();
        _offerStageMap.Clear();

        // ── Проход 1: вычисление дат с каскадным сдвигом и расширением ──
        DateOnly? maxEndSoFar = null;
        foreach (var stage in _stages)
        {
            var rawStart = _planStart.AddDays(stage.StartOffsetDays ?? 0);

            if (maxEndSoFar.HasValue && maxEndSoFar.Value > rawStart)
                rawStart = maxEndSoFar.Value.AddDays(1);

            if (!string.IsNullOrEmpty(stage.PredecessorStageIds))
            {
                try
                {
                    var predIds = System.Text.Json.JsonSerializer.Deserialize<Guid[]>(stage.PredecessorStageIds!);
                    if (predIds != null)
                    {
                        foreach (var pid in predIds)
                        {
                            if (computedStageEnd.TryGetValue(pid, out var pe) && pe > rawStart)
                                rawStart = pe.AddDays(1);
                        }
                    }
                }
                catch { }
            }

            var stageStart = WorkingDayHelper.GetNextWorkingDay(rawStart, _holidays);
            DateOnly? stageEnd = null;
            if (!string.IsNullOrEmpty(stage.DeadlineRule) && stage.DeadlineDays.HasValue)
            {
                var raw = stageStart.AddDays(Math.Max(0, stage.DeadlineDays.Value - 1));
                stageEnd = WorkingDayHelper.IsNonWorking(raw, _holidays)
                    ? WorkingDayHelper.GetNextWorkingDay(raw, _holidays)
                    : raw;
            }

            var stageOffers = filteredOffers.Where(o => o.StageId == stage.Id).ToList();
            foreach (var offer in stageOffers)
            {
                var offerStart = WorkingDayHelper.GetNextWorkingDay(
                    stageStart.AddDays(offer.StartOffsetDays ?? 0), _holidays);
                DateOnly? offerEnd = null;
                if (!string.IsNullOrEmpty(offer.DeadlineRule) && offer.DeadlineDays.HasValue)
                {
                    var raw = offerStart.AddDays(Math.Max(0, offer.DeadlineDays.Value - 1));
                    offerEnd = WorkingDayHelper.IsNonWorking(raw, _holidays)
                        ? WorkingDayHelper.GetNextWorkingDay(raw, _holidays)
                        : raw;
                }
                var end = offerEnd ?? offerStart.AddDays(1);
                computedOfferDates[offer.Id] = (offerStart, end);
                if (end > (stageEnd ?? stageStart))
                    stageEnd = end;
            }

            var finalEnd = stageEnd ?? stageStart;
            computedStageStart[stage.Id] = stageStart;
            computedStageEnd[stage.Id] = finalEnd;
            if (!maxEndSoFar.HasValue || finalEnd > maxEndSoFar.Value)
                maxEndSoFar = finalEnd;
        }

        // ── Проход 2: создание узлов ──
        var sort = 0;
        var intentId = $"intent-{IntentId}";
        nodes.Add(new GanttNode
        {
            Id = intentId, Name = _intentName ?? "", NodeType = GanttNodeType.Project,
            SortOrder = sort++, Expanded = true
        });

        foreach (var stage in _stages)
        {
            var stageOffers = filteredOffers.Where(o => o.StageId == stage.Id).ToList();
            if (stageOffers.Count == 0) continue;

            var stageStart = computedStageStart[stage.Id];
            var stageEnd = computedStageEnd[stage.Id];
            var stageId = $"stage-{stage.Id}";
            nodes.Add(new GanttNode
            {
                Id = stageId, ParentId = intentId, Name = stage.Name,
                NodeType = GanttNodeType.Stage,
                StartDate = stageStart,
                EndDate = stageEnd,
                SortOrder = sort++,
                BreadcrumbPath = $"{_intentName} > {stage.Name}"
            });

            foreach (var offer in stageOffers)
            {
                _offerStageMap[offer.Id] = stage.Id;
                var (offerStart, offerEnd) = computedOfferDates[offer.Id];
                nodes.Add(new GanttNode
                {
                    Id = $"offer-{offer.Id}", ParentId = stageId, Name = offer.Name,
                    NodeType = GanttNodeType.Task,
                    StartDate = offerStart,
                    EndDate = offerEnd,
                    SortOrder = sort++,
                    BreadcrumbPath = $"{_intentName} > {stage.Name}"
                });
            }
        }

        // Вехи — всегда видимы
        foreach (var ms in _milestones)
        {
            var msDate = _planStart.AddDays(ms.OffsetDays ?? 0);
            var parentId = ms.StageId.HasValue
                && nodes.Any(n => n.Id == $"stage-{ms.StageId.Value}")
                    ? $"stage-{ms.StageId.Value}"
                    : intentId;
            nodes.Add(new GanttNode
            {
                Id = $"milestone-{ms.Id}", ParentId = parentId, Name = ms.Name,
                NodeType = GanttNodeType.Milestone,
                MilestoneDate = msDate,
                MilestoneType = MapMilestoneType(ms.MilestoneType),
                SortOrder = sort++,
                BreadcrumbPath = $"{_intentName} > {ms.Name}"
            });
        }

        // Зависимости — только между видимыми узлами
        var nodeIds = new HashSet<string>(nodes.Select(n => n.Id));

        foreach (var stage in _stages.Where(s => !string.IsNullOrEmpty(s.PredecessorStageIds)))
        {
            if (!nodeIds.Contains($"stage-{stage.Id}")) continue;
            try
            {
                var predIds = System.Text.Json.JsonSerializer.Deserialize<Guid[]>(stage.PredecessorStageIds!);
                if (predIds != null)
                {
                    foreach (var predId in predIds)
                    {
                        if (nodeIds.Contains($"stage-{predId}"))
                        {
                            dependencies.Add(new GanttDependency
                            {
                                FromId = $"stage-{predId}",
                                ToId = $"stage-{stage.Id}",
                                Type = GanttDependencyType.Regular
                            });
                        }
                    }
                }
            }
            catch { }
        }

        foreach (var offer in filteredOffers.Where(o => !string.IsNullOrEmpty(o.PredecessorOfferIds)))
        {
            if (!nodeIds.Contains($"offer-{offer.Id}")) continue;
            try
            {
                var predIds = System.Text.Json.JsonSerializer.Deserialize<Guid[]>(offer.PredecessorOfferIds!);
                if (predIds != null)
                {
                    foreach (var predId in predIds)
                    {
                        if (nodeIds.Contains($"offer-{predId}"))
                        {
                            dependencies.Add(new GanttDependency
                            {
                                FromId = $"offer-{predId}",
                                ToId = $"offer-{offer.Id}",
                                Type = GanttDependencyType.Regular
                            });
                        }
                    }
                }
            }
            catch { }
        }

        var chartStart = ComputeChartStart(nodes).AddDays(-ChartStartPaddingDays);
        var chartEnd = ComputeChartEnd(nodes).AddDays(ChartEndPaddingDays);

        var allDays = WorkCalendar.GenerateCalendar(chartStart.Year, chartEnd.Year);
        var calendarDays = allDays.Where(d => d.Date >= chartStart && d.Date <= chartEnd).ToList();

        _ganttInput = new GanttChartInput
        {
            Nodes = nodes,
            CalendarDays = calendarDays,
            StartDate = chartStart,
            EndDate = chartEnd,
            Today = DateOnly.FromDateTime(DateTime.Today),
            EndPaddingWeeks = 0,
            Dependencies = dependencies
        };
    }

    // ── Маркеры: логика ────────────────────────────────────────────────

    /// <summary>Возвращает набор ключей маркеров, установленных у задачи (true).</summary>
    private static HashSet<string> GetOfferMarkers(TplOrgTaskOffer offer)
    {
        var result = new HashSet<string>();
        if (offer.RequireNotaryConfirmation == true) result.Add(nameof(TplOrgTaskOffer.RequireNotaryConfirmation));
        if (offer.RequireAllSignConfirmation == true) result.Add(nameof(TplOrgTaskOffer.RequireAllSignConfirmation));
        if (offer.RequireCommittees == true) result.Add(nameof(TplOrgTaskOffer.RequireCommittees));
        if (offer.RequireBoardRegulation == true) result.Add(nameof(TplOrgTaskOffer.RequireBoardRegulation));
        if (offer.RequireCustomCharter == true) result.Add(nameof(TplOrgTaskOffer.RequireCustomCharter));
        if (offer.RequireExecutiveBodyA == true) result.Add(nameof(TplOrgTaskOffer.RequireExecutiveBodyA));
        if (offer.RequireBoardOfDirectors == true) result.Add(nameof(TplOrgTaskOffer.RequireBoardOfDirectors));
        if (offer.RequireDocumentFlowLegalElectronic == true) result.Add(nameof(TplOrgTaskOffer.RequireDocumentFlowLegalElectronic));
        if (offer.RequireMandatoryAudit == true) result.Add(nameof(TplOrgTaskOffer.RequireMandatoryAudit));
        if (offer.RequireRevisionCommission == true) result.Add(nameof(TplOrgTaskOffer.RequireRevisionCommission));
        return result;
    }

    /// <summary>Проверяет, видна ли задача при текущем состоянии фильтра.
    /// Задача видима, если все её маркеры включены (или у неё нет маркеров).</summary>
    private bool IsOfferVisible(TplOrgTaskOffer offer)
    {
        foreach (var key in GetOfferMarkers(offer))
        {
            if (_activeMarkers.TryGetValue(key, out var active) && !active)
                return false;
        }
        return true;
    }

    /// <summary>Переключает состояние маркера и пересобирает диаграмму.</summary>
    private void ToggleMarker(string key)
    {
        _activeMarkers[key] = !_activeMarkers[key];
        RebuildGanttInput();
        StateHasChanged();
    }

    /// <summary>Включает все маркеры и пересобирает диаграмму.</summary>
    private void EnableAllMarkers()
    {
        foreach (var key in _activeMarkers.Keys.ToList())
            _activeMarkers[key] = true;
        RebuildGanttInput();
        StateHasChanged();
    }

    // ── Модальное окно задачи ──────────────────────────────────────────

    private async Task OpenOfferModal(Guid offerId)
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            _modalOffer = await ctx.TplOrgOffers
                .Include(x => x.Stage).ThenInclude(x => x!.Intent)
                .Include(x => x.MeasurementUnit)
                .Include(x => x.AssignedBoardRole)
                .Include(x => x.AssignedRole)
                .FirstOrDefaultAsync(x => x.Id == offerId);
            if (_modalOffer == null) return;

            _modalStageName = _modalOffer.Stage?.Name;
            _modalIntentName = _modalOffer.Stage?.Intent?.Name;

            _modalRoles = await ctx.Roles.OrderBy(x => x.Name).ToListAsync();
            _modalBoardRoles = await ctx.BoardRoles.OrderBy(x => x.SortOrder).ThenBy(x => x.Name).ToListAsync();

            var links = await ctx.TplOrgOfferRoles.Where(x => x.TplOfferId == offerId).ToListAsync();
            _modalOfferRoleNames = links
                .Select(l => new { l.RoleId, Name = ctx.Roles.FirstOrDefault(r => r.Id == l.RoleId)?.Name })
                .Where(x => x.Name != null)
                .ToDictionary(x => x.RoleId, x => x.Name!);

            var stageIds = await ctx.TplOrgStages.Where(x => x.IntentId == IntentId).Select(x => x.Id).ToListAsync();
            var allOffers = await ctx.TplOrgOffers.Where(x => stageIds.Contains(x.StageId)).ToListAsync();
            var lookup = allOffers.ToDictionary(x => x.Id);
            _modalPredecessorNames = new();
            if (!string.IsNullOrEmpty(_modalOffer.PredecessorOfferIds))
            {
                try
                {
                    var predIds = System.Text.Json.JsonSerializer.Deserialize<Guid[]>(_modalOffer.PredecessorOfferIds);
                    if (predIds != null)
                        _modalPredecessorNames = predIds
                            .Where(id => lookup.ContainsKey(id))
                            .ToDictionary(id => id, id => lookup[id].Name);
                }
                catch { }
            }

            _showOfferModal = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка загрузки задачи для модалки");
            _error = ExceptionFlattener.Unwrap(ex);
        }
    }

    private void CloseOfferModal()
    {
        _showOfferModal = false;
        _modalOffer = null;
    }

    private async Task HandleDoubleClick(GanttNode node)
    {
        Logger.LogDebug("Gantt double-click: {NodeId} {NodeName}", node.Id, node.Name);
        if (node.Id.StartsWith("offer-"))
        {
            var offerId = Guid.Parse(node.Id[6..]);
            await OpenOfferModal(offerId);
        }
    }

    // ── Вспомогательные методы ─────────────────────────────────────────

    private static DateOnly ComputeChartStart(List<GanttNode> nodes)
    {
        DateOnly? min = null;
        foreach (var n in nodes)
        {
            var d = n.StartDate ?? n.MilestoneDate;
            if (d.HasValue && (min == null || d.Value < min.Value))
                min = d.Value;
        }
        return min ?? DateOnly.FromDateTime(DateTime.Today);
    }

    private static DateOnly ComputeChartEnd(List<GanttNode> nodes)
    {
        DateOnly? max = null;
        foreach (var n in nodes)
        {
            var d = n.EndDate ?? n.StartDate ?? n.MilestoneDate;
            if (d.HasValue && (max == null || d.Value > max.Value))
                max = d.Value;
        }
        if (max == null) max = DateOnly.FromDateTime(DateTime.Today);
        return max.Value.AddDays(ComputeChartEndPaddingDays);
    }

    private static string FormatDate(DateOnly? d) => d.HasValue ? d.Value.ToString("dd.MM.yyyy") : "—";

    private static GanttMilestoneType MapMilestoneType(MilestoneType src) => src switch
    {
        MilestoneType.REGULAR => GanttMilestoneType.Regular,
        MilestoneType.PHASE_GATE => GanttMilestoneType.PhaseGate,
        MilestoneType.LEGAL => GanttMilestoneType.Legal,
        MilestoneType.CONTROL => GanttMilestoneType.Control,
        MilestoneType.INTEGRATION => GanttMilestoneType.Integration,
        _ => GanttMilestoneType.Regular
    };
}
