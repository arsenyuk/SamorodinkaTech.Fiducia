@page "/standard-charters"
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SYS_ADMIN")]

<h3>Типовые уставы ООО</h3>

<p class="text-muted">
    36 типовых уставов, утверждённых Приказом Минэкономразвития России от 01.08.2018 № 411.
    Номера 01–09 указаны с ведущим нулём в соответствии с форматом ФНС для форм Р11001 и Р13014.
</p>

@if (_charters is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover">
            <thead class="table-light">
                <tr>
                    <th style="min-width:3em">№</th>
                    <th>Выход участника<br>из общества</th>
                    <th style="font-weight:700" title="Требуется ли согласие участников при переходе доли между участниками. Влияет на голосование ОСУ.">Переход доли<br>к участникам</th>
                    <th style="font-weight:700" title="Требуется ли согласие участников при продаже доли третьему лицу. Влияет на голосование ОСУ.">Переход доли<br>к третьим лицам</th>
                    <th style="font-weight:700" title="Приоритет участников перед третьими лицами при покупке доли. Запускает обязательную рассылку оферт с дедлайном 30 дней.">Преимущественное<br>право покупки</th>
                    <th>Переход доли<br>к наследникам</th>
                    <th style="font-weight:700" title="Тип исполнительного органа: A — гендиректор (избрание на 5 лет), B — каждый участник = директор, C — все совместно. Определяет процедуру избрания и подписания документов.">Исполнительный<br>орган общества</th>
                    <th>Срок<br>полномочий</th>
                    <th style="font-weight:700" title="Способ подтверждения решений ОСУ: нотариальное удостоверение или подписание протокола всеми участниками. Определяет процесс оформления собрания.">Подтверждение<br>решений собрания</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var c in _charters!)
            {
                <tr>
                    <td><strong>@c.Number</strong></td>
                    <td><span class="badge @(c.ExitAllowed ? "bg-success" : "bg-secondary")">@(c.ExitAllowed ? "Да" : "Нет")</span></td>
                    <td>@(c.TransferToParticipantsWithoutConsent ? "Без согласия" : "С согласия")</td>
                    <td>@(c.TransferToThirdPartiesWithoutConsent ? "Без согласия" : "С согласия")</td>
                    <td>@(c.PreemptiveRight ? "Есть" : "Нет")</td>
                    <td>@(c.InheritanceWithoutConsent ? "Без согласия" : "С согласия")</td>
                    <td>@ExecBodyLabel(c.ExecutiveBody)</td>
                    <td>@DirectorTermLabel(c.ExecutiveBody)</td>
                    <td>@(c.ProtocolConfirmationMethod?.Name ?? "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <p class="text-muted small mt-2">
        <strong>Жирным</strong> выделены параметры, влияющие на бизнес-процессы системы.
        Подробнее — в <a href="/docs/business-processes/standard-charter-impact" target="_blank">документации</a>.
    </p>
}

@code {
    private List<SamorodinkaTech.Fiducia.Domain.Entities.RefStandardCharter>? _charters;

    protected override async Task OnInitializedAsync()
    {
        await using var ctx = await DbFactory.CreateDbContextAsync();
        _charters = await ctx.RefStandardCharters
            .Include(x => x.ProtocolConfirmationMethod)
            .OrderBy(x => x.Number).ToListAsync();
    }

    private static string ExecBodyLabel(char body) => body switch
    {
        'A' => "Генеральный директор",
        'B' => "Каждый участник — директор",
        'C' => "Все участники совместно",
        _ => "—"
    };

    private static string DirectorTermLabel(char body) => body switch
    {
        'A' => "5 лет",
        'B' => "Бессрочно",
        'C' => "Бессрочно",
        _ => "—"
    };
}