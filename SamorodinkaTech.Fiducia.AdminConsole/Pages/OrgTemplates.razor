@page "/org-templates"
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@inject ILogger<OrgTemplates> Logger
@inject NavigationManager Nav
@inject SamorodinkaTech.Fiducia.Domain.Interfaces.ITemplateInstantiationService TemplateSvc
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SYS_ADMIN")]

<h3>Шаблоны организационных мероприятий</h3>

@if (_currentLe != null)
{
    <div class="card mb-2 bg-light">
        <div class="card-body py-2">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary">@_orgTypeLabel</span>
                @if (_hasBoardOfDirectors)
                {
                    <span class="badge bg-success">Совет директоров</span>
                }
                <div class="ms-auto form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="filterToggle"
                           checked="@_filterByContext"
                           @onchange="async e => { _filterByContext = (bool)(e.Value ?? false); await LoadAsync(); }" />
                    <label class="form-check-label small" for="filterToggle">По контексту организации</label>
                </div>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success">@_success</div>
}

<button class="btn btn-primary btn-sm mb-2" @onclick="() => _showForm = true">Добавить цель</button>

@if (_showForm)
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label">Код</label>
                    <input class="form-control" @bind="_editCode" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Название</label>
                    <input class="form-control" @bind="_editName" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Описание</label>
                    <input class="form-control" @bind="_editDesc" />
                </div>
                <div class="col-md-3">
                    <label class="form-label mb-1">Признаки</label>
                    <div class="d-flex gap-2">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="edit_ao"
                                   @bind="_editIsForAo" />
                            <label class="form-check-label small" for="edit_ao">АО</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="edit_llc"
                                   @bind="_editIsForLlc" />
                            <label class="form-check-label small" for="edit_llc">ООО</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="edit_bod"
                                   @bind="_editRequiresBod" />
                            <label class="form-check-label small" for="edit_bod">Совет директоров</label>
                        </div>
                    </div>
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button class="btn btn-success btn-sm me-1" @onclick="Save">✓</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="CancelForm">✕</button>
                </div>
            </div>
        </div>
    </div>
}

<table class="table table-sm table-hover">
    <thead>
        <tr><th>Код</th><th>Название</th><th>Описание</th><th>Признаки</th><th style="width:130px">Действия</th></tr>
    </thead>
    <tbody>
    @foreach (var i in _items)
    {
        <tr>
            <td><code>@(i.Code ?? "—")</code></td>
            <td>
                <a href="/org-templates/intents/@i.Id/stages" class="text-decoration-none">@i.Name</a>
            </td>
            <td class="text-muted small">@i.Description</td>
            <td class="small">
                @if (i.IsForAo == true) { <span class="badge bg-primary me-1">АО</span> }
                @if (i.IsForLlc == true) { <span class="badge bg-info me-1">ООО</span> }
                @if (i.RequiresBoardOfDirectors == true) { <span class="badge bg-success me-1">СД</span> }
            </td>
            <td>
                <button class="btn btn-outline-secondary btn-sm me-1" @onclick="() => Edit(i)">✏️</button>
                @if (_currentLe != null)
                {
                    <button class="btn btn-outline-success btn-sm" @onclick="() => Instantiate(i)">▶</button>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@code {
    private List<TplOrgIntent> _items = new();
    private string? _error;
    private string? _success;
    private bool _showForm;
    private string _editCode = "";
    private string _editName = "";
    private string _editDesc = "";
    private bool _editIsForAo;
    private bool _editIsForLlc;
    private bool _editRequiresBod;
    private int _editSort;
    private Guid? _editingId;

    private LegalEntity? _currentLe;
    private string _orgTypeLabel = "";
    private bool _hasBoardOfDirectors;
    private bool _filterByContext = true;
    private static readonly string[] _aoOkopfCodes = { OkopfTypeMapper.PjscCode, OkopfTypeMapper.NjscCode };
    private static readonly string _llcOkopfCode = OkopfTypeMapper.LlcCode;

    protected override async Task OnInitializedAsync() { await LoadAsync(); }

    private async Task LoadAsync()
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();

            // Загружаем текущий контекст организации
            /*var wp = await ctx.CurrentWorkplaces.FirstOrDefaultAsync();
            if (wp?.LastSelectedLegalEntityId != null)
            {
                _currentLe = await ctx.LegalEntities
                    .Include(x => x.RefOkopf)
                    .FirstOrDefaultAsync(x => x.Id == wp.LastSelectedLegalEntityId.Value);
                if (_currentLe?.RefOkopf != null)
                {
                    _orgTypeLabel = _aoOkopfCodes.Contains(_currentLe.RefOkopf.Code) ? "АО" :
                                    _currentLe.RefOkopf.Code == _llcOkopfCode ? "ООО" :
                                    _currentLe.RefOkopf.Name;
                    _hasBoardOfDirectors = await ctx.BoardsOfDirectors
                        .AnyAsync(x => x.OsaMeeting.LegalEntityId == _currentLe.Id
                                    && x.Status.Code == "ACTIVE");
                }
            }*/

            var query = ctx.TplOrgIntents.AsQueryable();

            if (_filterByContext && _currentLe != null)
            {
                if (_orgTypeLabel == "АО")
                    query = query.Where(x => x.IsForAo == true || x.IsForAo == null);
                else if (_orgTypeLabel == "ООО")
                    query = query.Where(x => x.IsForLlc == true || x.IsForLlc == null);

                if (!_hasBoardOfDirectors)
                    query = query.Where(x => x.RequiresBoardOfDirectors != true);
            }

            _items = await query.OrderBy(x => x.SortOrder).ThenBy(x => x.Name).ToListAsync();
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Ошибка загрузки целей"); _error = ExceptionFlattener.Unwrap(ex); }
    }

    private void Edit(TplOrgIntent i)
    {
        _editingId = i.Id; _editCode = i.Code ?? ""; _editName = i.Name; _editDesc = i.Description ?? "";
        _editIsForAo = i.IsForAo ?? false; _editIsForLlc = i.IsForLlc ?? false;
        _editRequiresBod = i.RequiresBoardOfDirectors ?? false;
        _editSort = i.SortOrder; _showForm = true;
    }

    private void CancelForm() { _showForm = false; _editingId = null; _editCode = ""; }

    private async Task Instantiate(TplOrgIntent intent)
    {
        if (_currentLe == null) return;
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var boardId = _hasBoardOfDirectors
                ? await ctx.BoardsOfDirectors
                    .Where(x => x.OsaMeeting.LegalEntityId == _currentLe.Id && x.Status.Code == "ACTIVE")
                    .Select(x => (Guid?)x.Id)
                    .FirstOrDefaultAsync()
                : null;

            var count = await TemplateSvc.InstantiateAsync(ctx, intent.Code ?? "", _currentLe.Id, boardId);
            await ctx.SaveChangesAsync();
            _success = $"Создано задач: {count}";
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Ошибка инстанцирования"); _error = ExceptionFlattener.Unwrap(ex); }
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_editName)) return;
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            if (_editingId.HasValue)
            {
                var e = await ctx.TplOrgIntents.FirstOrDefaultAsync(x => x.Id == _editingId.Value);
                if (e != null)
                {
                    e.Name = _editName.Trim(); e.Description = (string.IsNullOrWhiteSpace(_editDesc) ? null : _editDesc.Trim());
                    e.SortOrder = _editSort;
                    e.IsForAo = _editIsForAo ? true : null;
                    e.IsForLlc = _editIsForLlc ? true : null;
                    e.RequiresBoardOfDirectors = _editRequiresBod ? true : null;
                }
            }
            else
            {
                ctx.TplOrgIntents.Add(new TplOrgIntent
                {
                    Id = Guid.NewGuid(),
                    Name = _editName.Trim(),
                    Description = (string.IsNullOrWhiteSpace(_editDesc) ? null : _editDesc.Trim()),
                    SortOrder = _editSort,
                    IsForAo = _editIsForAo ? true : null,
                    IsForLlc = _editIsForLlc ? true : null,
                    RequiresBoardOfDirectors = _editRequiresBod ? true : null
                });
            }
            await ctx.SaveChangesAsync();
            CancelForm(); await LoadAsync();
            _success = _editingId.HasValue ? "Цель обновлена." : "Цель создана.";
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Ошибка сохранения"); _error = ExceptionFlattener.Unwrap(ex); }
    }

}
