@page "/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SYS_ADMIN")]

<PageTitle>Fiducia — Системные настройки</PageTitle>

<h3>Системные настройки</h3>

<!-- Основные -->
<h5 class="mt-4">Основные</h5>
<div class="list-group">
    <a href="/settings/system" class="list-group-item list-group-item-action">
        Системные настройки
        <small class="text-muted d-block">Дедлайн протокола, инвайт, TSP, Гант, шаблоны заседаний, расширения файлов</small>
    </a>
    <a href="/settings/thresholds" class="list-group-item list-group-item-action">
        Пороги для собраний
        <small class="text-muted d-block">Пороги доли участника для требований о созыве ВОСУ/ВОСА</small>
    </a>
    <a href="/settings/auth" class="list-group-item list-group-item-action">
        Метод авторизации
        <small class="text-muted d-block">Basic / Active Directory (LDAP)</small>
    </a>
</div>

<!-- Документы и интеграции -->
<h5 class="mt-4">Документы и интеграции</h5>
<div class="list-group">
    <a href="/settings/print" class="list-group-item list-group-item-action">
        Настройки печати (ГОСТ)
        <small class="text-muted d-block">Поля, шрифты, шапка/подвал, водяной знак, ЭЦП</small>
    </a>
    <a href="/settings/integrations" class="list-group-item list-group-item-action">
        Интеграции
        <small class="text-muted d-block">КриптоПро, SMTP, SMS</small>
    </a>
</div>
