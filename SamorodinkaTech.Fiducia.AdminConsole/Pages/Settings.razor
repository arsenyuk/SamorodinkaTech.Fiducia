@page "/settings"
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory

<PageTitle>Fiducia — Системные настройки</PageTitle>

<div class="container-fluid">
    <!-- Текущее юридическое лицо -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Текущее юридическое лицо</h5>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Выберите организацию</label>
                    <select class="form-select" @bind="_selectedLeId">
                        <option value="">— не выбрано —</option>
                        @foreach (var le in _legalEntities)
                        {
                            <option value="@le.Id">@le.Name (ИНН: @le.Inn)</option>
                        }
                    </select>
                    <small class="text-muted">Определяет контекст для шаблонов, заседаний и других страниц</small>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_leSaveMessage))
            {
                <div class="alert alert-success py-2">@_leSaveMessage</div>
            }
            <button class="btn btn-primary btn-sm" @onclick="SaveSelectedLegalEntity">Сохранить</button>
        </div>
    </div>

    <!-- Системные настройки -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Системные настройки</h5>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Дедлайн протокола (дней)</label>
                    <input type="number" class="form-control" @bind="_protocolDeadline" min="1" max="30">
                    <small class="text-muted">Согласно <a href="/board-law/68">ст. 68 п. 4 208-ФЗ</a></small>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Срок действия инвайта (дней)</label>
                    <input type="number" class="form-control" @bind="_inviteExpiry" min="1" max="30">
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">TSP-сервер (RFC 3161)</label>
                <input type="text" class="form-control" @bind="_tspServer">
                <small class="text-muted">Сервер точного времени для фиксации UTC-меток подписей</small>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Запас шкалы Ганта (недель)</label>
                    <input type="number" class="form-control" @bind="_ganttPaddingWeeks" min="0" max="12">
                    <small class="text-muted">После окончания последней задачи на диаграмме оргплана</small>
                </div>
            </div>
            <hr />
            <h6>Шаблоны наименований заседаний</h6>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Шаблон наименования ГОСА</label>
                    <input type="text" class="form-control" @bind="_gosaTitleTemplate" placeholder="Годовое за {YYYY} год">
                    <small class="text-muted">Используется плейсхолдер <code>{YYYY}</code> для года</small>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Шаблон наименования ООСУ</label>
                    <input type="text" class="form-control" @bind="_oosuTitleTemplate" placeholder="Очередное за {YYYY} год">
                    <small class="text-muted">Используется плейсхолдер <code>{YYYY}</code> для года</small>
                </div>
            </div>
            <hr />
            <h6>Загрузка файлов</h6>
            <div class="mb-3">
                <label class="form-label">Запрещённые расширения (через запятую)</label>
                <textarea class="form-control @(_blockedExtensionsError is not null ? "is-invalid" : "")" rows="3" @bind="_blockedExtensions"
                          @oninput="() => _blockedExtensionsError = null"
                          placeholder="exe, dll, bat, cmd, ..."></textarea>
                @if (_blockedExtensionsError is not null)
                {
                    <div class="invalid-feedback">@_blockedExtensionsError</div>
                }
                <small class="text-muted">Файлы с этими расширениями будут отклоняться при загрузке. Только латинские буквы без точки (пример: exe, dll, bat)</small>
            </div>
            <button class="btn btn-primary" @onclick="SaveSystemSettings">Сохранить настройки</button>
        </div>
    </div>

    <!-- Метод авторизации -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Метод авторизации</h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Режим авторизации</label>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="authMethod" value="Basic"
                           checked="@(_authMethod == "Basic")"
                           @onchange="SetAuthMethod">
                    <label class="form-check-label">
                        <strong>Basic</strong> — выбор пользователя из списка
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="authMethod" value="ActiveDirectory"
                           checked="@(_authMethod == "ActiveDirectory")"
                           @onchange="SetAuthMethod">
                    <label class="form-check-label">
                        <strong>Active Directory</strong> — аутентификация по логину/паролю через LDAP
                    </label>
                </div>
            </div>

            @if (_authMethod == "ActiveDirectory")
            {
                <div class="border rounded p-3 bg-light">
                    <h6>Настройки Active Directory</h6>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">LDAP Server</label>
                            <input type="text" class="form-control" @bind="_ldapServer" placeholder="ldap://dc.company.local">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Domain</label>
                            <input type="text" class="form-control" @bind="_ldapDomain" placeholder="company.local">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Base DN</label>
                            <input type="text" class="form-control" @bind="_ldapBaseDn" placeholder="DC=company,DC=local">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">SSL</label>
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" checked="@_ldapUseSsl"
                                       @onchange="() => _ldapUseSsl = !_ldapUseSsl">
                                <label class="form-check-label">Использовать LDAPS (636)</label>
                            </div>
                        </div>
                    </div>
                    <button class="btn btn-sm btn-outline-primary">Тест подключения</button>
                </div>
            }

            <div class="mt-3">
                <small class="text-muted">
                    @if (_authMethod == "Basic")
                    {
                        <span>Пользователи выбирают своё ФИО из выпадающего списка. Подходит для небольших организаций.</span>
                    }
                    else
                    {
                        <span>Аутентификация через корпоративный каталог Active Directory. Пользователи вводят логин и пароль.</span>
                    }
                </small>
            </div>
        </div>
    </div>

    <!-- Настройки печати (ГОСТ) -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Настройки печати (ГОСТ Р 7.0.97-2025)</h5>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-3">
                    <label class="form-label">Левое поле (мм)</label>
                    <input type="number" class="form-control" @bind="_marginLeft" min="10" max="50">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Правое поле (мм)</label>
                    <input type="number" class="form-control" @bind="_marginRight" min="10" max="50">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Верхнее поле (мм)</label>
                    <input type="number" class="form-control" @bind="_marginTop" min="10" max="50">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Нижнее поле (мм)</label>
                    <input type="number" class="form-control" @bind="_marginBottom" min="10" max="50">
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">Шрифт заголовков</label>
                    <select class="form-select" @bind="_headerFont">
                        <option value="Times New Roman">Times New Roman</option>
                        <option value="Arial">Arial</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Размер (пт)</label>
                    <input type="number" class="form-control" @bind="_headerFontSize" min="10" max="20">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Шрифт текста</label>
                    <select class="form-select" @bind="_bodyFont">
                        <option value="Times New Roman">Times New Roman</option>
                        <option value="Arial">Arial</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Размер (пт)</label>
                    <input type="number" class="form-control" @bind="_bodyFontSize" min="10" max="16">
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-3">
                    <label class="form-label">Межстрочный интервал</label>
                    <select class="form-select" @bind="_lineSpacing">
                        <option value="1">1.0</option>
                        <option value="1.15">1.15</option>
                        <option value="1.5">1.5</option>
                        <option value="2">2.0</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Отступ абзаца (см)</label>
                    <input type="number" class="form-control" @bind="_paragraphIndent" min="0.5" max="3" step="0.1">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Ориентация</label>
                    <select class="form-select" @bind="_pageOrientation">
                        <option value="portrait">Книжная</option>
                        <option value="landscape">Альбомная</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Формат бумаги</label>
                    <select class="form-select" @bind="_paperSize">
                        <option value="A4">А4 (210×297)</option>
                        <option value="A3">А3 (297×420)</option>
                        <option value="Letter">Letter</option>
                    </select>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">Нумерация страниц</label>
                    <select class="form-select" @bind="_pageNumbering">
                        <option value="bottom-center">Снизу по центру</option>
                        <option value="bottom-right">Снизу справа</option>
                        <option value="top-right">Сверху справа</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Шапка документа</label>
                    <input type="text" class="form-control" @bind="_headerText" placeholder="АО «Ромашка»">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Подвал документа</label>
                    <input type="text" class="form-control" @bind="_footerText" placeholder="Г. Москва">
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@_showWatermark"
                               @onchange="() => _showWatermark = !_showWatermark">
                        <label class="form-check-label">Водяной знак при просмотре</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@_showStamp"
                               @onchange="() => _showStamp = !_showStamp">
                        <label class="form-check-label">Штамп ЭЦП (п. 5.23 ГОСТа)</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked="@_autoDeclineDates"
                               @onchange="() => _autoDeclineDates = !_autoDeclineDates">
                        <label class="form-check-label">Автосклонение дат</label>
                    </div>
                </div>
            </div>
            <button class="btn btn-primary">Сохранить настройки печати</button>
        </div>
    </div>

    <!-- Интеграции -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Интеграции</h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">КриптоПро CSP</label>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" checked="@_cryptoproEnabled"
                           @onchange="() => _cryptoproEnabled = !_cryptoproEnabled">
                    <span class="ms-2 @(_cryptoproEnabled ? "text-success" : "text-muted")">
                        @(_cryptoproEnabled ? "Подключено" : "Не настроено")
                    </span>
                </div>
                <small class="text-muted">Для подписания УКЭП Председателем и Секретарём СД</small>
            </div>
            <div class="mb-3">
                <label class="form-label">SMTP-сервер (Email)</label>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" checked="@_smtpEnabled"
                           @onchange="() => _smtpEnabled = !_smtpEnabled">
                    <span class="ms-2 @(_smtpEnabled ? "text-success" : "text-muted")">
                        @(_smtpEnabled ? "Подключено" : "Не настроено")
                    </span>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">SMS-провайдер (ПЭП)</label>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" checked="@_smsEnabled"
                           @onchange="() => _smsEnabled = !_smsEnabled">
                    <span class="ms-2 @(_smsEnabled ? "text-success" : "text-muted")">
                        @(_smsEnabled ? "Подключено" : "Не настроено")
                    </span>
                </div>
            </div>
        </div>
    </div>

</div>

@code {
    // Системные настройки
    private int _protocolDeadline = 3;
    private int _inviteExpiry = 7;
    private string _tspServer = "http://timestamp.ru/timestamp";
    private int _ganttPaddingWeeks = 2;
    private string _gosaTitleTemplate = "Годовое за {YYYY} год";
    private string _oosuTitleTemplate = "Очередное за {YYYY} год";
    private string _blockedExtensions = "exe,dll,com,msi,bat,cmd,scr,pif";
    private string? _blockedExtensionsError;

    // Авторизация
    private string _authMethod = "Basic";
    private string _ldapServer = "ldap://dc.company.local";
    private string _ldapDomain = "company.local";
    private string _ldapBaseDn = "DC=company,DC=local";
    private bool _ldapUseSsl = true;

    // Печать (ГОСТ)
    private int _marginLeft = 30;
    private int _marginRight = 15;
    private int _marginTop = 20;
    private int _marginBottom = 20;
    private string _headerFont = "Times New Roman";
    private int _headerFontSize = 14;
    private string _bodyFont = "Times New Roman";
    private int _bodyFontSize = 14;
    private string _lineSpacing = "1.5";
    private double _paragraphIndent = 1.25;
    private string _pageOrientation = "portrait";
    private string _paperSize = "A4";
    private string _pageNumbering = "bottom-center";
    private string _headerText = string.Empty;
    private string _footerText = string.Empty;
    private bool _showWatermark = true;
    private bool _showStamp = true;
    private bool _autoDeclineDates = true;

    // Интеграции
    private bool _cryptoproEnabled = true;
    private bool _smtpEnabled = true;
    private bool _smsEnabled = false;

    // Текущее ЮЛ
    private List<SamorodinkaTech.Fiducia.Domain.Entities.LegalEntity> _legalEntities = new();
    private string _selectedLeId = "";
    private string? _leSaveMessage;

    // Удалено: настройки логирования приложений перешли в appsettings.* (см. AGENTS.md — Конфигурация логирования)

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();

            // Загружаем список ЮЛ
            _legalEntities = await ctx.LegalEntities.OrderBy(x => x.Name).ToListAsync();

            // Загружаем текущее место работы
            var wp = await ctx.CurrentWorkplaces.FirstOrDefaultAsync();
            if (wp != null)
                _selectedLeId = wp.LastSelectedLegalEntityId?.ToString() ?? "";

            // Загружаем системные настройки
            var settings = await ctx.SystemSettings.ToDictionaryAsync(x => x.Key, x => x.Value);
            if (settings.TryGetValue("gantt_end_padding_weeks", out var paddingWeeks) && int.TryParse(paddingWeeks, out var pw))
                _ganttPaddingWeeks = pw;
            if (settings.TryGetValue("gosa_title_template", out var gosaTemplate) && !string.IsNullOrEmpty(gosaTemplate))
                _gosaTitleTemplate = gosaTemplate;
            if (settings.TryGetValue("oosu_title_template", out var oosuTemplate) && !string.IsNullOrEmpty(oosuTemplate))
                _oosuTitleTemplate = oosuTemplate;
            if (settings.TryGetValue("blocked_extensions", out var blockedExt) && !string.IsNullOrEmpty(blockedExt))
                _blockedExtensions = blockedExt;
        }
        catch { }
    }

    private async Task SaveSelectedLegalEntity()
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var wp = await ctx.CurrentWorkplaces.FirstOrDefaultAsync();
            if (wp != null)
            {
                wp.LastSelectedLegalEntityId = string.IsNullOrEmpty(_selectedLeId)
                    ? null
                    : Guid.Parse(_selectedLeId);
                await ctx.SaveChangesAsync();
                _leSaveMessage = "Юридическое лицо обновлено.";
            }
        }
        catch { }
    }

    private async Task SaveSystemSettings()
    {
        try
        {
            // Валидация запрещённых расширений
            _blockedExtensionsError = ValidateBlockedExtensions(_blockedExtensions);
            StateHasChanged();
            if (_blockedExtensionsError is not null) return;

            await using var ctx = await DbFactory.CreateDbContextAsync();

            // Сохраняем gantt_end_padding_weeks
            var setting = await ctx.SystemSettings.FirstOrDefaultAsync(x => x.Key == "gantt_end_padding_weeks");
            if (setting != null)
            {
                setting.Value = _ganttPaddingWeeks.ToString();
                setting.UpdatedAt = DateTime.UtcNow;
            }
            else
            {
                ctx.SystemSettings.Add(new SamorodinkaTech.Fiducia.Domain.Entities.SystemSetting
                {
                    Id = Guid.NewGuid(),
                    Key = "gantt_end_padding_weeks",
                    Value = _ganttPaddingWeeks.ToString(),
                    Description = "Запас в неделях после окончания последней задачи на диаграмме Ганта"
                });
            }

            // Сохраняем шаблоны заседаний
            await UpsertSetting(ctx, "gosa_title_template", _gosaTitleTemplate, "Шаблон названия ГОСА");
            await UpsertSetting(ctx, "oosu_title_template", _oosuTitleTemplate, "Шаблон названия ООСУ");

            // Сохраняем запрещённые расширения
            await UpsertSetting(ctx, "blocked_extensions", _blockedExtensions, "Запрещённые расширения файлов (через запятую)");

            await ctx.SaveChangesAsync();
        }
        catch { }
    }

    private static async Task UpsertSetting(SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext ctx, string key, string value, string description)
    {
        var setting = await ctx.SystemSettings.FirstOrDefaultAsync(x => x.Key == key);
        if (setting != null)
        {
            setting.Value = value;
            setting.UpdatedAt = DateTime.UtcNow;
        }
        else
        {
            ctx.SystemSettings.Add(new SamorodinkaTech.Fiducia.Domain.Entities.SystemSetting
            {
                Id = Guid.NewGuid(),
                Key = key,
                Value = value,
                Description = description
            });
        }
    }

    private void SetAuthMethod(ChangeEventArgs e)
    {
        _authMethod = e.Value?.ToString() ?? "Basic";
    }

    private static string? ValidateBlockedExtensions(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null; // Пустое значение допустимо (нет запрещённых расширений)

        var extensions = value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        if (extensions.Length == 0)
            return null;

        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var ext in extensions)
        {
            // Проверяем что расширение содержит только латинские буквы и цифры
            if (!System.Text.RegularExpressions.Regex.IsMatch(ext, @"^[a-zA-Z0-9]+$"))
                return $"Недопустимое расширение «{ext}». Допустимы только латинские буквы и цифры без точки.";

            // Проверяем дубликаты
            if (!seen.Add(ext))
                return $"Дубликат расширения «{ext}».";

            // Проверяем длину
            if (ext.Length > 20)
                return $"Расширение «{ext}» слишком длинное (максимум 20 символов).";
        }

        return null;
    }
}
