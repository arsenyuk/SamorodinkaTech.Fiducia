@page "/access-management"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.WebUtilities
@using SamorodinkaTech.Fiducia.Domain.Entities
@using SamorodinkaTech.Fiducia.Domain.Interfaces
@using SamorodinkaTech.Fiducia.Domain.Validation
@using SamorodinkaTech.Fiducia.Infrastructure.Persistence
@inject IDbContextFactory<FiduciaDbContext> DbFactory
@inject ILogger<AccessManagement> Logger
@inject ILdapService LdapService
@inject ISecurityAuditService SecurityAuditService
@inject IClientIpProvider ClientIpProvider
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SYS_ADMIN,LE_ADMIN")]

<h3>Сотрудники и доступ</h3>

@if (!string.IsNullOrEmpty(_leError))
{
    <div class="alert alert-danger py-2">
        @_leError
        <a href="/legal-entities" class="ms-2">← К списку ЮЛ</a>
    </div>
}

@if (!string.IsNullOrEmpty(_selectedLegalEntityId))
{
    <div class="card mb-3">
        <div class="card-body py-2">
            <strong>@_selectedLegalEntityName</strong>
            <a href="/legal-entities" class="ms-3 small">← К списку ЮЛ</a>
        </div>
    </div>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link active">Сотрудники</button>
        </li>
    </ul>
}

@if (_activeTab == 0 && !string.IsNullOrEmpty(_selectedLegalEntityId))
{
    <div class="mb-3">
        <button class="btn btn-primary btn-sm" @onclick="ShowAddEmployeeModal">+ Добавить сотрудника</button>
    </div>

    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>ФИО</th>
                <th>Должность</th>
                <th>Логин</th>
                <th>Роль</th>
                <th>Статус</th>
                <th style="width:80px"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in _employees)
            {
                <tr>
                    <td>
                        @if (e.UserId.HasValue)
                        {
                            <a href="/users/@e.UserId" title="Карточка пользователя">@e.FullName</a>
                        }
                        else
                        {
                            @e.FullName
                        }
                    </td>
                    <td>@(e.Position ?? "—")</td>
                    <td>@e.Login</td>
                    <td><span class="badge bg-info">@e.RoleName</span></td>
                    <td>
                        <span class="badge @(e.IsActive ? "bg-success" : "bg-secondary")">
                            @(e.IsActive ? "Активен" : "Неактивен")
                        </span>
                    </td>
                    <td><button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveEmployee(e.Id)">✕</button></td>
                </tr>
            }
        </tbody>
    </table>
}


@if (_showAddEmpModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color:rgba(0,0,0,.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Добавить сотрудника</h5>
                    <button class="btn-close" @onclick="CloseAddEmployeeModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3 row">
                        <label class="col-sm-4 col-form-label">Юридическое лицо *</label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" value="@_selectedLegalEntityName" readonly>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="col-sm-4 col-form-label">Поиск по логину *</label>
                        <div class="col-sm-8">
                            <div class="input-group">
                                <input type="text" class="form-control" @bind="_ldapSearchLogin">
                                <button class="btn btn-outline-secondary" @onclick="SearchLdapAsync" disabled="@_ldapSearching">
                                    @if (_ldapSearching) { <span class="spinner-border spinner-border-sm"></span> } else { <span>🔍</span> }
                                </button>
                            </div>
                            @if (!string.IsNullOrEmpty(_ldapWarning)) { <div class="text-warning small mt-1">@_ldapWarning</div> }
                        </div>
                    </div>
                    @if (_ldapFound)
                    {
                        <div class="mb-3 row">
                            <label class="col-sm-4 col-form-label">Логин</label>
                            <div class="col-sm-8"><input type="text" class="form-control" value="@_empLogin" readonly></div>
                        </div>
                        <div class="mb-3 row">
                            <label class="col-sm-4 col-form-label">Фамилия</label>
                            <div class="col-sm-8"><input type="text" class="form-control" value="@_empLastName" readonly></div>
                        </div>
                        <div class="mb-3 row">
                            <label class="col-sm-4 col-form-label">Имя</label>
                            <div class="col-sm-8"><input type="text" class="form-control" value="@_empFirstName" readonly></div>
                        </div>
                        <div class="mb-3 row">
                            <label class="col-sm-4 col-form-label">Отчество</label>
                            <div class="col-sm-8"><input type="text" class="form-control" value="@_empMiddleName" readonly></div>
                        </div>
                        <div class="mb-3 row">
                            <label class="col-sm-4 col-form-label">Должность</label>
                            <div class="col-sm-8"><input type="text" class="form-control" value="@_empPosition" readonly></div>
                        </div>
                        <div class="mb-3 row">
                            <label class="col-sm-4 col-form-label">Роль *</label>
                            <div class="col-sm-8">
                                <select class="form-select" @bind="_empRoleCode">
                                    <option value="">— Выберите роль —</option>
                                    @foreach (var r in _assignableRoles)
                                    {
                                        <option value="@r.Code">@r.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_empError))
                    {
                        <div class="alert alert-danger py-1 px-2 mt-3 mb-0 small">@_empError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseAddEmployeeModal">Отмена</button>
                    <button class="btn btn-primary" @onclick="AddEmployee"
                            disabled="@(_addEmpLoading || !_canAddEmployee)">Добавить</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private int _activeTab;
    private string _selectedLegalEntityId = "";
    private string _selectedLegalEntityName = "";
    private string? _leError;
    private bool _isSysAdmin;

    private List<RefRole> _assignableRoles = new();
    private List<RefRole> _extAvailableRoles = new();
    private List<LegalEntity> _legalEntities = new();
    private List<EmployeeRow> _employees = new();

    // ── Поля формы «Сотрудники» ──
    private string _empLastName = "", _empFirstName = "", _empMiddleName = "", _empPosition = "", _empLogin = "", _empRoleCode = "", _empEmail = "";
    private bool _addEmpLoading;
    private string? _empError;
    private bool _ldapSearching;
    private string? _ldapWarning;
    private string _ldapSearchLogin = "";
    private bool _ldapFound;

    // ── Поля формы «Внешние лица» ──
    private List<ExternalPersonRow> _externalPersons = new();
    private string _extLastName = "", _extFirstName = "", _extMiddleName = "", _extRoleCode = "";
    private DateOnly? _extStartDate, _extEndDate;
    private bool _addExtLoading;
    private string? _extError;
    private bool _showLeTypeWarning;

    // ── Модальное окно добавления сотрудника ──
    private bool _showAddEmpModal;

    // ── Вычисляемые свойства ──
    private bool _canAddEmployee => !_addEmpLoading
        && _ldapFound
        && !string.IsNullOrWhiteSpace(_empRoleCode)
        && !string.IsNullOrWhiteSpace(_selectedLegalEntityId);

    private bool _canAddExternalPerson => !_addExtLoading
        && !string.IsNullOrWhiteSpace(_extLastName)
        && !string.IsNullOrWhiteSpace(_extFirstName)
        && !string.IsNullOrWhiteSpace(_extRoleCode)
        && !string.IsNullOrWhiteSpace(_selectedLegalEntityId)
        && !_showLeTypeWarning;

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            _assignableRoles = await ctx.Roles.Where(r => r.IsAssignable).OrderBy(r => r.Name).ToListAsync();

            var role = HttpContextAccessor.HttpContext?.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            _isSysAdmin = role == "SYS_ADMIN";

            // Загружаем список ЮЛ для LE_ADMIN (для scope-фильтрации)
            if (!_isSysAdmin)
            {
                var login = HttpContextAccessor.HttpContext?.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                if (Guid.TryParse(login, out var userId))
                {
                    var user = await ctx.Users.FindAsync(userId);
                    login = user?.Login;
                }
                if (!string.IsNullOrEmpty(login))
                {
                    _legalEntities = await ctx.LegalEntities
                        .Where(le => ctx.EcosystemParticipants.Any(ep =>
                            ep.LegalEntityId == le.Id && ep.User != null && ep.User.Login == login))
                        .OrderBy(le => le.Name).ToListAsync();
                }
                else
                {
                    _legalEntities = new();
                }
            }
            else
            {
                _legalEntities = await ctx.LegalEntities.OrderBy(le => le.Name).ToListAsync();
            }

            // Определяем выбранное ЮЛ из query-параметра ?le={id}
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("le", out var leParam)
                && Guid.TryParse(leParam, out var leId))
            {
                // Параметр передан — проверяем существование ЮЛ
                var selectedLe = _legalEntities.FirstOrDefault(le => le.Id == leId);
                if (selectedLe is null)
                {
                    _leError = _isSysAdmin
                        ? $"Юридическое лицо с ID {leId} не найдено."
                        : "У вас нет доступа к этому юридическому лицу.";
                    return;
                }
                _selectedLegalEntityId = leId.ToString();
                _selectedLegalEntityName = selectedLe.Name;
            }
            else
            {
                // Параметр ?le не передан — ошибка
                _leError = "Не указано юридическое лицо. Вернитесь в «Общества» и выберите ЮЛ.";
                return;
            }

            // Загружаем сотрудников для выбранного ЮЛ
            if (!string.IsNullOrEmpty(_selectedLegalEntityId))
            {
                await LoadEmployeesAsync();
                await LoadExternalPersonsAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка загрузки данных");
            _leError = "Ошибка загрузки данных.";
        }
    }

    private async Task LoadEmployeesAsync()
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var leId = Guid.Parse(_selectedLegalEntityId);
            var rows = await ctx.Employees
                .Include(e => e.EcosystemParticipant)
                .Where(e => e.LegalEntityId == leId)
                .ToListAsync();

            var employeeUserIds = rows
                .Where(e => e.EcosystemParticipant?.UserId != null)
                .Select(e => e.EcosystemParticipant!.UserId!.Value)
                .ToList();

            var roles = await ctx.UserRoles
                .Include(ur => ur.Role)
                .Where(ur => employeeUserIds.Contains(ur.UserId))
                .ToListAsync();

            _employees = rows.Select(e =>
            {
                var person = e.EcosystemParticipant?.EcosystemPerson;
                var login = e.EcosystemParticipant?.User?.Login ?? "—";
                var userId = e.EcosystemParticipant?.UserId;
                var roleName = roles.Where(r => r.UserId == userId).Select(r => r.Role!.Name).FirstOrDefault() ?? "—";
                return new EmployeeRow
                {
                    Id = e.Id,
                    FullName = person != null
                        ? string.Join(" ", new[] { person.LastName, person.FirstName, person.MiddleName }.Where(p => !string.IsNullOrWhiteSpace(p)))
                        : "—",
                    Position = e.Position,
                    Login = login,
                    RoleName = roleName,
                    IsActive = e.EcosystemParticipant?.IsActive ?? true,
                    UserId = userId
                };
            }).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка загрузки сотрудников");
            _empError = "Ошибка загрузки сотрудников.";
        }
    }

    private async Task LoadExternalPersonsAsync()
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var rows = await ctx.ExternalAttractedPersons
                .Include(x => x.EcosystemParticipant)
                .Where(x => x.LegalEntityId == Guid.Parse(_selectedLegalEntityId))
                .ToListAsync();

            _externalPersons = rows.Select(x => new ExternalPersonRow
            {
                Id = x.Id,
                FullName = x.EcosystemParticipant?.EcosystemPerson != null
                    ? string.Join(" ", new[] { x.EcosystemParticipant.EcosystemPerson.LastName, x.EcosystemParticipant.EcosystemPerson.FirstName, x.EcosystemParticipant.EcosystemPerson.MiddleName }.Where(p => !string.IsNullOrWhiteSpace(p)))
                    : "—",
                RoleName = x.Position,
                StartedAt = x.StartedAt,
                EndedAt = x.EndedAt,
                IsActive = x.IsActive
            }).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка загрузки внешних лиц");
        }
    }

    private async Task SearchLdapAsync()
    {
        if (string.IsNullOrWhiteSpace(_ldapSearchLogin)) { _ldapWarning = "Введите логин."; return; }

        _ldapSearching = true;
        _ldapWarning = null;
        _ldapFound = false;
        StateHasChanged();

        try
        {
            var user = await LdapService.FindUserByLoginAsync(_ldapSearchLogin);
            if (user is null)
            {
                _ldapWarning = $"Пользователь «{_ldapSearchLogin}» не найден в LDAP.";
                var userIp = ClientIpProvider.GetClientIp();
                await SecurityAuditService.LogEventAsync("EXTERNAL:LDAP:NotFound", userIp,
                    $"Пользователь «{_ldapSearchLogin}» не найден в LDAP-каталоге",
                    login: _ldapSearchLogin, entityName: "User");
                return;
            }

            if (!string.IsNullOrWhiteSpace(_selectedLegalEntityId))
            {
                await using var ctx = await DbFactory.CreateDbContextAsync();

                if (await ctx.EcosystemParticipants
                    .Include(x => x.User)
                    .AnyAsync(ep =>
                    ep.LegalEntityId == Guid.Parse(_selectedLegalEntityId) && ep.User != null && ep.User.Login == _ldapSearchLogin))
                {
                    _ldapWarning = $"Логин «{_ldapSearchLogin}» уже используется в этом ЮЛ.";
                    Logger.LogWarning("Дубль логина при поиске: {Login} уже используется в ЮЛ {LeId}", _ldapSearchLogin, _selectedLegalEntityId);
                    var userIp = ClientIpProvider.GetClientIp();
                    await SecurityAuditService.LogEventAsync("ACCESS:DUPLICATE_LOGIN", userIp,
                        $"Попытка добавить сотрудника с логином «{_ldapSearchLogin}» — логин уже используется в ЮЛ",
                        login: _ldapSearchLogin, entityName: "EcosystemParticipant");
                    return;
                }
            }

            _empLogin = _ldapSearchLogin;
            var nameParts = user.DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (nameParts.Length >= 2)
            {
                _empLastName = nameParts[0];
                _empFirstName = nameParts[1];
                _empMiddleName = nameParts.Length >= 3 ? nameParts[2] : string.Empty;
            }
            _empPosition = user.Title ?? string.Empty;
            _empEmail = user.Email ?? $"{_ldapSearchLogin}@ldap.local";
            _ldapFound = true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Ошибка LDAP-поиска для логина {Login}", _ldapSearchLogin);
            _ldapWarning = $"Ошибка LDAP: {ex.Message}";
        }
        finally
        {
            _ldapSearching = false;
            StateHasChanged();
        }
    }

    private void ShowAddEmployeeModal()
    {
        _ldapSearchLogin = "";
        _ldapFound = false;
        _empLastName = "";
        _empFirstName = "";
        _empMiddleName = "";
        _empPosition = "";
        _empLogin = "";
        _empRoleCode = "";
        _empEmail = "";
        _empError = null;
        _ldapWarning = null;
        _showAddEmpModal = true;
    }

    private void CloseAddEmployeeModal()
    {
        _showAddEmpModal = false;
    }

    private async Task AddEmployee()
    {
        _addEmpLoading = true;
        _empError = null;

        try
        {
            var userRole = HttpContextAccessor.HttpContext?.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            if (userRole != "SYS_ADMIN" && userRole != "LE_ADMIN")
            {
                _empError = "Недостаточно прав.";
                return;
            }

            if (_empRoleCode == "SYS_ADMIN")
            {
                _empError = "Нельзя «Системный администратор».";
                return;
            }

            if (string.IsNullOrWhiteSpace(_selectedLegalEntityId))
            {
                _empError = "Выберите ЮЛ.";
                return;
            }

            await using var ctx = await DbFactory.CreateDbContextAsync();
            var leId = Guid.Parse(_selectedLegalEntityId);

            if (await ctx.EcosystemParticipants
                .Include(x => x.User)
                .AnyAsync(ep =>
                ep.LegalEntityId == leId && ep.User != null && ep.User.Login == _empLogin))
            {
                _empError = $"Логин «{_empLogin}» уже используется.";
                Logger.LogWarning("Дубль логина при добавлении сотрудника: {Login} уже используется в ЮЛ {LeId}", _empLogin, _selectedLegalEntityId);
                var userIp = ClientIpProvider.GetClientIp();
                await SecurityAuditService.LogEventAsync("ACCESS:DUPLICATE_LOGIN", userIp,
                    $"Попытка добавить сотрудника с логином «{_empLogin}» — логин уже используется в ЮЛ",
                    login: _empLogin, entityName: "EcosystemParticipant");
                return;
            }

            var existingUser = await ctx.Users.FirstOrDefaultAsync(u => u.Login == _empLogin);

            // Если пользователь не найден — создать из LDAP-данных
            if (existingUser is null)
            {
                existingUser = new User
                {
                    Id = Guid.NewGuid(),
                    Login = _empLogin,
                    LastName = _empLastName,
                    FirstName = _empFirstName,
                    MiddleName = _empMiddleName,
                    Email = _empEmail,
                    Phone = "",
                    IsExternal = false,
                    CreatedAt = DateTime.UtcNow,
                    CreatedBy = Guid.Empty
                };
                ctx.Users.Add(existingUser);
                await ctx.SaveChangesAsync();
            }

            var pid = Guid.NewGuid();
            var personId = Guid.NewGuid();
            ctx.EcosystemPersons.Add(new()
            {
                Id = personId,
                LastName = _empLastName,
                FirstName = _empFirstName,
                MiddleName = _empMiddleName,
                CreatedAt = DateTime.UtcNow,
                CreatedBy = Guid.Empty
            });
            ctx.EcosystemParticipants.Add(new()
            {
                Id = pid,
                LegalEntityId = leId,
                EcosystemPersonId = personId,
                UserId = existingUser?.Id,
                CreatedAt = DateTime.UtcNow,
                CreatedBy = Guid.Empty
            });

            ctx.Employees.Add(new()
            {
                Id = Guid.NewGuid(),
                EcosystemParticipantId = pid,
                LegalEntityId = leId,
                Position = _empPosition,
                CreatedAt = DateTime.UtcNow,
                CreatedBy = Guid.Empty
            });

            if (existingUser is not null)
            {
                var role = await ctx.Roles.FirstOrDefaultAsync(r => r.Code == _empRoleCode);
                if (role is not null && !await ctx.UserRoles.AnyAsync(ur =>
                    ur.UserId == existingUser.Id && ur.RoleId == role.Id))
                {
                    ctx.UserRoles.Add(new UserRole { UserId = existingUser.Id, RoleId = role.Id });
                }
            }

            await ctx.SaveChangesAsync();

            CloseAddEmployeeModal();
            await LoadEmployeesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка добавления сотрудника");
            _empError = "Ошибка.";
        }
        finally
        {
            _addEmpLoading = false;
        }
    }

    private async Task RemoveEmployee(Guid id)
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var e = await ctx.Employees.FindAsync(id);
            if (e != null)
            {
                ctx.Employees.Remove(e);
                await ctx.SaveChangesAsync();
                await LoadEmployeesAsync();
            }
        }
        catch { }
    }

    private async Task OnExternalTabClick()
    {
        _activeTab = 1;
        _showLeTypeWarning = false;
        _extAvailableRoles.Clear();

        if (string.IsNullOrEmpty(_selectedLegalEntityId)) return;

        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var le = await ctx.LegalEntities
                .Include(l => l.RefOkopf)
                .FirstOrDefaultAsync(l => l.Id == Guid.Parse(_selectedLegalEntityId));

            if (le?.RefOkopf == null)
            {
                _showLeTypeWarning = true;
                return;
            }

            var t = OkopfTypeMapper.DetectType(le.RefOkopf.Code);
            var all = await ctx.Roles
                .Where(r => r.Code == "EXTERNAL_DIRECTOR" || r.Code == "PARTICIPANT" || r.Code == "SHAREHOLDER")
                .ToListAsync();

            _extAvailableRoles = t switch
            {
                OrgValidationType.LLC => all.Where(r =>
                    r.Code == "EXTERNAL_DIRECTOR" || r.Code == "PARTICIPANT").ToList(),
                OrgValidationType.PJSC or OrgValidationType.NJSC => all.Where(r =>
                    r.Code == "EXTERNAL_DIRECTOR" || r.Code == "SHAREHOLDER").ToList(),
                _ => new()
            };

            if (_extAvailableRoles.Count == 0)
                _showLeTypeWarning = true;
        }
        catch
        {
            _showLeTypeWarning = true;
        }
    }

    private async Task AddExternalPerson()
    {
        _addExtLoading = true;
        _extError = null;

        try
        {
            if (string.IsNullOrWhiteSpace(_selectedLegalEntityId))
            {
                _extError = "Выберите ЮЛ.";
                return;
            }

            if (_showLeTypeWarning)
            {
                _extError = "Тип ЮЛ не определён.";
                return;
            }

            if (string.IsNullOrWhiteSpace(_extLastName) || string.IsNullOrWhiteSpace(_extFirstName))
            {
                _extError = "Фамилия и Имя обязательны.";
                return;
            }

            await using var ctx = await DbFactory.CreateDbContextAsync();
            var leId = Guid.Parse(_selectedLegalEntityId);
            var extLogin = $"{_extLastName.ToLowerInvariant()}.{_extFirstName.ToLowerInvariant()}";

            if (await ctx.EcosystemParticipants
                .Include(x => x.User)
                .AnyAsync(ep =>
                ep.LegalEntityId == leId && ep.User != null && ep.User.Login == extLogin))
            {
                _extError = $"Логин «{extLogin}» уже используется в этом ЮЛ.";
                Logger.LogWarning("Дубль логина при добавлении внешнего лица: {Login} уже используется в ЮЛ {LeId}", extLogin, _selectedLegalEntityId);
                var userIp = ClientIpProvider.GetClientIp();
                await SecurityAuditService.LogEventAsync("ACCESS:DUPLICATE_LOGIN", userIp,
                    $"Попытка добавить внешнее лицо с логином «{extLogin}» — логин уже используется в ЮЛ",
                    login: extLogin, entityName: "EcosystemParticipant");
                return;
            }

            var pid = Guid.NewGuid();
            var personId = Guid.NewGuid();
            ctx.EcosystemPersons.Add(new()
            {
                Id = personId,
                LastName = _extLastName,
                FirstName = _extFirstName,
                MiddleName = _extMiddleName,
                CreatedAt = DateTime.UtcNow,
                CreatedBy = Guid.Empty
            });
            ctx.EcosystemParticipants.Add(new()
            {
                Id = pid,
                LegalEntityId = leId,
                EcosystemPersonId = personId,
                CreatedAt = DateTime.UtcNow,
                CreatedBy = Guid.Empty
            });

            var role = await ctx.Roles.FirstOrDefaultAsync(r => r.Code == _extRoleCode);

            ctx.ExternalAttractedPersons.Add(new()
            {
                Id = Guid.NewGuid(),
                EcosystemParticipantId = pid,
                LegalEntityId = leId,
                Position = role?.Name ?? _extRoleCode,
                StartedAt = _extStartDate?.ToDateTime(TimeOnly.MinValue),
                EndedAt = _extEndDate?.ToDateTime(TimeOnly.MinValue),
                IsActive = true,
                CreatedAt = DateTime.UtcNow,
                CreatedBy = Guid.Empty
            });

            await ctx.SaveChangesAsync();

            _extLastName = "";
            _extFirstName = "";
            _extMiddleName = "";
            _extRoleCode = "";
            _extStartDate = null;
            _extEndDate = null;

            await LoadExternalPersonsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка добавления внешнего лица");
            _extError = "Ошибка.";
        }
        finally
        {
            _addExtLoading = false;
        }
    }

    private async Task RemoveExternalPerson(Guid id)
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var p = await ctx.ExternalAttractedPersons.FindAsync(id);
            if (p != null)
            {
                ctx.ExternalAttractedPersons.Remove(p);
                await ctx.SaveChangesAsync();
                await LoadExternalPersonsAsync();
            }
        }
        catch { }
    }

