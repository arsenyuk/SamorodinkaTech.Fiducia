@page "/access-management"
@using Microsoft.EntityFrameworkCore
@using SamorodinkaTech.Fiducia.Domain.Entities
@using SamorodinkaTech.Fiducia.Domain.Validation
@using SamorodinkaTech.Fiducia.Infrastructure.Persistence
@inject IDbContextFactory<FiduciaDbContext> DbFactory
@inject ILogger<AccessManagement> Logger
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SYS_ADMIN")]

<h3>Сотрудники и доступ</h3>

<div class="card mb-3"><div class="card-body py-2"><div class="row g-2 align-items-end"><div class="col-md-8"><label class="form-label small fw-bold">Юридическое лицо</label><div class="input-group input-group-sm"><select class="form-select" @onchange="OnLeChanged"><option value="">— выбрать ЮЛ —</option>@foreach (var le in _legalEntities) { <option value="@le.Id">@le.Name (@le.Inn)</option> }</select><button class="btn btn-outline-success" @onclick="ShowCreateLeModal">+ Создать ЮЛ</button></div></div></div></div></div>

@if (!string.IsNullOrEmpty(_leError)) { <div class="alert alert-danger py-2">@_leError</div> }
@if (string.IsNullOrEmpty(_selectedLegalEntityId)) { <div class="text-muted py-4 text-center">Выберите юридическое лицо для работы</div> }
@if (!string.IsNullOrEmpty(_selectedLegalEntityId)) { <ul class="nav nav-tabs mb-3"><li class="nav-item"><button class="nav-link @(_activeTab == 0 ? "active" : "")" @onclick="() => _activeTab = 0">Сотрудники</button></li><li class="nav-item"><button class="nav-link @(_activeTab == 1 ? "active" : "")" @onclick="OnExternalTabClick">Внешние лица</button></li></ul> }

@if (_activeTab == 0 && !string.IsNullOrEmpty(_selectedLegalEntityId))
{
    <div class="card mb-3"><div class="card-body"><h5>Добавить сотрудника</h5>
        <div class="row g-2"><div class="col-md-2"><label class="form-label small">Фамилия *</label><input class="form-control form-control-sm" @bind="_empLastName" /></div><div class="col-md-2"><label class="form-label small">Имя *</label><input class="form-control form-control-sm" @bind="_empFirstName" /></div><div class="col-md-2"><label class="form-label small">Отчество</label><input class="form-control form-control-sm" @bind="_empMiddleName" /></div><div class="col-md-2"><label class="form-label small">Должность *</label><input class="form-control form-control-sm" @bind="_empPosition" /></div><div class="col-md-2"><label class="form-label small">Логин *</label><div class="input-group input-group-sm"><input class="form-control" @bind="_empLogin" /><button class="btn btn-outline-secondary" @onclick="SearchLdapAsync" disabled="@_ldapSearching">🔍</button></div>@if (!string.IsNullOrEmpty(_ldapWarning)) { <div class="text-warning small mt-1">@_ldapWarning</div> }</div><div class="col-md-2"><label class="form-label small">Роль *</label><select class="form-select form-select-sm" @bind="_empRoleCode"><option value="">— выбрать —</option>@foreach (var r in _assignableRoles) { <option value="@r.Code">@r.Name</option> }</select></div></div>
        <div class="mt-2"><button class="btn btn-primary btn-sm" @onclick="AddEmployee" disabled="@(_addEmpLoading || !_canAddEmployee)">Добавить</button></div>
        @if (!string.IsNullOrEmpty(_empError)) { <div class="alert alert-danger py-1 px-2 mt-2 mb-0 small">@_empError</div> }
    </div></div>
    <table class="table table-sm table-striped"><thead><tr><th>ФИО</th><th>Должность</th><th>Логин</th><th>Роль</th><th style="width:60px"></th></tr></thead><tbody>@foreach (var e in _employees) { <tr><td>@e.FullName</td><td>@(e.Position ?? "—")</td><td>@e.Login</td><td><span class="badge bg-info">@e.RoleName</span></td><td><button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveEmployee(e.Id)">✕</button></td></tr> }</tbody></table>
}

@if (_activeTab == 1 && !string.IsNullOrEmpty(_selectedLegalEntityId))
{
    if (_showLeTypeWarning) { <div class="alert alert-warning py-2">Тип ЮЛ не определён.</div> }
    <div class="card mb-3"><div class="card-body"><h5>Добавить внешнее лицо</h5>
        <div class="row g-2"><div class="col-md-2"><label class="form-label small">Фамилия *</label><input class="form-control form-control-sm" @bind="_extLastName" /></div><div class="col-md-2"><label class="form-label small">Имя *</label><input class="form-control form-control-sm" @bind="_extFirstName" /></div><div class="col-md-2"><label class="form-label small">Отчество</label><input class="form-control form-control-sm" @bind="_extMiddleName" /></div><div class="col-md-3"><label class="form-label small">Роль *</label><select class="form-select form-select-sm" @bind="_extRoleCode" disabled="@_showLeTypeWarning"><option value="">— выбрать —</option>@foreach (var r in _extAvailableRoles) { <option value="@r.Code">@r.Name</option> }</select></div></div>
        <div class="row g-2 mt-2"><div class="col-md-2"><label class="form-label small">Дата начала</label><input type="date" class="form-control form-control-sm" @bind="_extStartDate" /></div><div class="col-md-2"><label class="form-label small">Дата окончания</label><input type="date" class="form-control form-control-sm" @bind="_extEndDate" /></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary btn-sm" @onclick="AddExternalPerson" disabled="@(_addExtLoading || !_canAddExternalPerson)">Добавить</button></div></div>
        @if (!string.IsNullOrEmpty(_extError)) { <div class="alert alert-danger py-1 px-2 mt-2 mb-0 small">@_extError</div> }
    </div></div>
    <table class="table table-sm table-striped"><thead><tr><th>ФИО</th><th>Роль</th><th>Период</th><th>Статус</th><th style="width:60px"></th></tr></thead><tbody>@foreach (var e in _externalPersons) { <tr><td>@e.FullName</td><td><span class="badge bg-warning text-dark">@e.RoleName</span></td><td>@(e.StartedAt?.ToString("dd.MM.yyyy") ?? "") @(e.EndedAt.HasValue ? $"— {e.EndedAt.Value:dd.MM.yyyy}" : "")</td><td>@(e.IsActive ? "Активен" : "Неактивен")</td><td><button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveExternalPerson(e.Id)">✕</button></td></tr> }</tbody></table>
}

@if (_showCreateLeModal) { <div class="modal show d-block" tabindex="-1" style="background-color:rgba(0,0,0,.5)"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Новое ЮЛ</h5><button class="btn-close" @onclick="() => _showCreateLeModal = false"></button></div><div class="modal-body"><div class="mb-3"><label class="form-label">Наименование *</label><input class="form-control @(_createLeNameError is not null ? "is-invalid" : "")" @bind="_createLeName" @oninput="() => _createLeNameError = null" />@if (_createLeNameError is not null) { <div class="invalid-feedback">@_createLeNameError</div> }</div><div class="mb-3"><label class="form-label">ИНН *</label><input class="form-control @(_createLeInnError is not null ? "is-invalid" : "")" @bind="_createLeInn" maxlength="12" @oninput="() => _createLeInnError = null" />@if (_createLeInnError is not null) { <div class="invalid-feedback">@_createLeInnError</div> }</div>@if (!string.IsNullOrEmpty(_createLeError)) { <div class="alert alert-danger py-1 px-2 small">@_createLeError</div> }</div><div class="modal-footer"><button class="btn btn-secondary" @onclick="() => _showCreateLeModal = false">Отмена</button><button class="btn btn-primary" @onclick="CreateLegalEntity" disabled="@(_createLeLoading || string.IsNullOrWhiteSpace(_createLeName) || string.IsNullOrWhiteSpace(_createLeInn))">Создать</button></div></div></div></div> }

@code { private int _activeTab; private string _selectedLegalEntityId = ""; private string? _leError; private List<RefRole> _assignableRoles = new(); private List<RefRole> _extAvailableRoles = new(); private List<LegalEntity> _legalEntities = new(); private List<EmployeeRow> _employees = new(); private string _empLastName = "", _empFirstName = "", _empMiddleName = "", _empPosition = "", _empLogin = "", _empRoleCode = ""; private bool _addEmpLoading; private string? _empError; private bool _ldapSearching; private string? _ldapWarning; private List<ExternalPersonRow> _externalPersons = new(); private string _extLastName = "", _extFirstName = "", _extMiddleName = "", _extRoleCode = ""; private DateOnly? _extStartDate, _extEndDate; private bool _addExtLoading; private string? _extError; private bool _showLeTypeWarning; private bool _showCreateLeModal; private string _createLeName = "", _createLeInn = ""; private string? _createLeNameError, _createLeInnError, _createLeError; private bool _createLeLoading; private bool _canAddEmployee => !_addEmpLoading && !string.IsNullOrWhiteSpace(_empLastName) && !string.IsNullOrWhiteSpace(_empFirstName) && !string.IsNullOrWhiteSpace(_empPosition) && !string.IsNullOrWhiteSpace(_empLogin) && !string.IsNullOrWhiteSpace(_empRoleCode) && !string.IsNullOrWhiteSpace(_selectedLegalEntityId); private bool _canAddExternalPerson => !_addExtLoading && !string.IsNullOrWhiteSpace(_extLastName) && !string.IsNullOrWhiteSpace(_extFirstName) && !string.IsNullOrWhiteSpace(_extRoleCode) && !string.IsNullOrWhiteSpace(_selectedLegalEntityId) && !_showLeTypeWarning; protected override async Task OnInitializedAsync() => await LoadDataAsync(); private async Task LoadDataAsync() { try { await using var ctx = await DbFactory.CreateDbContextAsync(); _assignableRoles = await ctx.Roles.Where(r => r.IsAssignable).OrderBy(r => r.Name).ToListAsync(); _legalEntities = await ctx.LegalEntities.OrderBy(le => le.Name).ToListAsync(); } catch (Exception ex) { Logger.LogWarning(ex, "LoadData"); } } private async Task OnLeChanged(ChangeEventArgs e) { _selectedLegalEntityId = e.Value?.ToString() ?? ""; _leError = null; _showLeTypeWarning = false; _extAvailableRoles.Clear(); _activeTab = 0; if (!string.IsNullOrEmpty(_selectedLegalEntityId)) { await LoadEmployeesAsync(); await LoadExternalPersonsAsync(); } else { _employees.Clear(); _externalPersons.Clear(); } } private async Task LoadEmployeesAsync() { if (string.IsNullOrEmpty(_selectedLegalEntityId)) return; await using var ctx = await DbFactory.CreateDbContextAsync(); var rows = await ctx.Employees.Include(x => x.EcosystemParticipant).Where(x => x.LegalEntityId == Guid.Parse(_selectedLegalEntityId)).ToListAsync(); _employees = rows.Select(x => new EmployeeRow { Id = x.Id, FullName = x.EcosystemParticipant != null ? string.Join(" ", new[] { x.EcosystemParticipant.LastName, x.EcosystemParticipant.FirstName, x.EcosystemParticipant.MiddleName }.Where(p => !string.IsNullOrWhiteSpace(p))) : "—", Position = x.Position, Login = x.EcosystemParticipant != null ? x.EcosystemParticipant.Login : "—", RoleName = "—" }).ToList(); } private async Task LoadExternalPersonsAsync() { if (string.IsNullOrEmpty(_selectedLegalEntityId)) return; await using var ctx = await DbFactory.CreateDbContextAsync(); var rows = await ctx.ExternalAttractedPersons.Include(x => x.EcosystemParticipant).Where(x => x.LegalEntityId == Guid.Parse(_selectedLegalEntityId)).ToListAsync(); _externalPersons = rows.Select(x => new ExternalPersonRow { Id = x.Id, FullName = x.EcosystemParticipant != null ? string.Join(" ", new[] { x.EcosystemParticipant.LastName, x.EcosystemParticipant.FirstName, x.EcosystemParticipant.MiddleName }.Where(p => !string.IsNullOrWhiteSpace(p))) : "—", RoleName = x.Position, StartedAt = x.StartedAt, EndedAt = x.EndedAt, IsActive = x.IsActive }).ToList(); } private async Task SearchLdapAsync() { if (string.IsNullOrWhiteSpace(_empLogin)) return; _ldapSearching = true; _ldapWarning = null; StateHasChanged(); try { if (!string.IsNullOrWhiteSpace(_selectedLegalEntityId)) { await using var ctx = await DbFactory.CreateDbContextAsync(); if (await ctx.EcosystemParticipants.AnyAsync(ep => ep.LegalEntityId == Guid.Parse(_selectedLegalEntityId) && ep.Login == _empLogin)) { _ldapWarning = $"Логин «{_empLogin}» уже используется."; return; } } _ldapWarning = $"Пользователь «{_empLogin}» — проверьте вручную."; } catch { _ldapWarning = "Ошибка LDAP."; } finally { _ldapSearching = false; StateHasChanged(); } } private async Task AddEmployee() { _addEmpLoading = true; _empError = null; try { if (_empRoleCode == "SYS_ADMIN") { _empError = "Нельзя «Системный администратор»."; return; } if (string.IsNullOrWhiteSpace(_selectedLegalEntityId)) { _empError = "Выберите ЮЛ."; return; } await using var ctx = await DbFactory.CreateDbContextAsync(); var leId = Guid.Parse(_selectedLegalEntityId); if (await ctx.EcosystemParticipants.AnyAsync(ep => ep.LegalEntityId == leId && ep.Login == _empLogin)) { _empError = $"Логин «{_empLogin}» уже используется."; return; } var pid = Guid.NewGuid(); ctx.EcosystemParticipants.Add(new() { Id = pid, LegalEntityId = leId, LastName = _empLastName, FirstName = _empFirstName, MiddleName = _empMiddleName, Login = _empLogin, CreatedAt = DateTime.UtcNow, CreatedBy = Guid.Empty }); ctx.Employees.Add(new() { Id = Guid.NewGuid(), EcosystemParticipantId = pid, LegalEntityId = leId, Position = _empPosition, CreatedAt = DateTime.UtcNow, CreatedBy = Guid.Empty }); await ctx.SaveChangesAsync(); _empLastName = ""; _empFirstName = ""; _empMiddleName = ""; _empPosition = ""; _empLogin = ""; _empRoleCode = ""; _ldapWarning = null; await LoadEmployeesAsync(); } catch { _empError = "Ошибка."; } finally { _addEmpLoading = false; } } private async Task RemoveEmployee(Guid id) { try { await using var ctx = await DbFactory.CreateDbContextAsync(); var e = await ctx.Employees.FindAsync(id); if (e != null) { ctx.Employees.Remove(e); await ctx.SaveChangesAsync(); await LoadEmployeesAsync(); } } catch { } } private async Task OnExternalTabClick() { _activeTab = 1; _showLeTypeWarning = false; _extAvailableRoles.Clear(); if (string.IsNullOrEmpty(_selectedLegalEntityId)) return; try { await using var ctx = await DbFactory.CreateDbContextAsync(); var le = await ctx.LegalEntities.Include(l => l.RefOkopf).FirstOrDefaultAsync(l => l.Id == Guid.Parse(_selectedLegalEntityId)); if (le?.RefOkopf == null) { _showLeTypeWarning = true; return; } var t = OkopfTypeMapper.DetectType(le.RefOkopf.Code); var all = await ctx.Roles.Where(r => r.Code == "EXTERNAL_DIRECTOR" || r.Code == "PARTICIPANT" || r.Code == "SHAREHOLDER").ToListAsync(); _extAvailableRoles = t switch { OrgValidationType.LLC => all.Where(r => r.Code == "EXTERNAL_DIRECTOR" || r.Code == "PARTICIPANT").ToList(), OrgValidationType.PJSC or OrgValidationType.NJSC => all.Where(r => r.Code == "EXTERNAL_DIRECTOR" || r.Code == "SHAREHOLDER").ToList(), _ => new() }; if (_extAvailableRoles.Count == 0) _showLeTypeWarning = true; } catch { _showLeTypeWarning = true; } } private async Task AddExternalPerson() { _addExtLoading = true; _extError = null; try { if (string.IsNullOrWhiteSpace(_selectedLegalEntityId)) { _extError = "Выберите ЮЛ."; return; } if (_showLeTypeWarning) { _extError = "Тип ЮЛ не определён."; return; } await using var ctx = await DbFactory.CreateDbContextAsync(); var leId = Guid.Parse(_selectedLegalEntityId); var pid = Guid.NewGuid(); ctx.EcosystemParticipants.Add(new() { Id = pid, LegalEntityId = leId, LastName = _extLastName, FirstName = _extFirstName, MiddleName = _extMiddleName, Login = $"{_extLastName.ToLowerInvariant()}.{_extFirstName.ToLowerInvariant()}", CreatedAt = DateTime.UtcNow, CreatedBy = Guid.Empty }); var role = await ctx.Roles.FirstOrDefaultAsync(r => r.Code == _extRoleCode); ctx.ExternalAttractedPersons.Add(new() { Id = Guid.NewGuid(), EcosystemParticipantId = pid, LegalEntityId = leId, Position = role?.Name ?? _extRoleCode, StartedAt = _extStartDate?.ToDateTime(TimeOnly.MinValue), EndedAt = _extEndDate?.ToDateTime(TimeOnly.MinValue), IsActive = true, CreatedAt = DateTime.UtcNow, CreatedBy = Guid.Empty }); await ctx.SaveChangesAsync(); _extLastName = ""; _extFirstName = ""; _extMiddleName = ""; _extRoleCode = ""; _extStartDate = null; _extEndDate = null; await LoadExternalPersonsAsync(); } catch { _extError = "Ошибка."; } finally { _addExtLoading = false; } } private async Task RemoveExternalPerson(Guid id) { try { await using var ctx = await DbFactory.CreateDbContextAsync(); var p = await ctx.ExternalAttractedPersons.FindAsync(id); if (p != null) { ctx.ExternalAttractedPersons.Remove(p); await ctx.SaveChangesAsync(); await LoadExternalPersonsAsync(); } } catch { } } private void ShowCreateLeModal() { _showCreateLeModal = true; _createLeName = ""; _createLeInn = ""; _createLeNameError = null; _createLeInnError = null; _createLeError = null; } private async Task CreateLegalEntity() { _createLeNameError = null; _createLeInnError = null; _createLeError = null; if (string.IsNullOrWhiteSpace(_createLeName)) { _createLeNameError = "Введите наименование."; return; } if (string.IsNullOrWhiteSpace(_createLeInn)) { _createLeInnError = "Введите ИНН."; return; } if (_createLeInn.Length != 10 && _createLeInn.Length != 12) { _createLeInnError = "ИНН: 10 или 12 цифр."; return; } _createLeLoading = true; StateHasChanged(); try { await using var ctx = await DbFactory.CreateDbContextAsync(); if (await ctx.LegalEntities.AnyAsync(le => le.Inn == _createLeInn)) { _createLeInnError = $"ИНН {_createLeInn} уже существует."; return; } var le = new LegalEntity { Id = Guid.NewGuid(), Name = _createLeName, Inn = _createLeInn }; ctx.LegalEntities.Add(le); await ctx.SaveChangesAsync(); _legalEntities.Add(le); _selectedLegalEntityId = le.Id.ToString(); _showCreateLeModal = false; } catch { _createLeError = "Ошибка."; } finally { _createLeLoading = false; StateHasChanged(); } } private record EmployeeRow { public Guid Id { get; init; } public string FullName { get; init; } = ""; public string? Position { get; init; } public string Login { get; init; } = ""; public string RoleName { get; init; } = ""; } private record ExternalPersonRow { public Guid Id { get; init; } public string FullName { get; init; } = ""; public string RoleName { get; init; } = ""; public DateTime? StartedAt { get; init; } public DateTime? EndedAt { get; init; } public bool IsActive { get; init; } } }
