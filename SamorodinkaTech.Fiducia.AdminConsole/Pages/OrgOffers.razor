@page "/org-templates/stages/{StageId:guid}/offers"
@using Microsoft.EntityFrameworkCore
@using System.Collections.Generic
@inject IDbContextFactory<SamorodinkaTech.Fiducia.Infrastructure.Persistence.FiduciaDbContext> DbFactory
@inject ILogger<OrgTemplates> Logger
@inject NavigationManager Nav
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SYS_ADMIN")]

<h3>
    <a href="/org-templates" class="text-decoration-none">Шаблоны</a> →
    @if (_intentId.HasValue)
    {
        <a href="/org-templates/intents/@_intentId/stages" class="text-decoration-none">@(_intentName ?? "Этапы")</a>
    }
    <span>→ @(_stageName ?? "Задачи")</span>
</h3>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success">@_success</div>
}

<button class="btn btn-primary btn-sm mb-2" @onclick="() => _showForm = true">Добавить задачу</button>

@if (_showForm)
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Название</label>
                    <input class="form-control" @bind="_editName" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Описание</label>
                    <input class="form-control" @bind="_editDesc" />
                </div>
                <div class="col-md-1">
                    <label class="form-label">Смещение</label>
                    <input class="form-control" type="number" @bind="_editOffset" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Дедлайн</label>
                    <select class="form-select" @bind="_editDeadlineRule">
                        <option value="">— нет —</option>
                        <option value="FIXED_DAYS">Через N дней</option>
                        <option value="AFTER_START">После начала</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <label class="form-label">Дни</label>
                    <input class="form-control" type="number" @bind="_editDeadlineDays" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Ед. изм.</label>
                    <select class="form-select" @bind="_editMeasurementUnitId">
                        <option value="">— не указано —</option>
                        @foreach (var mu in _measurementUnits)
                        {
                            <option value="@mu.Id">@mu.ShortName</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Должность СД</label>
                    <select class="form-select" @bind="_editBoardRoleId">
                        <option value="">— нет —</option>
                        @foreach (var br in _boardRoles)
                        {
                            <option value="@br.Id">@br.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="row g-2 mt-2">
                <div class="col-md-6">
                    <label class="form-label mb-1">Канд. роли</label>
                    <div style="max-height:100px; overflow-y:auto; border:1px solid #dee2e6; border-radius:4px; padding:4px 8px;">
                        @foreach (var r in _roles)
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox"
                                       id="role_@r.Id"
                                       checked="@_editRoleIds.Contains(r.Id)"
                                       @onchange="e => ToggleRole(r.Id, (bool)(e.Value ?? false))" />
                                <label class="form-check-label small" for="role_@r.Id">@r.Name</label>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label mb-1">Условия включения</label>
                    <div style="max-height:100px; overflow-y:auto; border:1px solid #dee2e6; border-radius:4px; padding:4px 8px;">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="pred_notary"
                                   @bind="_editNotaryConfirmation" />
                            <label class="form-check-label small" for="pred_notary">Нотариус</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="pred_allsign"
                                   @bind="_editAllSignConfirmation" />
                            <label class="form-check-label small" for="pred_allsign">Подп. всеми</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="pred_committees"
                                   @bind="_editCommittees" />
                            <label class="form-check-label small" for="pred_committees">Комитеты</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="pred_regulation"
                                   @bind="_editBoardRegulation" />
                            <label class="form-check-label small" for="pred_regulation">Положение</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="pred_custom"
                                   @bind="_editCustomCharter" />
                            <label class="form-check-label small" for="pred_custom">Нетиповой устав</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="pred_exec_a"
                                   @bind="_editExecutiveBodyA" />
                            <label class="form-check-label small" for="pred_exec_a">Гендиректор</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="pred_bod"
                                   @bind="_editBoardOfDirectors" />
                            <label class="form-check-label small" for="pred_bod">Совет директоров</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="pred_uzedo"
                                   @bind="_editDocumentFlowLegalElectronic" />
                            <label class="form-check-label small" for="pred_uzedo">ЮЗЭДО</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row g-2 mt-2">
                <div class="col-md-1 d-flex gap-1">
                    <button class="btn btn-success btn-sm" @onclick="Save">✓</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="CancelForm">✕</button>
                </div>
            </div>
        </div>
    </div>
}

<table class="table table-sm table-hover">
    <thead>
        <tr><th>Название</th><th>Смещение</th><th>Дедлайн</th><th>Должность СД</th><th>Предшественник</th><th>Предикаты</th><th style="width:100px">Действия</th></tr>
    </thead>
    <tbody>
    @foreach (var s in _items)
    {
        var deadlineLabel = s.DeadlineRule switch
        {
            "FIXED_DAYS" => $"+{s.DeadlineDays} {s.MeasurementUnit?.ShortName ?? "дн."}",
            "AFTER_START" => $"после нач. +{s.DeadlineDays} {s.MeasurementUnit?.ShortName ?? "дн."}",
            _ => "—"
        };
        var boardRoleName = _boardRoles.FirstOrDefault(r => r.Id == s.AssignedBoardRoleId)?.Name ?? "—";
        <tr>
            <td>@s.Name</td>
            <td>@(s.StartOffsetDays?.ToString() ?? "—")</td>
            <td>@deadlineLabel</td>
            <td>@boardRoleName</td>
            <td class="small text-muted">@(_predecessorNames.GetValueOrDefault(s.Id, "—"))</td>
            <td class="small">
                @if (s.RequireNotaryConfirmation == true) { <span class="badge bg-secondary me-1">нотариус</span> }
                @if (s.RequireAllSignConfirmation == true) { <span class="badge bg-secondary me-1">подп.всеми</span> }
                @if (s.RequireCommittees == true) { <span class="badge bg-secondary me-1">комитеты</span> }
                @if (s.RequireBoardRegulation == true) { <span class="badge bg-secondary me-1">положение</span> }
                @if (s.RequireCustomCharter == true) { <span class="badge bg-secondary me-1">нетиповой</span> }
                @if (s.RequireExecutiveBodyA == true) { <span class="badge bg-secondary me-1">гендир</span> }
                @if (s.RequireBoardOfDirectors == true) { <span class="badge bg-secondary me-1">СД</span> }
                @if (s.RequireDocumentFlowLegalElectronic == true) { <span class="badge bg-secondary me-1">ЮЗЭДО</span> }
            </td>
            <td>
                <button class="btn btn-outline-secondary btn-sm me-1" @onclick="async () => await Edit(s)">✏️</button>
            </td>
        </tr>
    }
    </tbody>
</table>

@code {
    [Parameter] public Guid StageId { get; set; }

    private List<TplOrgTaskOffer> _items = new();
    private List<SamorodinkaTech.Fiducia.Domain.Entities.RefRole> _roles = new();
    private List<SamorodinkaTech.Fiducia.Domain.Entities.RefBoardRole> _boardRoles = new();
    private List<RefMeasurementUnit> _measurementUnits = new();
    private Dictionary<Guid, List<string>> _offerRoleNames = new();
    private Dictionary<Guid, string> _predecessorNames = new();
    private string? _stageName;
    private string? _intentName;
    private Guid? _intentId;
    private string? _error;
    private string? _success;
    private bool _showForm;
    private string _editName = "";
    private string _editDesc = "";
    private HashSet<Guid> _editRoleIds = new();
    private int? _editOffset;
    private string _editDeadlineRule = "";
    private int? _editDeadlineDays;
    private string? _editMeasurementUnitId;
    private string _editBoardRoleId = "";
    private bool _editNotaryConfirmation;
    private bool _editAllSignConfirmation;
    private bool _editCommittees;
    private bool _editBoardRegulation;
    private bool _editCustomCharter;
    private bool _editExecutiveBodyA;
    private bool _editBoardOfDirectors;
    private bool _editDocumentFlowLegalElectronic;
    private Guid? _editingId;

    protected override async Task OnInitializedAsync() { await LoadAsync(); }

    private async Task LoadAsync()
    {
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var stage = await ctx.TplOrgStages.Include(x => x.Intent).FirstOrDefaultAsync(x => x.Id == StageId);
            if (stage != null)
            {
                _stageName = stage.Name;
                _intentId = stage.IntentId;
                _intentName = stage.Intent?.Name;
            }
            _roles = await ctx.Roles.OrderBy(x => x.Name).ToListAsync();
            _boardRoles = await ctx.BoardRoles.OrderBy(x => x.SortOrder).ThenBy(x => x.Name).ToListAsync();
            _measurementUnits = await ctx.RefMeasurementUnits.OrderBy(x => x.SortOrder).ToListAsync();
            _items = await ctx.TplOrgOffers.Where(x => x.StageId == StageId).OrderBy(x => x.StartOffsetDays ?? 0).ThenBy(x => x.Name).ToListAsync();
            // Загружаем все оферы intent'а для разрешения имён предшественников (кросс-этапные ссылки)
            List<TplOrgTaskOffer>? allOffers = null;
            if (_intentId.HasValue)
            {
                var stageIds = await ctx.TplOrgStages.Where(x => x.IntentId == _intentId.Value).Select(x => x.Id).ToListAsync();
                allOffers = await ctx.TplOrgOffers.Where(x => stageIds.Contains(x.StageId)).ToListAsync();
            }
            var links = await ctx.TplOrgOfferRoles.Where(x => _items.Select(o => o.Id).Contains(x.TplOfferId)).ToListAsync();
            _offerRoleNames = links.GroupBy(x => x.TplOfferId).ToDictionary(
                g => g.Key,
                g => g.Select(l => _roles.FirstOrDefault(r => r.Id == l.RoleId)?.Name ?? "?").Where(n => n != "?").ToList()
            );
            var lookup = allOffers ?? _items;
            _predecessorNames = _items.Where(o => !string.IsNullOrEmpty(o.PredecessorOfferIds)).SelectMany(o =>
            {
                try
                {
                    var ids = System.Text.Json.JsonSerializer.Deserialize<Guid[]>(o.PredecessorOfferIds!);
                    return ids?.Select(id => new { OfferId = o.Id, PredName = lookup.FirstOrDefault(p => p.Id == id)?.Name ?? id.ToString() }) ?? [];
                }
                catch { return []; }
            }).GroupBy(x => x.OfferId).ToDictionary(g => g.Key, g => string.Join(", ", g.Select(x => x.PredName)));
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Ошибка загрузки задач"); _error = ExceptionFlattener.Unwrap(ex); }
    }

    private async Task Edit(TplOrgTaskOffer o)
    {
        _editingId = o.Id; _editName = o.Name; _editDesc = o.Description ?? "";
        _editOffset = o.StartOffsetDays; _editDeadlineRule = o.DeadlineRule ?? ""; _editDeadlineDays = o.DeadlineDays;
        _editMeasurementUnitId = o.MeasurementUnitId?.ToString();
        _editBoardRoleId = o.AssignedBoardRoleId?.ToString() ?? "";
        _editNotaryConfirmation = o.RequireNotaryConfirmation ?? false;
        _editAllSignConfirmation = o.RequireAllSignConfirmation ?? false;
        _editCommittees = o.RequireCommittees ?? false;
        _editBoardRegulation = o.RequireBoardRegulation ?? false;
        _editCustomCharter = o.RequireCustomCharter ?? false;
        _editExecutiveBodyA = o.RequireExecutiveBodyA ?? false;
        _editBoardOfDirectors = o.RequireBoardOfDirectors ?? false;
        _editDocumentFlowLegalElectronic = o.RequireDocumentFlowLegalElectronic ?? false;
        _editRoleIds.Clear();
        await using var ctx = await DbFactory.CreateDbContextAsync();
        var links = await ctx.TplOrgOfferRoles.Where(x => x.TplOfferId == o.Id).Select(x => x.RoleId).ToListAsync();
        foreach (var rid in links) _editRoleIds.Add(rid);
        _showForm = true;
    }

    private void ToggleRole(Guid roleId, bool add)
    {
        if (add) _editRoleIds.Add(roleId);
        else _editRoleIds.Remove(roleId);
    }

    private void CancelForm()
    {
        _showForm = false; _editingId = null; _editRoleIds.Clear();
        _editNotaryConfirmation = false; _editAllSignConfirmation = false; _editCommittees = false;
        _editBoardRegulation = false; _editCustomCharter = false; _editExecutiveBodyA = false;
        _editBoardOfDirectors = false; _editDocumentFlowLegalElectronic = false;
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_editName)) return;
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            Guid? boardRoleId = Guid.TryParse(_editBoardRoleId, out var brId) ? brId : null;
            Guid? measurementUnitId = Guid.TryParse(_editMeasurementUnitId, out var muId) ? muId : null;
            if (_editingId.HasValue)
            {
                var e = await ctx.TplOrgOffers.FirstOrDefaultAsync(x => x.Id == _editingId.Value);
                if (e != null)
                {
                    e.Name = _editName.Trim(); e.Description = (string.IsNullOrWhiteSpace(_editDesc) ? null : _editDesc.Trim());
                    e.StartOffsetDays = _editOffset;
                    e.DeadlineRule = (string.IsNullOrWhiteSpace(_editDeadlineRule) ? null : _editDeadlineRule.Trim());
                    e.DeadlineDays = _editDeadlineDays;
                    e.MeasurementUnitId = measurementUnitId;
                    e.AssignedBoardRoleId = boardRoleId;
                    e.RequireNotaryConfirmation = _editNotaryConfirmation ? true : null;
                    e.RequireAllSignConfirmation = _editAllSignConfirmation ? true : null;
                    e.RequireCommittees = _editCommittees ? true : null;
                    e.RequireBoardRegulation = _editBoardRegulation ? true : null;
                    e.RequireCustomCharter = _editCustomCharter ? true : null;
                    e.RequireExecutiveBodyA = _editExecutiveBodyA ? true : null;
                    e.RequireBoardOfDirectors = _editBoardOfDirectors ? true : null;
                    e.RequireDocumentFlowLegalElectronic = _editDocumentFlowLegalElectronic ? true : null;
                }
            }
            else
            {
                var newOffer = new TplOrgTaskOffer
                {
                    Id = Guid.NewGuid(), Name = _editName.Trim(),
                    Description = (string.IsNullOrWhiteSpace(_editDesc) ? null : _editDesc.Trim()),
                    StageId = StageId,
                    StartOffsetDays = _editOffset,
                    DeadlineRule = (string.IsNullOrWhiteSpace(_editDeadlineRule) ? null : _editDeadlineRule.Trim()),
                    DeadlineDays = _editDeadlineDays,
                    MeasurementUnitId = measurementUnitId,
                    AssignedBoardRoleId = boardRoleId,
                    RequireNotaryConfirmation = _editNotaryConfirmation ? true : null,
                    RequireAllSignConfirmation = _editAllSignConfirmation ? true : null,
                    RequireCommittees = _editCommittees ? true : null,
                    RequireBoardRegulation = _editBoardRegulation ? true : null,
                    RequireCustomCharter = _editCustomCharter ? true : null,
                    RequireExecutiveBodyA = _editExecutiveBodyA ? true : null,
                    RequireBoardOfDirectors = _editBoardOfDirectors ? true : null,
                    RequireDocumentFlowLegalElectronic = _editDocumentFlowLegalElectronic ? true : null
                };
                ctx.TplOrgOffers.Add(newOffer);
                foreach (var rid in _editRoleIds)
                    ctx.TplOrgOfferRoles.Add(new TplOrgOfferRole { Id = Guid.NewGuid(), TplOfferId = newOffer.Id, RoleId = rid });
            }
            await ctx.SaveChangesAsync();
            CancelForm(); await LoadAsync();
            _success = _editingId.HasValue ? "Задача обновлена." : "Задача создана.";
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Ошибка сохранения"); _error = ExceptionFlattener.Unwrap(ex); }
    }

}
